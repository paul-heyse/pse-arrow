+#[cfg(test)]
+#[test]
+#[allow(clippy::unwrap_used, reason = "the row codec fixture requires exact round trips")]
+fn optional_project_description_preserves_historical_and_explicit_rows() {
+    let mut historical = Object::new();
+    historical.insert("key", Value::String("historical-project".into()));
+    historical.insert("title", Value::String("Historical title".into()));
+    historical.insert("deleted", Value::Bool(false));
+    historical.insert("generation", codec::encode_uint(7).unwrap());
+
+    let previous = wire::decode_canonical_projects(historical.clone()).unwrap();
+    assert_eq!(previous.key, "historical-project");
+    assert_eq!(previous.title, "Historical title");
+    assert_eq!(previous.generation, 7);
+    assert_eq!(previous.description, None);
+
+    historical.insert("description", Value::String("Independent metadata".into()));
+    let explicit = wire::decode_canonical_projects(historical).unwrap();
+    assert_eq!(explicit.description.as_deref(), Some("Independent metadata"));
+    assert_eq!(
+        wire::decode_canonical_projects(wire::encode_canonical_projects(&explicit).unwrap())
+            .unwrap()
+            .description,
+        explicit.description
+    );
+}
