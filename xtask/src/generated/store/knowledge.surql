DEFINE FIELD OVERWRITE kind ON knowledge_subjects TYPE pse_knowledge_subject_kind READONLY ASSERT ($value='document' AND $this.document_role IN ['contract','instruction','plan','review','reference','evidence','index'] AND (($this.native_state=NONE AND $this.state_basis=NONE) OR ($this.native_state!=NONE AND $this.state_basis!=NONE)) AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE) OR ($value='contract' AND $this.document_role IN ['contract'] AND (($this.native_state=NONE AND $this.state_basis=NONE) OR ($this.native_state!=NONE AND $this.state_basis!=NONE)) AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE) OR ($value='decision' AND $this.document_role IN ['decision'] AND $this.native_state!=NONE AND $this.state_basis!=NONE AND (($this.native_state=NONE AND $this.state_basis=NONE) OR ($this.native_state!=NONE AND $this.state_basis!=NONE)) AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE) OR ($value='plan_package' AND $this.document_role IN ['plan'] AND $this.native_state!=NONE AND $this.state_basis!=NONE AND (($this.native_state=NONE AND $this.state_basis=NONE) OR ($this.native_state!=NONE AND $this.state_basis!=NONE)) AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE) OR ($value='declaration' AND $this.document_role=NONE AND $this.native_state=NONE AND $this.state_basis=NONE AND $this.publication_scope=NONE AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE) OR ($value='generator' AND $this.document_role=NONE AND $this.native_state=NONE AND $this.state_basis=NONE AND $this.publication_scope=NONE AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE) OR ($value='generated_artifact' AND $this.document_role=NONE AND $this.native_state=NONE AND $this.state_basis=NONE AND $this.publication_scope=NONE AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE) OR ($value='experiment' AND $this.document_role=NONE AND $this.native_state=NONE AND $this.state_basis=NONE AND $this.publication_scope=NONE AND $this.native_version!=NONE AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE AND $this.basis IN ['native']) OR ($value='diagnostic' AND $this.document_role=NONE AND $this.native_state=NONE AND $this.state_basis=NONE AND $this.publication_scope=NONE AND $this.native_version!=NONE AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE AND $this.basis IN ['native']) OR ($value='evidence_reference' AND $this.document_role=NONE AND $this.native_state=NONE AND $this.state_basis=NONE AND $this.publication_scope=NONE AND $this.evidence_authority!=NONE AND $this.evidence_codec!=NONE AND $this.evidence_source!=NONE AND $this.evidence_version!=NONE AND $this.evidence_member!=NONE AND $this.basis IN ['native','historical']) OR ($value='research_question' AND $this.document_role=NONE AND $this.native_state=NONE AND $this.state_basis=NONE AND $this.publication_scope=NONE AND $this.evidence_authority=NONE AND $this.evidence_codec=NONE AND $this.evidence_source=NONE AND $this.evidence_version=NONE AND $this.evidence_member=NONE AND $this.basis IN ['user-question','agent-interpretation']);
DEFINE FIELD OVERWRITE relation ON knowledge_subject_edges TYPE pse_knowledge_relation_kind READONLY ASSERT ($value='owns' AND $this.in.kind IN ['document','contract','decision'] AND $this.out.kind IN ['document','contract','decision','plan_package','declaration','generator','generated_artifact']) OR ($value='governs' AND $this.in.kind IN ['contract','decision'] AND $this.out.kind IN ['document','contract','decision','plan_package','declaration','generator','generated_artifact','experiment','diagnostic']) OR ($value='contains' AND $this.in.kind IN ['document'] AND $this.out.kind IN ['contract','decision','plan_package']) OR ($value='depends_on' AND $this.in.kind IN ['plan_package'] AND $this.out.kind IN ['plan_package']) OR ($value='status_owned_by' AND $this.in.kind IN ['plan_package'] AND $this.out.kind IN ['plan_package']) OR ($value='superseded_by' AND $this.in.kind IN ['decision','plan_package','contract'] AND $this.out.kind IN ['decision','plan_package','contract'] AND $this.in.kind=$this.out.kind) OR ($value='supports' AND $this.in.kind IN ['evidence_reference','experiment','diagnostic'] AND $this.out.kind IN ['document','contract','decision','plan_package','declaration','research_question']) OR ($value='answers' AND $this.in.kind IN ['evidence_reference','experiment','diagnostic'] AND $this.out.kind IN ['research_question']) OR ($value='diagnoses' AND $this.in.kind IN ['diagnostic'] AND $this.out.kind IN ['experiment']) OR ($value='references' AND $this.in.kind IN ['document','contract','decision','plan_package','research_question'] AND $this.out.kind IN ['evidence_reference']);
DEFINE FIELD OVERWRITE topic ON knowledge_subject_topics TYPE string READONLY ASSERT { LET $knowledge_assert_generation=$this.generation; LET $knowledge_assert_subject=$this.subject_key; LET $knowledge_assert_source=$this.source_key; RETURN $this.subject_key_record.kind IN ['document','contract','decision','plan_package'] AND array::len((SELECT VALUE key FROM knowledge_subject_sources WHERE generation=$knowledge_assert_generation AND subject_key=$knowledge_assert_subject AND source_key=$knowledge_assert_source AND role='metadata' LIMIT 1))=1; };
DEFINE FIELD OVERWRITE excerpt_id ON knowledge_excerpts TYPE string READONLY ASSERT { LET $knowledge_assert_generation=$this.generation; LET $knowledge_assert_subject=$this.subject_key; LET $knowledge_assert_source=$this.source_key; RETURN ($this.subject_key=NONE AND $this.subject_key_record=NONE) OR ($this.subject_key!=NONE AND $this.subject_key_record=type::record('knowledge_subjects',$this.subject_key) AND record::exists($this.subject_key_record) AND $this.subject_key_record.generation=$this.generation AND array::len((SELECT VALUE key FROM knowledge_subject_sources WHERE generation=$knowledge_assert_generation AND subject_key=$knowledge_assert_subject AND source_key=$knowledge_assert_source LIMIT 1))=1); };
DEFINE ANALYZER knowledge_text_v2 TOKENIZERS blank,class,camel,punct FILTERS lowercase;
DEFINE INDEX knowledge_excerpt_text ON knowledge_excerpts FIELDS text FULLTEXT ANALYZER knowledge_text_v2 BM25 HIGHLIGHTS;
