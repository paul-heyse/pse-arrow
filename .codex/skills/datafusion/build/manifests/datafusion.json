{
  "repository": {
    "name": "datafusion",
    "title": "Apache DataFusion and the Arrow Rust family",
    "description": "Pinned API surface, narrative guides and runnable examples for the DataFusion 55.1.0 universe."
  },
  "tools": {
    "ast_grep_version": "0.45.2",
    "rustdoc_format_versions": [
      57,
      59,
      60,
      61
    ]
  },
  "crate_sets": [
    {
      "name": "datafusion",
      "version": "55.1.0",
      "facade": "datafusion",
      "crates": [
        "datafusion",
        "datafusion-catalog",
        "datafusion-catalog-listing",
        "datafusion-common",
        "datafusion-common-runtime",
        "datafusion-datasource",
        "datafusion-datasource-arrow",
        "datafusion-datasource-avro",
        "datafusion-datasource-csv",
        "datafusion-datasource-json",
        "datafusion-datasource-parquet",
        "datafusion-doc",
        "datafusion-execution",
        "datafusion-expr",
        "datafusion-expr-common",
        "datafusion-ffi",
        "datafusion-functions",
        "datafusion-functions-aggregate",
        "datafusion-functions-aggregate-common",
        "datafusion-functions-nested",
        "datafusion-functions-table",
        "datafusion-functions-window",
        "datafusion-functions-window-common",
        "datafusion-macros",
        "datafusion-optimizer",
        "datafusion-physical-expr",
        "datafusion-physical-expr-adapter",
        "datafusion-physical-expr-common",
        "datafusion-physical-optimizer",
        "datafusion-physical-plan",
        "datafusion-proto",
        "datafusion-proto-common",
        "datafusion-proto-models",
        "datafusion-pruning",
        "datafusion-session",
        "datafusion-spark",
        "datafusion-sql",
        "datafusion-substrait"
      ]
    },
    {
      "name": "arrow",
      "version": "59.3.0",
      "facade": "arrow",
      "crates": [
        "arrow",
        "arrow-arith",
        "arrow-array",
        "arrow-avro",
        "arrow-buffer",
        "arrow-cast",
        "arrow-csv",
        "arrow-data",
        "arrow-flight",
        "arrow-ipc",
        "arrow-json",
        "arrow-ord",
        "arrow-pyarrow",
        "arrow-row",
        "arrow-schema",
        "arrow-select",
        "arrow-string",
        "parquet",
        "parquet-variant",
        "parquet-variant-compute"
      ]
    },
    {
      "name": "object_store",
      "version": "0.13.2",
      "facade": "object_store",
      "crates": [
        "object_store"
      ]
    },
    {
      "name": "sqlparser",
      "version": "0.62.0",
      "facade": "sqlparser",
      "crates": [
        "sqlparser"
      ],
      "note": "DataFusion re-exports the SQL dialect surface as datafusion::sql::sqlparser."
    }
  ],
  "corpora": [
    {
      "name": "examples",
      "repo": "apache/datafusion",
      "ref": "55.1.0",
      "source_prefix": "datafusion-examples/examples/",
      "dest": "corpus/examples",
      "suffixes": [
        ".rs"
      ]
    },
    {
      "name": "guides",
      "repo": "apache/datafusion",
      "ref": "55.1.0",
      "source_prefix": "docs/source/user-guide/",
      "dest": "corpus/guides/user-guide",
      "suffixes": [
        ".md"
      ]
    },
    {
      "name": "library-guides",
      "repo": "apache/datafusion",
      "ref": "55.1.0",
      "source_prefix": "docs/source/library-user-guide/",
      "dest": "corpus/guides/library-user-guide",
      "suffixes": [
        ".md"
      ]
    }
  ]
}
