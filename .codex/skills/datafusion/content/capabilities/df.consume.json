  "brief": "Streaming avoids retaining every output batch in the terminal API; it does not bound the query working set. A blocking sort can still fail for memory even when output is streamed.",
  "choices": [
    {
      "candidate": "collect",
      "choose_when": "All output is intentionally retained",
      "tradeoff": "Returns Vec<RecordBatch>; memory includes result retention.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "execute_stream",
      "choose_when": "Incremental single-stream consumer",
      "tradeoff": "Planning and stream polling can fail separately; consumer retention still matters.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "execute_stream_partitioned",
      "choose_when": "Caller can manage output partition concurrency",
      "tradeoff": "Partition streams do not imply global ordering.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "cache",
      "choose_when": "Reuse materialized results",
      "tradeoff": "Executes and stores results in memory; a cloned plan/view is not the same guarantee.",
      "kind": "authored_conditional_judgment"
    }
  ],
  "claims": [
    {
      "id": "df.consume.shape",
      "aspect": "shape",
      "statement": "Terminal methods consume DataFrame. execute_stream asynchronously creates a physical plan and returns a fallible RecordBatch stream; collect returns a batch vector. Single-stream output is not an implicit sort.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.consume.memory",
      "aspect": "memory",
      "statement": "Operator state, prefetch, caches and consumer batches contribute memory. Default pool is unbounded; disk manager defaults to OS temporary storage. with_memory_limit explicitly does not account for every allocation.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream",
        "source"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.consume.spill",
      "aspect": "spill",
      "statement": "Configure a participating pool and operator-specific spill behavior, directory/capacity and concurrency. A pool budget is not an RSS bound. Inspect EXPLAIN/metrics and execute the workload.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.consume.lifecycle",
      "aspect": "lifecycle",
      "statement": "Upstream documents dropping the output stream aborts its execution and frees associated resources. This is not a guarantee for unrelated application background tasks or retained batch buffers.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    }
  ],
  "implementation": [
    "Choose terminal API from ownership and consumption requirements.",
    "Inspect blocking operators and configure their resource policy before execution.",
    "Handle failures both creating and polling streams; test cancellation if operational correctness depends on it."
  ],
