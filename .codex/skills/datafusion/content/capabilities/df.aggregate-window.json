  "brief": "Choose built-in aggregates/windows first. For extensions, partial state, merge, grouped layout and window retraction are distinct contracts; an accumulator is not merely a final reduction function.",
  "choices": [
    {
      "candidate": "built-in aggregate/window",
      "choose_when": "Existing semantics and frames fit",
      "tradeoff": "Check empty/null/order/distinct behavior and registration.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "Accumulator",
      "choose_when": "Custom stateful aggregate",
      "tradeoff": "Consumes batches; state output must compose correctly with merge_batch and declared state fields.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "GroupsAccumulator / adapter",
      "choose_when": "Many groups need shared state layout",
      "tradeoff": "Specialization can reduce overhead but must preserve groups/null/emit semantics; benchmark rather than assuming.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "PartitionEvaluator / retract-capable aggregate",
      "choose_when": "Window-specific or moving-frame evaluation",
      "tradeoff": "Capability hooks determine available evaluation paths; returning unsupported/default may be correct.",
      "kind": "authored_conditional_judgment"
    }
  ],
  "claims": [
    {
      "id": "df.aggregate-window.state",
      "aspect": "state",
      "statement": "Accumulator update_batch receives arrays, state returns partial ScalarValues, merge_batch consumes state arrays, and evaluate produces a final ScalarValue. Declared state fields must agree with both serialization and merge.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.aggregate-window.frames",
      "aspect": "frames",
      "statement": "Window partitioning, ORDER BY, peer groups and frame bounds determine rows contributing to output. Default ordered RANGE and explicit ROWS can differ on duplicate ordering keys.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.aggregate-window.retraction",
      "aspect": "retraction",
      "statement": "Sliding windows may require retract_batch or specialized partition evaluation. Advertise support only when removal/order/empty-state semantics are correct.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.aggregate-window.memory",
      "aspect": "memory",
      "statement": "Accumulator size reporting and groups state influence resource accounting. A groups implementation is not an automatic throughput or memory improvement.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    }
  ],
  "implementation": [
    "Look up the built-in function and its signature/null/frame behavior.",
    "For custom aggregates test partitioned partial->merge against single-pass output.",
    "For moving windows test duplicate keys, empty frames and retractions; inspect state schema and memory reporting."
