  ],
  "brief": "Join keys can multiply rows; equality and null-safe equality differ. Bag/set operations differ on duplicates, and neither partitioning nor streaming promises global result order.",
  "choices": [
    {
      "candidate": "join / join_on",
      "choose_when": "Combine matching rows with chosen join type/predicate",
      "tradeoff": "Check multiplicity and null-safe versus ordinary equality.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "union / UNION ALL",
      "choose_when": "Concatenate bags",
      "tradeoff": "Preserves duplicate multiplicity, subject to compatible schemas.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "union_distinct / UNION",
      "choose_when": "Set-like duplicate elimination",
      "tradeoff": "Adds equality/dedup work; output order is unspecified without sort.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "unnest",
      "choose_when": "Expand nested values into rows",
      "tradeoff": "Row cardinality and null/empty-list options require explicit review.",
      "kind": "authored_conditional_judgment"
    }
  ],
  "claims": [
    {
      "id": "df.relations.cardinality",
      "aspect": "cardinality",
      "statement": "Many-to-many key matches multiply rows. Ordinary SQL equality does not match null keys; IS NOT DISTINCT FROM has different null equality. Select the join predicate deliberately.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.relations.sets",
      "aspect": "sets",
      "statement": "DataFrame union keeps duplicates; union_distinct removes them. Intersect/except expose distinct/all semantics via their APIs; inspect their flag and schema requirements rather than assuming SQL default multiplicities.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.relations.ordering",
      "aspect": "ordering",
      "statement": "Explicit ORDER BY establishes requested ordering. LIMIT without a total ordering does not identify deterministic rows among ties; partitioned execution changes arrival order.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    },
    {
      "id": "df.relations.schema",
      "aspect": "schema",
      "statement": "Align widths, types, column identity and metadata before relational combination. Compatible logical schema does not establish every physical metadata propagation path.",
      "kind": "upstream_contract_interpretation",
      "evidence": [
        "upstream"
      ],
      "conditions": [
        "DataFusion 55.1.0 / Arrow-Parquet 59.3.0 as applicable"
      ]
    }
  ],
