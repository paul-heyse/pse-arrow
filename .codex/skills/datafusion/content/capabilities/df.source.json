  "brief": "MemTable exposes materialized partitioned batches; ViewTable exposes a logical plan; ListingTable composes supported file formats and stores. Custom providers can reuse these execution components.",
  "choices": [
    {
      "candidate": "MemTable",
      "choose_when": "Already materialized batches",
      "tradeoff": "Owns in-memory table data; does not perform file pruning.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "ListingTable + ParquetSource",
      "choose_when": "Files with partition/statistics pruning",
      "tradeoff": "Requires store mapping, schema and listing/read configuration.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "ViewTable",
      "choose_when": "Reusable logical relation",
      "tradeoff": "Reuses a plan, not necessarily materialized results.",
      "kind": "authored_conditional_judgment"
    },
    {
      "candidate": "custom TableProvider",
      "choose_when": "Source behavior cannot be expressed by existing providers",
      "tradeoff": "Implement the scan/capability contract; do not rebuild formats/stores unnecessarily.",
      "kind": "authored_conditional_judgment"
    }
  ],
