      "path": "datafusion_functions_nested::remove::array_remove",
      "name": "array_remove",
      "kind": "function",
      "crate": "datafusion-functions-nested",
      "signature": "fn array_remove(array: datafusion_expr::Expr, element: datafusion_expr::Expr) -> datafusion_expr::Expr",
      "summary": "removes the first element from the array equal to the given value. NULL elements already in the array are preserved when removing a non-NULL value. If `element` evaluates to NULL, the result is NULL rather than removing NULL entries.",
      "doc": "api/datafusion_functions_nested.remove.md#array_remove",
