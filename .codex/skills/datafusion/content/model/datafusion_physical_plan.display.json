        {
          "name": "set_metric_types",
          "signature": "fn set_metric_types(self, metric_types: Vec<MetricType>) -> Self",
          "summary": "Specify which metric types should be rendered alongside the plan"
        },
        {
          "name": "set_show_schema",
          "signature": "fn set_show_schema(self, show_schema: bool) -> Self",
          "summary": "Enable display of schema"
        },
        {
          "name": "set_show_statistics",
          "signature": "fn set_show_statistics(self, show_statistics: bool) -> Self",
          "summary": "Enable display of statistics"
        },
        {
          "name": "set_summary",
          "signature": "fn set_summary(self, total_rows: Option<usize>, duration: Option<Duration>) -> Self",
          "summary": "Attach an `EXPLAIN ANALYZE` summary (total output rows and duration) to the rendered output. Currently only used by [`Self::pgjson`], which serializes the summary alongside the root plan object."
