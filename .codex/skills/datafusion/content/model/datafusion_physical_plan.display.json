        },
        {
          "name": "indent",
          "signature": "fn indent(&self, verbose: bool) -> impl fmt::Display + 'a",
          "summary": "Return a `format`able structure that produces a single line per node."
        },
        {
          "name": "new",
          "signature": "fn new(inner: &'a dyn ExecutionPlan) -> Self",
          "summary": "Create a wrapper around an [`ExecutionPlan`] which can be pretty printed in a variety of ways"
        },
        {
          "name": "one_line",
          "signature": "fn one_line(&self) -> impl fmt::Display + 'a",
          "summary": "Return a single-line summary of the root of the plan Example: `ProjectionExec: expr=[a@0 as a]`."
        },
        {
          "name": "pgjson",
          "signature": "fn pgjson(&self, verbose: bool) -> impl fmt::Display + 'a",
          "summary": "Returns a `format`able structure that produces PostgreSQL-style JSON output, mirroring the logical-plan pgjson format."
        },
        {
          "name": "set_metric_categories",
          "signature": "fn set_metric_categories(self, metric_categories: Option<Vec<MetricCategory>>) -> Self",
          "summary": "Specify which metric categories to include."
