    "id": "822350206b0073e10a7979ae",
    "path": "datafusion_functions_aggregate_common::order::AggregateOrderSensitivity::Beneficial",
    "name": "Beneficial",
    "owner": "datafusion_functions_aggregate_common::order::AggregateOrderSensitivity",
    "crate": "datafusion-functions-aggregate-common",
    "version": "55.1.0",
    "kind": "variant",
    "signature": "Beneficial",
    "docs": "Indicates that ordering is beneficial for the aggregate expression in terms\nof evaluation efficiency. The aggregator can produce its result efficiently\nwhen its required ordering is satisfied; however, it can still produce the\ncorrect result (albeit less efficiently) when its required ordering is not met.",
