    "id": "0c6bf94a7ecf7f1f856c8782",
    "path": "datafusion_expr_common::signature::Volatility::Immutable",
    "name": "Immutable",
    "owner": "datafusion_expr_common::signature::Volatility",
    "crate": "datafusion-expr-common",
    "version": "55.1.0",
    "kind": "variant",
    "signature": "Immutable",
    "docs": "Always returns the same output when given the same input.\n\nDataFusion will inline immutable functions during planning.\n\nFor example, the `abs` function is immutable, so `abs(-1)` will be\nevaluated and replaced  with `1` during planning rather than invoking\nthe function at runtime.",
