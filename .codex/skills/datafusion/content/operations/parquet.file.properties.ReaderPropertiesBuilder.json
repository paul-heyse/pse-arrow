    "path": "parquet::file::properties::ReaderPropertiesBuilder::set_backward_compatible_lz4",
    "name": "set_backward_compatible_lz4",
    "owner": "parquet::file::properties::ReaderPropertiesBuilder",
    "crate": "parquet",
    "version": "59.3.0",
    "kind": "function",
    "signature": "fn set_backward_compatible_lz4(self, value: bool) -> Self",
    "docs": "Enable/disable backward compatible LZ4.\n\nIf backward compatible LZ4 is enable, on LZ4_HADOOP error it will fallback\nto the older versions LZ4 algorithms. That is LZ4_FRAME, for backward compatibility\nwith files generated by older versions of this library, and LZ4_RAW, for backward\ncompatibility with files generated by older versions of parquet-cpp.\n\nIf backward compatible LZ4 is disabled, on LZ4_HADOOP error it will return the error.",
