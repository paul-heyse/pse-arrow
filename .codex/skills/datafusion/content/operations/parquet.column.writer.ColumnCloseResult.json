  {
    "id": "af9a5a9ba057420e46e25915",
    "path": "parquet::column::writer::ColumnCloseResult::update_dictionary_location",
    "name": "update_dictionary_location",
    "owner": "parquet::column::writer::ColumnCloseResult",
    "crate": "parquet",
    "version": "59.3.0",
    "kind": "function",
    "signature": "fn update_dictionary_location(self, dictionary_len: usize) -> Result<Self>",
    "docs": "Rewrite the page offsets for a dictionary-first on-disk layout.\n\nA writer that buffers the whole column chunk and splices it later (the\nArrow path) may accept the data pages *before* the dictionary page so the\ndata pages can stream straight through, then emit the dictionary page\nfirst at splice. The offsets recorded during encoding therefore assume a\ndata-pages-first layout; call this with the serialized length of the\ndictionary page to move it to offset 0 and shift every data page after\nit. A `dictionary_len` of 0 (no dictionary page) leaves the result\nunchanged.",
