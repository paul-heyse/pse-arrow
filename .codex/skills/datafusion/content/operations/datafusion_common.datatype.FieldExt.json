    "id": "3714ef82752897e8eeba6a11",
    "path": "datafusion_common::datatype::FieldExt::renamed",
    "name": "renamed",
    "owner": "datafusion_common::datatype::FieldExt",
    "crate": "datafusion-common",
    "version": "55.1.0",
    "kind": "function",
    "signature": "fn renamed(self, new_name: &str) -> Self",
    "docs": "Ensure the field is named `new_name`, returning the given field if the\nname matches, and a new field if not.\n\nThis method avoids `clone`ing fields and names if the name is the same\nas the field's existing name.\n\nExample:\n```\n# use std::sync::Arc;\n# use arrow::datatypes::{DataType, Field};\n# use datafusion_common::datatype::FieldExt;\nlet int_field = Field::new(\"my_int\", DataType::Int32, true);\n// rename to \"your_int\"\nlet renamed_field = int_field.renamed(\"your_int\");\nassert_eq!(renamed_field.name(), \"your_int\");\n```",
