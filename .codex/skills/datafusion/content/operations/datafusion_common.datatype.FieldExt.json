  {
    "id": "8c6d8b6da6323acf8bb4218f",
    "path": "datafusion_common::datatype::FieldExt::into_list",
    "name": "into_list",
    "owner": "datafusion_common::datatype::FieldExt",
    "crate": "datafusion-common",
    "version": "55.1.0",
    "kind": "function",
    "signature": "fn into_list(self) -> Self",
    "docs": "Returns a new Field representing a List of this Field's DataType.\n\nFor example if input represents an `Int32`, the return value will\nrepresent a `List<Int32>`.\n\nExample:\n```\n# use std::sync::Arc;\n# use arrow::datatypes::{DataType, Field};\n# use datafusion_common::datatype::FieldExt;\n// Int32 field\nlet int_field = Field::new(\"my_int\", DataType::Int32, true);\n// convert to a List field\nlet list_field = int_field.into_list();\n// List<Int32>\n// Note that the item field name has been renamed to \"item\"\nassert_eq!(list_field.data_type(), &DataType::List(Arc::new(\n    Field::new(\"item\", DataType::Int32, true)\n)));",
