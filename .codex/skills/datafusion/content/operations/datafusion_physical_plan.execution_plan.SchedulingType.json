  {
    "id": "87aaf2d02bb118a5b3d7c4aa",
    "path": "datafusion_physical_plan::execution_plan::SchedulingType::NonCooperative",
    "name": "NonCooperative",
    "owner": "datafusion_physical_plan::execution_plan::SchedulingType",
    "crate": "datafusion-physical-plan",
    "version": "55.1.0",
    "kind": "variant",
    "signature": "NonCooperative",
    "docs": "The stream generated by [`execute`](ExecutionPlan::execute) does not actively participate in\ncooperative scheduling. This means the implementation of the `Stream` returned by\n[`ExecutionPlan::execute`] does not contain explicit task budget consumption such as\n[`tokio::task::coop::consume_budget`].\n\n`NonCooperative` is the default value and is acceptable for most operators. Please refer to\nthe [`coop`](crate::coop) module for details on when it may be useful to use\n`Cooperative` instead.",
