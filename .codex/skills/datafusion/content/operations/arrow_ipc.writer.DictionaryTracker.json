  {
    "id": "6b1b645edb897ad0cd1fb3fd",
    "path": "arrow_ipc::writer::DictionaryTracker::insert",
    "name": "insert",
    "owner": "arrow_ipc::writer::DictionaryTracker",
    "crate": "arrow-ipc",
    "version": "59.3.0",
    "kind": "function",
    "signature": "fn insert(&mut self, dict_id: i64, column: &ArrayRef) -> Result<bool, ArrowError>",
    "docs": "Keep track of the dictionary with the given ID and values. Behavior:\n\n* If this ID has been written already and has the same data, return `Ok(false)` to indicate\n  that the dictionary was not actually inserted (because it's already been seen).\n* If this ID has been written already but with different data, and this tracker is\n  configured to return an error, return an error.\n* If the tracker has not been configured to error on replacement or this dictionary\n  has never been seen before, return `Ok(true)` to indicate that the dictionary was just\n  inserted.",
