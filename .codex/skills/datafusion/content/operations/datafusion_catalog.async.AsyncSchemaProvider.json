    "id": "565aacf0f8e77dcb568c42fb",
    "path": "datafusion_catalog::async::AsyncSchemaProvider::resolve",
    "name": "resolve",
    "owner": "datafusion_catalog::async::AsyncSchemaProvider",
    "crate": "datafusion-catalog",
    "version": "55.1.0",
    "kind": "function",
    "signature": "async fn resolve(&self, references: &[TableReference], config: &SessionConfig, catalog_name: &str, schema_name: &str) -> Result<Arc<dyn SchemaProvider>>",
    "docs": "Creates a cached provider that can be used to execute a query containing given references\n\nThis method will walk through the references and look them up once, creating a cache of table\nproviders.  This cache will be returned as a synchronous TableProvider that can be used to plan\nand execute a query containing the given references.\n\nThis cache is intended to be short-lived for the execution of a single query.  There is no mechanism\nfor refresh or eviction of stale entries.\n\nSee the [`AsyncSchemaProvider`] documentation for additional details",
