    "path": "datafusion_common::alias::AliasGenerator::update_min_id",
    "name": "update_min_id",
    "owner": "datafusion_common::alias::AliasGenerator",
    "crate": "datafusion-common",
    "version": "55.1.0",
    "kind": "function",
    "signature": "fn update_min_id(&self, min_id: usize)",
    "docs": "Advance the counter to at least `min_id`, ensuring future aliases\nwon't collide with already-existing ones.\n\nFor example, if the query already contains an alias `alias_42`, then calling\n`update_min_id(42)` will ensure that future aliases generated by this\n[`AliasGenerator`] will start from `alias_43`.",
