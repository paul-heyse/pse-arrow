    "signature": "fn concat_elements_fixed_size_binary(left: &FixedSizeBinaryArray, right: &FixedSizeBinaryArray) -> Result<FixedSizeBinaryArray, arrow_schema::ArrowError>",
    "docs": "Returns the elementwise concatenation of a [`FixedSizeBinaryArray`].\n\nThe result has `value_length = left.value_length() + right.value_length()`.\nAn index is null if either input is null at that position.\n\nAn error will be returned if `left` and `right` have different lengths.",
