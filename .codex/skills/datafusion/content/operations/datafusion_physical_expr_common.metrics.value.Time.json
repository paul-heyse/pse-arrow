    "id": "cc942d629ff9bb05e8ea9250",
    "path": "datafusion_physical_expr_common::metrics::value::Time::add_duration",
    "name": "add_duration",
    "owner": "datafusion_physical_expr_common::metrics::value::Time",
    "crate": "datafusion-physical-expr-common",
    "version": "55.1.0",
    "kind": "function",
    "signature": "fn add_duration(&self, duration: Duration)",
    "docs": "Add duration of time to self\n\nNote: this will always increment the recorded time by at least 1 nanosecond\nto distinguish between the scenario of no values recorded, in which\ncase the value will be 0, and no measurable amount of time having passed,\nin which case the value will be small but not 0.\n\nThis is based on the assumption that the timing logic in most cases is likely\nto take at least a nanosecond, and so this is reasonable mechanism to avoid\nambiguity, especially on systems with low-resolution monotonic clocks",
