  {
    "id": "d48d9c35fd3d8e9786869bdc",
    "path": "datafusion_physical_optimizer::output_requirements::OutputRequirements",
    "name": "OutputRequirements",
    "owner": null,
    "crate": "datafusion-physical-optimizer",
    "version": "55.1.0",
    "kind": "struct",
    "signature": "struct OutputRequirements",
    "docs": "This rule either adds or removes [`OutputRequirements`]s to/from the physical\nplan according to its `mode` attribute, which is set by the constructors\n`new_add_mode` and `new_remove_mode`. With this rule, we can keep track of\nthe global requirements (ordering and distribution) across rules.\n\nThe primary use case of this node and rule is to specify and preserve the desired output\nordering and distribution the entire plan. When sending to a single client, a single partition may\nbe desirable, but when sending to a multi-partitioned writer, keeping multiple partitions may be\nbetter.",
