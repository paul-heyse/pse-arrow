    "name": "visit_statements_mut",
    "owner": null,
    "crate": "sqlparser",
    "version": "0.62.0",
    "kind": "function",
    "signature": "fn visit_statements_mut<V, E, F>(v: &mut V, f: F) -> core::ops::ControlFlow<E> where V: VisitMut, F: FnMut(&mut ast::Statement) -> core::ops::ControlFlow<E>",
    "docs": "Invokes the provided closure on all statements (e.g. `SELECT`, `CREATE TABLE`, etc) present in `v`\n\n# Example\n```\n# use sqlparser::parser::Parser;\n# use sqlparser::dialect::GenericDialect;\n# use sqlparser::ast::{Statement, visit_statements_mut};\n# use core::ops::ControlFlow;\nlet sql = \"SELECT x FROM foo LIMIT 9+$limit; SELECT * FROM t LIMIT f()\";\nlet mut statements = Parser::parse_sql(&GenericDialect{}, sql).unwrap();\n\n// Remove all select limits in outer statements (not in sub-queries)\nvisit_statements_mut(&mut statements, |stmt| {\n  if let Statement::Query(q) = stmt {\n     q.limit_clause = None;\n  }\n  ControlFlow::<()>::Continue(())\n});\n\nassert_eq!(statements[0].to_string(), \"SELECT x FROM foo\");\nassert_eq!(statements[1].to_string(), \"SELECT * FROM t\");\n```",
