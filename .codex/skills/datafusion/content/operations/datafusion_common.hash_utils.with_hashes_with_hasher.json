    "signature": "fn with_hashes_with_hasher<I, T, F, R, S>(arrays: I, hash_builder: &S, callback: F) -> error::Result<R> where I: IntoIterator<Item = T>, T: AsDynArray, F: FnOnce(&[u64]) -> error::Result<R>, S: BuildHasher",
    "docs": "Creates hashes for the given arrays using a thread-local buffer and a custom\nhash builder, then calls the provided callback with the computed hashes.\n\nHash compatibility with [`with_hashes`] follows the rules documented on\n[`create_hashes_with_hasher`].",
