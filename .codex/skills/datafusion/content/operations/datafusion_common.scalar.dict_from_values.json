    "signature": "fn dict_from_values<K: ArrowDictionaryKeyType>(values_array: arrow::array::ArrayRef) -> error::Result<arrow::array::ArrayRef>",
    "docs": "Create a `DictionaryArray` from the provided values array.\n\nEach element gets a unique key (`0..N-1`), without deduplication.\nUseful for wrapping arrays in dictionary form.\n\n# Input\n[\"alice\", \"bob\", \"alice\", null, \"carol\"]\n\n# Output\n`DictionaryArray<Int32>`\n{\n  keys:   [0, 1, 2, 3, 4],\n  values: [\"alice\", \"bob\", \"alice\", null, \"carol\"]\n}",
