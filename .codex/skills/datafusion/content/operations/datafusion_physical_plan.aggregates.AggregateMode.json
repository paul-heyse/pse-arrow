    "id": "272118d05401d355de466003",
    "path": "datafusion_physical_plan::aggregates::AggregateMode::FinalPartitioned",
    "name": "FinalPartitioned",
    "owner": "datafusion_physical_plan::aggregates::AggregateMode",
