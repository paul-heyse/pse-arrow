    "id": "1566931cc57a3e8f3f405351",
    "path": "parquet::file::properties::CdcOptions::min_chunk_size",
    "name": "min_chunk_size",
    "owner": "parquet::file::properties::CdcOptions",
    "crate": "parquet",
    "version": "59.3.0",
    "kind": "struct_field",
    "signature": "min_chunk_size: usize",
    "docs": "Minimum chunk size in bytes, default is 256 KiB.\nThe rolling hash will not be updated until this size is reached for each chunk.\nNote that all data sent through the hash function is counted towards the chunk\nsize, including definition and repetition levels if present.",
