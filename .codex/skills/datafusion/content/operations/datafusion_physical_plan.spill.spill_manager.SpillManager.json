    "path": "datafusion_physical_plan::spill::spill_manager::SpillManager::read_spill_as_stream",
    "name": "read_spill_as_stream",
    "owner": "datafusion_physical_plan::spill::spill_manager::SpillManager",
    "crate": "datafusion-physical-plan",
