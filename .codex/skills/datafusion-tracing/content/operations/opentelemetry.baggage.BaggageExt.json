    "id": "7a55d8fd9da3e62a4357b9e3",
    "path": "opentelemetry::baggage::BaggageExt::with_baggage",
    "name": "with_baggage",
    "owner": "opentelemetry::baggage::BaggageExt",
    "crate": "opentelemetry",
    "version": "0.31.0",
    "kind": "function",
    "signature": "fn with_baggage<T: Into<Baggage>>(&self, baggage: T) -> Self",
    "docs": "Returns a clone of the given context with the included name/value pairs.\n\n# Examples\n\n```\nuse opentelemetry::{baggage::{Baggage, BaggageExt}, Context, KeyValue, StringValue};\n\n// Explicit `Baggage` creation\nlet mut baggage = Baggage::new();\nlet _ = baggage.insert(\"my-name\", \"my-value\");\n\nlet cx = Context::map_current(|cx| {\n    cx.with_baggage(baggage)\n});\n\n// Passing an iterator\nlet cx = Context::map_current(|cx| {\n    cx.with_baggage([KeyValue::new(\"my-name\", \"my-value\")])\n});\n\nassert_eq!(\n    cx.baggage().get(\"my-name\"),\n    Some(&StringValue::from(\"my-value\")),\n)\n```",
