  {
    "id": "aa35adec4514e43d89129e3f",
    "path": "opentelemetry_sdk::metrics::meter_provider::MeterProviderBuilder::with_view",
    "name": "with_view",
    "owner": "opentelemetry_sdk::metrics::meter_provider::MeterProviderBuilder",
