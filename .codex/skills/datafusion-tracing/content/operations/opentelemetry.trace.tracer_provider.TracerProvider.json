  {
    "id": "08a1438e5f6544db1c3265a3",
    "path": "opentelemetry::trace::tracer_provider::TracerProvider::tracer_with_scope",
    "name": "tracer_with_scope",
    "owner": "opentelemetry::trace::tracer_provider::TracerProvider",
    "crate": "opentelemetry",
    "version": "0.31.0",
    "kind": "function",
    "signature": "fn tracer_with_scope(&self, scope: InstrumentationScope) -> Self::Tracer",
    "docs": "Returns a new versioned tracer with the given instrumentation scope.\n\n# Examples\n\n```\nuse opentelemetry::{global, InstrumentationScope, trace::TracerProvider};\n\nlet provider = global::tracer_provider();\n\n// tracer used in applications/binaries\nlet tracer = provider.tracer(\"my_app\");\n\n// tracer used in libraries/crates that optionally includes version and schema url\nlet scope =\n    InstrumentationScope::builder(env!(\"CARGO_PKG_NAME\"))\n        .with_version(env!(\"CARGO_PKG_VERSION\"))\n        .with_schema_url(\"https://opentelemetry.io/schema/1.0.0\")\n        .build();\n\nlet tracer = provider.tracer_with_scope(scope);\n```",
