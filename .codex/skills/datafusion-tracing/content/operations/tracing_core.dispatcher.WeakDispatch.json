  {
    "id": "579b0e9e6911ae19b38a2911",
    "path": "tracing_core::dispatcher::WeakDispatch::upgrade",
    "name": "upgrade",
    "owner": "tracing_core::dispatcher::WeakDispatch",
    "crate": "tracing-core",
    "version": "0.1.36",
    "kind": "function",
    "signature": "fn upgrade(&self) -> Option<Dispatch>",
    "docs": "Attempts to upgrade this `WeakDispatch` to a [`Dispatch`].\n\nReturns `None` if the referenced `Dispatch` has already been dropped.\n\n## Examples\n\n```\n# use tracing_core::subscriber::NoSubscriber;\n# use tracing_core::dispatcher::Dispatch;\nlet strong = Dispatch::new(NoSubscriber::default());\nlet weak = strong.downgrade();\n\n// The strong here keeps it alive, so we can still access the object.\nassert!(weak.upgrade().is_some());\n\ndrop(strong); // But not any more.\nassert!(weak.upgrade().is_none());\n```",
