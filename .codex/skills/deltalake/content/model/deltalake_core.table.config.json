          "name": "enable_expired_log_cleanup",
          "signature": "fn enable_expired_log_cleanup(&self) -> bool",
          "summary": "Whether to clean up expired checkpoints/commits in the delta log."
        },
        {
          "name": "get_constraints",
          "signature": "fn get_constraints(&self) -> Vec<Constraint>",
