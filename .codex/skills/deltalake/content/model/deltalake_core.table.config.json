          "name": "append_only",
          "signature": "fn append_only(&self) -> bool",
          "summary": "true for this Delta table to be append-only. If append-only, existing records cannot be deleted, and existing values cannot be updated. See [append-only tables] in the protocol."
        },
        {
          "name": "checkpoint_interval",
          "signature": "fn checkpoint_interval(&self) -> NonZero<u64>",
          "summary": "Interval (expressed as number of commits) after which a new checkpoint should be created. E.g. if checkpoint interval = 10, then a checkpoint should be written every 10 commits."
        },
        {
          "name": "deleted_file_retention_duration",
          "signature": "fn deleted_file_retention_duration(&self) -> Duration",
          "summary": "How long removed data files are retained before they may be physically deleted by vacuum."
        },
        {
          "name": "enable_change_data_feed",
