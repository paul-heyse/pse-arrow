    "id": "4a2433159bf000c4ef35bef0",
    "path": "buoyant_kernel::column_trie::ColumnTrie::contains_prefix_of",
    "name": "contains_prefix_of",
    "owner": "buoyant_kernel::column_trie::ColumnTrie",
    "crate": "buoyant_kernel",
    "version": "1.0.0+58f07cd6",
    "kind": "function",
    "signature": "fn contains_prefix_of(&self, path: &[String]) -> bool",
    "docs": "Returns true if `path` equals or is a descendant of any inserted column.\n\nFor example, if the trie contains `[\"a\", \"b\"]`:\n- `[\"a\", \"b\"]` -> true (exact match)\n- `[\"a\", \"b\", \"c\"]` -> true (descendant)\n- `[\"a\"]` -> false (ancestor, not descendant)\n- `[\"a\", \"x\"]` -> false (divergent path)",
