{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [{
          "type": "command",
          "command": "(\"$(git rev-parse --show-toplevel)/scripts/pse-host\" agent-hook tooling-advice) 2>/dev/null || true",
          "timeout": 2
        }]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/pse-host\" agent-hook guard",
            "timeout": 10
          }
        ],
        "matcher": "^(Edit|MultiEdit|NotebookEdit|Write)$"
      }
    ]
  }
}
