-                    self.define("XBLAS_INCLUDE_DIR", self.spec["netlib-xblas"].prefix.include),
-                    self.define("XBLAS_LIBRARY", self.spec["netlib-xblas"].libs.joined(";")),
-                ]
-            )
-
-        args.append(self.define("BUILD_TESTING", self.pkg.run_tests))
-
-        return args
