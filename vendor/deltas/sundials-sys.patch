+  xd = yd = NULL;
+
+  N  = MYNV_LENGTH(x);
+  xd = MYNV_DATA(x);
+  yd = MYNV_DATA(y);
+
+  if (a == ONE)
+  {
+    for (i = 0; i < N; i++) { yd[i] += xd[i]; }
+    return;
+  }
+
+  if (a == -ONE)
+  {
+    for (i = 0; i < N; i++) { yd[i] -= xd[i]; }
