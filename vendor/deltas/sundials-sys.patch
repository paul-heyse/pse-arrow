+
+  xd = yd = zd = NULL;
+
+  N  = MYNV_LENGTH(x);
+  xd = MYNV_DATA(x);
+  yd = MYNV_DATA(y);
+  zd = MYNV_DATA(z);
+
+  for (i = 0; i < N; i++) { zd[i] = xd[i] * yd[i]; }
+
+  return;
+}
