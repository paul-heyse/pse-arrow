-
-        if self.spec.satisfies("%xl") or self.spec.satisfies("%xl_r"):
-            # use F77 compiler if IBM XL
-            args.extend(
-                [
-                    self.define("CMAKE_Fortran_COMPILER", self.pkg.compiler.f77),
-                    self.define(
