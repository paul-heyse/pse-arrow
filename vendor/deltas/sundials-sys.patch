-  %fortran_struct(_generic_ ## TYPE ## _Ops);
-  %typemap(ctype) _generic_ ## TYPE * "TYPE ## _Ops";
-  %rename(TYPE ## _Ops) _generic_ ## TYPE ## _Ops;
-  %fortran_struct(_generic_ ## TYPE);
-  %typemap(ctype) _generic_ ## TYPE * "TYPE";
-  %rename(TYPE) _generic_ ## TYPE;
-%enddef
