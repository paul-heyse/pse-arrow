-
-%insert("fdecl") %{
-#if SUNDIALS_MPI_ENABLED
- include "mpif.h"
- integer(C_INT), protected, public :: SUN_COMM_NULL = MPI_COMM_NULL
-#else
- integer(C_INT), parameter, public :: SUN_COMM_NULL = 0_C_INT
-#endif
-%}
