+
+  /* set each vector in the vector array to a constant */
+  for (i = 0; i < nvec; i++)
+  {
+    zd = MYNV_DATA(Z[i]);
+    for (j = 0; j < N; j++) { zd[j] = c; }
+  }
+
+  return SUN_SUCCESS;
+}
