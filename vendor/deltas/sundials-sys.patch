+/*
+ * -----------------------------------------------------------------
+ * fused vector operations
+ * -----------------------------------------------------------------
+ */
+
+SUNErrCode N_VLinearCombination_Mine(int nvec, sunrealtype* c, N_Vector* X,
+                                     N_Vector z)
+{
+  int i;
+  sunindextype j, N;
+  sunrealtype* zd = NULL;
+  sunrealtype* xd = NULL;
+
+  /* invalid number of vectors */
+  if (nvec < 0) { return SUN_ERR_ARG_OUTOFRANGE; }
+
+  /* should have called N_VScale */
+  if (nvec == 1)
+  {
+    N_VScale_Mine(c[0], X[0], z);
+    return SUN_SUCCESS;
+  }
+
+  /* should have called N_VLinearSum */
+  if (nvec == 2)
+  {
+    N_VLinearSum_Mine(c[0], X[0], c[1], X[1], z);
+    return SUN_SUCCESS;
+  }
+
+  /* get vector length and data array */
+  N  = MYNV_LENGTH(z);
+  zd = MYNV_DATA(z);
+
+  /*
+   * X[0] += c[i]*X[i], i = 1,...,nvec-1
+   */
+  if ((X[0] == z) && (c[0] == ONE))
+  {
+    for (i = 1; i < nvec; i++)
+    {
+      xd = MYNV_DATA(X[i]);
+      for (j = 0; j < N; j++) { zd[j] += c[i] * xd[j]; }
+    }
+    return SUN_SUCCESS;
+  }
+
+  /*
+   * X[0] = c[0] * X[0] + sum{ c[i] * X[i] }, i = 1,...,nvec-1
+   */
+  if (X[0] == z)
+  {
+    for (j = 0; j < N; j++) { zd[j] *= c[0]; }
+    for (i = 1; i < nvec; i++)
+    {
+      xd = MYNV_DATA(X[i]);
+      for (j = 0; j < N; j++) { zd[j] += c[i] * xd[j]; }
+    }
+    return SUN_SUCCESS;
+  }
+
+  /*
+   * z = sum{ c[i] * X[i] }, i = 0,...,nvec-1
+   */
+  xd = MYNV_DATA(X[0]);
+  for (j = 0; j < N; j++) { zd[j] = c[0] * xd[j]; }
+  for (i = 1; i < nvec; i++)
+  {
+    xd = MYNV_DATA(X[i]);
+    for (j = 0; j < N; j++) { zd[j] += c[i] * xd[j]; }
+  }
+  return SUN_SUCCESS;
+}
+
+SUNErrCode N_VScaleAddMulti_Mine(int nvec, sunrealtype* a, N_Vector x,
+                                 N_Vector* Y, N_Vector* Z)
+{
+  int i;
+  sunindextype j, N;
+  sunrealtype* xd = NULL;
+  sunrealtype* yd = NULL;
+  sunrealtype* zd = NULL;
+
+  /* invalid number of vectors */
+  if (nvec < 0) { return SUN_ERR_ARG_OUTOFRANGE; }
+
+  /* should have called N_VLinearSum */
+  if (nvec == 1)
+  {
+    N_VLinearSum_Mine(a[0], x, ONE, Y[0], Z[0]);
+    return SUN_SUCCESS;
+  }
+
+  /* get vector length and data array */
+  N  = MYNV_LENGTH(x);
+  xd = MYNV_DATA(x);
+
+  /*
+   * Y[i][j] += a[i] * x[j]
+   */
+  if (Y == Z)
+  {
+    for (i = 0; i < nvec; i++)
+    {
+      yd = MYNV_DATA(Y[i]);
+      for (j = 0; j < N; j++) { yd[j] += a[i] * xd[j]; }
+    }
+    return SUN_SUCCESS;
+  }
+
+  /*
+   * Z[i][j] = Y[i][j] + a[i] * x[j]
+   */
+  for (i = 0; i < nvec; i++)
+  {
+    yd = MYNV_DATA(Y[i]);
+    zd = MYNV_DATA(Z[i]);
+    for (j = 0; j < N; j++) { zd[j] = a[i] * xd[j] + yd[j]; }
+  }
+  return SUN_SUCCESS;
+}
+
+SUNErrCode N_VDotProdMulti_Mine(int nvec, N_Vector x, N_Vector* Y,
+                                sunrealtype* dotprods)
+{
+  int i;
+  sunindextype j, N;
+  sunrealtype* xd = NULL;
+  sunrealtype* yd = NULL;
+
+  /* invalid number of vectors */
+  if (nvec < 0) { return SUN_ERR_ARG_OUTOFRANGE; }
+
+  /* should have called N_VDotProd */
+  if (nvec == 1)
+  {
+    dotprods[0] = N_VDotProd_Mine(x, Y[0]);
+    return SUN_SUCCESS;
+  }
+
+  /* get vector length and data array */
+  N  = MYNV_LENGTH(x);
+  xd = MYNV_DATA(x);
+
+  /* compute multiple dot products */
+  for (i = 0; i < nvec; i++)
+  {
+    yd          = MYNV_DATA(Y[i]);
+    dotprods[i] = ZERO;
+    for (j = 0; j < N; j++) { dotprods[i] += xd[j] * yd[j]; }
+  }
+
+  return SUN_SUCCESS;
+}
+
+/*
+ * -----------------------------------------------------------------
+ * vector array operations
+ * -----------------------------------------------------------------
+ */
+
+SUNErrCode N_VLinearSumVectorArray_Mine(int nvec, sunrealtype a, N_Vector* X,
+                                        sunrealtype b, N_Vector* Y, N_Vector* Z)
+{
+  int i;
+  sunindextype j, N;
+  sunrealtype* xd = NULL;
+  sunrealtype* yd = NULL;
+  sunrealtype* zd = NULL;
+  sunrealtype c;
+  N_Vector* V1;
+  N_Vector* V2;
+  sunbooleantype test;
+
+  /* invalid number of vectors */
+  if (nvec < 0) { return SUN_ERR_ARG_OUTOFRANGE; }
+
+  /* should have called N_VLinearSum */
+  if (nvec == 1)
+  {
+    N_VLinearSum_Mine(a, X[0], b, Y[0], Z[0]);
+    return SUN_SUCCESS;
+  }
+
+  /* BLAS usage: axpy y <- ax+y */
+  if ((b == ONE) && (Z == Y))
+  {
+    VaxpyVectorArray_Mine(nvec, a, X, Y);
+    return SUN_SUCCESS;
+  }
+
+  /* BLAS usage: axpy x <- by+x */
+  if ((a == ONE) && (Z == X))
+  {
+    VaxpyVectorArray_Mine(nvec, b, Y, X);
+    return SUN_SUCCESS;
+  }
+
+  /* Case: a == b == 1.0 */
+  if ((a == ONE) && (b == ONE))
+  {
+    VSumVectorArray_Mine(nvec, X, Y, Z);
+    return SUN_SUCCESS;
+  }
+
+  /* Cases:                    */
+  /*   (1) a == 1.0, b = -1.0, */
+  /*   (2) a == -1.0, b == 1.0 */
+  if ((test = ((a == ONE) && (b == -ONE))) || ((a == -ONE) && (b == ONE)))
+  {
+    V1 = test ? Y : X;
+    V2 = test ? X : Y;
+    VDiffVectorArray_Mine(nvec, V2, V1, Z);
+    return SUN_SUCCESS;
+  }
+
+  /* Cases:                                                  */
+  /*   (1) a == 1.0, b == other or 0.0,                      */
+  /*   (2) a == other or 0.0, b == 1.0                       */
+  /* if a or b is 0.0, then user should have called N_VScale */
+  if ((test = (a == ONE)) || (b == ONE))
+  {
+    c  = test ? b : a;
+    V1 = test ? Y : X;
+    V2 = test ? X : Y;
+    VLin1VectorArray_Mine(nvec, c, V1, V2, Z);
+    return SUN_SUCCESS;
+  }
+
+  /* Cases:                     */
+  /*   (1) a == -1.0, b != 1.0, */
+  /*   (2) a != 1.0, b == -1.0  */
+  if ((test = (a == -ONE)) || (b == -ONE))
+  {
+    c  = test ? b : a;
+    V1 = test ? Y : X;
+    V2 = test ? X : Y;
+    VLin2VectorArray_Mine(nvec, c, V1, V2, Z);
+    return SUN_SUCCESS;
+  }
+
+  /* Case: a == b                                                         */
+  /* catches case both a and b are 0.0 - user should have called N_VConst */
+  if (a == b)
+  {
+    VScaleSumVectorArray_Mine(nvec, a, X, Y, Z);
+    return SUN_SUCCESS;
+  }
+
+  /* Case: a == -b */
+  if (a == -b)
+  {
+    VScaleDiffVectorArray_Mine(nvec, a, X, Y, Z);
+    return SUN_SUCCESS;
+  }
+
+  /* Do all cases not handled above:                               */
+  /*   (1) a == other, b == 0.0 - user should have called N_VScale */
+  /*   (2) a == 0.0, b == other - user should have called N_VScale */
+  /*   (3) a,b == other, a !=b, a != -b                            */
+
+  /* get vector length */
+  N = MYNV_LENGTH(Z[0]);
+
+  /* compute linear sum for each vector pair in vector arrays */
+  for (i = 0; i < nvec; i++)
+  {
+    xd = MYNV_DATA(X[i]);
+    yd = MYNV_DATA(Y[i]);
+    zd = MYNV_DATA(Z[i]);
+    for (j = 0; j < N; j++) { zd[j] = a * xd[j] + b * yd[j]; }
+  }
+
+  return SUN_SUCCESS;
+}
+
+SUNErrCode N_VScaleVectorArray_Mine(int nvec, sunrealtype* c, N_Vector* X,
+                                    N_Vector* Z)
+{
+  int i;
+  sunindextype j, N;
+  sunrealtype* xd = NULL;
+  sunrealtype* zd = NULL;
+
+  /* invalid number of vectors */
+  if (nvec < 0) { return SUN_ERR_ARG_OUTOFRANGE; }
+
+  /* should have called N_VScale */
+  if (nvec == 1)
+  {
+    N_VScale_Mine(c[0], X[0], Z[0]);
+    return SUN_SUCCESS;
+  }
+
+  /* get vector length */
+  N = MYNV_LENGTH(Z[0]);
+
+  /*
+   * X[i] *= c[i]
+   */
+  if (X == Z)
+  {
+    for (i = 0; i < nvec; i++)
+    {
+      xd = MYNV_DATA(X[i]);
+      for (j = 0; j < N; j++) { xd[j] *= c[i]; }
+    }
+    return SUN_SUCCESS;
+  }
+
+  /*
+   * Z[i] = c[i] * X[i]
+   */
+  for (i = 0; i < nvec; i++)
+  {
+    xd = MYNV_DATA(X[i]);
+    zd = MYNV_DATA(Z[i]);
+    for (j = 0; j < N; j++) { zd[j] = c[i] * xd[j]; }
+  }
+  return SUN_SUCCESS;
+}
