--- /dev/null
+++ b/vendor/src/sunadaptcontroller/mrihtol/sunadaptcontroller_mrihtol.c
@@ -0,0 +1,383 @@
+/* -----------------------------------------------------------------
+ * Programmer(s): Daniel R. Reynolds @ UMBC
+ * -----------------------------------------------------------------
+ * SUNDIALS Copyright Start
