+  {
+    IDAProcessError(IDA_mem, IDA_FIRST_QSRHS_ERR, __LINE__, __func__,
+                    __FILE__, MSG_QSRHSFUNC_FIRST);
+    return (IDA_FIRST_QSRHS_ERR);
