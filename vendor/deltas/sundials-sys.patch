-/* b'*c = 1/2 */
-static sunbooleantype arkode_butcher_order2(sunrealtype* b, sunrealtype* c, int s)
-{
-  sunrealtype bc;
-  if (arkode_butcher_dot(b, c, s, &bc)) { return (SUNFALSE); }
-  return (SUNRabs(bc - SUN_RCONST(0.5)) > TOL) ? SUNFALSE : SUNTRUE;
-}
