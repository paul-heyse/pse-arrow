+  sunrealtype *xd, *zd;
+
+  xd = zd = NULL;
+
+  N  = MYNV_LENGTH(x);
+  xd = MYNV_DATA(x);
+  zd = MYNV_DATA(z);
+
+  for (i = 0; i < N; i++) { zd[i] = xd[i] + b; }
+
