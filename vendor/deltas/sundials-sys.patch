+  SUNFunctionBegin(sunctx);
+
+  SUNAdjointCheckpointScheme self = NULL;
+  self                            = malloc(sizeof(*self));
+  SUNAssert(self, SUN_ERR_MALLOC_FAIL);
+
+  self->sunctx  = sunctx;
+  self->content = NULL;
+  self->ops     = NULL;
