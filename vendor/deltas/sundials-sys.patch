+SUNErrCode SUNDomEigEstimator_Destroy(SUNDomEigEstimator* DEEptr)
+{
+  SUNErrCode ier = SUN_SUCCESS;
+  if (DEEptr == NULL) { return ier; }
+  if (*DEEptr == NULL) { return ier; }
