+  ops->needssaving  = NULL;
+  ops->insertvector = NULL;
+  ops->loadvector   = NULL;
+  ops->enableDense  = NULL;
+  ops->destroy      = NULL;
+
+  self->ops         = ops;
+  *check_scheme_ptr = self;
+
+  return SUN_SUCCESS;
