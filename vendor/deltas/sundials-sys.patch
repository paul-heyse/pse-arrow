diff --git a/vendor/include/sundials/priv/sundials_logger_macros.h b/vendor/include/sundials/priv/sundials_logger_macros.h
new file mode 100644
index 0000000000000000000000000000000000000000..a6a3141f0770f892f1f990ffe95a568cbe7832c8
--- /dev/null
+++ b/vendor/include/sundials/priv/sundials_logger_macros.h
@@ -0,0 +1,136 @@
+/* -----------------------------------------------------------------
+ * Programmer(s): Cody J. Balos @ LLNL
+ * -----------------------------------------------------------------
+ * SUNDIALS Copyright Start
+ * Copyright (c) 2025-2026, Lawrence Livermore National Security,
+ * University of Maryland Baltimore County, and the SUNDIALS contributors.
+ * Copyright (c) 2013-2025, Lawrence Livermore National Security
