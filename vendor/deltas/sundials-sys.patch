+}
+
+void N_VScale_Mine(sunrealtype c, N_Vector x, N_Vector z)
+{
+  sunindextype i, N;
+  sunrealtype *xd, *zd;
+
+  xd = zd = NULL;
+
+  if (z == x)
+  { /* BLAS usage: scale x <- cx */
+    VScaleBy_Mine(c, x);
+    return;
+  }
+
+  if (c == ONE) { VCopy_Mine(x, z); }
+  else if (c == -ONE) { VNeg_Mine(x, z); }
+  else
+  {
+    N  = MYNV_LENGTH(x);
+    xd = MYNV_DATA(x);
+    zd = MYNV_DATA(z);
+    for (i = 0; i < N; i++) { zd[i] = c * xd[i]; }
+  }
+
+  return;
+}
+
+void N_VAbs_Mine(N_Vector x, N_Vector z)
+{
+  sunindextype i, N;
+  sunrealtype *xd, *zd;
+
+  xd = zd = NULL;
+
+  N  = MYNV_LENGTH(x);
+  xd = MYNV_DATA(x);
+  zd = MYNV_DATA(z);
+
+  for (i = 0; i < N; i++) { zd[i] = SUNRabs(xd[i]); }
+
+  return;
+}
+
+void N_VInv_Mine(N_Vector x, N_Vector z)
+{
+  sunindextype i, N;
+  sunrealtype *xd, *zd;
+
+  xd = zd = NULL;
+
+  N  = MYNV_LENGTH(x);
+  xd = MYNV_DATA(x);
+  zd = MYNV_DATA(z);
+
+  for (i = 0; i < N; i++) { zd[i] = ONE / xd[i]; }
+
+  return;
+}
