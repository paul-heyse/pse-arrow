+        ("Value", 14) => (Message("RecordId"), false),
+        ("Value", 15) => (String, false),
+        ("Value", 16) => (Message("File"), false),
+        ("Value", 17) => (Message("Range"), false),
+        ("Value", 18) => (String, false),
+        ("Value", 19) => (Message("Object"), false),
+        ("Value", 20) => (Message("Array"), false),
+        ("Value", 21) => (Message("Set"), false),
+        ("ValueBatch", 1) => (Message("Value"), true),
+        ("ValueBound", 1) => (Message("Value"), false),
+        ("ValueBound", 2) => (Message("Value"), false),
+        ("ValueBound", 3) => (Message("NullValue"), false),
+        ("Variables", 1) => (Message("KeyValue"), true),
+        _ => return None,
+    })
+}
+pub(super) fn response(path: &str) -> Option<&'static str> {
+    Some(match path.rsplit('/').next()? {
+        "GetCapabilities" => "GetCapabilitiesResponse",
+        "Health" => "HealthResponse",
+        "AttachSession" => "AttachSessionResponse",
+        "DetachSession" => "DetachSessionResponse",
+        "ResetSession" => "ResetSessionResponse",
+        "Use" => "UseResponse",
+        "SetVariable" => "SetVariableResponse",
+        "UnsetVariable" => "UnsetVariableResponse",
+        "Signup" => "SignupResponse",
+        "Signin" => "SigninResponse",
+        "Authenticate" => "AuthenticateResponse",
+        "RefreshTokens" => "RefreshTokensResponse",
+        "RevokeTokens" => "RevokeTokensResponse",
+        "Invalidate" => "InvalidateResponse",
+        "BeginTransaction" => "BeginTransactionResponse",
+        "CommitTransaction" => "CommitTransactionResponse",
+        "CancelTransaction" => "CancelTransactionResponse",
+        "Query" => "QueryResponse",
+        "Run" => "RunResponse",
+        "Kill" => "KillResponse",
+        "Subscribe" => "SubscribeResponse",
+        "ImportSurql" => "ImportSurqlResponse",
+        "ExportSurql" => "ExportSurqlResponse",
+        "ExportDirectory" => "ExportDirectoryResponse",
+        "ExportMlModel" => "ExportMlModelResponse",
+        "ImportMlModel" => "ImportMlModelResponse",
+        _ => return None,
+    })
+}
