diff --git a/src/engine/remote/grpc_lifecycle_tests.rs b/src/engine/remote/grpc_lifecycle_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..74a9351a3c9f04ac9eddeb2bb0e1b7d50665245a
--- /dev/null
+++ b/src/engine/remote/grpc_lifecycle_tests.rs
@@ -0,0 +1,316 @@
+//! Focused SDK context/lifetime controls. Real server and module parentage is
+//! deliberately established by the integration journey, not these controls.
+use super::*;
+use opentelemetry::trace::TracerProvider;
+use opentelemetry_sdk::trace::{SdkTracerProvider, SpanData, SpanExporter};
+use tracing_subscriber::prelude::*;
+
+#[derive(Clone, Debug, Default)]
+struct Recorded(Arc<Mutex<Vec<SpanData>>>);
+impl SpanExporter for Recorded {
+    async fn export(&self, batch: Vec<SpanData>) -> opentelemetry_sdk::error::OTelSdkResult {
+        self.0.lock().unwrap().extend(batch);
+        Ok(())
+    }
+}
+fn subscriber() -> (SdkTracerProvider, tracing::Dispatch, Recorded) {
+    let recorded = Recorded::default();
+    let provider = SdkTracerProvider::builder().with_simple_exporter(recorded.clone()).build();
+    let subscriber = tracing_subscriber::registry()
+        .with(tracing_opentelemetry::layer().with_tracer(provider.tracer("sdk-control")));
+    (provider, tracing::Dispatch::new(subscriber), recorded)
+}
+fn parent(trace: &str, span: &str, sampled: &str) -> opentelemetry::Context {
+    let fields = std::collections::HashMap::from([
+        ("traceparent".into(), format!("00-{trace}-{span}-{sampled}")),
+        ("tracestate".into(), "vendor=independent".into()),
+    ]);
+    TraceContextPropagator::new().extract_with_context(&opentelemetry::Context::new(), &fields)
+}
+fn attribute(span: &SpanData, key: &str) -> Option<String> {
+    span.attributes.iter().find(|value| value.key.as_str() == key).map(|value| value.value.to_string())
+}
+
+#[cfg_attr(test, tokio::test)]
+pub async fn spawned_siblings_keep_independent_parent_and_wire_carrier() {
+    let (provider, dispatch, recorded) = subscriber();
+    let barrier = Arc::new(tokio::sync::Barrier::new(2));
+    let mut tasks = Vec::new();
+    for (id, ancestor) in [
+        ("11111111111111111111111111111111", "aaaaaaaaaaaaaaaa"),
+        ("22222222222222222222222222222222", "bbbbbbbbbbbbbbbb"),
+    ] {
+        let barrier = barrier.clone();
+        let dispatch = dispatch.clone();
+        tasks.push(tokio::spawn(async move {
+            let parent = parent(id, ancestor, "01");
+            async move {
+                let bounded = RequestTrace::new("bounded");
+                tokio::spawn(bounded.future(async move {
+                    barrier.wait().await;
+                    tokio::task::yield_now().await;
+                    let rpc = RequestTrace::new("grpc");
+                    let expected = rpc.context.span().span_context().clone();
+                    let mut headers = http::HeaderMap::new();
+                    rpc.inject(&mut headers);
+                    assert_eq!(headers["traceparent"], format!("00-{id}-{}-01", expected.span_id()));
+                    assert_eq!(headers["tracestate"], "vendor=independent");
+                    assert!(!headers.contains_key("baggage"));
+                    (id, ancestor, expected.span_id())
+                })).await.unwrap()
+            }.with_context(parent).with_subscriber(dispatch).await
+        }));
+    }
+    for task in tasks {
+        let (id, ancestor, rpc_id) = task.await.unwrap();
+        provider.force_flush().unwrap();
+        let spans = recorded.0.lock().unwrap();
+        let bounded = spans.iter().find(|span| span.span_context.trace_id().to_string() == id && attribute(span, "operation").as_deref() == Some("bounded")).unwrap();
+        let rpc = spans.iter().find(|span| span.span_context.span_id() == rpc_id).unwrap();
+        assert_eq!(bounded.parent_span_id.to_string(), ancestor);
+        assert!(bounded.parent_span_is_remote);
+        assert_eq!(rpc.parent_span_id, bounded.span_context.span_id());
+        assert!(!rpc.parent_span_is_remote);
+    }
+    provider.shutdown().unwrap();
+}
+
+#[cfg_attr(test, tokio::test)]
+pub async fn authentic_tracing_parent_precedes_unrelated_ambient_api_context() {
+    let (provider, dispatch, recorded) = subscriber();
+    let span = tracing::dispatcher::with_default(&dispatch, || {
+        let span = tracing::info_span!(parent: None, "caller");
+        span.set_parent(parent("33333333333333333333333333333333", "cccccccccccccccc", "01")).unwrap();
+        span
+    });
+    let caller = span.context().span().span_context().clone();
+    let expected_caller = caller.clone();
+    async move {
+        tokio::spawn(RequestTrace::new("bounded").future(async move {
+            let rpc = RequestTrace::new("grpc");
+            assert_eq!(rpc.context.span().span_context().trace_id(), expected_caller.trace_id());
+        })).await.unwrap();
+    }.instrument(span).with_context(parent("44444444444444444444444444444444", "dddddddddddddddd", "01")).with_subscriber(dispatch).await;
+    provider.force_flush().unwrap();
+    let spans = recorded.0.lock().unwrap();
+    let bounded = spans.iter().find(|span| attribute(span, "operation").as_deref() == Some("bounded")).unwrap();
+    assert_eq!(bounded.parent_span_id, caller.span_id());
+    drop(spans);
+    provider.shutdown().unwrap();
+}
+
+#[cfg_attr(test, tokio::test)]
+pub async fn missing_context_removes_stale_carrier_without_inventing_parent() {
+    async {
+        let trace = RequestTrace::new("grpc");
+        let mut headers = http::HeaderMap::new();
+        headers.insert("traceparent", "stale".parse().unwrap());
+        headers.insert("tracestate", "vendor=stale".parse().unwrap());
+        trace.inject(&mut headers);
+        assert!(!headers.contains_key("traceparent"));
+        assert!(!headers.contains_key("tracestate"));
+    }.with_context(opentelemetry::Context::new())
+        .with_subscriber(tracing::Dispatch::new(tracing::subscriber::NoSubscriber::default())).await;
+}
+
+#[cfg_attr(test, tokio::test)]
+pub async fn api_only_unsampled_context_preserves_flags_and_state() {
+    async {
+        let trace = RequestTrace::new("grpc");
+        let mut headers = http::HeaderMap::new();
+        trace.inject(&mut headers);
+        assert_eq!(headers["traceparent"], "00-77777777777777777777777777777777-1212121212121212-00");
+        assert_eq!(headers["tracestate"], "vendor=independent");
+    }.with_context(parent("77777777777777777777777777777777", "1212121212121212", "00"))
+        .with_subscriber(tracing::Dispatch::new(tracing::subscriber::NoSubscriber::default())).await;
+}
+
+struct ProbeBody {
+    frames: tokio::sync::mpsc::UnboundedReceiver<Result<Frame<Bytes>, std::io::Error>>,
+    observed: Arc<Mutex<Vec<opentelemetry::trace::SpanContext>>>,
+}
+impl Body for ProbeBody {
+    type Data = Bytes;
+    type Error = std::io::Error;
+    fn poll_frame(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<Result<Frame<Bytes>, Self::Error>>> {
+        self.observed.lock().unwrap().push(opentelemetry::Context::current().span().span_context().clone());
+        self.frames.poll_recv(cx)
+    }
+}
+impl Drop for ProbeBody {
+    fn drop(&mut self) {
+        self.observed.lock().unwrap().push(opentelemetry::Context::current().span().span_context().clone());
+    }
+}
+
+#[cfg_attr(test, tokio::test)]
+pub async fn response_body_retains_span_and_installs_its_context_on_poll_error_and_drop() {
+    for terminal in ["complete", "error", "dropped"] {
+        let (provider, dispatch, recorded) = subscriber();
+        let observed = Arc::new(Mutex::new(Vec::new()));
+        let (send, receive) = tokio::sync::mpsc::unbounded_channel();
+        let (mut body, expected) = async {
+            let trace = RequestTrace::new("grpc");
+            let expected = trace.context.span().span_context().clone();
+            (ObservedBody::new(ProbeBody { frames: receive, observed: observed.clone() }, trace), expected)
+        }.with_context(parent("55555555555555555555555555555555", "eeeeeeeeeeeeeeee", "01")).with_subscriber(dispatch).await;
+        // Headers have returned, but the actual body still owns the RPC span.
+        provider.force_flush().unwrap();
+        assert!(recorded.0.lock().unwrap().is_empty());
+        let mut cx = Context::from_waker(futures::task::noop_waker_ref());
+        assert!(Pin::new(&mut body).poll_frame(&mut cx).is_pending());
+        send.send(Ok(Frame::data(Bytes::from_static(b"protobuf")))).unwrap();
+        assert!(matches!(Pin::new(&mut body).poll_frame(&mut cx), Poll::Ready(Some(Ok(_)))));
+        match terminal {
+            "complete" => { send.send(Ok(Frame::trailers(http::HeaderMap::new()))).unwrap(); }
+            "error" => { send.send(Err(std::io::Error::other("stream failure"))).unwrap(); }
+            _ => {}
+        }
+        if terminal != "dropped" { let _ = Pin::new(&mut body).poll_frame(&mut cx); }
+        drop(body);
+        provider.force_flush().unwrap();
+        let spans = recorded.0.lock().unwrap();
+        assert_eq!(spans.len(), 1);
+        assert_eq!(attribute(&spans[0], "response").as_deref(), Some(terminal));
+        assert!(observed.lock().unwrap().iter().all(|context| context.span_id() == expected.span_id() && context.trace_id() == expected.trace_id()));
+        assert!(!opentelemetry::Context::current().span().span_context().is_valid());
+        drop(spans);
+        provider.shutdown().unwrap();
+    }
+}
+
+#[cfg_attr(test, tokio::test)]
+pub async fn query_owner_outlives_transport_until_decode_finishes() {
+    let (provider, dispatch, recorded) = subscriber();
+    let (started, ready) = tokio::sync::oneshot::channel();
+    let (finish, decoded) = tokio::sync::oneshot::channel();
+    let task = tokio::spawn(observe("query", async move {
+        let transport = RequestTrace::new("grpc");
+        drop(transport);
+        started.send(()).unwrap();
+        decoded.await.unwrap();
+    }).with_context(parent("66666666666666666666666666666666", "ffffffffffffffff", "01")).with_subscriber(dispatch));
+    ready.await.unwrap();
+    provider.force_flush().unwrap();
+    assert_eq!(recorded.0.lock().unwrap().len(), 1);
+    assert_eq!(attribute(&recorded.0.lock().unwrap()[0], "operation").as_deref(), Some("grpc"));
+    finish.send(()).unwrap();
+    task.await.unwrap();
+    provider.force_flush().unwrap();
+    let spans = recorded.0.lock().unwrap();
+    let query = spans.iter().find(|span| attribute(span, "operation").as_deref() == Some("query")).unwrap();
+    let transport = spans.iter().find(|span| attribute(span, "operation").as_deref() == Some("grpc")).unwrap();
+    assert_eq!(transport.parent_span_id, query.span_context.span_id());
+    drop(spans);
+    provider.shutdown().unwrap();
+}
+
+async fn real_http2_route(owned: bool, terminal: &'static str) {
+    let (provider, dispatch, recorded) = subscriber();
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let (requests, mut received) = tokio::sync::mpsc::unbounded_channel();
+    let server = tokio::spawn(async move {
+        let (socket, _) = listener.accept().await.unwrap();
+        let service = hyper::service::service_fn(move |request: http::Request<hyper::body::Incoming>| {
+            let (send, frames) = tokio::sync::mpsc::unbounded_channel();
+            requests.send((request.headers().clone(), send)).unwrap();
+            async move {
+                Ok::<_, std::convert::Infallible>(http::Response::builder()
+                    .header("content-type", "application/grpc")
+                    .body(ProbeBody { frames, observed: Arc::default() }).unwrap())
+            }
+        });
+        let _ = hyper::server::conn::http2::Builder::new(TokioExecutor::new())
+            .serve_connection(TokioIo::new(socket), service).await;
+    });
+    let (transport, driver) = if owned {
+        let url = url::Url::parse(&format!("grpc://{address}")).unwrap();
+        let (transport, driver) = Transport::connect(&url, 1024).await.unwrap();
+        (transport, Some(driver))
+    } else {
+        let channel = tonic::transport::Endpoint::from_shared(format!("http://{address}")).unwrap().connect().await.unwrap();
+        (Transport::Upstream(channel), None)
+    };
+    let mut responses = Vec::new();
+    for (id, ancestor) in [
+        ("88888888888888888888888888888888", "1313131313131313"),
+        ("99999999999999999999999999999999", "1414141414141414"),
+    ] {
+        let mut transport = transport.clone();
+        let dispatch = dispatch.clone();
+        responses.push(tokio::spawn(async move {
+            let request_context = RequestContext::new(std::time::Instant::now() + std::time::Duration::from_secs(10));
+            let response = REQUEST.scope(request_context.clone(), async {
+                futures::future::poll_fn(|cx| transport.poll_ready(cx)).await.unwrap();
+                let request = http::Request::builder()
+                    .uri(format!("http://{address}/surrealdb.rpc.v1.SurrealDBService/Query"))
+                    .header("content-type", "application/grpc")
+                    .body(tonic::body::Body::empty()).unwrap();
+                transport.call(request).await.unwrap()
+            }).with_context(parent(id, ancestor, "01")).with_subscriber(dispatch).await;
+            (id, ancestor, response.into_body(), request_context)
+        }));
+    }
+    let mut on_wire = std::collections::HashMap::new();
+    for _ in 0..2 {
+        let (headers, frames) = tokio::time::timeout(std::time::Duration::from_secs(5), received.recv()).await.unwrap().unwrap();
+        let carrier = headers["traceparent"].to_str().unwrap();
+        let id = carrier[3..35].to_owned();
+        let span = carrier[36..52].to_owned();
+        assert_eq!(headers["tracestate"], "vendor=independent");
+        assert_eq!(&carrier[53..], "01");
+        assert!(on_wire.insert(id, (span, frames)).is_none());
+    }
+    for response in responses {
+        let (id, ancestor, mut body, context) = tokio::time::timeout(std::time::Duration::from_secs(5), response).await.unwrap().unwrap();
+        let (span_id, frames) = on_wire.remove(id).unwrap();
+        provider.force_flush().unwrap();
+        assert!(!recorded.0.lock().unwrap().iter().any(|span| span.span_context.span_id().to_string() == span_id));
+        // The owned route validates this complete empty protobuf message before
+        // tonic can decode. The peer deliberately retains trailers for later.
+        frames.send(Ok(Frame::data(Bytes::from_static(b"\0\0\0\0\0")))).unwrap();
+        let first = futures::future::poll_fn(|cx| Pin::new(&mut body).poll_frame(cx)).await;
+        assert!(matches!(first, Some(Ok(_))));
+        if owned { assert_eq!(context.dispatch_state(), surrealdb_engine_api::DispatchState::Dispatched); }
+        match terminal {
+            "complete" => {
+                let mut trailers = http::HeaderMap::new();
+                trailers.insert("grpc-status", "0".parse().unwrap());
+                frames.send(Ok(Frame::trailers(trailers))).unwrap();
+                while let Some(frame) = futures::future::poll_fn(|cx| Pin::new(&mut body).poll_frame(cx)).await { frame.unwrap(); }
+            }
+            "error" => {
+                frames.send(Err(std::io::Error::other("peer stream failure"))).unwrap();
+                assert!(futures::future::poll_fn(|cx| Pin::new(&mut body).poll_frame(cx)).await.unwrap().is_err());
+            }
+            "dropped" => { context.cancel(); }
+            _ => unreachable!(),
+        }
+        drop(body);
+        // Neither headers nor telemetry completion/cancellation can settle the
+        // native response: only BoundedEngine's completed decode owner can do so.
+        if owned { assert_eq!(context.dispatch_state(), surrealdb_engine_api::DispatchState::Dispatched); }
+        provider.force_flush().unwrap();
+        let spans = recorded.0.lock().unwrap();
+        let rpc = spans.iter().find(|span| span.span_context.span_id().to_string() == span_id).unwrap();
+        assert_eq!(rpc.span_context.trace_id().to_string(), id);
+        assert_eq!(rpc.parent_span_id.to_string(), ancestor);
+        assert_eq!(attribute(rpc, "response").as_deref(), Some(terminal));
+    }
+    if let Some(driver) = driver { driver.shutdown().await; assert!(driver.drained.load(Ordering::Acquire)); }
+    drop(transport);
+    server.abort();
+    let _ = server.await;
+    provider.shutdown().unwrap();
+}
+
+#[cfg_attr(test, tokio::test)]
+pub async fn actual_owned_http2_headers_stream_error_cancel_and_siblings() {
+    for terminal in ["complete", "error", "dropped"] { real_http2_route(true, terminal).await; }
+}
+
+#[cfg_attr(test, tokio::test)]
+pub async fn actual_upstream_http2_headers_stream_error_cancel_and_siblings() {
+    for terminal in ["complete", "error", "dropped"] { real_http2_route(false, terminal).await; }
+}
diff --git a/src/engine/remote/grpc_wire.rs b/src/engine/remote/grpc_wire.rs
new file mode 100644
index 0000000000000000000000000000000000000000..682479684bee891bdf1573eb0391534a8682e641
--- /dev/null
+++ b/src/engine/remote/grpc_wire.rs
@@ -0,0 +1,139 @@
+//! Borrowed protobuf preflight. No prost Value or owned string is allocated
+//! until the original endpoint's cumulative occurrence envelope admits it.
+use surrealdb_engine_api::ResponseLimits;
+
+#[derive(Clone, Copy)]
+pub(super) enum Kind { Varint, Fixed64, String, Blob, FixedUuid, Message(&'static str) }
+#[derive(Default)]
+pub(super) struct Counts { wire: usize, nodes: usize, items: usize, strings: usize, blobs: usize }
+impl Counts {
+    pub(super) fn check(&mut self, bytes: &[u8], schema: Option<&str>, limits: ResponseLimits) -> Result<(), &'static str> {
+        self.wire = self.wire.checked_add(bytes.len()).ok_or("response wire count overflow")?;
+        if self.wire > limits.wire_bytes { return Err("aggregate gRPC response exceeds wire envelope"); }
+        self.message(bytes, schema.ok_or("unrecognized gRPC response recipient")?, 0, limits)
+    }
+    fn own_nodes(&mut self, count: usize, limits: ResponseLimits) -> Result<(), &'static str> {
+        self.nodes = self.nodes.checked_add(count).ok_or("response node count overflow")?;
+        if self.nodes > limits.nodes { return Err("gRPC response exceeds node envelope"); }
+        Ok(())
+    }
+    fn message(&mut self, mut bytes: &[u8], schema: &str, depth: usize, limits: ResponseLimits) -> Result<(), &'static str> {
+        if depth > limits.depth { return Err("gRPC response exceeds depth envelope"); }
+        // Charge the owned message once. Its ordinary field tags and scalar
+        // fields are inline storage, not another owned Value/key allocation.
+        // Repeated non-message fields additionally allocate vector slots.
+        self.own_nodes(1, limits)?;
+        let mut items = 0usize;
+        while !bytes.is_empty() {
+            let key = varint(&mut bytes)?;
+            let tag = u32::try_from(key >> 3).map_err(|_| "invalid protobuf tag")?;
+            if tag == 0 { return Err("zero protobuf tag"); }
+            let shape = super::grpc_wire_schema::field(schema, tag);
+            if let Some((kind, true)) = shape {
+                if !matches!(kind, Kind::Message(_)) { self.own_nodes(1, limits)?; }
+                items = items.checked_add(1).ok_or("response item count overflow")?;
+                self.items = self.items.checked_add(1).ok_or("response item count overflow")?;
+                if items > limits.container_items || self.items > limits.nodes { return Err("gRPC response exceeds container envelope"); }
+            }
+            match key & 7 {
+                0 => { varint(&mut bytes)?; },
+                1 => { take(&mut bytes, 8)?; },
+                5 => { take(&mut bytes, 4)?; },
+                2 => {
+                    let len = usize::try_from(varint(&mut bytes)?).map_err(|_| "protobuf length overflow")?;
+                    let value = take(&mut bytes, len)?;
+                    if let Some((kind, true)) = shape {
+                        let count = match kind {
+                            Kind::Fixed64 if len % 8 == 0 => len / 8,
+                            Kind::Varint => {
+                                let mut packed = value;
+                                let mut count = 0usize;
+                                while !packed.is_empty() { varint(&mut packed)?; count = count.checked_add(1).ok_or("packed protobuf item overflow")?; }
+                                count
+                            },
+                            Kind::Fixed64 => return Err("malformed packed protobuf scalar"),
+                            _ => 0,
+                        };
+                        if matches!(kind, Kind::Fixed64 | Kind::Varint) { self.own_nodes(count.saturating_sub(1), limits)?; }
+                        items = items.checked_add(count.saturating_sub(1)).ok_or("response item count overflow")?;
+                        self.items = self.items.checked_add(count.saturating_sub(1)).ok_or("response item count overflow")?;
+                        if items > limits.container_items || self.items > limits.nodes { return Err("gRPC response exceeds packed container envelope"); }
+                    }
+                    match shape.map(|(kind, _)| kind) {
+                        Some(Kind::Message(nested)) => self.message(value, nested, depth + 1, limits)?,
+                        Some(Kind::String) => {
+                            self.strings = self.strings.checked_add(len).ok_or("response string count overflow")?;
+                            if len > limits.string_length || self.strings > limits.string_bytes { return Err("gRPC response exceeds string envelope"); }
+                            std::str::from_utf8(value).map_err(|_| "invalid protobuf UTF8")?;
+                        },
+                        Some(Kind::FixedUuid) => {
+                            // Native protocol identities are fixed envelopes,
+                            // not application blob payloads. Nodes and encoded
+                            // bytes still charge every occurrence.
+                            if len != 16 { return Err("invalid native UUID length"); }
+                        },
+                        Some(Kind::Blob) => {
+                            self.blobs = self.blobs.checked_add(len).ok_or("response blob count overflow")?;
+                            if len > limits.blob_length || self.blobs > limits.blob_bytes { return Err("gRPC response exceeds blob envelope"); }
+                        },
+                        // Unknown fields are bounded by encoded length; prost skips
+                        // them without building a nested owned representation.
+                        _ => {},
+                    }
+                },
+                _ => return Err("unsupported protobuf wire type"),
+            }
+        }
+        Ok(())
+    }
+}
+fn take<'a>(bytes: &mut &'a [u8], len: usize) -> Result<&'a [u8], &'static str> {
+    let (value, rest) = bytes.split_at_checked(len).ok_or("truncated protobuf field")?;
+    *bytes = rest;
+    Ok(value)
+}
+fn varint(bytes: &mut &[u8]) -> Result<u64, &'static str> {
+    let mut value = 0u64;
+    for shift in (0..70).step_by(7) {
+        let byte = *take(bytes, 1)?.first().ok_or("truncated protobuf varint")?;
+        if shift == 63 && byte > 1 { return Err("protobuf varint overflow"); }
+        value |= u64::from(byte & 127) << shift;
+        if byte & 128 == 0 { return Ok(value); }
+    }
+    Err("protobuf varint overflow")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn limits() -> ResponseLimits { ResponseLimits { wire_bytes: 1024, nodes: 32, depth: 8, container_items: 4, string_bytes: 8, string_length: 8, blob_bytes: 8, blob_length: 8 } }
+    #[test]
+    fn cumulative_frames_and_occurrences_are_bounded_before_decode() {
+        let string = [0x3a, 4, b'a', b'b', b'c', b'd'];
+        let mut counts = Counts::default();
+        assert!(counts.check(&string, Some("Value"), limits()).is_ok());
+        assert!(counts.check(&string, Some("Value"), limits()).is_ok());
+        assert!(counts.check(&string, Some("Value"), limits()).is_err());
+    }
+    #[test]
+    fn empty_repeated_strings_and_packed_scalars_still_charge_owned_slots() {
+        let mut envelope = limits();
+        envelope.nodes = 2;
+        // A scalar bool is one Value allocation; inline tag/value bytes do
+        // not manufacture a second allocation.
+        assert!(Counts::default().check(&[0x18, 1], Some("Value"), envelope).is_ok());
+        // Empty strings consume no byte allowance but each vector slot owns
+        // String storage; two slots plus the message exceed two nodes.
+        assert!(Counts::default().check(&[0x22, 0, 0x22, 0], Some("ServerCapabilities"), envelope).is_err());
+        // Packed enum values likewise own individual inline vector slots.
+        assert!(Counts::default().check(&[0x22, 2, 1, 1], Some("QueryRequest"), envelope).is_err());
+    }
+    #[test]
+    fn malformed_and_excessively_nested_values_are_refused() {
+        assert!(Counts::default().check(&[0x3a, 10], Some("Value"), limits()).is_err());
+        assert!(Counts::default().check(&[0x3a, 1, 255], Some("Value"), limits()).is_err());
+        let mut value = vec![0x20, 1];
+        for _ in 0..10 { let mut array = vec![10, value.len() as u8]; array.extend(value); value = vec![0xa2, 1, array.len() as u8]; value.extend(array); }
+        assert!(Counts::default().check(&value, Some("Value"), limits()).is_err());
+    }
+}
