+    fn to_map(
+        vec: Vec<std::result::Result<Value, TypesError>>,
+    ) -> IndexMap<usize, (DbResultStats, std::result::Result<Value, TypesError>)> {
+        vec.into_iter()
+            .map(|result| match result {
+                Ok(result) => {
+                    let stats = DbResultStats::default();
+                    (stats, Ok(result))
+                }
+                Err(error) => {
+                    let stats = DbResultStats::default();
+                    (stats, Err(error))
+                }
+            })
+            .enumerate()
+            .collect()
+    }
