+    #[derive(Debug)]
+    struct BuilderBudget {
+        bytes: Vec<u8>,
+        reserved: Arc<std::sync::atomic::AtomicUsize>,
+    }
+    impl Drop for BuilderBudget {
+        fn drop(&mut self) {
+            self.reserved
+                .fetch_sub(self.bytes.len(), std::sync::atomic::Ordering::AcqRel);
+        }
+    }
