diff --git a/build.rs b/build.rs
index 3bc5d90d6d3975e6aa0db0d338b9507dcf4c3fb3..d64b4f58889d2bd98536198a9a59f89f85e3a231 100644
--- a/build.rs
+++ b/build.rs
@@ -1,4 +1,25 @@
 fn main() {
+    use sha2::{Digest, Sha256};
+    use std::{env, fs, path::PathBuf};
+    println!("cargo:rerun-if-env-changed=COOLPROP_DIR");
+    let prefix = PathBuf::from(env::var_os("COOLPROP_DIR").expect("explicit CoolProp native preparation is required"));
+    assert!(prefix.is_absolute(), "CoolProp prepared prefix must be absolute");
+    let image = prefix.join("lib/libCoolProp.so");
+    let receipt = prefix.join(".complete.json");
+    println!("cargo:rerun-if-changed={}", receipt.display());
+    println!("cargo:rerun-if-changed={}", image.display());
+    let bytes = fs::read(&receipt).expect("completed CoolProp preparation receipt");
+    let document: serde_json::Value = serde_json::from_slice(&bytes).expect("valid preparation receipt");
+    assert_eq!(document["version"], 1);
+    assert_eq!(document["identity"]["kind"], "coolprop");
+    let digest: String = Sha256::digest(fs::read(&image).expect("prepared CoolProp image"))
+        .iter()
+        .map(|byte| format!("{byte:02x}"))
+        .collect();
+    assert_eq!(document["files"]["lib/libCoolProp.so"], digest);
+    fs::write(PathBuf::from(env::var_os("OUT_DIR").unwrap()).join("coolprop-receipt.json"), bytes).unwrap();
+    println!("cargo:rustc-env=PSE_COOLPROP_IMAGE={}", image.display());
+    println!("cargo:rustc-env=PSE_COOLPROP_IMAGE_SHA256={digest}");
     #[cfg(feature = "regen-bindings")]
     {
         use std::{env, path::PathBuf};
diff --git a/pse-patch.md b/pse-patch.md
new file mode 100644
index 0000000000000000000000000000000000000000..bef4c86b60772697cb0783fb6e1faab796db61b0
--- /dev/null
+++ b/pse-patch.md
@@ -0,0 +1,17 @@
+# CoolProp sys native-provider integration
+
+This maintained copy retains `coolprop-sys` 8.0.0's upstream process-wide access lock,
+native handle API and licenses. Its original published archive is SHA256
+`7d388a1023cf8236d1a9f372db5f3ade4dc752b7588eef68848bba2050b2eb08`.
+The source VCS revision is `30801b93f8a27dfa7f93537151bc5d39630d3f24`.
+
+The local manifest removes bundled platform-image dependencies. The build consumes
+`COOLPROP_DIR` from explicit immutable native preparation, checks its original receipt/image
+and records that image for the existing global loader. It neither downloads nor builds native
+code. The matched C declaration adds the library-owned second saturation derivative export;
+`xtask codegen --only bindgen` regenerates the function table. The backend additionally checks
+the declared native source/patch recipe and this maintained supplier's complete delta.
+
+The native C export patch is separate from this Rust supplier delta. It lives inside the
+original CoolProp wrapper's handle manager and exception boundary; no second state owner,
+EOS, interpolation or production finite-difference derivative is introduced (ADR-0238).
