+        }
+        impl Drop for Range {
+            fn drop(&mut self) {
+                // SAFETY: restore the current thread's original MPFR range.
+                unsafe {
+                    assert_eq!(mpfr::set_emin(self.min), 0);
+                    assert_eq!(mpfr::set_emax(self.max), 0);
