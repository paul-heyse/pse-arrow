+    ///
+    /// The caller establishes square-freeness. Unlike the general API this
+    /// overload never invokes Yun factorization, a preferred polynomial GCD,
+    /// complex isolation or the global root cache. Exact endpoint roots are
+    /// normalized to singleton intervals; every other interval owns one root
+    /// strictly in its open interior. No partial list is returned on refusal.
+    pub fn isolate_real_root_intervals_square_free_bounded<E>(
+        &self,
+        mut control: impl FnMut(RealRootIsolationStep) -> Result<(), E>,
+    ) -> Result<Vec<(Rational, Rational)>, BoundedRootIsolationError<E>> {
+        let mut peak_bytes = 0;
+        let mut report = |mut step: RealRootIsolationStep| {
+            peak_bytes = peak_bytes.max(step.bytes);
+            step.bytes = peak_bytes;
+            control(step)
+        };
+        if self.degree() == 0 || self.degree() > 3 {
+            return Err(BoundedRootIsolationError::Extent);
+        }
+        let height = self.coefficients.iter().flat_map(|c| {
+            [c.numerator_ref().significant_bits(), c.denominator_ref().significant_bits()]
+        }).max().unwrap_or(1);
+        // At most four rational coefficients: common denominator/product
+        // content, divisions and conversion to primitive integer coefficients
+        // use <=32h+64 bits including unreduced rational intermediates.
+        let bits = height.checked_mul(32).and_then(|n| n.checked_add(64))
+            .ok_or(BoundedRootIsolationError::Extent)?;
+        report(real_root_step(bits, 256)?).map_err(BoundedRootIsolationError::Control)?;
+        let content = self.content();
+        let stripped = self.map_coeff(|coefficient| {
+            self.ring.div(coefficient, &content).numerator()
+        }, Z);
+        let mut intervals = Vec::with_capacity(2*self.degree());
+        for negative in [true, false] {
+            report(real_root_step(bits, 32)?).map_err(BoundedRootIsolationError::Control)?;
+            let mut polynomial = stripped.clone();
+            if negative {
+                for coefficient in polynomial.coefficients.iter_mut().skip(1).step_by(2) {
+                    *coefficient = -coefficient.clone();
+                }
+            }
+            for (mut a, mut b) in polynomial.isolate_real_roots_square_free_controlled(Some(&mut report))? {
+                if negative {
+                    std::mem::swap(&mut a, &mut b);
+                    a = -a;
+                    b = -b;
+                }
+                intervals.push((a,b));
+            }
+        }
+        // VAS can return an exact root as an endpoint of a nondegenerate
+        // interval. Preserve it separately, then use signs immediately inside
+        // the ends to decide whether an open-interior root also belongs here.
+        // Degree<=3 and square-freeness make these simple endpoint roots.
+        let mut result = Vec::with_capacity(2*self.degree());
+        for (a,b) in &intervals {
+            let endpoints = intervals.iter().flat_map(|(a,b)| {
+                [a.numerator_ref(),a.denominator_ref(),b.numerator_ref(),b.denominator_ref()]
+            }).map(Integer::significant_bits).max().unwrap_or(1);
+            let bits = height.checked_add(endpoints).and_then(|n| n.checked_add(2))
+                .and_then(|n| n.checked_mul(8)).ok_or(BoundedRootIsolationError::Extent)?;
+            report(real_root_step(bits, 128)?).map_err(BoundedRootIsolationError::Control)?;
