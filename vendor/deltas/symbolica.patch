+    // Keep the borrowed instruction alive while testing the shared counter.
+    let raw = Instr::Add(4, vec![0, 1]);
+    let instruction = NativeInstruction::from_instr(&raw, ComplexPhase::Any, &[], &[]).unwrap();
+    assert_eq!(
+        instruction.count_into(&mut count),
