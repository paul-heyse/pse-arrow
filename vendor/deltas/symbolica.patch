+        ));
+        evaluator.instructions = vec![(Instr::Pow(1, 0, i64::MAX), ComplexPhase::Any)];
+        assert!(matches!(
+            evaluator.try_export_cpp_with(
+                "checked",
+                settings(),
+                CppProfile::ScalarF64,
+                &[],
+                &mut |_| Ok::<_, &'static str>(())
