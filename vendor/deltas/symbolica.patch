+    pub fn square_free_part_bounded<E>(
+        &self,
+        mut control: impl FnMut(RealRootIsolationStep) -> Result<(), E>,
+    ) -> Result<Self, BoundedRootIsolationError<E>> {
+        let mut peak_bytes = 0;
+        let mut report = |mut step: RealRootIsolationStep| {
+            peak_bytes = peak_bytes.max(step.bytes);
+            step.bytes = peak_bytes;
+            control(step)
+        };
+        if self.degree()==0 || self.degree()>3 {
+            return Err(BoundedRootIsolationError::Extent);
+        }
+        let mut admit = |left: &Self, right: &Self| {
+            let height = left.coefficients.iter().chain(&right.coefficients).flat_map(|c| {
+                [c.numerator_ref().significant_bits(),c.denominator_ref().significant_bits()]
+            }).max().unwrap_or(1);
+            // One rational quotient has <=2h-bit limbs; multiplying its
+            // divisor uses <=3h, and subtracting from a remainder coefficient
+            // uses <=4h+1 before canonical reduction. Degree<=3 keeps all
+            // vectors at four entries, covered by the common slot envelope.
+            let bits = height.checked_add(4).and_then(|n| n.checked_mul(8))
