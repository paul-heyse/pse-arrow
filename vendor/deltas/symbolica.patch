+        NativeInstruction::from_instr(&raw, ComplexPhase::Any, &[], &[])
+            .unwrap()
+            .count_into(&mut count),
+        Err(F64TransferError::Overflow("operation count"))
+    );
+    count = OperationCount::new(0, 0, 0, usize::MAX);
+    let raw = Instr::Powf(4, 0, 1);
