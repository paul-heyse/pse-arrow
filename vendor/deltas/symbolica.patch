+        for external in &self.external_fns {
+            external_bytes = add(external_bytes, external.export_name.capacity())?;
+            external_bytes = add(external_bytes, mul(add(external.fixed_args.capacity(), external.stack.capacity())?, size_of::<Complex<Rational>>())?)?;
+            if let Some(implementation) = &external.imp {
+                external_bytes = add(external_bytes, size_of_val(implementation.as_ref()))?;
+            }
+            coefficients = external.stack.iter().try_fold(coefficients, |bytes, value| add(bytes, payload(value)?))?;
