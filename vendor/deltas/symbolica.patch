+fn fixture() -> ExpressionEvaluator<f64> {
+    ExpressionEvaluator {
+        stack: vec![
+            12.,
+            13.,
+            -0.,
+            f64::from_bits(0x7ff8_0000_0000_1234),
+            14.,
+            15.,
+            16.,
+            17.,
+        ],
+        param_count: 2,
+        reserved_indices: 4,
+        instructions: vec![
+            (Instr::Add(4, vec![0, 2]), ComplexPhase::Any),
+            (Instr::Mul(5, vec![4, 1]), ComplexPhase::PartialReal(1)),
+            (Instr::Pow(6, 5, -1), ComplexPhase::Real),
+        ],
