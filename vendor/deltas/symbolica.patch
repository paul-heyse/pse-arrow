+/// Incremental admission immediately before exact real-root isolation work.
+#[derive(Clone, Copy, Debug)]
+pub struct RealRootIsolationStep {
+    /// Conservative scalar exact-arithmetic operation count for the next stage.
+    pub operations: usize,
+    /// Conservative peak live integer/rational/vector mathematical storage.
+    pub bytes: usize,
+}
+
+/// A bounded isolation request refused without publishing partial roots.
+#[derive(Debug)]
+pub enum BoundedRootIsolationError<E> {
+    /// The caller's cancellation, deadline, work or storage refusal.
+    Control(E),
+    /// An unsupported degree or an unrepresentable predicted extent.
+    Extent,
+}
+
+/// Extents are mathematical storage, including old/new vector overlap and
+/// temporaries, rather than allocator bookkeeping or process RSS. For cubic VAS
+/// a stage retains <=3 pending intervals, <=6 root intervals (before endpoint
+/// normalization), and <=3 temporary degree-three polynomials. 512 integer slots
+/// dominate their limbs, matrices, rational numerators/denominators, arithmetic
+/// temporaries and old/new vector capacities. Each slot includes its Rust owner
+/// and twice the rounded limb payload for growth/copy overlap.
+fn real_root_step<E>(bits: u64, operations: usize) -> Result<RealRootIsolationStep, BoundedRootIsolationError<E>> {
+    let limb_bytes = bits.checked_add(63).and_then(|n| n.checked_div(64))
+        .and_then(|n| n.checked_mul(8)).and_then(|n| usize::try_from(n).ok())
+        .ok_or(BoundedRootIsolationError::Extent)?;
+    let bytes = limb_bytes.checked_mul(2)
+        .and_then(|n| n.checked_add(std::mem::size_of::<Integer>()))
+        .and_then(|n| n.checked_mul(512)).and_then(|n| n.checked_add(8192))
+        .ok_or(BoundedRootIsolationError::Extent)?;
+    Ok(RealRootIsolationStep { operations, bytes })
+}
