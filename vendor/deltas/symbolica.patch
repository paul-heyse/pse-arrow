+                Instr::Pow(..) => return Err(OperationError::Unsupported("integer power other than inversion")),
+                Instr::Powf(..) => (power, 1, 7),
+                Instr::BuiltinFun(_, symbol, _) if [Symbol::EXP_ID, Symbol::LOG_ID,
