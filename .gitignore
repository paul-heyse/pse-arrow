# Library capability skills are links to the shared library-skills store.
# Only the repository-process skills are tracked by rule; any new skill is ignored by default.
# .config/library-skills.toml selects them; just skills-sync recreates local links.
# The alias paths are symlinks on Linux, but `just agent-config-sync` copies the tree on
# Windows, so the same rule covers them.
/.codex/skills/*
!/.codex/skills/adr/
!/.codex/skills/design-review/
!/.codex/skills/design-review-process-simulator/
!/.codex/skills/README.md
!/.codex/skills/plan-design-review/
!/.codex/skills/plan-creation/
!/.codex/skills/create-plan/
!/.codex/skills/plan-execution/
!/.codex/skills/execute-plan/
/.claude/skills/*
!/.claude/skills/adr/
!/.claude/skills/design-review/
!/.claude/skills/design-review-process-simulator/
!/.claude/skills/README.md
!/.claude/skills/plan-design-review/
!/.claude/skills/plan-creation/
!/.claude/skills/create-plan/
!/.claude/skills/plan-execution/
!/.claude/skills/execute-plan/
/.agents/skills/*
!/.agents/skills/adr/
!/.agents/skills/design-review/
!/.agents/skills/design-review-process-simulator/
!/.agents/skills/README.md
!/.agents/skills/plan-design-review/
!/.agents/skills/plan-creation/
!/.agents/skills/create-plan/
!/.agents/skills/plan-execution/
!/.agents/skills/execute-plan/

# Local overrides (templates are committed)
.envrc.local
.claude/settings.local.json

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store

# Logs, except the committed evidence receipts
*.log
!docs/capability-maps/evidence/**/*.log
# lu-resolve (rust-analyzer resolver behind the library catalog) builds in its own target
/tools/*/target/

# rustc internal-compiler-error dumps (written to the cwd on a compiler crash)
rustc-ice-*.txt
