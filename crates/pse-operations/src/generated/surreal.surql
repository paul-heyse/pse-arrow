DEFINE EVENT pse_attempt_terminal_publication_immutable ON canonical_attempts WHEN $event='UPDATE' AND $before.phase IN ['terminal','terminal_compacted'] AND ($before.seed_manifest!=$after.seed_manifest) THEN { THROW 'PSE_REFUSAL:execution_terminal_seed_manifest_immutable'; };

DEFINE FUNCTION fn::pse_execution_v1::deadline($rpc_expiry: int) -> bool {
    IF time::micros() >= $rpc_expiry { THROW 'PSE_REFUSAL:original_canonical_rpc_deadline_expired'; };
    RETURN true;
};

// A page is a complete prefix of block/descriptor pairs. The CBOR allowance
// reserves three quarters of the wire bound for native tagged values/envelopes;
// the SDK also enforces its endpoint-shaped predecode limits before allocation.
DEFINE FUNCTION fn::pse_execution_v1::result_block_page($rpc_expiry:int,$set:string,$output:string,$partition:string,$start:decimal,$end:decimal,$after:option<decimal>,$count:decimal) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $candidates = IF $after=NONE {
        SELECT * FROM canonical_result_blocks WHERE result_set=$set AND output=$output AND partition=$partition AND ordinal<$count AND end>$start AND start<$end ORDER BY ordinal LIMIT 65
    } ELSE {
        SELECT * FROM canonical_result_blocks WHERE result_set=$set AND output=$output AND partition=$partition AND ordinal>$after AND ordinal<$count AND end>$start AND start<$end ORDER BY ordinal LIMIT 65
    };
    LET $page = $candidates.fold({blocks:[],batches:[],extent:512,stopped:false}, |$acc,$block| {
        IF $acc.stopped { RETURN $acc; };
        IF array::len($acc.blocks)=64 { RETURN {blocks:$acc.blocks,batches:$acc.batches,extent:$acc.extent,stopped:true}; };
        LET $batch = SELECT * FROM ONLY type::record('canonical_result_batches',$block.batch);
        IF $batch=NONE { THROW 'PSE_REFUSAL:results_page_member_unavailable'; };
        LET $extent = $acc.extent + bytes::len(encoding::cbor::encode({block:$block,batch:$batch}));
        IF $extent>4194304/4 {
            IF array::len($acc.blocks)=0 { THROW 'PSE_REFUSAL:results_page_member_extent_exceeded'; };
            RETURN {blocks:$acc.blocks,batches:$acc.batches,extent:$acc.extent,stopped:true};
        };
        RETURN {blocks:array::append($acc.blocks,$block),batches:array::append($acc.batches,$batch),extent:$extent,stopped:false};
    });
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {blocks:$page.blocks,batches:$page.batches,next:IF array::len($page.blocks)=0 { NULL } ELSE { array::last($page.blocks).ordinal },exhausted:!$page.stopped};
};

// Dense owner indexes keep their original source-coordinate cursor. All three
// member kinds are returned together, with shared blocks/descriptors deduplicated.
DEFINE FUNCTION fn::pse_execution_v1::result_output_page($rpc_expiry:int,$set:string,$output:string,$partition:string,$start:decimal,$end:decimal,$after:option<decimal>,$minimum:option<float>,$maximum:option<float>) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $candidates = IF $after!=NONE AND $after>=$start AND $after<$end {
        SELECT * FROM canonical_result_block_outputs WHERE result_set=$set AND output=$output AND partition=$partition AND start>$after AND end>$start AND start<$end AND ($minimum=NONE OR coordinate_max.projection>=$minimum) AND ($maximum=NONE OR coordinate_min.projection<=$maximum) ORDER BY start LIMIT 65
    } ELSE {
        SELECT * FROM canonical_result_block_outputs WHERE result_set=$set AND output=$output AND partition=$partition AND end>$start AND start<$end AND ($after=NONE OR start>$after) AND ($minimum=NONE OR coordinate_max.projection>=$minimum) AND ($maximum=NONE OR coordinate_min.projection<=$maximum) ORDER BY start LIMIT 65
    };
    LET $page = $candidates.fold({indexes:[],blocks:[],batches:[],extent:512,stopped:false}, |$acc,$item| {
        IF $acc.stopped { RETURN $acc; };
        IF array::len($acc.indexes)=64 { RETURN {indexes:$acc.indexes,blocks:$acc.blocks,batches:$acc.batches,extent:$acc.extent,stopped:true}; };
        LET $block = SELECT * FROM ONLY type::record('canonical_result_blocks',$item.batch);
        LET $batch = SELECT * FROM ONLY type::record('canonical_result_batches',$item.batch);
        IF $block=NONE OR $batch=NONE { THROW 'PSE_REFUSAL:results_page_member_unavailable'; };
        LET $known = $item.batch IN $acc.blocks.key;
        LET $extent = $acc.extent + bytes::len(encoding::cbor::encode($item)) + IF $known { 0 } ELSE { bytes::len(encoding::cbor::encode({block:$block,batch:$batch})) };
        IF $extent>4194304/4 {
            IF array::len($acc.indexes)=0 { THROW 'PSE_REFUSAL:results_page_member_extent_exceeded'; };
            RETURN {indexes:$acc.indexes,blocks:$acc.blocks,batches:$acc.batches,extent:$acc.extent,stopped:true};
        };
        RETURN {indexes:array::append($acc.indexes,$item),blocks:IF $known { $acc.blocks } ELSE { array::append($acc.blocks,$block) },batches:IF $known { $acc.batches } ELSE { array::append($acc.batches,$batch) },extent:$extent,stopped:false};
    });
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {indexes:$page.indexes,blocks:$page.blocks,batches:$page.batches,next:IF array::len($page.indexes)=0 { NULL } ELSE { array::last($page.indexes).start },exhausted:!$page.stopped};
};

DEFINE FUNCTION fn::pse_execution_v1::lease($rpc_expiry: int, $expires_at: int) -> bool {
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $expires_at <= time::micros() { THROW 'PSE_REFUSAL:execution_attempt_lease_expired_before_commit'; };
    RETURN true;
};

DEFINE FUNCTION fn::pse_execution_v1::touch($rpc_expiry: int, $key: string) -> decimal {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $id = type::record('canonical_guards', $key);
    LET $old = SELECT * FROM ONLY $id;
    IF $old = NONE {
        CREATE ONLY $id SET key = $key, generation = 1dec, incarnation = <string>rand::uuid::v4();
        LET $rpc_result = 1dec;
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    } ELSE {
        UPDATE ONLY $id SET generation += 1dec;
        LET $rpc_result = $old.generation + 1dec;
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    };
};

// Register exact keys, including absence. Registration does not write or block.
DEFINE FUNCTION fn::pse_execution_v1::register($rpc_expiry:int,$key:string) -> bool {
    SELECT * FROM ONLY type::record('canonical_guards',$key) FOR UPDATE;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN true;
};

DEFINE FUNCTION fn::pse_execution_v1::source_creator($rpc_expiry:int,$problem:string,$root:string) -> bool {
    fn::pse_execution_v1::register($rpc_expiry,'retention:'+$problem);
    SELECT * FROM ONLY type::record('canonical_roots',$root) FOR UPDATE;
    fn::pse_execution_v1::touch($rpc_expiry,'source-creators:'+$problem);
    RETURN true;
};

DEFINE FUNCTION fn::pse_execution_v1::result_creator($rpc_expiry:int,$run:string) -> bool {
    fn::pse_history_v1::run($rpc_expiry,$run);
    SELECT * FROM ONLY type::record('canonical_result_retirements',$run) FOR UPDATE;
    IF (SELECT * FROM ONLY type::record('canonical_result_retirements',$run))!=NONE { THROW 'PSE_REFUSAL:execution_results_explicitly_retired'; };
    fn::pse_execution_v1::touch($rpc_expiry,'result-creators:'+$run);
    RETURN true;
};

// The key itself carries the original acquisition window, including before
// a delayed acquisition has created its record. Release never invents a window.
DEFINE FUNCTION fn::pse_execution_v1::protection_grant($rpc_expiry:int,$problem:string,$key:string,$acquiring:bool) -> object {
    LET $parts=string::split($key,':');
    IF array::len($parts)!=4 OR $parts[0]!='pse.protection.v2' OR string::len($parts[2])!=36 { THROW 'PSE_REFUSAL:protection_immutable_grant_binding'; };
    LET $authority=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$problem) FOR UPDATE;
    LET $deadline=<int>$parts[3];
    IF $authority=NONE OR $authority.incarnation!=$parts[1] OR $deadline<=0 { THROW 'PSE_REFUSAL:protection_authority_incarnation_differs'; };
    IF $acquiring AND ($deadline<=time::micros() OR $deadline<=($authority.protection_closed_through ?? 0dec)) { THROW 'PSE_REFUSAL:protection_acquisition_window_closed'; };
    SELECT * FROM ONLY type::record('canonical_protections',$key) FOR UPDATE;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {grant_deadline:$deadline,grant_nonce:$parts[2],authority_incarnation:$parts[1],closed:$deadline<=($authority.protection_closed_through ?? 0dec)};
};

DEFINE FUNCTION fn::pse_execution_v1::operation($rpc_expiry: int, $key: string, $kind: string, $request: bytes) -> option<object> {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-operation:' + $key);
    LET $old = fn::pse_history_v1::operation($rpc_expiry,$key,NONE);
    IF $old != NONE AND ($old.kind != $kind OR $old.request != $request) { THROW 'PSE_REFUSAL:execution_operation_identity_reused'; };
    LET $rpc_result = $old;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::available($rpc_expiry: int, $run: string) -> bool {
    fn::pse_history_v1::run($rpc_expiry,$run);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry, 'run-cancel:' + $run);
    IF (SELECT * FROM ONLY type::record('canonical_result_retirements',$run) FOR UPDATE) != NONE { THROW 'PSE_REFUSAL:execution_results_explicitly_retired'; };
    LET $rpc_result = true;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::study_cancelled($rpc_expiry: int, $run: string) -> bool {
    fn::pse_history_v1::run($rpc_expiry,$run);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry,'study-association:'+$run);
    LET $points = SELECT study FROM canonical_history_locators WHERE run=$run AND point!=NONE LIMIT 1;
    IF array::len($points) = 0 { LET $rpc_result = false; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $points[0].study);
    LET $study = SELECT * FROM ONLY type::record('canonical_studies', $points[0].study);
    IF $study = NONE { THROW 'PSE_REFUSAL:execution_study_cancellation_authority_absent'; };
    LET $rpc_result = $study.cancelled;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::summary_cancelled($rpc_expiry: int, $run: string) -> bool {
    fn::pse_history_v1::run($rpc_expiry,$run);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry,'study-association:'+$run);
    LET $parents = SELECT study AS key FROM canonical_history_locators WHERE run=$run AND point=NONE LIMIT 1;
    IF array::len($parents) = 0 { LET $rpc_result = false; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $parents[0].key);
    LET $study = SELECT * FROM ONLY type::record('canonical_studies',$parents[0].key);
    IF $study = NONE { THROW 'PSE_REFUSAL:execution_summary_cancellation_authority_absent'; };
    LET $rpc_result = $study.cancelled;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::writer($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $operation: string, $kind: string) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::available($rpc_expiry, $run);
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:' + $run);
    LET $r = SELECT * FROM ONLY type::record('canonical_runs', $run);
    LET $a = SELECT * FROM ONLY type::record('canonical_attempts', $attempt);
    IF $r = NONE OR $a = NONE OR $a.run != $run OR $r.current_attempt != $attempt OR $r.current_generation != $generation OR $a.generation != $generation OR $r.cancelled OR $r.terminal_attempt != NONE OR ($a.phase IN ['terminal','terminal_compacted']) OR $a.expires_at <= time::micros() { THROW 'PSE_REFUSAL:execution_attempt_fence_revoked'; };
    LET $summary_cancelled=fn::pse_execution_v1::summary_cancelled($rpc_expiry,$run);
    LET $finalizing=IF $a.finalization_study!=NONE {
        LET $summary=SELECT * FROM ONLY type::record('canonical_studies',$a.finalization_study) FOR UPDATE;
        IF $summary=NONE OR $summary.run!=$run OR !$summary.active OR $summary.next_ordinal!=$summary.point_count OR $summary.terminal { THROW 'PSE_REFUSAL:study_summary_finalization_association_changed'; };
        IF $kind NOT IN ['append','empty','close','renew'] { THROW 'PSE_REFUSAL:study_summary_capability_only_permits_publication'; };
        true
    } ELSE { false };
    IF fn::pse_execution_v1::study_cancelled($rpc_expiry, $run) OR ($summary_cancelled AND !$finalizing) {
        fn::pse_execution_v1::deadline($rpc_expiry);
        fn::pse_execution_v1::lease($rpc_expiry, $a.expires_at);
        RETURN {pse_writer:'study-cancelled',run:$run,attempt:$attempt,generation:$generation,operation:$operation};
    };
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry, $a.expires_at);
    RETURN {pse_writer:'admitted',attempt:$a};
};

DEFINE FUNCTION fn::pse_execution_v1::fence($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal) -> object {
    LET $writer = fn::pse_execution_v1::writer($rpc_expiry, $run, $attempt, $generation, 'dispatch', 'dispatch');
    IF $writer.pse_writer != 'admitted' { THROW 'PSE_REFUSAL:execution_study_cancellation_fence_revoked'; };
    RETURN $writer.attempt;
};

DEFINE FUNCTION fn::pse_execution_v1::begin_run($rpc_expiry: int, $row: object, $sources: array<object>, $admission: option<object>) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $row.interpretation!='pse.substrate.v8' OR (SELECT * FROM ONLY canonical_interpretations:current).interpretation!='pse.substrate.v8' { THROW 'PSE_REFUSAL:stale_execution_publication_interpretation'; };
    fn::pse_execution_v1::available($rpc_expiry, $row.key);
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:' + $row.key);
    LET $old = SELECT * FROM ONLY type::record('canonical_runs', $row.key);
    IF $old != NONE {
        IF $old.request != $row.request OR $old.problem != $row.problem OR $old.revision != $row.revision OR $old.source_sequence != $row.source_sequence OR $old.source_selection != $row.source_selection OR $old.attestation != $row.attestation OR $old.interpretation != $row.interpretation { THROW 'PSE_REFUSAL:execution_run_identity_reused'; };
        LET $rpc_result = $old;
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    };
    LET $admission_owner=IF $admission=NONE {NONE} ELSE {fn::pse_study_v1::admission_authority($rpc_expiry,$admission)};
    IF $admission!=NONE AND $row.key!=(SELECT run FROM ONLY type::record('canonical_study_points',$admission.point)).run { THROW 'PSE_REFUSAL:selected_scientific_run_identity_differs_from_its_occurrence'; };
    fn::pse_execution_v1::source_creator($rpc_expiry,$row.problem,'run:'+$row.key);
    LET $revision = SELECT * FROM ONLY type::record('canonical_revisions', $row.revision);
    IF $revision = NONE OR $revision.problem != $row.problem OR $revision.sequence != $row.source_sequence OR $revision.interpretation != $row.interpretation { THROW 'PSE_REFUSAL:execution_revision_unavailable'; };
    LET $pruned = SELECT key FROM canonical_reclaimed_ranges WHERE problem = $row.problem AND from_sequence <= $revision.sequence AND to_sequence > $revision.sequence LIMIT 1;
    IF array::len($pruned) != 0 { THROW 'PSE_REFUSAL:execution_revision_source_reclaimed'; };
    IF array::len($sources)>64 { THROW 'PSE_REFUSAL:execution_sources_limit_exceeded'; };
    FOR $source IN $sources {
        fn::pse_execution_v1::source_creator($rpc_expiry,$source.problem,$source.key);
        LET $selected = SELECT * FROM ONLY type::record('canonical_revisions',$source.revision);
        IF $selected=NONE OR $selected.problem!=$source.problem OR $selected.sequence!=$source.sequence OR $selected.interpretation!=$source.interpretation { THROW 'PSE_REFUSAL:execution_selected_source_unavailable'; };
        LET $reclaimed=SELECT key FROM canonical_reclaimed_ranges WHERE problem=$source.problem AND from_sequence<=$source.sequence AND to_sequence>$source.sequence LIMIT 1;
        IF array::len($reclaimed)!=0 { THROW 'PSE_REFUSAL:execution_selected_source_reclaimed'; };
    };
    LET $sequence = fn::pse_execution_v1::touch($rpc_expiry, 'execution-sequence:' + $row.problem);
    LET $saved = CREATE ONLY type::record('canonical_runs', $row.key) CONTENT object::extend($row, {sequence:$sequence});
    CREATE ONLY type::record('canonical_roots', 'run:' + $row.key) SET key = 'run:' + $row.key, problem = $row.problem, revision = $revision.key, sequence = $revision.sequence, owner_kind = 'run', owner = $row.key;
    INSERT RELATION INTO canonical_problem_runs {id:type::record('canonical_problem_runs',$row.key),in:type::record('canonical_problems',$row.problem),out:type::record('canonical_runs',$row.key),key:$row.key,problem:$row.problem,run:$row.key} RETURN NONE;
    INSERT RELATION INTO canonical_run_sources {id:type::record('canonical_run_sources',$row.key),in:type::record('canonical_runs',$row.key),out:type::record('canonical_revisions',$row.revision),key:$row.key,run:$row.key,revision:$row.revision} RETURN NONE;
    FOR $source IN $sources {
        CREATE ONLY type::record('canonical_roots',$source.key) SET key=$source.key,problem=$source.problem,revision=$source.revision,sequence=$source.sequence,owner_kind='run',owner=$row.key;
        INSERT RELATION INTO canonical_run_sources {id:type::record('canonical_run_sources',$source.key),in:type::record('canonical_runs',$row.key),out:type::record('canonical_revisions',$source.revision),key:$source.key,run:$row.key,revision:$source.revision} RETURN NONE;
    };
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $admission_owner!=NONE { fn::pse_execution_v1::lease($rpc_expiry,$admission_owner.expires_at); };
    RETURN $rpc_result;
};

// Installed writer meaning is server authority, independent of a stale client's argument.
// This fence is separate from worker freshness: current immutable replays still work
// after cancellation, closure or a later attempt.
DEFINE FUNCTION fn::pse_execution_v1::current_writer($rpc_expiry:int,$run:string) -> bool {
    fn::pse_history_v1::run($rpc_expiry,$run);
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $marker=SELECT * FROM ONLY canonical_interpretations:current;
    LET $row=SELECT * FROM ONLY type::record('canonical_runs',$run);
    IF $marker=NONE OR $marker.interpretation!='pse.substrate.v8' OR $row=NONE OR $row.interpretation!='pse.substrate.v8' { THROW 'PSE_REFUSAL:historical_execution_is_read_only'; };
    RETURN true;
};

DEFINE FUNCTION fn::pse_execution_v1::claim($rpc_expiry: int, $run: string, $operation: string, $request: bytes, $attempt: string, $worker: string, $lifetime: int, $interpretation: string, $finalization_study: option<string>) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    IF $interpretation!='pse.substrate.v8' { THROW 'PSE_REFUSAL:stale_execution_claim_interpretation'; };
    fn::pse_execution_v1::available($rpc_expiry, $run);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation, 'claim', $request);
    IF $op != NONE { LET $rpc_result = SELECT * FROM ONLY type::record('canonical_attempts', $op.attempt); fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:' + $run);
    LET $r = SELECT * FROM ONLY type::record('canonical_runs', $run);
    LET $summary_cancelled=fn::pse_execution_v1::summary_cancelled($rpc_expiry,$run);
    IF $finalization_study!=NONE {
        LET $summary=SELECT * FROM ONLY type::record('canonical_studies',$finalization_study) FOR UPDATE;
        fn::pse_execution_v1::register($rpc_expiry,'study-cancel:'+$finalization_study);
        IF $summary=NONE OR $summary.run!=$run OR !$summary.active OR $summary.terminal OR $summary.point_count=0dec OR $summary.next_ordinal!=$summary.point_count { THROW 'PSE_REFUSAL:study_summary_finalization_association_unavailable'; };
        LET $pending=SELECT key FROM canonical_study_points WHERE study=$finalization_study AND settled=false LIMIT 1;
        IF array::len($pending)!=0 { THROW 'PSE_REFUSAL:study_summary_finalization_requires_settled_membership'; };
    };
    IF fn::pse_execution_v1::study_cancelled($rpc_expiry, $run) OR ($summary_cancelled AND $finalization_study=NONE) { THROW 'PSE_REFUSAL:execution_cancelled_study_run_not_claimable'; };
    IF $r = NONE OR $r.cancelled OR $r.interpretation != $interpretation { THROW 'PSE_REFUSAL:execution_run_not_claimable'; };
    IF (SELECT * FROM ONLY type::record('canonical_history_identities','effect-free-run:'+$run) FOR UPDATE)!=NONE { THROW 'PSE_REFUSAL:effect_free_execution_already_settled'; };
    IF $r.current_attempt != NONE {
        LET $previous = SELECT * FROM ONLY type::record('canonical_attempts', $r.current_attempt);
        IF $previous != NONE AND (($previous.phase NOT IN ['terminal','terminal_compacted']) OR $previous.outcome = 'succeeded') { THROW 'PSE_REFUSAL:execution_attempt_is_live_or_already_succeeded'; };
    };
    LET $generation = $r.current_generation + 1dec;
    LET $saved = CREATE ONLY type::record('canonical_attempts', $attempt) SET key = $attempt, run = $run, generation = $generation, claim_operation = $operation, request = $request, worker = $worker, expires_at = time::micros() + $lifetime, phase = 'ingesting', finalization_study=$finalization_study;
    UPDATE ONLY type::record('canonical_runs', $run) SET current_generation = $generation, current_attempt = $attempt, terminal_attempt = NONE,terminal_class=NONE;
    fn::pse_execution_v1::source_creator($rpc_expiry,$r.problem,'active_attempt:'+$attempt);
    LET $source_root = SELECT * FROM ONLY type::record('canonical_roots', 'run:' + $run);
    IF $source_root = NONE OR $source_root.problem != $r.problem OR $source_root.revision != $r.revision OR $source_root.sequence != $r.source_sequence OR $source_root.owner_kind != 'run' OR $source_root.owner != $run { THROW 'PSE_REFUSAL:execution_retained_source_selection_unavailable'; };
    CREATE ONLY type::record('canonical_roots', 'active_attempt:' + $attempt) SET key = 'active_attempt:' + $attempt, problem = $r.problem, revision = $r.revision, sequence = $r.source_sequence, owner_kind = 'active_attempt', owner = $attempt;
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'claim',$request,$request,NONE,NONE);
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry, $saved.expires_at);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::append($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $operation: string, $request: bytes, $set: object, $batch: object, $block: option<object>, $outputs: array<object>) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    IF $set.interpretation!='pse.substrate.v8' OR ($block!=NONE AND $block.interpretation!='pse.substrate.v8') OR array::len($outputs[WHERE interpretation!='pse.substrate.v8'])!=0 { THROW 'PSE_REFUSAL:stale_execution_append_interpretation'; };
    IF array::len($outputs) > 18724 OR bytes::len(encoding::cbor::encode({block:$block,outputs:$outputs})) > 131072 { THROW 'PSE_REFUSAL:execution_index_metadata_extent_exceeded'; };
    fn::pse_execution_v1::available($rpc_expiry, $run);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation, 'append', $request);
    LET $writer = IF $op = NONE { fn::pse_execution_v1::writer($rpc_expiry, $run, $attempt, $generation, $operation, 'append') } ELSE { NONE };
    IF $writer != NONE AND $writer.pse_writer != 'admitted' { RETURN $writer; };
    LET $a = $writer.attempt;
    IF $op = NONE AND (($a.phase!='ingesting')) { THROW 'PSE_REFUSAL:execution_result_ingestion_closed'; };
    IF $batch.attempt != $attempt OR $set.attempt != $attempt OR $batch.result_set != $set.key { THROW 'PSE_REFUSAL:execution_batch_coordinate_mismatch'; };
    LET $existing = SELECT * FROM ONLY type::record('canonical_result_batches', $batch.key);
    LET $existing_block = SELECT * FROM ONLY type::record('canonical_result_blocks', $batch.key);
    IF $existing != NONE {
        IF object::remove($existing,'id')!=$batch OR $existing.digest != $batch.digest OR $existing.ordinal != $batch.ordinal OR $existing.row_count != $batch.row_count OR $existing.result_set != $batch.result_set OR $existing.attempt != $attempt { THROW 'PSE_REFUSAL:execution_immutable_batch_changed'; };
        IF ($block = NONE AND $existing_block != NONE) OR ($block != NONE AND ($existing_block = NONE OR object::remove($existing_block, 'id') != $block)) { THROW 'PSE_REFUSAL:execution_immutable_block_changed'; };
        LET $old_outputs = SELECT * FROM canonical_result_block_outputs WHERE batch = $batch.key ORDER BY key LIMIT 18725;
        IF array::len($old_outputs) != array::len($outputs) OR $old_outputs.map(|$output| object::remove($output, 'id')) != $outputs { THROW 'PSE_REFUSAL:execution_immutable_output_block_indexes_changed'; };
        IF $op != NONE { LET $rpc_result = {key:$batch.key,attempt:$attempt,result_set:$set.key,ordinal:$batch.ordinal,digest:$batch.digest,row_count:$batch.row_count,file_binding:$batch.file_binding,request:$request}; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    } ELSE {
        IF $op != NONE { THROW 'PSE_REFUSAL:execution_acknowledged_batch_unavailable'; };
        LET $s = SELECT * FROM ONLY type::record('canonical_result_sets', $set.key);
        IF $s = NONE {
            LET $sets = SELECT key FROM canonical_result_sets WHERE attempt = $attempt LIMIT 256;
            IF array::len($sets) >= 256 { THROW 'PSE_REFUSAL:execution_result_set_bound_exceeded'; };
            IF $batch.ordinal != 0dec { THROW 'PSE_REFUSAL:execution_batch_sequence_gap'; };
            CREATE ONLY type::record('canonical_result_sets', $set.key) CONTENT $set;
        } ELSE {
            IF $s.attempt != $attempt OR $s.name != $set.name OR $s.interpretation != $set.interpretation OR $s.next_ordinal != $batch.ordinal { THROW 'PSE_REFUSAL:execution_batch_sequence_gap'; };
        };
        fn::pse_files_v1::attach($rpc_expiry,$batch,'result',$attempt,'result:'+$batch.key);
        CREATE ONLY type::record('canonical_result_batches', $batch.key) CONTENT $batch;
        IF $block != NONE { CREATE ONLY type::record('canonical_result_blocks', $batch.key) CONTENT $block; };
        IF array::len($outputs) != 0 {
            LET $rows = $outputs.map(|$output| object::extend($output, {id:type::record('canonical_result_block_outputs', $output.key)}));
            INSERT INTO canonical_result_block_outputs $rows RETURN NONE;
        };
        UPDATE ONLY type::record('canonical_result_sets', $set.key) SET next_ordinal += 1dec, row_count += $batch.row_count;
    };
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'append',$request,$request,NONE,NONE);
    LET $rpc_result = {key:$batch.key,attempt:$attempt,result_set:$set.key,ordinal:$batch.ordinal,digest:$batch.digest,row_count:$batch.row_count,file_binding:$batch.file_binding,request:$request};
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $op = NONE { fn::pse_execution_v1::lease($rpc_expiry, $a.expires_at); };
    RETURN $rpc_result;
};

// One statement/transaction, preserving every existing per-block operation receipt.
DEFINE FUNCTION fn::pse_execution_v1::append_many($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $items: array<object>) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    IF array::len($items)=0 OR array::len($items)>18724 OR bytes::len(encoding::cbor::encode($items))>4194304 { THROW 'PSE_REFUSAL:execution_append_group_extent_exceeded'; };
    fn::pse_execution_v1::available($rpc_expiry,$run);
    // Preflight BEFORE any append mutation. An entirely replayed group needs no
    // fresh writer admission after cancellation, closure or attempt replacement.
    FOR $item IN $items {
        LET $old=fn::pse_execution_v1::operation($rpc_expiry,$item.operation,'append',$item.request);
        IF $old=NONE {
            LET $writer=fn::pse_execution_v1::writer($rpc_expiry,$run,$attempt,$generation,$item.operation,'append');
            IF $writer.pse_writer!='admitted' { RETURN $writer; };
            IF ($writer.attempt.phase!='ingesting') { THROW 'PSE_REFUSAL:execution_result_ingestion_closed'; };
        };
    };
    // FOR executes each original append serially. A later gap, conflicting
    // immutable receipt or deadline THROW rolls the entire new group back.
    FOR $item IN $items {
        LET $saved=fn::pse_execution_v1::append($rpc_expiry,$run,$attempt,$generation,$item.operation,$item.request,$item.set,$item.batch,$item.block,$item.outputs);
        IF $saved.pse_writer!=NONE { THROW 'PSE_REFUSAL:execution_append_group_admission_changed'; };
    };
    LET $receipts=$items.map(|$item| {key:$item.batch.key,attempt:$attempt,result_set:$item.set.key,ordinal:$item.batch.ordinal,digest:$item.batch.digest,row_count:$item.batch.row_count,file_binding:$item.batch.file_binding,request:$item.request});
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {acknowledgments:$receipts};
};

DEFINE FUNCTION fn::pse_execution_v1::empty($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $operation: string, $request: bytes, $set: object) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    fn::pse_execution_v1::available($rpc_expiry,$run);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry,$operation,'empty',$request);
    LET $writer=IF $op=NONE { fn::pse_execution_v1::writer($rpc_expiry,$run,$attempt,$generation,$operation,'empty') } ELSE { NONE };
    IF $writer!=NONE AND $writer.pse_writer != 'admitted' { RETURN $writer; };
    IF $op=NONE AND (($writer.attempt.phase!='ingesting')) { THROW 'PSE_REFUSAL:execution_empty_declaration_ingestion_closed'; };
    IF $set.attempt != $attempt OR $set.interpretation != 'pse.substrate.v8' OR $set.next_ordinal != 0dec OR $set.row_count != 0dec { THROW 'PSE_REFUSAL:execution_empty_declaration_mismatch'; };
    LET $old = SELECT * FROM ONLY type::record('canonical_result_sets',$set.key);
    IF $old != NONE {
        IF object::remove($old,'id') != $set { THROW 'PSE_REFUSAL:execution_demanded_empty_set_changed'; };
    } ELSE {
        IF $op != NONE { THROW 'PSE_REFUSAL:execution_acknowledged_empty_set_unavailable'; };
        LET $sets = SELECT key FROM canonical_result_sets WHERE attempt=$attempt LIMIT 256;
        IF array::len($sets) >= 256 { THROW 'PSE_REFUSAL:execution_result_set_bound_exceeded'; };
        CREATE ONLY type::record('canonical_result_sets',$set.key) CONTENT $set;
    };
    IF $op = NONE { fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'empty',$request,$request,NONE,NONE); };
    LET $saved = SELECT * FROM ONLY type::record('canonical_result_sets',$set.key);
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $op = NONE { fn::pse_execution_v1::lease($rpc_expiry,$writer.attempt.expires_at); };
    RETURN $saved;
};

DEFINE FUNCTION fn::pse_execution_v1::verify_acknowledged($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $proofs: array<object>, $seeds: object, $progress_queued: option<decimal>) -> bool {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    LET $sets=SELECT * FROM canonical_result_sets WHERE attempt=$attempt ORDER BY key LIMIT 257;
    IF array::len($sets)>256 OR array::len($proofs)>256 OR array::len(array::distinct($proofs.map(|$p| $p.set))) != array::len($proofs) { THROW 'PSE_REFUSAL:execution_acknowledged_set_membership_differs'; };
    FOR $p IN $proofs {
        IF array::len($sets.filter(|$s| $s.key=$p.set))!=1 { THROW 'PSE_REFUSAL:execution_advertised_set_missing'; };
    };
    FOR $s IN $sets {
        LET $matching=$proofs.filter(|$p| $p.set=$s.key);
        IF array::len($matching)=0 {
            IF $progress_queued=NONE OR $s.name!='__progress' OR $s.attempt!=$attempt OR $s.interpretation!='pse.substrate.v8' OR $s.row_count>$progress_queued { THROW 'PSE_REFUSAL:execution_unacknowledged_set_membership_differs'; };
        } ELSE {
        IF array::len($matching)!=1 { THROW 'PSE_REFUSAL:execution_advertised_set_ambiguous'; };
        LET $p=$matching[0];
        LET $uncertain=$s.name='__progress' AND $progress_queued!=NONE;
        IF $s.attempt != $attempt OR $s.name != $p.name OR $s.interpretation != 'pse.substrate.v8' OR (!$uncertain AND ($s.next_ordinal != $p.count OR $s.row_count != $p.row_count)) OR ($uncertain AND ($s.next_ordinal<$p.count OR $s.row_count<$p.row_count OR $s.row_count>$progress_queued)) { THROW 'PSE_REFUSAL:execution_acknowledged_set_coverage_differs'; };
        LET $receipt=SELECT * FROM ONLY type::record('canonical_execution_operations',$p.operation);
        IF $receipt=NONE OR $receipt.run != $run OR $receipt.attempt != $attempt OR $receipt.kind != $p.kind OR $receipt.request != $p.request OR $receipt.result != $p.request { THROW 'PSE_REFUSAL:execution_actual_final_receipt_differs'; };
        IF $p.count=0dec {
            IF $p.kind != 'empty' OR $p.row_count != 0dec { THROW 'PSE_REFUSAL:execution_empty_membership_lacks_declaration'; };
        } ELSE {
            LET $last=SELECT key,attempt,result_set,ordinal,digest,row_count,file_binding FROM ONLY type::record('canonical_result_batches',$p.key);
            IF $p.kind != 'append' OR $last=NONE OR $last.attempt != $attempt OR $last.result_set != $s.key OR $last.ordinal+1dec != $p.count OR $last.ordinal != $p.ordinal OR $last.digest != $p.digest OR $last.row_count != $p.rows OR $last.file_binding!=$p.file_binding { THROW 'PSE_REFUSAL:execution_final_batch_receipt_differs'; };
        };
        };
    };
    LET $completion=$sets.filter(|$s| $s.name='__completion');
    IF array::len($completion)!=1 OR $completion[0].next_ordinal=0dec { THROW 'PSE_REFUSAL:execution_completion_coverage_missing'; };
    LET $inventory=SELECT count() AS n,math::sum(batch_count) AS batches,math::sum(payload_bytes) AS bytes FROM canonical_result_seeds WHERE attempt=$attempt GROUP ALL;
    LET $n=IF array::len($inventory)=0 { 0dec } ELSE { $inventory[0].n };
    LET $seed_sets=$sets.filter(|$s| $s.name='__seeds');
    IF $n != $seeds.count { THROW 'PSE_REFUSAL:execution_seed_inventory_differs'; };
    IF $n=0dec {
        IF array::len($seed_sets)!=0 OR $seeds.batches != 0dec OR $seeds.bytes != 0dec { THROW 'PSE_REFUSAL:execution_orphaned_seed_chunks'; };
    } ELSE {
        IF array::len($seed_sets)!=1 OR $seed_sets[0].next_ordinal != $seeds.batches OR $seed_sets[0].row_count != $seeds.bytes OR $inventory[0].batches != $seeds.batches OR $inventory[0].bytes != $seeds.bytes { THROW 'PSE_REFUSAL:execution_seed_coverage_differs'; };
        LET $last=SELECT * FROM ONLY type::record('canonical_result_seeds',$seeds.key);
        LET $receipt=SELECT * FROM ONLY type::record('canonical_execution_operations',$seeds.operation);
        IF $last=NONE OR $last.run != $run OR $last.attempt != $attempt OR $last.attempt_generation != $generation OR $last.result_set != $seed_sets[0].key OR $last.first_ordinal+$last.batch_count != $seeds.batches OR $receipt=NONE OR $receipt.run != $run OR $receipt.attempt != $attempt OR $receipt.kind != 'seed' OR $receipt.request != $seeds.request OR $receipt.result != $seeds.request { THROW 'PSE_REFUSAL:execution_actual_seed_receipt_differs'; };
    };
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN true;
};
DEFINE FUNCTION fn::pse_execution_v1::check_closed_acknowledgments($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $proofs: array<object>, $seeds: object, $progress_queued: decimal) -> object {
    LET $writer=fn::pse_execution_v1::writer($rpc_expiry,$run,$attempt,$generation,'ack-readback','close');
    IF $writer.pse_writer!='admitted' { RETURN $writer; };
    IF ($writer.attempt.phase='ingesting') OR $writer.attempt.close_generation!=$generation { THROW 'PSE_REFUSAL:execution_acknowledgment_readback_fenced'; };
    fn::pse_execution_v1::verify_acknowledged($rpc_expiry,$run,$attempt,$generation,$proofs,$seeds,$progress_queued);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    fn::pse_execution_v1::lease($rpc_expiry,$writer.attempt.expires_at);
    RETURN {valid:true};
};

DEFINE FUNCTION fn::pse_execution_v1::close_acknowledged($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $operation: string, $request: bytes, $manifest: object, $proofs: array<object>, $seeds: object) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    fn::pse_execution_v1::available($rpc_expiry,$run);
    LET $op=fn::pse_execution_v1::operation($rpc_expiry,$operation,'close',$request);
    IF $op != NONE {
        LET $m=SELECT * FROM ONLY type::record('canonical_result_manifests',$manifest.key);
        IF $m=NONE OR object::remove($m,'id') != $manifest { THROW 'PSE_REFUSAL:execution_acknowledged_close_descriptor_changed'; };
        LET $saved=SELECT * FROM ONLY type::record('canonical_attempts',$attempt);
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $saved;
    };
    LET $writer=fn::pse_execution_v1::writer($rpc_expiry,$run,$attempt,$generation,$operation,'close');
    IF $writer.pse_writer != 'admitted' { RETURN $writer; };
    LET $a=$writer.attempt;
    IF ($a.phase!='ingesting') OR $manifest.key != $attempt OR $manifest.attempt != $attempt OR $manifest.generation != $generation OR bytes::len($manifest.descriptors) > 131072 { THROW 'PSE_REFUSAL:execution_acknowledged_close_fenced'; };
    fn::pse_execution_v1::verify_acknowledged($rpc_expiry,$run,$attempt,$generation,$proofs,$seeds,NONE);
    fn::pse_history_v1::identity($rpc_expiry,'manifest',$manifest.key,$run); CREATE ONLY type::record('canonical_result_manifests',$manifest.key) CONTENT $manifest;
    LET $saved=UPDATE ONLY type::record('canonical_attempts',$attempt) SET phase='closed_with_manifest',close_generation=$generation,closed_manifest=$manifest.key;
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'close',$request,type::bytes(<string>$generation),NONE,NONE);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry,$a.expires_at);
    RETURN $saved;
};

DEFINE FUNCTION fn::pse_execution_v1::seal_ack($rpc_expiry: int, $run: string, $attempt: string, $authority: decimal, $operation: string, $request: bytes, $manifest: string, $digest: string, $outcome: string, $completion: bytes, $seed_eligible: bool, $coverage: option<object>) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    IF $coverage != NONE {
        LET $sets=SELECT * FROM canonical_result_sets WHERE attempt=$attempt AND name='__completion' LIMIT 2;
        LET $progress=SELECT * FROM canonical_result_sets WHERE attempt=$attempt AND name='__progress' LIMIT 2;
        LET $rows=IF array::len($progress)=0 { 0dec } ELSE { $progress[0].row_count };
        IF array::len($sets)!=1 OR $sets[0].next_ordinal != $coverage.count OR $sets[0].row_count != $coverage.bytes OR $rows != $coverage.progress { THROW 'PSE_REFUSAL:execution_original_completion_coverage_differs'; };
    };
    LET $a=fn::pse_execution_v1::seal($rpc_expiry,$run,$attempt,$authority,$operation,$request,$manifest,$digest,$outcome,$completion,$seed_eligible);
    IF $a.pse_writer != NONE { RETURN $a; };
    LET $r=SELECT * FROM ONLY type::record('canonical_runs',$run);
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {attempt:$a,run:$r};
};
DEFINE FUNCTION fn::pse_execution_v1::study_seal_ack($rpc_expiry: int, $study: string, $run: string, $attempt: string, $authority: decimal, $operation: string, $request: bytes, $manifest: string, $digest: string, $outcome: string, $completion: bytes) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    LET $a=fn::pse_study_v1::seal($rpc_expiry,$study,$run,$attempt,$authority,$operation,$request,$manifest,$digest,$outcome,$completion);
    IF $a.pse_writer != NONE { RETURN $a; };
    LET $r=SELECT * FROM ONLY type::record('canonical_runs',$run);
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {attempt:$a,run:$r};
};

DEFINE FUNCTION fn::pse_execution_v1::close($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $operation: string, $request: bytes) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    fn::pse_execution_v1::available($rpc_expiry, $run);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation, 'close', $request);
    IF $op != NONE { LET $rpc_result = SELECT * FROM ONLY type::record('canonical_attempts', $op.attempt); fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    LET $writer = fn::pse_execution_v1::writer($rpc_expiry, $run, $attempt, $generation, $operation, 'close');
    IF $writer.pse_writer != 'admitted' { RETURN $writer; };
    LET $a = $writer.attempt;
    IF ($a.phase!='ingesting') { THROW 'PSE_REFUSAL:execution_ingestion_already_closed'; };
    LET $saved = UPDATE ONLY type::record('canonical_attempts', $attempt) SET phase = IF closed_manifest=NONE { 'closed_awaiting_manifest' } ELSE { 'closed_with_manifest' }, close_generation = $generation;
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'close',$request,type::bytes(<string>$generation),NONE,NONE);
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry, $a.expires_at);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::cancel($rpc_expiry: int, $run: string, $operation: string, $request: bytes) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::available($rpc_expiry, $run);
    fn::pse_execution_v1::touch($rpc_expiry,'run-cancel:'+$run);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation, 'cancel', $request);
    IF $op != NONE { LET $rpc_result = SELECT * FROM ONLY type::record('canonical_runs', $run); fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:' + $run);
    LET $r = SELECT * FROM ONLY type::record('canonical_runs', $run);
    IF $r = NONE { THROW 'PSE_REFUSAL:execution_run_unavailable'; };
    IF $r.terminal_attempt != NONE { THROW 'PSE_REFUSAL:execution_run_already_sealed'; };
    LET $generation = $r.current_generation + 1dec;
    LET $saved = UPDATE ONLY type::record('canonical_runs', $run) SET cancelled = true, current_generation = $generation;
    IF $r.current_attempt != NONE { UPDATE ONLY type::record('canonical_attempts', $r.current_attempt) SET phase = IF closed_manifest=NONE { 'closed_awaiting_manifest' } ELSE { 'closed_with_manifest' }, close_generation = $generation; };
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,NONE,'cancel',$request,$request,NONE,NONE);
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::recover($rpc_expiry: int, $run: string, $operation: string, $request: bytes) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::available($rpc_expiry, $run);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation, 'recover', $request);
    IF $op != NONE { LET $rpc_result = SELECT * FROM ONLY type::record('canonical_attempts', $op.attempt); fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:' + $run);
    LET $r = SELECT * FROM ONLY type::record('canonical_runs', $run);
    IF $r = NONE OR $r.current_attempt = NONE OR $r.terminal_attempt != NONE { THROW 'PSE_REFUSAL:execution_recovery_unavailable'; };
    LET $a = SELECT * FROM ONLY type::record('canonical_attempts', $r.current_attempt);
    LET $study_cancelled = fn::pse_execution_v1::study_cancelled($rpc_expiry, $run);
    LET $summary_cancelled = fn::pse_execution_v1::summary_cancelled($rpc_expiry, $run);
    IF $a = NONE OR ($a.phase IN ['terminal','terminal_compacted']) OR ($r.cancelled = false AND $study_cancelled = false AND $a.expires_at > time::micros()) { THROW 'PSE_REFUSAL:execution_recovery_still_owned_by_live_worker'; };
    LET $generation = $r.current_generation + 1dec;
    UPDATE ONLY type::record('canonical_runs', $run) SET current_generation = $generation, cancelled = $r.cancelled OR $study_cancelled;
    LET $saved = UPDATE ONLY type::record('canonical_attempts', $a.key) SET phase = IF closed_manifest=NONE { 'closed_awaiting_manifest' } ELSE { 'closed_with_manifest' }, close_generation = $generation;
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$a.key,'recover',$request,type::bytes(<string>$generation),NONE,NONE);
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::manifest($rpc_expiry: int, $run: string, $manifest: object) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    fn::pse_execution_v1::available($rpc_expiry, $run);
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:' + $run);
    LET $study_cancelled=fn::pse_execution_v1::study_cancelled($rpc_expiry,$run);
    LET $summary_cancelled=fn::pse_execution_v1::summary_cancelled($rpc_expiry,$run);
    LET $a = SELECT * FROM ONLY type::record('canonical_attempts', $manifest.attempt);
    IF $a = NONE OR $a.run != $run OR ($a.phase='ingesting') OR $a.generation != $manifest.generation { THROW 'PSE_REFUSAL:execution_closed_descriptor_fenced'; };
    LET $old = SELECT * FROM ONLY type::record('canonical_result_manifests', $manifest.key);
    IF $old != NONE {
        IF $old.attempt != $manifest.attempt OR $old.generation != $manifest.generation OR $old.digest != $manifest.digest OR $old.descriptors != $manifest.descriptors { THROW 'PSE_REFUSAL:execution_immutable_descriptor_changed'; };
        LET $rpc_result = $old;
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    };
    IF ($a.phase IN ['terminal','terminal_compacted']) { THROW 'PSE_REFUSAL:execution_terminal_manifest_unavailable'; };
    fn::pse_history_v1::identity($rpc_expiry,'manifest',$manifest.key,$run);
    LET $saved = CREATE ONLY type::record('canonical_result_manifests', $manifest.key) CONTENT $manifest;
    UPDATE ONLY type::record('canonical_attempts', $a.key) SET phase = 'closed_with_manifest', closed_manifest = $manifest.key;
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::seal($rpc_expiry: int, $run: string, $attempt: string, $authority: decimal, $operation: string, $request: bytes, $manifest: string, $digest: string, $outcome: string, $completion: bytes, $seed_eligible: bool) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    fn::pse_execution_v1::available($rpc_expiry, $run);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation, 'seal', $request);
    IF $op != NONE { LET $rpc_result = SELECT * FROM ONLY type::record('canonical_attempts', $op.attempt); fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:' + $run);
    LET $r = SELECT * FROM ONLY type::record('canonical_runs', $run);
    LET $a = SELECT * FROM ONLY type::record('canonical_attempts', $attempt);
    LET $m = SELECT * FROM ONLY type::record('canonical_result_manifests', $manifest);
    IF $r = NONE OR $a = NONE OR $m = NONE OR $r.current_attempt != $attempt OR $r.current_generation != $authority OR $a.close_generation != $authority OR $a.run != $run OR ($a.phase IN ['terminal','terminal_compacted']) OR $r.terminal_attempt != NONE OR ($a.phase='ingesting') OR $a.closed_manifest != $manifest OR $m.attempt != $attempt OR $m.generation != $a.generation OR $m.digest != $digest { THROW 'PSE_REFUSAL:execution_terminal_seal_fenced'; };
    IF $outcome NOT IN ['succeeded','failed','partial','cancelled'] { THROW 'PSE_REFUSAL:execution_unknown_terminal_outcome'; };
    LET $study_cancelled = fn::pse_execution_v1::study_cancelled($rpc_expiry, $run);
    IF $study_cancelled AND ($r.cancelled = false OR $authority = $a.generation OR $outcome != 'cancelled') { fn::pse_execution_v1::deadline($rpc_expiry); RETURN {pse_writer:'study-cancelled',run:$run,attempt:$attempt,generation:$a.generation,operation:$operation}; };
    IF fn::pse_execution_v1::summary_cancelled($rpc_expiry, $run) AND $outcome != 'cancelled' { THROW 'PSE_REFUSAL:execution_summary_cancellation_wins_terminal_seal'; };
    IF ($r.cancelled OR $study_cancelled) AND $outcome != 'cancelled' { THROW 'PSE_REFUSAL:execution_cancellation_wins_terminal_seal'; };
    IF $outcome = 'succeeded' AND ($authority != $a.generation OR $a.expires_at <= time::micros()) { THROW 'PSE_REFUSAL:execution_expired_worker_cannot_seal_success'; };
    IF $authority = $a.generation AND $a.expires_at <= time::micros() { THROW 'PSE_REFUSAL:execution_expired_worker_must_recover_before_sealing'; };
    LET $saved = UPDATE ONLY type::record('canonical_attempts', $attempt) SET phase = 'terminal', outcome = $outcome, completion = $completion, seed_manifest = IF $seed_eligible { $manifest } ELSE { NONE };
    UPDATE ONLY type::record('canonical_runs', $run) SET terminal_attempt = $attempt,terminal_class=$outcome;
    // Removing this exact owned root adds no retention dependency. Keep the
    // reclaim/exact-root fences without writing the shared creator generation.
    // The run root remains until its separate terminal retirement owner releases it.
    fn::pse_execution_v1::register($rpc_expiry,'retention:'+$r.problem);
    SELECT * FROM ONLY type::record('canonical_roots','active_attempt:'+$attempt) FOR UPDATE;
    DELETE ONLY type::record('canonical_roots', 'active_attempt:' + $attempt);
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'seal',$request,$completion,NONE,NONE);
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $authority = $a.generation { fn::pse_execution_v1::lease($rpc_expiry, $a.expires_at); };
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::renew($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $lifetime: int) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    LET $writer = fn::pse_execution_v1::writer($rpc_expiry, $run, $attempt, $generation, 'renew', 'renew');
    IF $writer.pse_writer != 'admitted' { RETURN $writer; };
    LET $a = $writer.attempt;
    LET $original_expiry = $a.expires_at;
    LET $rpc_result = UPDATE ONLY type::record('canonical_attempts', $attempt) SET expires_at = time::micros() + $lifetime;
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry, $original_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_execution_v1::seed_eligible($seed: object) -> bool {
    LET $a = SELECT * FROM ONLY type::record('canonical_attempts', $seed.attempt);
    IF $a = NONE OR ($a.phase NOT IN ['terminal','terminal_compacted']) OR $a.seed_manifest = NONE OR $a.seed_manifest != $a.closed_manifest OR $a.run != $seed.run OR $a.generation != $seed.attempt_generation { RETURN false; };
    LET $r = SELECT sequence,interpretation FROM ONLY type::record('canonical_runs', $seed.run);
    LET $installed=SELECT interpretation FROM ONLY canonical_interpretations:current;
    IF $r=NONE OR $r.interpretation!='pse.substrate.v8' OR $installed=NONE OR $installed.interpretation!='pse.substrate.v8' { RETURN false; };
    LET $m = SELECT attempt,generation FROM ONLY type::record('canonical_result_manifests', $a.seed_manifest);
    RETURN $r != NONE AND $r.sequence = $seed.run_sequence AND $m != NONE AND $m.attempt = $seed.attempt AND $m.generation = $seed.attempt_generation;
};

DEFINE FUNCTION fn::pse_execution_v1::seed($rpc_expiry: int, $run: string, $attempt: string, $generation: decimal, $operation: string, $request: bytes, $seed: object) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    fn::pse_execution_v1::available($rpc_expiry, $run);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation, 'seed', $request);
    LET $old = SELECT * FROM ONLY type::record('canonical_result_seeds', $seed.key);
    IF $old != NONE {
        IF object::remove($old, 'id') != $seed { THROW 'PSE_REFUSAL:execution_immutable_seed_descriptor_changed'; };
        IF $op != NONE { LET $rpc_result = $old; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    };
    LET $writer = fn::pse_execution_v1::writer($rpc_expiry, $run, $attempt, $generation, $operation, 'seed');
    IF $writer.pse_writer != 'admitted' { RETURN $writer; };
    LET $a = $writer.attempt;
    IF ($a.phase!='ingesting') { THROW 'PSE_REFUSAL:execution_seed_ingestion_closed'; };
    IF $seed.run != $run OR $seed.attempt != $attempt OR $seed.batch_count <= 0dec { THROW 'PSE_REFUSAL:execution_seed_coordinate_mismatch'; };
    LET $set = SELECT * FROM ONLY type::record('canonical_result_sets', $seed.result_set);
    LET $batch = SELECT * FROM ONLY type::record('canonical_result_batches', $seed.batch);
    IF $set = NONE OR $batch = NONE OR $set.attempt != $attempt OR $set.next_ordinal < $seed.first_ordinal + $seed.batch_count OR $batch.attempt != $attempt OR $batch.result_set != $seed.result_set OR $batch.ordinal != $seed.first_ordinal { THROW 'PSE_REFUSAL:execution_seed_chunks_incomplete'; };
    fn::pse_history_v1::identity($rpc_expiry,'seed',$seed.key,$run);
    IF $old = NONE { CREATE ONLY type::record('canonical_result_seeds', $seed.key) CONTENT $seed; };
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'seed',$request,$request,NONE,NONE);
    LET $rpc_result = SELECT * FROM ONLY type::record('canonical_result_seeds', $seed.key);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry, $a.expires_at);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_project_v1::authority($expiry:int,$issuing:string) -> bool {
    fn::pse_execution_v1::deadline($expiry);
    IF (SELECT * FROM ONLY canonical_interpretations:current).issuing_store!=$issuing { THROW 'PSE_REFUSAL:project_issuing_authority_changed'; };
    RETURN true;
};
DEFINE FUNCTION fn::pse_project_v1::ack($expiry:int,$operation:string,$request:bytes) -> option<object> {
    fn::pse_execution_v1::deadline($expiry);
    LET $old=SELECT * FROM ONLY type::record('canonical_project_operations',$operation);
    IF $old!=NONE AND $old.request!=$request { THROW 'PSE_REFUSAL:project_operation_identity_changed'; };
    RETURN $old;
};
DEFINE FUNCTION fn::pse_project_v1::project($expiry:int,$key:string,$generation:decimal) -> object {
    fn::pse_execution_v1::deadline($expiry);
    LET $p=SELECT * FROM ONLY type::record('canonical_projects',$key);
    IF $p=NONE OR $p.deleted OR $p.generation!=$generation { THROW 'PSE_REFUSAL:project_generation_changed'; };
    RETURN $p;
};
DEFINE FUNCTION fn::pse_project_v1::root($expiry:int,$revision:string,$owner:string) -> bool {
    LET $r=SELECT * FROM ONLY type::record('canonical_revisions',$revision);
    IF $r=NONE { THROW 'PSE_REFUSAL:project_source_unavailable'; };
    fn::pse_execution_v1::source_creator($expiry,$r.problem,$owner);
    LET $lost=SELECT key FROM canonical_reclaimed_ranges WHERE problem=$r.problem AND from_sequence<=$r.sequence AND to_sequence>$r.sequence LIMIT 1;
    IF array::len($lost)!=0 { THROW 'PSE_REFUSAL:project_source_unavailable'; };
    UPSERT ONLY type::record('canonical_roots',$owner) CONTENT {key:$owner,problem:$r.problem,revision:$revision,sequence:$r.sequence,owner_kind:'project',owner:$owner};
    RETURN true;
};
DEFINE FUNCTION fn::pse_project_v1::create($expiry:int,$operation:string,$request:bytes,$project:string,$title:string) -> object {
    LET $old=fn::pse_project_v1::ack($expiry,$operation,$request); IF $old!=NONE { RETURN $old; };
    IF $project='' OR string::len($project)>4096 OR string::len($title)>4096 { THROW 'PSE_REFUSAL:project_metadata_bound'; };
    CREATE ONLY type::record('canonical_projects',$project) CONTENT {key:$project,title:$title,deleted:false,generation:0dec};
    LET $ack=CREATE ONLY type::record('canonical_project_operations',$operation) CONTENT {key:$operation,kind:'create',project:$project,request:$request,generation:0dec};
    RETURN $ack;
};
// Called inside EDIT before canonical_problems is changed. All branch writes,
// including ordinary source APIs, must present the matching project guard.
DEFINE FUNCTION fn::pse_project_v1::source_guard($expiry:int,$problem:string,$operation:string,$intent:option<object>) -> bool {
    IF $intent!=NONE {fn::pse_project_v1::authority($expiry,$intent.issuing_store);};
    LET $owners=SELECT * FROM canonical_project_branches WITH INDEX project_branch_problem WHERE problem=$problem LIMIT 2;
    IF $intent=NONE { IF array::len($owners)!=0 { THROW 'PSE_REFUSAL:project_publication_guard_required'; }; RETURN true; };
    IF $intent.kind NOT IN ['fork','publish'] { THROW 'PSE_REFUSAL:project_branch_changed'; };
    LET $stage=SELECT * FROM ONLY type::record('canonical_stages',$operation);
    IF $stage=NONE OR ($stage.expected_head ?? NONE)!=($intent.expected ?? NONE) { THROW 'PSE_REFUSAL:project_branch_changed'; };
    LET $ack=fn::pse_project_v1::ack($expiry,$operation,$intent.request);
    IF $ack!=NONE { THROW 'PSE_REFUSAL:project_operation_already_committed'; };
    fn::pse_project_v1::project($expiry,$intent.project,$intent.project_generation);
    IF $intent.kind='fork' {
        IF array::len($owners)!=0 OR (SELECT * FROM ONLY type::record('canonical_project_branches',$intent.branch))!=NONE { THROW 'PSE_REFUSAL:project_branch_changed'; };
        IF $intent.origin_revision=NONE { THROW 'PSE_REFUSAL:project_source_unavailable'; };
        fn::pse_project_v1::root($expiry,$intent.origin_revision,'project-origin:'+$intent.branch);
        LET $origin=SELECT * FROM ONLY type::record('canonical_revisions',$intent.origin_revision);
        LET $source=SELECT logical,scope,name,version FROM canonical_memberships WHERE problem=$origin.problem AND from_sequence<=$origin.sequence AND (to_sequence=NONE OR to_sequence>$origin.sequence) ORDER BY logical LIMIT 8193;
        LET $changes=SELECT logical,scope,name,version FROM canonical_staged_edits WHERE stage=$operation ORDER BY logical LIMIT 8193;
        IF array::len($source)!=array::len($changes) OR array::len($source)>8192 { THROW 'PSE_REFUSAL:project_fork_closure_differs'; };
        IF $source!=$changes { THROW 'PSE_REFUSAL:project_fork_closure_differs'; };
        CREATE ONLY type::record('canonical_project_branches',$intent.branch) CONTENT {key:$intent.branch,project:$intent.project,problem:$problem,name:$intent.branch_name,origin_revision:$intent.origin_revision,generation:0dec};
    } ELSE {
        LET $branch=SELECT * FROM ONLY type::record('canonical_project_branches',$intent.branch) FOR UPDATE;
        IF array::len($owners)!=1 OR $branch=NONE OR $branch.problem!=$problem OR $branch.project!=$intent.project OR $branch.generation!=$intent.branch_generation { THROW 'PSE_REFUSAL:project_branch_changed'; };
        IF $intent.draft!=NONE {
            LET $draft=SELECT * FROM ONLY type::record('canonical_project_drafts',$intent.draft) FOR UPDATE;
            LET $version=SELECT * FROM ONLY type::record('canonical_project_draft_versions',$draft.version);
            IF $draft=NONE OR $draft.deleted OR $draft.branch!=$intent.branch OR $draft.generation!=$intent.draft_generation OR $version.base_revision!=$intent.expected { THROW 'PSE_REFUSAL:project_draft_changed'; };
        };
    };
    RETURN true;
};
DEFINE FUNCTION fn::pse_project_v1::source_ack($expiry:int,$problem:string,$operation:string,$intent:option<object>) -> bool {
    IF $intent=NONE { RETURN true; };
    fn::pse_project_v1::root($expiry,$operation,'project-head:'+$intent.branch);
    FOR $parent IN $intent.extra_parents {
        fn::pse_project_v1::root($expiry,$parent,'project-ancestry:'+$operation+':'+$parent);
        LET $edge=<string>string::len($operation)+':'+$operation+$parent;
        CREATE ONLY type::record('canonical_project_ancestry',$edge) CONTENT {key:$edge,revision:$operation,parent:$parent};
    };
    UPDATE ONLY type::record('canonical_project_branches',$intent.branch) SET generation+=1dec;
    LET $project=IF $intent.kind='fork' { UPDATE ONLY type::record('canonical_projects',$intent.project) SET generation+=1dec } ELSE { SELECT * FROM ONLY type::record('canonical_projects',$intent.project) };
    CREATE ONLY type::record('canonical_project_operations',$operation) CONTENT {key:$operation,kind:$intent.kind,project:$intent.project,branch:$intent.branch,request:$intent.request,revision:$operation,generation:$project.generation};
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_project_v1::draft($expiry:int,$operation:string,$request:bytes,$row:object,$expected:option<decimal>,$project_generation:decimal,$obligation:option<object>) -> object {
    LET $ack=fn::pse_project_v1::ack($expiry,$operation,$request); IF $ack!=NONE { RETURN $ack; };
    fn::pse_project_v1::project($expiry,$row.project,$project_generation);
    LET $branch=SELECT * FROM ONLY type::record('canonical_project_branches',$row.branch) FOR UPDATE;
    IF $branch=NONE OR $branch.project!=$row.project { THROW 'PSE_REFUSAL:project_branch_changed'; };
    LET $revision=SELECT * FROM ONLY type::record('canonical_revisions',$row.base_revision);
    IF $revision=NONE OR $revision.problem!=$branch.problem { THROW 'PSE_REFUSAL:project_source_unavailable'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_project_drafts',$row.draft) FOR UPDATE;
    IF ($old.generation ?? NONE)!=$expected OR ($old!=NONE AND ($old.deleted OR $old.branch!=$row.branch OR $old.project!=$row.project)) { THROW 'PSE_REFUSAL:project_draft_changed'; };
    IF $row.generation!=($expected ?? 0dec)+1dec OR ($row.artifact!=NONE AND bytes::len($row.content)!=0) { THROW 'PSE_REFUSAL:project_draft_changed'; };
    IF $row.artifact!=NONE {
        LET $artifact=SELECT * FROM ONLY type::record('canonical_artifacts',$row.artifact);
        IF $artifact=NONE OR $artifact.revision!=$row.base_revision OR $artifact.kind!='project-draft' { THROW 'PSE_REFUSAL:project_source_unavailable'; };
        IF $obligation=NONE OR $obligation.artifact!=$row.artifact OR $obligation.owner_kind!='project' OR $obligation.owner!=$row.draft { THROW 'PSE_REFUSAL:project_draft_changed'; };
        fn::pse_artifact_v1::attach($expiry,$row.artifact,$obligation,true);
    };
    fn::pse_project_v1::root($expiry,$row.base_revision,'project-draft-version:'+$row.key);
    CREATE ONLY type::record('canonical_project_draft_versions',$row.key) CONTENT $row;
    UPSERT ONLY type::record('canonical_project_drafts',$row.draft) CONTENT {key:$row.draft,project:$row.project,branch:$row.branch,generation:$row.generation,version:$row.key,deleted:false};
    LET $project=SELECT * FROM ONLY type::record('canonical_projects',$row.project);
    LET $ack=CREATE ONLY type::record('canonical_project_operations',$operation) CONTENT {key:$operation,kind:'draft',project:$row.project,branch:$row.branch,request:$request,generation:$project.generation};
    fn::pse_execution_v1::deadline($expiry); RETURN $ack;
};
DEFINE FUNCTION fn::pse_project_v1::research($expiry:int,$operation:string,$request:bytes,$row:object,$project_generation:decimal,$obligation:option<object>) -> object {
    LET $ack=fn::pse_project_v1::ack($expiry,$operation,$request); IF $ack!=NONE { RETURN $ack; };
    fn::pse_project_v1::project($expiry,$row.project,$project_generation);
    fn::pse_project_v1::root($expiry,$row.revision,'project-research:'+$row.key);
    IF ($row.run=NONE)!=($row.attempt=NONE) { THROW 'PSE_REFUSAL:project_research_reference_differs'; };
    IF $row.run!=NONE {
        LET $attempt=fn::pse_history_v1::read_attempt($expiry,$row.attempt);
        LET $run=fn::pse_history_v1::read_run($expiry,$row.run);
        fn::pse_execution_v1::result_creator($expiry,$row.run);
        IF $attempt=NONE OR $run=NONE OR $attempt.run!=$row.run OR $run.revision!=$row.revision OR $attempt.phase NOT IN ['terminal','terminal_compacted'] OR $attempt.closed_manifest=NONE { THROW 'PSE_REFUSAL:project_research_reference_differs'; };
        LET $manifest=fn::pse_history_v1::read_manifest($expiry,$attempt.closed_manifest);
        IF $manifest=NONE OR $manifest.attempt!=$row.attempt OR $manifest.generation!=$attempt.generation { THROW 'PSE_REFUSAL:project_research_reference_differs'; };
        fn::pse_history_v1::retain($expiry,'project-research:'+$row.key,'run',$row.run,'audit',$row.project);
    };
    IF $row.artifact!=NONE {
        LET $artifact=SELECT * FROM ONLY type::record('canonical_artifacts',$row.artifact);
        IF $artifact=NONE OR $artifact.revision!=$row.revision { THROW 'PSE_REFUSAL:project_research_reference_differs'; };
        IF $obligation=NONE OR $obligation.artifact!=$row.artifact OR $obligation.owner_kind!='project' OR $obligation.owner!=$row.key { THROW 'PSE_REFUSAL:project_research_reference_differs'; };
        fn::pse_artifact_v1::attach($expiry,$row.artifact,$obligation,true);
    };
    CREATE ONLY type::record('canonical_research_references',$row.key) CONTENT $row;
    LET $project=SELECT * FROM ONLY type::record('canonical_projects',$row.project);
    LET $ack=CREATE ONLY type::record('canonical_project_operations',$operation) CONTENT {key:$operation,kind:'research',project:$row.project,request:$request,generation:$project.generation};
    fn::pse_execution_v1::deadline($expiry); RETURN $ack;
};
DEFINE FUNCTION fn::pse_project_v1::navigate($expiry:int,$operation:string,$request:bytes,$project:string,$generation:decimal,$action:object) -> object {
    LET $old=fn::pse_project_v1::ack($expiry,$operation,$request); IF $old!=NONE {RETURN $old;};
    LET $p=SELECT * FROM ONLY type::record('canonical_projects',$project) FOR UPDATE;
    IF $p=NONE OR $p.generation!=$generation OR ($p.deleted AND $action.kind!='project_visibility') {THROW 'PSE_REFUSAL:project_generation_changed';};
    IF $action.kind='project_title' {UPDATE ONLY type::record('canonical_projects',$project) SET title=$action.name;}
    ELSE IF $action.kind='project_visibility' {UPDATE ONLY type::record('canonical_projects',$project) SET deleted=$action.deleted;}
    ELSE IF $action.kind='branch_name' {
        LET $branch=SELECT * FROM ONLY type::record('canonical_project_branches',$action.key) FOR UPDATE;
        IF $branch=NONE OR $branch.project!=$project {THROW 'PSE_REFUSAL:project_branch_changed';};
        UPDATE ONLY type::record('canonical_project_branches',$action.key) SET name=$action.name,generation+=1dec;
    } ELSE IF $action.kind='bookmark' {
        fn::pse_project_v1::root($expiry,$action.revision,'project-bookmark:'+$action.key);
        CREATE ONLY type::record('canonical_project_bookmarks',$action.key) CONTENT {key:$action.key,project:$project,name:$action.name,revision:$action.revision};
    } ELSE IF $action.kind='savepoint' {
        LET $head=SELECT * FROM ONLY type::record('canonical_project_drafts',$action.draft) FOR UPDATE;
        LET $version=SELECT * FROM ONLY type::record('canonical_project_draft_versions',$action.version);
        IF $head=NONE OR $version=NONE OR $head.project!=$project OR $version.draft!=$head.key OR $head.generation!=$action.generation OR $head.version!=$version.key {THROW 'PSE_REFUSAL:project_draft_changed';};
        CREATE ONLY type::record('canonical_project_savepoints',$action.key) CONTENT {key:$action.key,project:$project,draft:$head.key,version:$version.key,name:$action.name,deleted:false};
    } ELSE IF $action.kind='draft_visibility' {
        LET $head=SELECT * FROM ONLY type::record('canonical_project_drafts',$action.key) FOR UPDATE;
        IF $head=NONE OR $head.project!=$project OR $head.generation!=$action.generation {THROW 'PSE_REFUSAL:project_draft_changed';};
        UPDATE ONLY type::record('canonical_project_drafts',$action.key) SET deleted=$action.deleted,generation+=1dec;
    } ELSE IF $action.kind='savepoint_visibility' {
        LET $point=SELECT * FROM ONLY type::record('canonical_project_savepoints',$action.key);
        IF $point=NONE OR $point.project!=$project {THROW 'PSE_REFUSAL:project_draft_changed';};
        UPDATE ONLY type::record('canonical_project_savepoints',$action.key) SET deleted=$action.deleted;
    } ELSE IF $action.kind='restore' {
        LET $point=SELECT * FROM ONLY type::record('canonical_project_savepoints',$action.key);
        LET $head=SELECT * FROM ONLY type::record('canonical_project_drafts',$action.draft) FOR UPDATE;
        IF $point=NONE OR $head=NONE OR $point.deleted OR $point.project!=$project OR $point.draft!=$head.key OR $head.project!=$project OR $head.generation!=$action.generation {THROW 'PSE_REFUSAL:project_draft_changed';};
        UPDATE ONLY type::record('canonical_project_drafts',$head.key) SET version=$point.version,deleted=false,generation+=1dec;
    } ELSE {THROW 'PSE_REFUSAL:project_metadata_bound';};
    LET $new=UPDATE ONLY type::record('canonical_projects',$project) SET generation+=1dec;
    LET $ack=CREATE ONLY type::record('canonical_project_operations',$operation) CONTENT {key:$operation,kind:'navigate',project:$project,request:$request,generation:$new.generation};
    fn::pse_execution_v1::deadline($expiry);RETURN $ack;
};
DEFINE FUNCTION fn::pse_project_v1::diagnostic($expiry:int,$operation:string,$version:string,$message:string,$admitted:bool) -> object {
    IF string::len($message)>65536 {THROW 'PSE_REFUSAL:project_metadata_bound';};
    LET $v=SELECT * FROM ONLY type::record('canonical_project_draft_versions',$version);
    IF $v=NONE {THROW 'PSE_REFUSAL:project_draft_changed';};
    LET $old=SELECT * FROM ONLY type::record('canonical_draft_diagnostics',$operation);
    IF $old!=NONE {IF $old.version!=$version OR $old.message!=$message OR $old.admitted!=$admitted {THROW 'PSE_REFUSAL:project_operation_identity_changed';};RETURN $old;};
    fn::pse_execution_v1::deadline($expiry);
    RETURN CREATE ONLY type::record('canonical_draft_diagnostics',$operation) CONTENT {key:$operation,version:$version,message:$message,admitted:$admitted};
};

DEFINE FUNCTION fn::pse_context_v1::available($expiry:int,$revision:string) -> bool {
    fn::pse_execution_v1::deadline($expiry);
    LET $r=SELECT * FROM ONLY type::record('canonical_revisions',$revision);
    IF $r=NONE {THROW 'PSE_REFUSAL:project_context_unavailable';};
    LET $lost=SELECT key FROM canonical_reclaimed_ranges WHERE problem=$r.problem AND from_sequence<=$r.sequence AND to_sequence>$r.sequence LIMIT 1;
    IF array::len($lost)!=0 {THROW 'PSE_REFUSAL:project_context_unavailable';}; RETURN true;
};
DEFINE FUNCTION fn::pse_context_v1::append($expiry:int,$row:object,$generation:decimal) -> object {
    fn::pse_execution_v1::deadline($expiry);
    LET $old=SELECT * FROM ONLY type::record('canonical_project_contexts',$row.key);
    IF $old!=NONE { IF $old.request!=$row.request {THROW 'PSE_REFUSAL:project_operation_identity_changed';}; RETURN $old; };
    fn::pse_project_v1::project($expiry,$row.project,$generation);
    LET $p=SELECT * FROM ONLY type::record('canonical_projects',$row.project);
    IF $p.deleted {THROW 'PSE_REFUSAL:project_context_unavailable';};
    IF $row.effective_to_us!=NONE AND $row.effective_to_us<=$row.effective_from_us {THROW 'PSE_REFUSAL:project_context_invalid';};
    IF $row.corrects!=NONE {
        LET $parent=SELECT * FROM ONLY type::record('canonical_project_contexts',$row.corrects);
        IF $parent=NONE OR $parent.project!=$row.project OR $parent.scope!=$row.scope {THROW 'PSE_REFUSAL:project_context_invalid';};
        LET $ancestors=SELECT * FROM canonical_context_ancestry WITH INDEX project_context_ancestor WHERE descendant=$row.corrects LIMIT 257;
        IF array::len($ancestors)>=256 {THROW 'PSE_REFUSAL:project_context_bound';};
        FOR $a IN $ancestors { LET $edge=<string>string::len($row.key)+':'+$row.key+$a.ancestor; CREATE ONLY type::record('canonical_context_ancestry',$edge) CONTENT {key:$edge,descendant:$row.key,ancestor:$a.ancestor};};
        LET $edge=<string>string::len($row.key)+':'+$row.key+$row.corrects; CREATE ONLY type::record('canonical_context_ancestry',$edge) CONTENT {key:$edge,descendant:$row.key,ancestor:$row.corrects};
    } ELSE {IF $row.deleted {THROW 'PSE_REFUSAL:project_context_invalid';};};
    fn::pse_project_v1::root($expiry,$row.revision,'project-context:'+$row.key);
    fn::pse_project_v1::root($expiry,$row.physical_revision,'project-context-physical:'+$row.key);
    LET $journal=SELECT * FROM ONLY type::record('canonical_context_journals',$row.project) FOR UPDATE;
    LET $sequence=($journal.sequence ?? 0dec)+1dec;
    UPSERT ONLY type::record('canonical_context_journals',$row.project) CONTENT {key:$row.project,sequence:$sequence};
    LET $new=CREATE ONLY type::record('canonical_project_contexts',$row.key) CONTENT object::extend($row,{recorded_sequence:$sequence});
    fn::pse_execution_v1::deadline($expiry); RETURN $new;
};
DEFINE FUNCTION fn::pse_context_v1::select($expiry:int,$project:string,$scope:string,$effective:int,$cut:decimal) -> option<object> {
    fn::pse_execution_v1::deadline($expiry);
    LET $journal=SELECT * FROM ONLY type::record('canonical_context_journals',$project);
    IF $cut>($journal.sequence ?? 0dec) {THROW 'PSE_REFUSAL:project_context_invalid';};
    LET $candidates=SELECT * FROM canonical_project_contexts WITH INDEX project_context_scope WHERE project=$project AND scope=$scope AND recorded_sequence<=$cut AND effective_from_us<=$effective AND (effective_to_us=NONE OR effective_to_us>$effective) LIMIT 257;
    IF array::len($candidates)>256 {THROW 'PSE_REFUSAL:project_context_bound';};
    LET $superseded=SELECT VALUE ancestor FROM canonical_context_ancestry WITH INDEX project_context_ancestor WHERE descendant IN $candidates.key LIMIT 65537;
    IF array::len($superseded)>65536 {THROW 'PSE_REFUSAL:project_context_bound';};
    LET $selected=$candidates.filter(|$c| $c.key NOT IN $superseded);
    IF array::len($selected)>1 {THROW 'PSE_REFUSAL:project_context_ambiguous';};
    IF array::len($selected)=0 OR $selected[0].deleted {RETURN NONE;};
    RETURN $selected[0];
};

DEFINE FUNCTION fn::pse_files_v1::admission($expiry:int,$incarnation:string,$collecting:bool) -> object {
    fn::pse_execution_v1::deadline($expiry);
    LET $gate=SELECT * FROM ONLY canonical_file_admission:current FOR UPDATE;
    IF $gate=NONE OR $gate.storage_incarnation!=$incarnation OR ($collecting AND $gate.gc_frozen) OR (!$collecting AND $gate.frozen) { THROW 'PSE_REFUSAL:file_admission_closed_or_incarnation_differs'; };
    RETURN $gate;
};
DEFINE FUNCTION fn::pse_files_v1::owner($expiry:int,$key:string,$incarnation:string) -> object {
    fn::pse_files_v1::admission($expiry,$incarnation,false);
    LET $owner=SELECT * FROM ONLY type::record('canonical_file_owners',$key) FOR UPDATE;
    IF $owner=NONE OR $owner.drained OR $owner.storage_incarnation!=$incarnation OR $owner.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store { THROW 'PSE_REFUSAL:file_actual_owner_unavailable'; };
    RETURN $owner;
};
DEFINE FUNCTION fn::pse_files_v1::register_owner($expiry:int,$row:object) -> object {
    fn::pse_files_v1::admission($expiry,$row.storage_incarnation,false);
    IF $row.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store OR $row.drained OR $row.pid=0dec OR string::len($row.boot)=0 OR string::len($row.start)=0 OR string::len($row.pid_namespace)=0 { THROW 'PSE_REFUSAL:file_process_identity_incomplete'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_file_owners',$row.key) FOR UPDATE;
    IF $old!=NONE { IF object::remove($old,'id')!=$row { THROW 'PSE_REFUSAL:file_owner_identity_reused'; }; RETURN $old; };
    RETURN CREATE ONLY type::record('canonical_file_owners',$row.key) CONTENT $row;
};
DEFINE FUNCTION fn::pse_files_v1::reserve($expiry:int,$row:object,$run:option<string>,$attempt:option<string>,$generation:option<decimal>) -> object {
    fn::pse_files_v1::owner($expiry,$row.owner,$row.storage_incarnation);
    LET $same=SELECT * FROM canonical_file_instances WHERE intent=$row.intent LIMIT 1;
    IF array::len($same)!=0 {
        LET $old=SELECT * FROM ONLY type::record('canonical_file_instances',$same[0].key) FOR UPDATE;
        IF $old.request_digest!=$row.request_digest OR $old.owner_kind!=$row.owner_kind OR $old.selection!=$row.selection OR $old.storage_incarnation!=$row.storage_incarnation OR $old.state IN ['collecting','collected','abandoned'] { THROW 'PSE_REFUSAL:original_file_intent_differs_or_settled'; };
        RETURN $old;
    };
    IF $row.owner_kind='result' {
        IF $run=NONE OR $attempt=NONE OR $generation=NONE OR $row.selection!=$attempt { THROW 'PSE_REFUSAL:result_file_original_fence_missing'; };
        LET $writer=fn::pse_execution_v1::writer($expiry,$run,$attempt,$generation,$row.intent,'append');
        IF $writer.pse_writer!='admitted' { RETURN $writer; };
        IF ($writer.attempt.phase!='ingesting') { THROW 'PSE_REFUSAL:result_file_writer_refused'; };
    } ELSE IF $row.owner_kind='artifact' {
        LET $artifact=SELECT * FROM ONLY type::record('canonical_artifacts',$row.selection) FOR UPDATE;
        IF $artifact=NONE OR $artifact.retiring OR $artifact.active OR $artifact.creation_expires_at<=time::micros() { THROW 'PSE_REFUSAL:artifact_file_original_creation_unavailable'; };
    } ELSE { THROW 'PSE_REFUSAL:file_intent_owner_kind'; };
    IF $row.state!='pending' OR $row.digest!='' OR $row.payload_bytes!=0dec OR $row.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store { THROW 'PSE_REFUSAL:file_original_intent_malformed'; };
    RETURN CREATE ONLY type::record('canonical_file_instances',$row.key) CONTENT $row;
};
// Custody recovery changes no original occurrence, writer generation, deadline,
// request or physical instance. Only authenticated actual owner drain permits it.
DEFINE FUNCTION fn::pse_files_v1::recover_intent($expiry:int,$expected:object,$new_owner:string,$incarnation:string) -> object {
    fn::pse_files_v1::owner($expiry,$new_owner,$incarnation);
    LET $file=SELECT * FROM ONLY type::record('canonical_file_instances',$expected.instance) FOR UPDATE;
    IF $file=NONE OR $file.intent!=$expected.intent OR $file.request_digest!=$expected.request_digest OR $file.storage_incarnation!=$incarnation OR $file.state IN ['abandoned','collecting','collected'] { THROW 'PSE_REFUSAL:original_file_recovery_intent_differs_or_settled'; };
    IF $file.owner=$new_owner { RETURN $file; };
    IF $file.owner!=$expected.owner { THROW 'PSE_REFUSAL:original_file_recovery_custody_differs'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_file_owners',$file.owner) FOR UPDATE;
    IF $old=NONE OR !$old.drained { THROW 'PSE_REFUSAL:original_file_owner_has_no_authenticated_drain_run_recover_file_owners_state_path'; };
    RETURN UPDATE ONLY type::record('canonical_file_instances',$file.key) SET owner=$new_owner;
};
// Called while the unique OS instance lock is held, before any physical
// mutation. This fences late original callers after irreversible collection.
DEFINE FUNCTION fn::pse_files_v1::intent_open($expiry:int,$expected:object,$owner:string,$incarnation:string) -> object {
    fn::pse_files_v1::owner($expiry,$owner,$incarnation);
    LET $file=SELECT * FROM ONLY type::record('canonical_file_instances',$expected.instance) FOR UPDATE;
    IF $file=NONE OR $file.intent!=$expected.intent OR $file.request_digest!=$expected.request_digest OR $file.owner!=$owner OR $file.storage_incarnation!=$incarnation OR $file.state NOT IN ['pending','sealed','attached'] { THROW 'PSE_REFUSAL:original_physical_intent_is_settled_or_differs'; };
    RETURN $file;
};
DEFINE FUNCTION fn::pse_files_v1::seal($expiry:int,$key:string,$owner:string,$incarnation:string,$descriptor:object) -> object {
    fn::pse_files_v1::owner($expiry,$owner,$incarnation);
    LET $row=SELECT * FROM ONLY type::record('canonical_file_instances',$key) FOR UPDATE;
    IF $row=NONE OR $row.owner!=$owner OR $row.storage_incarnation!=$incarnation OR $descriptor.instance!=$key OR $row.state NOT IN ['pending','sealed','attached'] { THROW 'PSE_REFUSAL:file_sealing_original_intent_unavailable'; };
    IF string::len($descriptor.digest)!=64 OR $descriptor.bytes=0dec OR $descriptor.bytes>33554432dec OR $descriptor.encoding NOT IN ['arrow-ipc-file','opaque-json','opaque-bytes'] OR ($descriptor.encoding='arrow-ipc-file' AND $descriptor.batch_count=0dec) OR ($descriptor.encoding!='arrow-ipc-file' AND $descriptor.batch_count!=0dec) { THROW 'PSE_REFUSAL:sealed_file_extent_or_encoding_invalid'; };
    IF $row.state!='pending' {
        IF $row.digest!=$descriptor.digest OR $row.payload_bytes!=$descriptor.bytes OR $row.encoding!=$descriptor.encoding OR $row.batch_count!=$descriptor.batch_count OR $row.schema!=$descriptor.schema OR $row.interpretation!=$descriptor.interpretation { THROW 'PSE_REFUSAL:sealed_file_immutable_descriptor_differs'; };
        RETURN $row;
    };
    RETURN UPDATE ONLY type::record('canonical_file_instances',$key) SET digest=$descriptor.digest,payload_bytes=$descriptor.bytes,encoding=$descriptor.encoding,batch_count=$descriptor.batch_count,schema=$descriptor.schema,interpretation=$descriptor.interpretation,state='sealed';
};
DEFINE FUNCTION fn::pse_files_v1::attach($expiry:int,$batch:object,$kind:string,$selection:string,$borrower:string) -> bool {
    LET $file=SELECT * FROM ONLY type::record('canonical_file_instances',$batch.file_instance) FOR UPDATE;
    IF $file=NONE { THROW 'PSE_REFUSAL:sealed_file_instance_unavailable'; };
    fn::pse_files_v1::admission($expiry,$file.storage_incarnation,false);
    IF $file.state NOT IN ['sealed','attached'] OR $file.digest!=$batch.file_digest OR $file.payload_bytes!=$batch.payload_bytes OR $file.encoding!=$batch.encoding OR $file.schema!=$batch.schema OR ($file.encoding='arrow-ipc-file' AND $batch.file_batch_index>=$file.batch_count) OR ($file.encoding!='arrow-ipc-file' AND $batch.file_batch_index!=0dec) { THROW 'PSE_REFUSAL:logical_batch_sealed_file_binding_differs'; };
    IF $file.owner_kind!=$kind OR $file.selection!=$selection { THROW 'PSE_REFUSAL:file_original_intent_selected_another_owner'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_file_borrowers',$borrower) FOR UPDATE;
    IF $old!=NONE AND ($old.released OR $old.instance!=$file.key OR $old.owner_kind!=$kind OR $old.owner!=$selection) { THROW 'PSE_REFUSAL:file_borrower_identity_released_or_reused'; };
    IF $old=NONE { CREATE ONLY type::record('canonical_file_borrowers',$borrower) SET key=$borrower,instance=$file.key,owner_kind=$kind,owner=$selection,released=false; };
    UPDATE ONLY type::record('canonical_file_instances',$file.key) SET state='attached';
    RETURN true;
};
DEFINE FUNCTION fn::pse_files_v1::release_borrower($expiry:int,$key:string) -> bool {
    LET $borrower=SELECT * FROM ONLY type::record('canonical_file_borrowers',$key) FOR UPDATE;
    IF $borrower=NONE { THROW 'PSE_REFUSAL:original_file_borrower_unavailable'; };
    SELECT * FROM ONLY type::record('canonical_file_instances',$borrower.instance) FOR UPDATE;
    UPDATE ONLY type::record('canonical_file_borrowers',$key) SET released=true;
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_files_v1::ticket($expiry:int,$row:object) -> object {
    fn::pse_files_v1::owner($expiry,$row.owner,$row.storage_incarnation);
    LET $pin=SELECT * FROM ONLY type::record('canonical_protections',$row.key) FOR UPDATE;
    IF $pin=NONE OR $pin.released OR $pin.expires_at<=time::micros() OR $row.released { THROW 'PSE_REFUSAL:read_ticket_original_admission_unavailable'; };
    IF $row.kind='result' {
        fn::pse_execution_v1::result_creator($expiry,$row.run);
        LET $selection=SELECT * FROM ONLY type::record('canonical_result_protections',$row.key) FOR UPDATE;
        IF $selection=NONE OR $selection.run!=$row.run OR $selection.attempt!=$row.attempt OR $selection.manifest!=$row.manifest OR $row.selection!=$row.manifest { THROW 'PSE_REFUSAL:read_ticket_exact_manifest_differs'; };
    } ELSE IF $row.kind='artifact' {
        LET $artifact=fn::pse_artifact_v1::available($expiry,$row.selection);
        LET $read=SELECT * FROM ONLY type::record('canonical_artifact_reads',$row.key) FOR UPDATE;
        IF $read=NONE OR $read.artifact!=$row.selection OR $artifact.revision!=$pin.revision { THROW 'PSE_REFUSAL:artifact_ticket_selection_differs'; };
    } ELSE { THROW 'PSE_REFUSAL:read_ticket_kind'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_manifest_tickets',$row.key) FOR UPDATE;
    IF $old!=NONE { IF object::remove($old,'id')!=$row { THROW 'PSE_REFUSAL:read_ticket_identity_reused'; }; RETURN $old; };
    RETURN CREATE ONLY type::record('canonical_manifest_tickets',$row.key) CONTENT $row;
};
DEFINE FUNCTION fn::pse_files_v1::ticket_open($expiry:int,$key:string) -> bool {
    LET $ticket=SELECT * FROM ONLY type::record('canonical_manifest_tickets',$key) FOR UPDATE;
    IF $ticket=NONE OR $ticket.released { RETURN false; };
    LET $owner=SELECT * FROM ONLY type::record('canonical_file_owners',$ticket.owner) FOR UPDATE;
    LET $gate=SELECT * FROM ONLY canonical_file_admission:current FOR UPDATE;
    IF $owner=NONE OR $gate=NONE { THROW 'PSE_REFUSAL:read_ticket_actual_process_owner_unavailable'; };
    IF $owner.drained { RETURN false; };
    IF $ticket.storage_incarnation!=$gate.storage_incarnation OR $owner.storage_incarnation!=$gate.storage_incarnation { THROW 'PSE_REFUSAL:read_ticket_actual_process_incarnation_unavailable'; };
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_files_v1::release_ticket($expiry:int,$key:string) -> bool {
    LET $ticket=SELECT * FROM ONLY type::record('canonical_manifest_tickets',$key) FOR UPDATE;
    IF $ticket!=NONE { UPDATE ONLY type::record('canonical_manifest_tickets',$key) SET released=true; };
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_files_v1::settle_intent($expiry:int,$expected:object,$incarnation:string) -> bool {
    fn::pse_files_v1::admission($expiry,$incarnation,false);
    LET $file=SELECT * FROM ONLY type::record('canonical_file_instances',$expected.instance) FOR UPDATE;
    IF $file=NONE OR $file.intent!=$expected.intent OR $file.request_digest!=$expected.request_digest OR $file.owner!=$expected.owner OR $file.storage_incarnation!=$incarnation { THROW 'PSE_REFUSAL:file_settlement_requires_exact_original_intent'; };
    IF $file.state IN ['attached','abandoned','collecting','collected'] { RETURN $file.state!='attached'; };
    LET $owner=SELECT * FROM ONLY type::record('canonical_file_owners',$file.owner) FOR UPDATE;
    IF $owner=NONE OR !$owner.drained { THROW 'PSE_REFUSAL:file_settlement_requires_authenticated_actual_owner_drain'; };
    IF $file.owner_kind='result' {
        LET $attempt=SELECT * FROM ONLY type::record('canonical_attempts',$file.selection) FOR UPDATE;
        IF $attempt=NONE { THROW 'PSE_REFUSAL:original_result_file_attempt_settlement_unavailable'; };
        fn::pse_execution_v1::touch($expiry,'execution-run:'+$attempt.run);
        IF ($attempt.phase='ingesting') AND $attempt.expires_at>time::micros() { RETURN false; };
    } ELSE IF $file.owner_kind='artifact' {
        LET $artifact=SELECT * FROM ONLY type::record('canonical_artifacts',$file.selection) FOR UPDATE;
        IF $artifact!=NONE AND !$artifact.retiring AND $artifact.creation_expires_at>time::micros() { RETURN false; };
        IF $artifact=NONE { LET $parts=string::split($file.selection,':'); LET $guards=SELECT artifact_creation_closed_through FROM canonical_guards WHERE incarnation=$parts[1] LIMIT 1; IF array::len($guards)!=1 OR ($guards[0].artifact_creation_closed_through ?? 0dec)< <decimal>$parts[3] { THROW 'PSE_REFUSAL:original_artifact_file_settlement_floor_unavailable'; }; };
    } ELSE { THROW 'PSE_REFUSAL:original_file_settlement_owner_kind'; };
    UPDATE ONLY type::record('canonical_file_instances',$file.key) SET state='abandoned';
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_files_v1::collect($expiry:int,$key:string,$incarnation:string) -> object {
    fn::pse_files_v1::admission($expiry,$incarnation,true);
    LET $file=SELECT * FROM ONLY type::record('canonical_file_instances',$key) FOR UPDATE;
    IF $file=NONE OR $file.storage_incarnation!=$incarnation { THROW 'PSE_REFUSAL:file_collection_exact_placement_unavailable'; };
    IF $file.state='collected' { RETURN $file; };
    IF $file.state IN ['pending','sealed'] { THROW 'PSE_REFUSAL:file_publication_remains_unresolved'; };
    LET $borrowers=SELECT key FROM canonical_file_borrowers WHERE instance=$key AND released=false LIMIT 1;
    IF array::len($borrowers)!=0 { THROW 'PSE_REFUSAL:file_still_has_independent_borrowers'; };
    RETURN UPDATE ONLY type::record('canonical_file_instances',$key) SET state='collecting';
};
DEFINE FUNCTION fn::pse_files_v1::collected($expiry:int,$key:string,$incarnation:string) -> bool {
    fn::pse_files_v1::admission($expiry,$incarnation,true);
    LET $file=SELECT * FROM ONLY type::record('canonical_file_instances',$key) FOR UPDATE;
    IF $file=NONE OR $file.storage_incarnation!=$incarnation OR $file.state NOT IN ['collecting','collected'] { THROW 'PSE_REFUSAL:file_collection_original_intent_unavailable'; };
    UPDATE ONLY type::record('canonical_file_instances',$key) SET state='collected';
    RETURN true;
};
DEFINE FUNCTION fn::pse_files_v1::freeze($expiry:int,$incarnation:string) -> bool {
    LET $gate=SELECT * FROM ONLY canonical_file_admission:current FOR UPDATE;
    IF $gate=NONE OR $gate.storage_incarnation!=$incarnation { THROW 'PSE_REFUSAL:file_freeze_incarnation_differs'; };
    UPDATE ONLY canonical_file_admission:current SET frozen=true,gc_frozen=true;
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_files_v1::thaw($expiry:int,$incarnation:string) -> bool {
    LET $gate=SELECT * FROM ONLY canonical_file_admission:current FOR UPDATE;
    IF $gate=NONE OR $gate.storage_incarnation!=$incarnation { THROW 'PSE_REFUSAL:file_thaw_incarnation_differs'; };
    UPDATE ONLY canonical_file_admission:current SET frozen=false,gc_frozen=false;
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_files_v1::drain_owner($expiry:int,$expected:object) -> bool {
    LET $owner=SELECT * FROM ONLY type::record('canonical_file_owners',$expected.key) FOR UPDATE;
    IF $owner=NONE {
        // Local cancellation can precede registration dispatch. Fence that
        // original key permanently before any delayed create can acquire it.
        LET $gate=SELECT * FROM ONLY canonical_file_admission:current FOR UPDATE;
        LET $marker=SELECT * FROM ONLY canonical_interpretations:current;
        IF $gate=NONE OR $marker=NONE OR $expected.storage_incarnation!=$gate.storage_incarnation OR $expected.storage_incarnation!=$marker.payload_incarnation OR $expected.issuing_store!=$marker.issuing_store OR $expected.drained OR $expected.pid=0dec OR string::len($expected.key)!=36 OR string::len($expected.boot)=0 OR string::len($expected.start)=0 OR string::len($expected.pid_namespace)=0 { THROW 'PSE_REFUSAL:file_pending_owner_drain_original_identity_unavailable'; };
        CREATE ONLY type::record('canonical_file_owners',$expected.key) CONTENT object::extend($expected,{drained:true});
    } ELSE {
        IF object::remove($owner,['id','drained'])!=object::remove($expected,['id','drained']) { THROW 'PSE_REFUSAL:file_owner_drain_exact_identity_differs'; };
        UPDATE ONLY type::record('canonical_file_owners',$expected.key) SET drained=true;
    };
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};

DEFINE FUNCTION fn::pse_maintenance_v1::current($expiry:int) -> option<object> {
    fn::pse_execution_v1::deadline($expiry);
    LET $owner=SELECT * FROM ONLY canonical_maintenance_operations:current;
    RETURN IF $owner=NONE { NONE } ELSE { {operation:$owner.operation,generation:$owner.generation,phase:$owner.phase} };
};
DEFINE FUNCTION fn::pse_maintenance_v1::claim($expiry:int,$operation:string,$generation:string,$phase:string,$source:string,$target:string,$previous:option<object>) -> object {
    fn::pse_execution_v1::deadline($expiry);
    LET $old=SELECT * FROM ONLY canonical_maintenance_operations:current FOR UPDATE;
    IF $old!=NONE AND ($previous=NONE OR $old.generation!=$previous.generation OR $old.operation!=$previous.operation OR $old.phase!=$previous.phase) { THROW 'PSE_REFUSAL:maintenance_generation_changed'; };
    IF $old=NONE AND $previous!=NONE { THROW 'PSE_REFUSAL:maintenance_generation_changed'; };
    IF string::len($operation)=0 OR string::len($generation)=0 OR string::len($phase)=0 OR string::len($source)=0 OR string::len($target)=0 { THROW 'PSE_REFUSAL:maintenance_original_inputs_differ'; };
    LET $gate=SELECT * FROM ONLY canonical_file_admission:current FOR UPDATE;
    IF $gate=NONE OR !$gate.frozen OR !$gate.gc_frozen OR $gate.storage_incarnation NOT IN [$source,$target] { THROW 'PSE_REFUSAL:maintenance_frozen_placement_required'; };
    LET $resume=$old!=NONE AND $old.operation=$operation AND $old.phase=$phase AND $old.source=$source AND $old.target=$target;
    UPSERT canonical_maintenance_operations:current SET key='current',operation=$operation,generation=$generation,phase=$phase,source=$source,target=$target,kind='generation',after='',next=IF $resume { $old.next } ELSE { '' },count=0dec,complete=false;
    fn::pse_execution_v1::deadline($expiry);
    RETURN {operation:$operation,generation:$generation,phase:$phase};
};
DEFINE FUNCTION fn::pse_maintenance_v1::guard($expiry:int,$operation:string,$generation:string,$phase:string) -> object {
    fn::pse_execution_v1::deadline($expiry);
    LET $owner=SELECT * FROM ONLY canonical_maintenance_operations:current FOR UPDATE;
    IF $owner=NONE OR $owner.operation!=$operation OR $owner.generation!=$generation OR $owner.phase!=$phase { THROW 'PSE_REFUSAL:maintenance_generation_changed'; };
    RETURN $owner;
};
DEFINE FUNCTION fn::pse_maintenance_v1::frozen($owner:object) -> object {
    LET $gate=SELECT * FROM ONLY canonical_file_admission:current FOR UPDATE;
    IF $gate=NONE OR !$gate.frozen OR !$gate.gc_frozen OR $gate.storage_incarnation NOT IN [$owner.source,$owner.target] { THROW 'PSE_REFUSAL:maintenance_frozen_placement_required'; };
    RETURN $gate;
};
DEFINE FUNCTION fn::pse_maintenance_v1::unprotected($expiry:int) -> bool {
    LET $pins=SELECT key FROM canonical_protections WHERE !released AND (expires_at>time::micros() OR fn::pse_files_v1::ticket_open($expiry,key)) LIMIT 1;
    IF array::len($pins)!=0 { THROW 'PSE_REFUSAL:maintenance_protected_source'; };
    RETURN true;
};
DEFINE FUNCTION fn::pse_maintenance_v1::page($expiry:int,$operation:string,$generation:string,$phase:string,$kind:string,$after:string) -> object {
    LET $owner=fn::pse_maintenance_v1::guard($expiry,$operation,$generation,$phase);
    fn::pse_maintenance_v1::frozen($owner);
    IF $kind NOT IN ['rotate','rehome'] { THROW 'PSE_REFUSAL:maintenance_original_inputs_differ'; };
    LET $key=$operation+':'+$kind+':'+$after;
    LET $prior=SELECT * FROM ONLY type::record('canonical_maintenance_operations',$key) FOR UPDATE;
    IF $prior!=NONE {
        IF $prior.operation!=$operation OR $prior.phase!=$phase OR $prior.source!=$owner.source OR $prior.target!=$owner.target OR $prior.kind!=$kind OR $prior.after!=$after { THROW 'PSE_REFUSAL:maintenance_original_inputs_differ'; };
        RETURN {count:<int>$prior.count,after:$prior.next,complete:$prior.complete};
    };
    IF $owner.next!=$after { THROW 'PSE_REFUSAL:maintenance_original_inputs_differ'; };
    LET $rows=IF $kind='rotate' {
        fn::pse_maintenance_v1::unprotected($expiry);
        SELECT * FROM canonical_guards WHERE string::starts_with(key,'retention:') AND key>$after ORDER BY key LIMIT 64;
    } ELSE {
        LET $owners=SELECT key FROM canonical_file_owners WHERE !drained LIMIT 1;
        IF array::len($owners)!=0 { THROW 'PSE_REFUSAL:maintenance_protected_source'; };
        SELECT * FROM canonical_file_instances WHERE key>$after ORDER BY key LIMIT 64;
    };
    FOR $row IN $rows {
        IF $kind='rotate' { UPDATE ONLY $row.id SET incarnation=<string>rand::uuid::v4(),generation=generation+1dec RETURN NONE; }
        ELSE {
            IF $row.storage_incarnation NOT IN [$owner.source,$owner.target] { THROW 'PSE_REFUSAL:maintenance_original_inputs_differ'; };
            UPDATE ONLY $row.id SET storage_incarnation=$owner.target RETURN NONE;
        };
    };
    LET $next=array::last($rows.key) ?? $after;
    LET $count=array::len($rows);
    CREATE ONLY type::record('canonical_maintenance_operations',$key) SET key=$key,operation=$operation,generation=$generation,phase=$phase,source=$owner.source,target=$owner.target,kind=$kind,after=$after,next=$next,count=<decimal>$count,complete=$count=0;
    UPDATE ONLY canonical_maintenance_operations:current SET next=$next,kind=$kind,complete=$count=0 RETURN NONE;
    fn::pse_execution_v1::deadline($expiry);
    RETURN {count:$count,after:$next,complete:$count=0};
};
DEFINE FUNCTION fn::pse_maintenance_v1::rehome_complete($expiry:int,$operation:string,$generation:string,$phase:string) -> bool {
    LET $owner=fn::pse_maintenance_v1::guard($expiry,$operation,$generation,$phase);
    fn::pse_maintenance_v1::frozen($owner);
    LET $owners=SELECT key FROM canonical_file_owners WHERE !drained LIMIT 1;
    IF array::len($owners)!=0 { THROW 'PSE_REFUSAL:maintenance_protected_source'; };
    LET $remaining=SELECT key FROM canonical_file_instances WHERE storage_incarnation!=$owner.target LIMIT 1;
    IF array::len($remaining)!=0 { THROW 'PSE_REFUSAL:maintenance_placement_incomplete'; };
    UPDATE ONLY canonical_interpretations:current SET payload_incarnation=$owner.target RETURN NONE;
    UPDATE ONLY canonical_file_admission:current SET storage_incarnation=$owner.target RETURN NONE;
    UPDATE ONLY canonical_maintenance_operations:current SET complete=true RETURN NONE;
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_maintenance_v1::validation_reads($expiry:int,$operation:string,$generation:string,$phase:string,$interpretation:string) -> bool {
    LET $owner=fn::pse_maintenance_v1::guard($expiry,$operation,$generation,$phase);
    fn::pse_maintenance_v1::frozen($owner);
    LET $marker=SELECT * FROM ONLY canonical_interpretations:current;
    IF $marker=NONE OR $marker.payload_incarnation!=$owner.target OR $marker.interpretation!=$interpretation OR $owner.source!=$owner.target { THROW 'PSE_REFUSAL:maintenance_original_inputs_differ'; };
    UPDATE ONLY canonical_file_admission:current SET frozen=false,gc_frozen=true RETURN NONE;
    fn::pse_execution_v1::deadline($expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_maintenance_v1::activate($expiry:int,$predecessor:option<object>,$interpretation:string,$schema_digest:string,$study_module_sha256:string,$issuing:string,$payload_incarnation:string,$nonce:string,$input_sha256:string,$predecessor_bytes:bytes) -> bool {
    fn::pse_execution_v1::deadline($expiry); LET $old=SELECT * FROM ONLY canonical_interpretations:current FOR UPDATE; LET $receipt=SELECT * FROM ONLY type::record('canonical_maintenance_activations',$nonce) FOR UPDATE; IF $receipt!=NONE { THROW 'PSE_REFUSAL:activation_operation_already_exists_settle_exact_receipt'; }; IF ($predecessor=NONE AND $old!=NONE) OR ($predecessor!=NONE AND ($old.interpretation!=$predecessor.interpretation OR $old.schema_digest!=$predecessor.schema_digest OR $old.study_module_sha256!=$predecessor.study_module_sha256 OR $old.issuing_store!=$predecessor.issuing_store)) { THROW 'PSE_REFUSAL:activation_predecessor_changed'; }; IF $old!=NONE AND $old.study_module_sha256!=$study_module_sha256 {THROW 'PSE_REFUSAL:activation_predecessor_changed';}; IF $old!=NONE AND $old.payload_incarnation!=$payload_incarnation { THROW 'PSE_REFUSAL:activation_payload_incarnation_differs'; }; LET $gate=SELECT * FROM ONLY canonical_file_admission:current FOR UPDATE; IF $gate!=NONE AND $gate.storage_incarnation!=$payload_incarnation { THROW 'PSE_REFUSAL:activation_file_placement_differs'; }; IF $gate=NONE { CREATE canonical_file_admission:current SET key='current',storage_incarnation=$payload_incarnation,frozen=false,gc_frozen=false; }; UPSERT canonical_interpretations:current SET key='current', interpretation=$interpretation, schema_digest=$schema_digest,study_module_sha256=$study_module_sha256, issuing_store=$issuing,payload_incarnation=$payload_incarnation; CREATE ONLY type::record('canonical_maintenance_activations',$nonce) SET key=$nonce,input_sha256=$input_sha256,predecessor=$predecessor_bytes,interpretation=$interpretation,schema_digest=$schema_digest,study_module_sha256=$study_module_sha256,issuing_store=$issuing; fn::pse_execution_v1::deadline($expiry);
    RETURN true;
};

// Every point writer queues its own derivation and outgoing propagation in the
// same transaction. These rows are evidence for discovery, never permission.
DEFINE FUNCTION fn::pse_study_v1::readiness_invalidate($rpc_expiry:int,$p: object, $initial: bool) -> bool {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$p.study);
    SELECT * FROM ONLY type::record('canonical_study_readiness',$p.key) FOR UPDATE;
    LET $edges = type::record('canonical_study_points',$p.key)->(SELECT predecessor FROM canonical_study_dependencies LIMIT 193);
    LET $keys = array::distinct($edges.predecessor);
    IF array::len($keys)>64 { THROW 'PSE_REFUSAL:study_readiness_immediate_dependency_bound'; };
    LET $predecessors = $keys.map(|$key| SELECT settled FROM ONLY type::record('canonical_study_points',$key));
    LET $pending = <decimal>array::len($predecessors.filter(|$row| $row=NONE OR $row.settled=false));
    UPSERT ONLY type::record('canonical_study_readiness',$p.key) CONTENT {
        key:$p.key,point:$p.key,study:$p.study,ordinal:$p.ordinal,source_revision:$p.revision,
        pending:$pending,eligible:($p.assigned=false AND $p.settled=false AND ($initial=false OR $pending=0dec)),
        premises:NONE,dirty:($initial=false),notify:($initial=false),notify_revision:$p.revision,notify_after:''
    };
    RETURN true;
};

DEFINE FUNCTION fn::pse_study_v1::readiness_cursor($rpc_expiry:int,$study:string,$fresh:bool) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    SELECT * FROM ONLY type::record('canonical_study_readiness_cursors',$study) FOR UPDATE;
    LET $old=SELECT * FROM ONLY type::record('canonical_study_readiness_cursors',$study);
    IF $old!=NONE { RETURN $old; };
    LET $s=SELECT key FROM ONLY type::record('canonical_studies',$study);
    IF $s=NONE { THROW 'PSE_REFUSAL:study_readiness_owner_unavailable'; };
    LET $result=CREATE ONLY type::record('canonical_study_readiness_cursors',$study) SET
        key=$study,study=$study,revision=0dec,rebuild_pending=($fresh=false),
        rebuild_after=NONE,notify_after=NONE,verify_after=NONE;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $result;
};

DEFINE FUNCTION fn::pse_study_v1::readiness_notify_advance($rpc_expiry:int,$study:string,$point:string,$revision:decimal,$before:string,$after:string,$done:bool) -> bool {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    SELECT * FROM ONLY type::record('canonical_study_readiness',$point) FOR UPDATE;
    LET $hint=SELECT * FROM ONLY type::record('canonical_study_readiness',$point);
    IF $hint=NONE OR $hint.study!=$study OR $hint.notify=false OR $hint.notify_revision!=$revision OR $hint.notify_after!=$before OR $hint.dirty { RETURN false; };
    UPDATE ONLY type::record('canonical_study_readiness',$point) SET notify=($done=false),notify_after=$after;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN true;
};

DEFINE FUNCTION fn::pse_study_v1::readiness_scan_advance($rpc_expiry:int,$study:string,$revision:decimal,$mode:string,$after:option<decimal>,$done:bool) -> bool {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    SELECT * FROM ONLY type::record('canonical_study_readiness_cursors',$study) FOR UPDATE;
    LET $old=SELECT * FROM ONLY type::record('canonical_study_readiness_cursors',$study);
    IF $old=NONE OR $old.revision!=$revision { RETURN false; };
    IF $mode='rebuild' {
        UPDATE ONLY type::record('canonical_study_readiness_cursors',$study) SET revision+=1dec,rebuild_after=$after,rebuild_pending=($done=false);
    } ELSE IF $mode='verify' {
        UPDATE ONLY type::record('canonical_study_readiness_cursors',$study) SET revision+=1dec,verify_after=$after;
    } ELSE IF $mode='notify' {
        UPDATE ONLY type::record('canonical_study_readiness_cursors',$study) SET revision+=1dec,notify_after=$after;
    } ELSE { THROW 'PSE_REFUSAL:study_readiness_cursor_mode'; };
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN true;
};

// Scope pages retain one native row per distinct premise. A candidate is admitted
// whole or left before the continuation; dependency lists are never truncated.
DEFINE FUNCTION fn::pse_study_v1::readiness_page_item($rpc_expiry:int,$study:string,$acc:object,$entry:object,$maximum:int) -> object {
    IF $acc.stopped OR $acc.refused { RETURN $acc; };
    IF $entry.position>=$maximum { RETURN object::extend($acc,{stopped:true}); };
    IF $entry.point IN $acc.items.point { RETURN object::extend($acc,{next_edge:$entry.edge,next_ordinal:$entry.ordinal}); };
    LET $point=$entry.point;
    LET $edges=type::record('canonical_study_points',$point)->(SELECT predecessor FROM canonical_study_dependencies LIMIT 193);
    LET $keys=array::distinct($edges.predecessor);
    IF array::len($keys)>64 { RETURN object::extend($acc,{refused:true}); };
    LET $required=array::distinct(array::concat([$point],$keys));
    LET $missing=$required.filter(|$key| $key NOT IN $acc.rows.key);
    LET $new=$missing.map(|$key| SELECT key,study,ordinal,occurrence,policy,facts,revision,assigned,settled FROM ONLY type::record('canonical_study_points',$key));
    IF array::len($new.filter(|$row| $row=NONE OR $row.study!=$study))!=0 { RETURN object::extend($acc,{refused:true}); };
    LET $rows=array::concat($acc.rows,$new);
    LET $items=array::append($acc.items,{point:$point,predecessors:$keys,ordinal:$entry.ordinal,edge:$entry.edge});
    LET $next={rows:$rows,items:$items,stopped:false,refused:false,next_edge:$entry.edge,next_ordinal:$entry.ordinal};
    // CBOR is used as a conservative application extent, independently of the
    // 4 MiB transport guard. 128 native rows also cap maps, keys and nesting.
    IF array::len($rows)>128 OR bytes::len(encoding::cbor::encode($next))>1048576 {
        IF array::len($acc.items)=0 { RETURN object::extend($acc,{refused:true}); };
        RETURN object::extend($acc,{stopped:true});
    };
    RETURN $next;
};

DEFINE FUNCTION fn::pse_study_v1::readiness_scope_page($rpc_expiry:int,$study:string,$cursor:decimal,$mode:string,$after:option<decimal>,$source:option<object>,$maximum:int) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $maximum<1 OR $maximum>64 { THROW 'PSE_REFUSAL:study_readiness_page_extent'; };
    LET $s=SELECT key,run,generation,cancelled,active,terminal FROM ONLY type::record('canonical_studies',$study);
    IF $s=NONE OR $s.active=false { THROW 'PSE_REFUSAL:study_not_active'; };
    LET $entries=IF $mode='notify' {
        LET $hint=SELECT * FROM ONLY type::record('canonical_study_readiness',$source.point);
        IF $hint=NONE OR $hint.study!=$study OR $hint.notify=false OR $hint.notify_revision!=$source.revision OR $hint.notify_after!=$source.before { THROW 'PSE_REFUSAL:study_readiness_notification_changed'; };
        LET $edges=type::record('canonical_study_points',$source.point)<-(SELECT key,dependent FROM canonical_study_dependencies WHERE key>$source.before ORDER BY key LIMIT 65);
        LET $children=$edges.map(|$edge,$index| {point:$edge.dependent,edge:$edge.key,ordinal:NONE,position:$index});
        IF $hint.dirty {array::prepend($children,{point:$source.point,edge:NONE,ordinal:NONE,position:-1})} ELSE {$children}
    } ELSE IF $mode IN ['rebuild','verify'] {
        LET $points=SELECT key,ordinal FROM canonical_study_points WHERE study=$study AND ordinal>($after ?? -1dec) ORDER BY ordinal LIMIT 65;
        $points.map(|$point,$index| {point:$point.key,ordinal:$point.ordinal,edge:NONE,position:$index})
    } ELSE { THROW 'PSE_REFUSAL:study_readiness_cursor_mode'; };
    // Position bounds outgoing edges even when relation kinds repeat a child.
    LET $page=$entries.fold({rows:[],items:[],stopped:false,refused:false,next_edge:$source.before,next_ordinal:$after},|$acc,$entry| fn::pse_study_v1::readiness_page_item($rpc_expiry,$study,$acc,$entry,$maximum));
    IF $page.refused { THROW 'PSE_REFUSAL:study_readiness_single_scope_extent'; };
    LET $exhausted=$page.stopped=false;
    LET $fence={cursor:$cursor,mode:$mode,after:$after,source:$source,next_ordinal:$page.next_ordinal,next_edge:$page.next_edge,exhausted:$exhausted};
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {study:$s,rows:$page.rows,items:$page.items,fence:$fence};
};

// One pure guest invocation per deduplicated native page. Scientific policy is
// the same Rust owner used by claims; no row/fact snapshot crosses the RPC.
DEFINE FUNCTION fn::pse_study_v1::readiness_policy($page:object) -> object {
    RETURN mod::pse::study::readiness({generation:$page.study.generation,cancelled:$page.study.cancelled,
        rows:$page.rows.map(|$row| {key:$row.key,occurrence:$row.occurrence,revision:$row.revision,policy:$row.policy,facts:$row.facts,assigned:$row.assigned,settled:$row.settled}),
        items:$page.items.map(|$item| {point:$item.point,predecessors:$item.predecessors})});
};

// Page acquisition and policy evaluation already share this exact native SSI
// snapshot. Only the destination hint needs a write lock; scientific rows and
// dependency edges are neither fetched nor decoded again per candidate.
DEFINE FUNCTION fn::pse_study_v1::readiness_apply_hint($rpc_expiry:int,$point:object,$item:object,$mutating:bool) -> object {
    LET $hint=SELECT * FROM ONLY type::record('canonical_study_readiness',$point.key) FOR UPDATE;
    LET $eligible=$item.eligible AND $point.assigned=false AND $point.settled=false;
    LET $changed=$hint=NONE OR $hint.source_revision!=$point.revision OR $hint.pending!=$item.pending OR $hint.eligible!=$eligible OR $hint.premises!=$item.premises OR $hint.dirty;
    IF $changed {
        IF $mutating=false { RETURN {point:$point.key,status:'stale',changed:false}; };
        IF $hint=NONE OR $hint.source_revision!=$point.revision {
            UPSERT ONLY type::record('canonical_study_readiness',$point.key) CONTENT {
                key:$point.key,point:$point.key,study:$point.study,
                ordinal:$point.ordinal,
                source_revision:$point.revision,pending:$item.pending,eligible:$eligible,premises:$item.premises,
                dirty:false,notify:true,notify_revision:$point.revision,notify_after:''
            };
        } ELSE {
            UPDATE ONLY type::record('canonical_study_readiness',$point.key) SET pending=$item.pending,eligible=$eligible,premises=$item.premises,dirty=false;
        };
    };
    RETURN {point:$point.key,status:'accepted',changed:$changed};
};

DEFINE FUNCTION fn::pse_study_v1::readiness_settlement($rpc_expiry:int,$operation:string,$study:string,$run:string) -> option<object> {
    LET $old=fn::pse_history_v1::study_repair_operation($rpc_expiry,$operation,$study,$run,NONE);
    RETURN IF $old=NONE OR $old.disposition NOT IN ['settled','no-effect','refused'] {NONE} ELSE IF $old.disposition='no-effect' {{no_effect:true}} ELSE IF $old.disposition='refused' {{refusal:true}} ELSE {encoding::cbor::decode($old.result)};
};

// The pending locator, exact original request and history obligation are born
// in one transaction. Losing preparation's acknowledgment cannot orphan an ID.
DEFINE FUNCTION fn::pse_study_v1::readiness_pending_page($rpc_expiry:int,$study:string) -> option<object> {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    LET $cursor=SELECT * FROM ONLY type::record('canonical_study_readiness_cursors',$study);
    IF $cursor.pending_operation=NONE { RETURN NONE; };
    LET $s=SELECT run FROM ONLY type::record('canonical_studies',$study);
    LET $old=fn::pse_history_v1::study_repair_operation($rpc_expiry,$cursor.pending_operation,$study,$s.run,NONE);
    IF $old=NONE OR $old.disposition IN ['settled','no-effect','refused'] { THROW 'PSE_REFUSAL:study_readiness_pending_operation_unavailable'; };
    LET $request=encoding::cbor::decode($old.request);
    RETURN {operation:$old.key,study:$study,run:$old.run,epoch:$old.disposition,keys:$request.keys,created:false};
};

DEFINE FUNCTION fn::pse_study_v1::readiness_prepare_page($rpc_expiry:int,$operation:string,$coordinates:object) -> option<object> {
    LET $study=$coordinates.study;
    LET $module=(SELECT study_module_sha256 FROM ONLY canonical_interpretations:current).study_module_sha256;
    IF $coordinates.module_sha256!=$module {THROW 'PSE_REFUSAL:study_readiness_module_identity_changed';};
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    LET $cursor=SELECT * FROM ONLY type::record('canonical_study_readiness_cursors',$study) FOR UPDATE;
    IF $cursor=NONE { THROW 'PSE_REFUSAL:study_readiness_owner_unavailable'; };
    IF $cursor.pending_operation!=NONE { RETURN fn::pse_study_v1::readiness_pending_page($rpc_expiry,$study); };
    IF $cursor.revision!=$coordinates.cursor { RETURN NONE; };
    LET $s=SELECT key,run,generation,cancelled,active,terminal FROM ONLY type::record('canonical_studies',$study);
    IF $s!=NONE AND ($s.active=false OR $s.terminal) { RETURN NONE; };
    IF $s=NONE { THROW 'PSE_REFUSAL:study_readiness_owner_unavailable'; };
    LET $page=fn::pse_study_v1::readiness_scope_page($rpc_expiry,$study,$coordinates.cursor,$coordinates.mode,$coordinates.after,$coordinates.source,64);
    // Verification stays entirely nonmutating when the authoritative guest
    // result already matches every hint. It creates no durable operation ID.
    IF $coordinates.mode='verify' {
        LET $reply=fn::pse_study_v1::readiness_policy($page);
        IF $reply.accepted=false { THROW 'PSE_REFUSAL:study_readiness_policy_refused'; };
        LET $check={study:$study,generation:$s.generation,cancelled:$s.cancelled,fence:$page.fence,mutating:false};
        LET $result=fn::pse_study_v1::readiness_apply_decisions($rpc_expiry,$check,$page,$reply.decisions,true);
        IF array::len($result.outcomes.filter(|$item| $item.status!='accepted'))=0 {
            RETURN {settled:true,result:$result,keys:$page.items.point};
        };
    };
    // Persist only traversal coordinates and immutable candidate identities.
    // Facts, premises and policy decisions are reacquired inside each apply.
    LET $request={study:$study,run:$s.run,module_sha256:$module,fence:$page.fence,keys:$page.items.point};
    LET $old=fn::pse_history_v1::study_repair_operation($rpc_expiry,$operation,$study,$s.run,encoding::cbor::encode($request));
    IF $old!=NONE { THROW 'PSE_REFUSAL:study_readiness_pending_operation_unavailable'; };
    fn::pse_history_v1::retain($rpc_expiry,$operation,'run',$s.run,'unsettled','study-readiness-repair-page');
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$s.run,NONE,'study-readiness-repair-page',encoding::cbor::encode($request),encoding::cbor::encode({outcomes:[]}),$study,NONE);
    LET $epoch='pending:'+$operation;
    UPDATE ONLY type::record('canonical_execution_operations',$operation) SET disposition=$epoch;
    UPDATE ONLY type::record('canonical_study_readiness_cursors',$study) SET pending_operation=$operation;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {operation:$operation,study:$study,run:$s.run,epoch:$epoch,keys:$request.keys,created:true};
};

// Writing the SAME row that every apply must read and write is an authenticated
// transaction fence, not an inference from a missing receipt or a dead client.
// A delayed old dispatch mismatches its epoch; an in-flight old transaction
// cannot commit its receipt after this write wins under native SSI.
DEFINE FUNCTION fn::pse_study_v1::readiness_fence_page($rpc_expiry:int,$operation:string,$study:string,$run:string,$before:string,$after:string) -> object {
    LET $old=fn::pse_history_v1::study_repair_operation($rpc_expiry,$operation,$study,$run,NONE);
    IF $old=NONE { THROW 'PSE_REFUSAL:study_readiness_pending_operation_unavailable'; };
    IF $old.disposition='no-effect' { RETURN {settled:true,result:{no_effect:true}}; };
    IF $old.disposition='refused' { RETURN {settled:true,result:{refusal:true}}; };
    IF $old.disposition='settled' { RETURN {settled:true,result:encoding::cbor::decode($old.result)}; };
    IF $old.disposition=$before { UPDATE ONLY type::record('canonical_execution_operations',$operation) SET disposition=$after; };
    LET $current=SELECT disposition FROM ONLY type::record('canonical_execution_operations',$operation);
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {settled:false,epoch:$current.disposition};
};

DEFINE FUNCTION fn::pse_study_v1::readiness_apply_decisions($rpc_expiry:int,$request:object,$page:object,$items:array<object>,$finish:bool) -> object {
    LET $study=$request.study; LET $fence=$request.fence;
    fn::pse_execution_v1::register($rpc_expiry,'study-cancel:'+$study);
    // Validate the entire guest result before any hint/cursor write. An empty
    // or malformed later item cannot certify a prefix or commit earlier hints.
    LET $coverage=array::sort($items.point)=array::sort($page.items.point) AND array::len(array::distinct($items.point))=array::len($items);
    IF $coverage!=true { THROW 'PSE_REFUSAL:study_readiness_repair_page_extent'; };
    LET $invalid=$items.filter(|$item| {
        LET $members=($page.items.filter(|$member|$member.point=$item.point))[0];
        LET $point=($page.rows.filter(|$row|$row.key=$item.point))[0];
        LET $keys=array::concat([$item.point],$members.predecessors);
        LET $expected=$item.expected;
        LET $pending=<decimal>array::len($page.rows.filter(|$row| $row.key IN $members.predecessors AND $row.settled=false));
        LET $valid=$point!=NONE AND $point.study=$study AND array::sort($expected.key)=array::sort($keys)
            AND array::len($expected)=array::len($keys) AND type::is_decimal($item.pending) AND $item.pending=$pending
            AND type::is_bool($item.eligible) AND type::is_bytes($item.premises) AND bytes::len($item.premises)<=16384
            AND array::len($expected.filter(|$premise| type::is_decimal($premise.revision)=false OR array::len($page.rows.filter(|$row| $row.key=$premise.key AND $row.revision=$premise.revision AND $row.study=$study))!=1))=0;
        RETURN $valid!=true;
    });
    IF array::len($invalid)!=0 { THROW 'PSE_REFUSAL:study_readiness_repair_page_extent'; };
    LET $available=$page.study!=NONE AND $page.study.active AND $page.study.terminal=false;
    LET $outcomes=$items.map(|$item| {
        LET $point=($page.rows.filter(|$row|$row.key=$item.point))[0];
        IF $available=false {{point:$item.point,status:'stale',changed:false}}
        ELSE {fn::pse_study_v1::readiness_apply_hint($rpc_expiry,$point,$item,$request.mutating)}
    });
    LET $safe=$available AND $finish AND array::len($outcomes.filter(|$item|$item.status='refused' OR ($request.mutating=false AND $item.status='stale')))=0;
    LET $notified=IF $safe AND $fence.mode='notify' {
        fn::pse_study_v1::readiness_notify_advance($rpc_expiry,$study,$fence.source.point,$fence.source.revision,$fence.source.before,$fence.next_edge ?? $fence.source.before,$fence.exhausted)
    } ELSE {false};
    LET $advanced=IF $safe AND ($fence.mode!='notify' OR $notified) {
        fn::pse_study_v1::readiness_scan_advance($rpc_expiry,$study,$fence.cursor,$fence.mode,IF $fence.mode='notify' {$fence.source.ordinal} ELSE IF $fence.exhausted AND $fence.mode='verify' {NONE} ELSE {$fence.next_ordinal},$fence.exhausted)
    } ELSE {false};
    LET $cursor=SELECT * FROM ONLY type::record('canonical_study_readiness_cursors',$study);
    RETURN {outcomes:$outcomes,advanced:$advanced,notified:$notified,cursor:$cursor};
};

// Partial application shrinks a repeatedly conflicting transaction while keeping
// the same original operation, exact inputs and cursor fence. Committed prefixes
// are retained in its pending body; only a complete result becomes immutable.
DEFINE FUNCTION fn::pse_study_v1::readiness_apply_page($rpc_expiry:int,$operation:string,$study:string,$run:string,$epoch:string,$maximum:int) -> object {
    LET $old=fn::pse_history_v1::study_repair_operation($rpc_expiry,$operation,$study,$run,NONE);
    IF $old=NONE OR $maximum<1 OR $maximum>65 { THROW 'PSE_REFUSAL:study_readiness_pending_operation_unavailable'; };
    IF $old.disposition='no-effect' { RETURN {settled:true,result:{no_effect:true}}; };
    IF $old.disposition='refused' { RETURN {settled:true,result:{refusal:true}}; };
    IF $old.disposition='settled' { RETURN {settled:true,result:encoding::cbor::decode($old.result)}; };
    IF $old.disposition!=$epoch { RETURN {settled:false,fenced:true}; };
    LET $cursor=SELECT pending_operation FROM ONLY type::record('canonical_study_readiness_cursors',$study) FOR UPDATE;
    IF $cursor.pending_operation!=$operation { THROW 'PSE_REFUSAL:study_readiness_pending_operation_unavailable'; };
    LET $request=encoding::cbor::decode($old.request);
    IF $request.module_sha256!=(SELECT study_module_sha256 FROM ONLY canonical_interpretations:current).study_module_sha256 {THROW 'PSE_REFUSAL:study_readiness_module_identity_changed';};
    LET $previous=encoding::cbor::decode($old.result);
    LET $offset=array::len($previous.outcomes);
    LET $keys=array::slice($request.keys,$offset,$offset+$maximum);
    LET $entries=$keys.map(|$key,$index| {point:$key,ordinal:NONE,edge:NONE,position:$index});
    LET $page=$entries.fold({rows:[],items:[],stopped:false,refused:false,next_edge:NONE,next_ordinal:NONE},|$acc,$entry| fn::pse_study_v1::readiness_page_item($rpc_expiry,$study,$acc,$entry,65));
    LET $s=SELECT key,generation,cancelled,active,terminal FROM ONLY type::record('canonical_studies',$study);
    LET $reply=IF $page.refused OR $page.stopped {{accepted:false,decisions:[]}} ELSE {fn::pse_study_v1::readiness_policy(object::extend($page,{study:$s}))};
    LET $finish=$reply.accepted=false OR $offset+array::len($keys)=array::len($request.keys);
    // A prior logical refusal also prevents cursor certification at the end.
    LET $safe=array::len($previous.outcomes.filter(|$item|$item.status='refused'))=0;
    LET $inputs=object::extend($request,{generation:$s.generation,cancelled:$s.cancelled,mutating:true});
    LET $next=IF $reply.accepted {
        fn::pse_study_v1::readiness_apply_decisions($rpc_expiry,$inputs,object::extend($page,{study:$s}),$reply.decisions,$finish AND $safe)
    } ELSE {{outcomes:array::slice($request.keys,$offset,array::len($request.keys)).map(|$key| {point:$key,status:'refused',changed:false}),advanced:false,notified:false,refusal:true}};
    IF $finish {
        UPDATE ONLY type::record('canonical_study_readiness_cursors',$study) SET pending_operation=NONE,revision=math::max([(SELECT revision FROM ONLY type::record('canonical_study_readiness_cursors',$study)).revision,$request.fence.cursor+1dec]);
        fn::pse_history_v1::drop_obligation($rpc_expiry,$operation,'run',$run,'unsettled','study-readiness-repair-page');
    };
    LET $cursor=SELECT * FROM ONLY type::record('canonical_study_readiness_cursors',$study);
    LET $result=object::extend($next,{outcomes:array::concat($previous.outcomes,$next.outcomes),cursor:$cursor});
    LET $effect=$result.notified OR ($result.advanced AND $request.fence.mode='rebuild') OR array::len($result.outcomes.filter(|$item|$item.changed))>0;
    // An acknowledged transaction with no obligation effect still consumes the
    // exact epoch. Its tiny permanent attribution is not a full history receipt.
    IF $finish AND $effect=false {
        UPDATE ONLY type::record('canonical_execution_operations',$operation) SET request=type::bytes(''),result=type::bytes(''),minimal=true,disposition=IF $result.refusal=true {'refused'} ELSE {'no-effect'};
    } ELSE {
        UPDATE ONLY type::record('canonical_execution_operations',$operation) SET result=encoding::cbor::encode($result),disposition=IF $finish {'settled'} ELSE {$epoch};
    };
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {settled:$finish,result:$result};
};

DEFINE FUNCTION fn::pse_study_v1::create($rpc_expiry: int, $row: object) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$row.key);
    IF (SELECT * FROM ONLY type::record('canonical_study_retirements',$row.key) FOR UPDATE)!=NONE { THROW 'PSE_REFUSAL:study_identity_explicitly_retired'; };
    fn::pse_history_v1::run($rpc_expiry,$row.run);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::touch($rpc_expiry, 'study:' + $row.key);
    LET $old = SELECT * FROM ONLY type::record('canonical_studies', $row.key);
    IF $old != NONE {
        IF $old.run != $row.run OR $old.revision != $row.revision OR $old.problem != $row.problem OR $old.metadata != $row.metadata OR $old.point_count != $row.point_count OR $old.dependency_count != $row.dependency_count OR $old.interpretation != $row.interpretation { THROW 'PSE_REFUSAL:study_identity_reused'; };
        LET $rpc_result = $old;
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    };
    fn::pse_execution_v1::result_creator($rpc_expiry,$row.run);
    fn::pse_execution_v1::touch($rpc_expiry,'study-association:'+$row.run);
    LET $run = SELECT * FROM ONLY type::record('canonical_runs', $row.run);
    IF $run = NONE OR $run.problem != $row.problem OR $run.revision != $row.revision { THROW 'PSE_REFUSAL:study_source_run_unavailable'; };
    fn::pse_history_v1::associate($rpc_expiry,$row.key,$row.run,NONE);
    LET $rpc_result = CREATE ONLY type::record('canonical_studies', $row.key) CONTENT $row;
    fn::pse_study_v1::readiness_cursor($rpc_expiry,$row.key,true);
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::append($rpc_expiry: int, $study: string, $points: array<object>) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies', $study) FOR UPDATE;
    IF $s = NONE OR array::len($points) = 0 OR array::len($points) > 64 { THROW 'PSE_REFUSAL:study_occurrence_batch_unavailable'; };
    LET $existing = $points.map(|$point| SELECT key FROM ONLY type::record('canonical_study_points', $point.key)).filter(|$row| $row != NONE);
    IF array::len($existing) != 0 AND array::len($existing) != array::len($points) { THROW 'PSE_REFUSAL:study_occurrence_batch_mixed_settlement'; };
    FOR $point IN $points {
        fn::pse_history_v1::point($rpc_expiry,$point.key);
        fn::pse_history_v1::run($rpc_expiry,$point.run);
        IF $point.study != $study { THROW 'PSE_REFUSAL:study_occurrence_belongs_elsewhere'; };
        IF $point.seed_solution!=NONE {
            LET $input=SELECT * FROM ONLY type::record('canonical_study_inputs',$study+':'+$point.seed_solution);
            IF $input=NONE OR $input.study!=$study OR $input.solution!=$point.seed_solution { THROW 'PSE_REFUSAL:study_external_seed_was_not_retained'; };
            fn::pse_artifact_v1::available($rpc_expiry,$input.artifact);
            LET $owners=SELECT key FROM canonical_artifact_obligations WHERE artifact=$input.artifact AND owner_kind='study' AND owner=$study LIMIT 1;
            IF array::len($owners)!=1 { THROW 'PSE_REFUSAL:study_external_seed_obligation_absent'; };
        };
        LET $old = SELECT * FROM ONLY type::record('canonical_study_points', $point.key);
        IF $old != NONE {
            IF $old.seed_solution != $point.seed_solution OR $old.ordinal != $point.ordinal OR $old.occurrence != $point.occurrence OR $old.policy != $point.policy OR $old.descriptor != $point.descriptor OR $old.run != $point.run { THROW 'PSE_REFUSAL:study_immutable_occurrence_changed'; };
        } ELSE {
            fn::pse_execution_v1::result_creator($rpc_expiry,$point.run);
            fn::pse_execution_v1::touch($rpc_expiry,'study-association:'+$point.run);
            SELECT * FROM ONLY type::record('canonical_study_points',$point.key) FOR UPDATE;
            LET $run = SELECT * FROM ONLY type::record('canonical_runs', $point.run);
            LET $admission_run = SELECT * FROM ONLY type::record('canonical_runs', 'study-admission:'+$point.key);
            IF $run=NONE {
                IF $admission_run=NONE OR $admission_run.problem!=$s.problem OR $admission_run.revision!=$s.revision { THROW 'PSE_REFUSAL:study_lazy_admission_source_run_unavailable'; };
                LET $locator='admission:'+$point.key;
                LET $issuing=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store;
                CREATE ONLY type::record('canonical_history_locators',$locator) SET key=$locator,study=$study,run=$admission_run.key,point=$point.key,issuing_store=$issuing;
            } ELSE IF $run.problem != $s.problem OR $run.revision != $s.revision { THROW 'PSE_REFUSAL:study_occurrence_source_run_unavailable'; };
            fn::pse_history_v1::associate($rpc_expiry,$study,$point.run,$point.key);
        };
    };
    IF array::len($existing) = 0 {
        IF $s.active OR $s.cancelled OR array::len(array::distinct($points.ordinal)) != array::len($points) OR array::min($points.ordinal) != $s.next_ordinal OR array::max($points.ordinal) + 1dec != $s.next_ordinal + array::len($points) OR $s.next_ordinal + array::len($points) > $s.point_count { THROW 'PSE_REFUSAL:study_membership_closed_or_sequence_gap'; };
        LET $new = $points.map(|$point| object::extend($point, {id:type::record('canonical_study_points', $point.key)}));
        INSERT INTO canonical_study_points $new RETURN NONE;
        FOR $point IN $points { fn::pse_study_v1::readiness_invalidate($rpc_expiry,$point,true); };
        UPDATE ONLY type::record('canonical_studies', $study) SET next_ordinal += <decimal>array::len($points);
    };
    LET $rpc_result = SELECT * FROM ONLY type::record('canonical_studies', $study) FOR UPDATE;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::append_dependencies($rpc_expiry:int,$study:string,$edges:array<object>) -> bool {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::register($rpc_expiry,'study-cancel:'+$study);
    LET $s=SELECT * FROM ONLY type::record('canonical_studies',$study) FOR UPDATE;
    IF $s=NONE OR $s.next_ordinal!=$s.point_count OR array::len($edges)=0 OR array::len($edges)>64 OR array::len(array::distinct($edges.key))!=array::len($edges) { THROW 'PSE_REFUSAL:study_dependency_installation_unavailable'; };
    FOR $edge IN $edges {
        IF $edge.study!=$study { THROW 'PSE_REFUSAL:study_dependency_belongs_elsewhere'; };
        LET $old=SELECT * FROM ONLY type::record('canonical_study_dependencies',$edge.key);
        IF $old!=NONE {
            IF object::remove($old,['id'])!=$edge { THROW 'PSE_REFUSAL:study_immutable_dependency_changed'; };
        } ELSE {
            IF $s.active OR $s.cancelled { THROW 'PSE_REFUSAL:study_dependency_installation_closed'; };
            LET $dependent=SELECT * FROM ONLY type::record('canonical_study_points',$edge.dependent);
            LET $predecessor=SELECT study FROM ONLY type::record('canonical_study_points',$edge.predecessor);
            IF $dependent=NONE OR $predecessor=NONE OR $dependent.study!=$study OR $predecessor.study!=$study { THROW 'PSE_REFUSAL:study_dependency_endpoint_unavailable'; };
            INSERT RELATION INTO canonical_study_dependencies object::extend($edge,{id:type::record('canonical_study_dependencies',$edge.key),in:type::record('canonical_study_points',$edge.dependent),out:type::record('canonical_study_points',$edge.predecessor)}) RETURN NONE;
            UPDATE ONLY type::record('canonical_studies',$study) SET installed_dependencies+=1dec;
            fn::pse_study_v1::readiness_invalidate($rpc_expiry,$dependent,true);
        };
    };
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN true;
};

DEFINE FUNCTION fn::pse_study_v1::activate($rpc_expiry: int, $study: string) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies', $study) FOR UPDATE;
    IF $s = NONE OR $s.cancelled OR $s.point_count = 0dec OR $s.next_ordinal != $s.point_count OR $s.installed_dependencies!=$s.dependency_count { THROW 'PSE_REFUSAL:study_membership_incomplete'; };
    LET $rpc_result = UPDATE ONLY type::record('canonical_studies', $study) SET active = true;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::scope($rpc_expiry: int, $point: string) -> object {
    fn::pse_history_v1::point($rpc_expiry,$point);
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $p = SELECT key, study, ordinal, occurrence, policy, facts, outcome, run, revision, assigned, settled, attempt, start FROM ONLY type::record('canonical_study_points', $point);
    IF $p = NONE { THROW 'PSE_REFUSAL:study_candidate_unavailable'; };
    LET $s = SELECT key, generation, cancelled, active, terminal FROM ONLY type::record('canonical_studies', $p.study);
    IF $s = NONE OR $s.active = false { THROW 'PSE_REFUSAL:study_not_active'; };
    LET $edges = type::record('canonical_study_points',$point)->(SELECT predecessor FROM canonical_study_dependencies LIMIT 193);
    IF array::len(array::distinct($edges.predecessor)) > 64 { THROW 'PSE_REFUSAL:study_candidate_immediate_dependency_bound'; };
    LET $keys = array::distinct($edges.predecessor);
    LET $predecessors = $keys.map(|$key| SELECT key, study, ordinal, occurrence, policy, facts, outcome, revision, assigned, settled, attempt, run, start FROM ONLY type::record('canonical_study_points', $key));
    LET $rpc_result = {study:$s, point:$p, predecessors:$predecessors};
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::guard($rpc_expiry: int, $study: string, $generation: decimal, $cancelled: bool, $point: string, $expected: array<object>) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies', $study) FOR UPDATE;
    IF $s = NONE OR $s.active = false OR $s.terminal OR $s.generation != $generation OR $s.cancelled != $cancelled { THROW 'PSE_REFUSAL:study_decision_generation_changed'; };
    LET $p = SELECT * FROM ONLY type::record('canonical_study_points', $point);
    IF $p = NONE OR $p.study != $study OR $p.assigned OR $p.settled { THROW 'PSE_REFUSAL:study_candidate_not_available'; };
    LET $edges = type::record('canonical_study_points',$point)->(SELECT predecessor FROM canonical_study_dependencies LIMIT 193);
    IF array::len(array::distinct($edges.predecessor)) > 64 { THROW 'PSE_REFUSAL:study_dependency_bound'; };
    LET $required = array::sort(array::distinct(array::concat([$point], $edges.predecessor)));
    IF array::sort($expected.key) != $required { THROW 'PSE_REFUSAL:study_decision_omitted_or_added_a_premise'; };
    FOR $item IN $expected {
        fn::pse_execution_v1::register($rpc_expiry, 'study-point:' + $item.key);
        SELECT * FROM ONLY type::record('canonical_study_points',$item.key) FOR UPDATE;
        LET $current = SELECT * FROM ONLY type::record('canonical_study_points', $item.key);
        IF $current = NONE OR $current.study != $study OR $current.revision != $item.revision { THROW 'PSE_REFUSAL:study_decision_premise_changed'; };
    };
    LET $rpc_result = $p;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::settle($rpc_expiry: int, $study: string, $generation: decimal, $cancelled: bool, $point: string, $expected: array<object>, $facts: bytes, $outcome: bytes) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $p = fn::pse_study_v1::guard($rpc_expiry, $study,$generation,$cancelled,$point,$expected);
    LET $rpc_result = UPDATE ONLY type::record('canonical_study_points',$point) SET revision += 1dec, facts=$facts,outcome=$outcome,settled=true;
    IF $rpc_result.settled AND !$rpc_result.assigned AND $rpc_result.attempt=NONE {
        LET $run=SELECT key FROM ONLY type::record('canonical_runs',$rpc_result.run);
        IF $run=NONE {
            LET $input=SELECT key FROM ONLY type::record('canonical_runs','study-admission:'+$point);
            IF $input=NONE { THROW 'PSE_REFUSAL:unadmitted_occurrence_input_owner_unavailable'; };
            fn::pse_history_v1::identity($rpc_expiry,'effect-free-run',$rpc_result.run,$rpc_result.run);
        } ELSE { fn::pse_history_v1::effect_free($rpc_expiry,$rpc_result); };
    };
    fn::pse_study_v1::readiness_invalidate($rpc_expiry,$rpc_result,false);
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::started($rpc_expiry: int, $study: string, $point: string, $revision: decimal, $run: string, $attempt: string, $generation: decimal, $operation: string, $request: bytes, $facts: bytes) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies',$study) FOR UPDATE;
    IF $s = NONE OR $s.cancelled OR $s.terminal { THROW 'PSE_REFUSAL:study_cancelled_before_native_dispatch'; };
    LET $a = fn::pse_execution_v1::fence($rpc_expiry, $run,$attempt,$generation);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation,'study-start',$request);
    IF $op != NONE {
        IF $op.run != $run OR $op.attempt != $attempt { THROW 'PSE_REFUSAL:study_start_operation_reused'; };
        LET $rpc_result = SELECT * FROM ONLY type::record('canonical_study_points',$point);
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    };
    LET $started = SELECT key FROM canonical_execution_operations WHERE run=$run AND kind='study-start' AND attempt=$attempt LIMIT 1;
    IF array::len($started) != 0 { THROW 'PSE_REFUSAL:study_native_start_already_admitted'; };
    fn::pse_execution_v1::touch($rpc_expiry, 'study-point:' + $point);
    LET $p = SELECT * FROM ONLY type::record('canonical_study_points',$point);
    IF $p = NONE OR $p.study != $study OR $p.run != $run OR $p.attempt != $attempt OR $p.revision != $revision OR $p.assigned = false OR $p.settled { THROW 'PSE_REFUSAL:study_native_start_premise_changed'; };
    LET $saved = UPDATE ONLY type::record('canonical_study_points',$point) SET revision += 1dec,facts=$facts;
    fn::pse_study_v1::readiness_invalidate($rpc_expiry,$saved,false);
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'study-start',$request,$request,$study,$point);
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry, $a.expires_at);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::finalize($rpc_expiry: int, $study: string, $operation: string, $request: bytes, $attempt: string, $worker: string, $lifetime: int) -> option<object> {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies',$study) FOR UPDATE;
    IF $s = NONE OR $s.active = false { THROW 'PSE_REFUSAL:study_unavailable'; };
    IF $s.terminal { LET $rpc_result = NONE; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    LET $pending = SELECT key FROM canonical_study_points WHERE study=$study AND settled=false LIMIT 1;
    IF array::len($pending) != 0 { LET $rpc_result = NONE; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    LET $run = SELECT * FROM ONLY type::record('canonical_runs',$s.run);
    IF $run.terminal_class = 'succeeded' { LET $rpc_result = NONE; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    IF $run.current_attempt != NONE {
        LET $current = SELECT * FROM ONLY type::record('canonical_attempts',$run.current_attempt);
        IF $current != NONE AND ($current.phase NOT IN ['terminal','terminal_compacted']) AND $current.expires_at > time::micros() { LET $rpc_result = NONE; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    };
    LET $existing_operation = SELECT key FROM ONLY type::record('canonical_execution_operations', $operation);
    LET $rpc_result = fn::pse_execution_v1::claim($rpc_expiry, $s.run,$operation,$request,$attempt,$worker,$lifetime,$s.interpretation,$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $existing_operation = NONE { fn::pse_execution_v1::lease($rpc_expiry, $rpc_result.expires_at); };
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::seal($rpc_expiry: int, $study: string, $run: string, $attempt: string, $authority: decimal, $operation: string, $request: bytes, $manifest: string, $digest: string, $outcome: string, $completion: bytes) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies',$study) FOR UPDATE;
    IF $s = NONE OR $s.active = false OR $s.run != $run { THROW 'PSE_REFUSAL:study_summary_association_unavailable'; };
    LET $pending = SELECT key FROM canonical_study_points WHERE study=$study AND settled=false LIMIT 1;
    IF array::len($pending) != 0 { THROW 'PSE_REFUSAL:study_summary_has_unsettled_scientific_occurrences'; };
    IF $s.cancelled AND $outcome != 'cancelled' { THROW 'PSE_REFUSAL:study_summary_cancellation_wins_admission'; };
    LET $existing_operation = SELECT key FROM ONLY type::record('canonical_execution_operations', $operation);
    LET $saved = fn::pse_execution_v1::seal($rpc_expiry, $run,$attempt,$authority,$operation,$request,$manifest,$digest,$outcome,$completion,false);
    UPDATE ONLY type::record('canonical_studies',$study) SET terminal=true;
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF $existing_operation = NONE AND $authority = $saved.generation { fn::pse_execution_v1::lease($rpc_expiry, $saved.expires_at); };
    RETURN $rpc_result;
};

// Shared mutation admission: exact original point/premises, cancellation, owner and lease.
DEFINE FUNCTION fn::pse_study_v1::admission_authority($rpc_expiry:int,$authority:object) -> object {
    IF $authority.run!='study-admission:'+$authority.point { THROW 'PSE_REFUSAL:scientific_admission_capability_belongs_elsewhere'; };
    LET $p=fn::pse_study_v1::guard($rpc_expiry,$authority.study,$authority.generation,false,$authority.point,$authority.expected);
    IF $p.admission!=NONE { THROW 'PSE_REFUSAL:scientific_admission_already_settled'; };
    fn::pse_execution_v1::current_writer($rpc_expiry,$authority.run);
    RETURN fn::pse_execution_v1::fence($rpc_expiry,$authority.run,$authority.attempt,$authority.authority);
};

// Input admission uses a separate run. Its lease never increments native point attempts.
DEFINE FUNCTION fn::pse_study_v1::admission_claim($rpc_expiry:int,$study:string,$generation:decimal,$point:string,$expected:array<object>,$operation:string,$request:bytes,$attempt:string,$worker:string,$lifetime:int) -> option<object> {
    LET $p=fn::pse_study_v1::guard($rpc_expiry,$study,$generation,false,$point,$expected);
    IF $p.admission!=NONE { RETURN NONE; };
    LET $run='study-admission:'+$point;
    fn::pse_execution_v1::current_writer($rpc_expiry,$run);
    LET $r=SELECT * FROM ONLY type::record('canonical_runs',$run) FOR UPDATE;
    IF $r=NONE { THROW 'PSE_REFUSAL:scientific_admission_run_unavailable'; };
    IF $r.current_attempt!=NONE {
        LET $old=SELECT * FROM ONLY type::record('canonical_attempts',$r.current_attempt) FOR UPDATE;
        IF $old!=NONE AND ($old.phase NOT IN ['terminal','terminal_compacted']) {
            IF $old.expires_at>time::micros() { RETURN NONE; };
            // This phase owns no native execution, callbacks, result ingestion or solver history.
            // Expiry fences the old source admission; actual published source receipts remain immutable.
            UPDATE ONLY type::record('canonical_attempts',$old.key) SET phase='terminal',outcome='failed';
            fn::pse_execution_v1::register($rpc_expiry,'retention:'+$r.problem);
            SELECT * FROM ONLY type::record('canonical_roots','active_attempt:'+$old.key) FOR UPDATE;
            DELETE ONLY type::record('canonical_roots','active_attempt:'+$old.key);
        };
    };
    LET $s=SELECT interpretation FROM ONLY type::record('canonical_studies',$study);
    LET $claimed=fn::pse_execution_v1::claim($rpc_expiry,$run,$operation,$request,$attempt,$worker,$lifetime,$s.interpretation,NONE);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry,$claimed.expires_at);
    RETURN $claimed;
};

DEFINE FUNCTION fn::pse_study_v1::admission_complete($rpc_expiry:int,$study:string,$generation:decimal,$point:string,$expected:array<object>,$run:string,$attempt:string,$authority:decimal,$operation:string,$request:bytes,$admission:bytes,$facts:bytes,$outcome:option<bytes>) -> object {
    fn::pse_history_v1::point($rpc_expiry,$point);
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $op=fn::pse_execution_v1::operation($rpc_expiry,$operation,'study-admission',$request);
    LET $saved=SELECT * FROM ONLY type::record('canonical_study_points',$point);
    IF $saved.admission!=NONE {
        IF $saved.admission!=$admission OR $op=NONE { THROW 'PSE_REFUSAL:immutable_scientific_admission_differs'; };
        RETURN $saved;
    };
    IF $run!='study-admission:'+$point { THROW 'PSE_REFUSAL:scientific_admission_owner_differs'; };
    LET $p=fn::pse_study_v1::guard($rpc_expiry,$study,$generation,false,$point,$expected);
    LET $a=fn::pse_execution_v1::fence($rpc_expiry,$run,$attempt,$authority);
    IF $outcome=NONE {
        LET $science=SELECT key FROM ONLY type::record('canonical_runs',$p.run);
        IF $science=NONE { THROW 'PSE_REFUSAL:selected_scientific_source_run_unavailable'; };
    };
    LET $result=UPDATE ONLY type::record('canonical_study_points',$point) SET admission=$admission,facts=$facts,outcome=$outcome,settled=($outcome!=NONE),revision+=1dec;
    UPDATE ONLY type::record('canonical_attempts',$attempt) SET phase='terminal',outcome='succeeded',completion=$admission;
    UPDATE ONLY type::record('canonical_runs',$run) SET terminal_attempt=$attempt,terminal_class='succeeded';
    fn::pse_execution_v1::register($rpc_expiry,'retention:'+(SELECT problem FROM ONLY type::record('canonical_runs',$run)).problem);
    SELECT * FROM ONLY type::record('canonical_roots','active_attempt:'+$attempt) FOR UPDATE;
    DELETE ONLY type::record('canonical_roots','active_attempt:'+$attempt);
    IF $result.settled { fn::pse_history_v1::identity($rpc_expiry,'effect-free-run',$p.run,$p.run); };
    fn::pse_study_v1::readiness_invalidate($rpc_expiry,$result,false);
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$run,$attempt,'study-admission',$request,$admission,$study,$point);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry,$a.expires_at);
    RETURN $result;
};

DEFINE FUNCTION fn::pse_study_v1::claim($rpc_expiry: int, $study: string, $generation: decimal, $point: string, $expected: array<object>, $start: bytes, $operation: string, $request: bytes, $claim_request: bytes, $attempt: string, $worker: string, $lifetime: int, $facts: bytes) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $op = fn::pse_execution_v1::operation($rpc_expiry, $operation, 'study-claim', $request);
    IF $op != NONE { LET $rpc_result = SELECT * FROM ONLY type::record('canonical_attempts', $op.attempt); fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies', $study) FOR UPDATE;
    IF $s = NONE OR $s.active = false OR $s.cancelled OR $s.terminal OR $s.generation != $generation { THROW 'PSE_REFUSAL:study_claim_cancellation_or_generation_changed'; };
    LET $p = SELECT * FROM ONLY type::record('canonical_study_points', $point);
    IF $p = NONE OR $p.study != $study OR $p.assigned OR $p.settled { THROW 'PSE_REFUSAL:study_candidate_not_claimable'; };
    LET $edges = type::record('canonical_study_points',$point)->(SELECT predecessor FROM canonical_study_dependencies LIMIT 193);
    IF array::len(array::distinct($edges.predecessor)) > 64 { THROW 'PSE_REFUSAL:study_dependency_bound'; };
    LET $required = array::sort(array::distinct(array::concat([$point], $edges.predecessor)));
    IF array::sort($expected.key) != $required { THROW 'PSE_REFUSAL:study_claim_omitted_or_added_a_premise'; };
    FOR $item IN $expected {
        fn::pse_execution_v1::register($rpc_expiry, 'study-point:' + $item.key);
        SELECT * FROM ONLY type::record('canonical_study_points',$item.key) FOR UPDATE;
        LET $current = SELECT * FROM ONLY type::record('canonical_study_points', $item.key);
        IF $current = NONE OR $current.study != $study OR $current.revision != $item.revision { THROW 'PSE_REFUSAL:study_point_premise_changed'; };
    };
    LET $claimed = fn::pse_execution_v1::claim($rpc_expiry, $p.run, $operation + ':attempt', $claim_request, $attempt, $worker, $lifetime, $s.interpretation,NONE);
    UPDATE ONLY type::record('canonical_study_points', $point) SET assigned = true, revision += 1dec, facts = $facts, start = $start, attempt = $attempt;
    fn::pse_study_v1::readiness_invalidate($rpc_expiry,(SELECT * FROM ONLY type::record('canonical_study_points',$point)),false);
    fn::pse_history_v1::record_operation($rpc_expiry,$operation,$p.run,$attempt,'study-claim',$request,$request,$study,$point);
    LET $rpc_result = $claimed;
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::lease($rpc_expiry, $claimed.expires_at);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::observe($rpc_expiry: int, $point: string, $revision: decimal, $attempt: option<string>, $facts: bytes, $outcome: bytes, $settled: bool) -> object {
    fn::pse_history_v1::point($rpc_expiry,$point);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::touch($rpc_expiry, 'study-point:' + $point);
    LET $p = SELECT * FROM ONLY type::record('canonical_study_points', $point);
    IF $p = NONE { THROW 'PSE_REFUSAL:study_observation_unavailable'; };
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $p.study);
    IF $p.revision != $revision {
        IF $p.outcome = $outcome AND $p.facts = $facts AND $p.settled = $settled { LET $rpc_result = $p; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
        THROW 'PSE_REFUSAL:study_observation_revision_changed';
    };
    IF $p.settled OR $p.attempt != $attempt { THROW 'PSE_REFUSAL:study_observation_attempt_changed_or_already_settled'; };
    IF $attempt != NONE {
        LET $a = SELECT * FROM ONLY type::record('canonical_attempts', $attempt);
        IF $a = NONE OR $a.run != $p.run OR ($a.phase NOT IN ['terminal','terminal_compacted']) { THROW 'PSE_REFUSAL:study_result_attempt_not_admitted'; };
    };
    LET $rpc_result = UPDATE ONLY type::record('canonical_study_points', $point) SET revision += 1dec, assigned = false, settled = $settled, facts = $facts, outcome = $outcome;
    IF $rpc_result.settled AND !$rpc_result.assigned AND $rpc_result.attempt=NONE {
        LET $run=SELECT key FROM ONLY type::record('canonical_runs',$rpc_result.run);
        IF $run=NONE {
            LET $input=SELECT key FROM ONLY type::record('canonical_runs','study-admission:'+$point);
            IF $input=NONE { THROW 'PSE_REFUSAL:unadmitted_occurrence_input_owner_unavailable'; };
            fn::pse_history_v1::identity($rpc_expiry,'effect-free-run',$rpc_result.run,$rpc_result.run);
        } ELSE { fn::pse_history_v1::effect_free($rpc_expiry,$rpc_result); };
    };
    fn::pse_study_v1::readiness_invalidate($rpc_expiry,$rpc_result,false);
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::cancel($rpc_expiry: int, $study: string) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::touch($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies', $study) FOR UPDATE;
    IF $s = NONE OR $s.terminal { THROW 'PSE_REFUSAL:study_unavailable_or_already_concluded'; };
    IF $s.cancelled { LET $rpc_result = $s; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    LET $rpc_result = UPDATE ONLY type::record('canonical_studies', $study) SET cancelled = true, generation += 1dec;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_study_v1::conclude($rpc_expiry: int, $study: string) -> object {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::register($rpc_expiry, 'study-cancel:' + $study);
    LET $s = SELECT * FROM ONLY type::record('canonical_studies', $study) FOR UPDATE;
    IF $s = NONE OR $s.active = false { THROW 'PSE_REFUSAL:study_unavailable'; };
    LET $pending = SELECT key FROM canonical_study_points WHERE study = $study AND settled = false LIMIT 1;
    IF array::len($pending) != 0 { THROW 'PSE_REFUSAL:study_occurrences_not_all_settled'; };
    LET $run = SELECT * FROM ONLY type::record('canonical_runs',$s.run);
    IF $run = NONE OR $run.terminal_attempt = NONE { THROW 'PSE_REFUSAL:study_result_manifest_not_admitted'; };
    LET $attempt=SELECT * FROM ONLY type::record('canonical_attempts',$run.terminal_attempt);
    IF $attempt=NONE OR ($attempt.phase NOT IN ['terminal','terminal_compacted']) OR $attempt.run!=$s.run OR $attempt.finalization_study!=$study OR $attempt.closed_manifest=NONE OR ($s.cancelled AND $attempt.outcome!='cancelled') { THROW 'PSE_REFUSAL:study_conclusion_requires_its_exact_admitted_summary'; };
    LET $rpc_result = UPDATE ONLY type::record('canonical_studies', $study) SET terminal = true;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};


// One physical source-deletion decision shared by stage and membership cleanup.
DEFINE FUNCTION fn::pse_retention_v1::delete_source_version($pse_rpc_expires_at:int,$version:string,$excluded_membership:option<string>,$excluded_stage:option<string>) -> object {
LET $version_guard = type::record('canonical_guards', 'version:' + $version);
SELECT * FROM $version_guard FOR UPDATE; fn::pse_execution_v1::deadline($pse_rpc_expires_at);
LET $members = SELECT key FROM canonical_memberships WHERE version = $version AND ($excluded_membership = NONE OR key != $excluded_membership) LIMIT 1;
LET $stages = SELECT key FROM canonical_staged_edits WHERE version = $version AND ($excluded_stage = NONE OR stage != $excluded_stage)
    AND type::record('canonical_stages', stage).activated = false AND type::record('canonical_stages', stage).abandoned = false
    AND type::record('canonical_stages', stage).expires_at > time::micros() LIMIT 1;
LET $products = SELECT key FROM canonical_product_associations WHERE (content = $version OR receipt = $version) AND type::record('canonical_roots',key).owner_kind = 'product' AND type::record('canonical_roots',key).owner = key AND type::record('canonical_roots',key).problem = problem AND type::record('canonical_roots',key).revision = revision LIMIT 1;
LET $deleted = IF array::len($members) != 0 OR array::len($stages) != 0 OR array::len($products) != 0 {
    {version:false, blocks:0dec, edges:0dec, pending:false}
} ELSE {
    LET $manifest = SELECT * FROM ONLY type::record('canonical_version_manifests', $version);
    UPDATE type::record('canonical_version_manifests', $version) SET closed = false;
    LET $blocks = SELECT key FROM canonical_payload_blocks WHERE version = $version ORDER BY ordinal LIMIT 64;
    LET $edges = SELECT key FROM canonical_edges WHERE source_version = $version ORDER BY ordinal LIMIT 64;
    FOR $block IN $blocks { DELETE ONLY type::record('canonical_payload_blocks', $block.key) RETURN NONE; };
    FOR $edge IN $edges { DELETE ONLY type::record('canonical_edges', $edge.key); };
    LET $remaining_blocks = SELECT key FROM canonical_payload_blocks WHERE version = $version LIMIT 1;
    LET $remaining_edges = SELECT key FROM canonical_edges WHERE source_version = $version LIMIT 1;
    IF array::len($remaining_blocks) = 0 AND array::len($remaining_edges) = 0 {
        DELETE ONLY type::record('canonical_version_manifests', $version);
        {version:$manifest != NONE, blocks:<decimal>array::len($blocks), edges:<decimal>array::len($edges), pending:false}
    } ELSE {
        {version:false, blocks:<decimal>array::len($blocks), edges:<decimal>array::len($edges), pending:true}
    };
};
UPSERT $version_guard SET key = 'version:' + $version, generation = (generation ?? 0dec) + 1dec;
    RETURN $deleted;
};

// Cursor and the candidate's full fresh decision commit in the same native transaction.
DEFINE FUNCTION fn::pse_retention_v1::source_step($pse_rpc_expires_at:int,$problem:string) -> object {
    fn::pse_execution_v1::register($pse_rpc_expires_at,'source-creators:'+$problem);
    LET $guard = type::record('canonical_guards','retention:'+$problem);
    LET $position = SELECT * FROM ONLY $guard FOR UPDATE;
    fn::pse_execution_v1::deadline($pse_rpc_expires_at);
    IF $position=NONE { THROW 'PSE_REFUSAL:reclamation_problem_head_unavailable'; };
    LET $after = $position.source_reclaim_after ?? '';
    LET $candidates = SELECT key FROM canonical_memberships WHERE problem=$problem AND key>$after AND to_sequence!=NONE ORDER BY key LIMIT 1;
    IF array::len($candidates)=0 {
        UPDATE ONLY $guard SET source_reclaim_after=NONE,generation=generation+1dec;
        RETURN {done:true,after:NONE,membership:false,version:false,edges:0dec,blocks:0dec,pending:false};
    };
    LET $candidate = $candidates[0].key;
LET $member = SELECT * FROM ONLY type::record('canonical_memberships', $candidate) FOR UPDATE;
LET $result = IF $member = NONE OR $member.problem != $problem OR $member.to_sequence = NONE {
    {membership:false, version:false, edges:0dec, blocks:0dec, pending:false}
} ELSE {
    LET $head = SELECT * FROM ONLY type::record('canonical_problems', $problem);
    IF $head = NONE { THROW 'PSE_REFUSAL:reclamation_problem_head_unavailable'; };
    LET $roots = SELECT key FROM canonical_roots WHERE problem = $problem AND sequence >= $member.from_sequence AND sequence < $member.to_sequence LIMIT 1;
    LET $pin_page=SELECT key,expires_at FROM canonical_protections WHERE problem=$problem AND sequence >= $member.from_sequence AND sequence < $member.to_sequence AND released=false ORDER BY key LIMIT 64;
    FOR $pin_key IN $pin_page {
        SELECT * FROM ONLY type::record('canonical_protections',$pin_key.key) FOR UPDATE;
        IF $pin_key.expires_at<=time::micros() AND !fn::pse_files_v1::ticket_open($pse_rpc_expires_at,$pin_key.key) { UPDATE ONLY type::record('canonical_protections',$pin_key.key) SET released=true; };
    };
    LET $pins=$pin_page.filter(|$pin|$pin.expires_at>time::micros() OR fn::pse_files_v1::ticket_open($pse_rpc_expires_at,$pin.key));
    IF ($head.sequence >= $member.from_sequence AND $head.sequence < $member.to_sequence) OR array::len($roots) != 0 OR array::len($pins) != 0 {
        {membership:false, version:false, edges:0dec, blocks:0dec, pending:false}
    } ELSE IF array::len($pin_page)=64 {
        {membership:false,version:false,edges:0dec,blocks:0dec,pending:true}
    } ELSE {
        UPSERT type::record('canonical_reclaimed_ranges', $candidate) SET key = $candidate, problem = $problem, from_sequence = $member.from_sequence, to_sequence = $member.to_sequence;
        LET $version = $member.version;
        LET $excluded_membership = $candidate;
        LET $excluded_stage = NONE;
        LET $deleted = fn::pse_retention_v1::delete_source_version($pse_rpc_expires_at,$version,$excluded_membership,$excluded_stage);
        IF $deleted.pending = false { DELETE ONLY type::record('canonical_memberships', $candidate); };
        {membership:!$deleted.pending, version:$deleted.version, edges:$deleted.edges, blocks:$deleted.blocks, pending:$deleted.pending}
    };
};

    LET $next = IF $result.pending { $after } ELSE { $candidate };
    UPDATE ONLY $guard SET source_reclaim_after=$next,generation=generation+1dec;
    fn::pse_execution_v1::deadline($pse_rpc_expires_at);
    RETURN object::extend($result,{done:false,after:$next});
};

// Settlement closes acquisition authority before deleting any per-grant row.
// Continued renewals register the exact pin and therefore invalidate a stale
// settlement decision. The monotone floor remains after physical cleanup.
DEFINE FUNCTION fn::pse_retention_v1::settle_protection($rpc_expiry:int,$problem:string,$key:string) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $parts=string::split($key,':');
    IF array::len($parts)!=4 OR $parts[0]!='pse.protection.v2' OR string::len($parts[1])!=36 OR string::len($parts[2])!=36 OR <int>$parts[3]<=0 { THROW 'PSE_REFUSAL:protection_settlement_immutable_grant_binding'; };
    LET $authority=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$problem) FOR UPDATE;
    IF $authority=NONE { THROW 'PSE_REFUSAL:protection_settlement_authority_unavailable'; };
    LET $pin=SELECT * FROM ONLY type::record('canonical_protections',$key) FOR UPDATE;
    IF $pin!=NONE AND ($pin.problem!=$problem OR $pin.grant_deadline!=<int>$parts[3] OR $pin.grant_nonce!=$parts[2] OR $pin.authority_incarnation!=$parts[1]) { THROW 'PSE_REFUSAL:protection_settlement_requires_original_grant'; };
    IF fn::pse_files_v1::ticket_open($rpc_expiry,$key) { RETURN {complete:false,waiting:true}; };
    IF $authority.incarnation!=$parts[1] {
        // A rotated authority closes old acquisition, but is not evidence that
        // an arbitrary absent grant ever belonged to this problem. Persisted
        // pins, or exact persisted read/header associations, supply that proof.
        IF $pin=NONE {
            LET $artifact_read=SELECT * FROM ONLY type::record('canonical_artifact_reads',$key) FOR UPDATE;
            LET $artifact=IF $artifact_read=NONE { NONE } ELSE { SELECT * FROM ONLY type::record('canonical_artifacts',$artifact_read.artifact) FOR UPDATE };
            LET $result_read=SELECT * FROM ONLY type::record('canonical_result_protections',$key) FOR UPDATE;
            LET $run=IF $result_read=NONE { NONE } ELSE { SELECT * FROM ONLY type::record('canonical_runs',$result_read.run) };
            IF ($artifact=NONE OR $artifact.primary_problem!=$problem) AND ($run=NONE OR $run.problem!=$problem) { THROW 'PSE_REFUSAL:historical_protection_original_receipt_unavailable'; };
            LET $revision_key=IF $artifact!=NONE AND $artifact.primary_problem=$problem { $artifact.revision } ELSE { $run.revision };
            LET $revision=SELECT * FROM ONLY type::record('canonical_revisions',$revision_key);
            IF $revision=NONE OR $revision.problem!=$problem { THROW 'PSE_REFUSAL:historical_protection_original_revision_unavailable'; };
            CREATE ONLY type::record('canonical_protections',$key) SET key=$key,problem=$problem,revision=$revision.key,sequence=$revision.sequence,expires_at=0,released=true,grant_deadline=<int>$parts[3],grant_nonce=$parts[2],authority_incarnation=$parts[1];
        } ELSE {
            // Retain the exact terminal grant as its lost-reply receipt. Released
            // pins retain no source/result bytes and cannot reacquire authority.
            UPDATE ONLY type::record('canonical_protections',$key) SET released=true,expires_at=0;
        };
        DELETE ONLY type::record('canonical_result_protections',$key);
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN {complete:true,waiting:false};
    };
    LET $grant=fn::pse_execution_v1::protection_grant($rpc_expiry,$problem,$key,false);
    IF time::micros()<$grant.grant_deadline { RETURN {complete:false,waiting:true}; };
    IF $pin!=NONE AND !$pin.released AND $pin.expires_at>time::micros() { RETURN {complete:false,waiting:true}; };
    UPDATE ONLY type::record('canonical_guards','retention:'+$problem) SET protection_closed_through=math::max([protection_closed_through ?? 0dec,<decimal>$grant.grant_deadline]);
    DELETE ONLY type::record('canonical_result_protections',$key);
    DELETE ONLY type::record('canonical_protections',$key);
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {complete:true,waiting:false};
};

DEFINE FUNCTION fn::pse_retention_v1::forget_study($rpc_expiry: int, $study:string) -> bool {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::touch($rpc_expiry, 'study:'+$study);
    LET $header=SELECT * FROM ONLY type::record('canonical_studies',$study);
    IF $header=NONE OR !$header.terminal { THROW 'PSE_REFUSAL:only_terminal_studies_may_be_retired'; };
    UPSERT type::record('canonical_study_retirements',$study) SET key=$study,study=$study;
    LET $inputs=SELECT * FROM canonical_artifact_obligations WHERE owner_kind='study' AND owner=$study ORDER BY key LIMIT 64;
    FOR $input IN $inputs { fn::pse_artifact_v1::release($rpc_expiry,object::remove($input,['id'])); };
    LET $rpc_result = array::len($inputs)<64;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

// The occurrence key carries its immutable authority and expiry even after header deletion.
DEFINE FUNCTION fn::pse_retention_v1::forget_analysis($rpc_expiry: int, $analysis:string) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $header=SELECT * FROM ONLY type::record('canonical_analyses',$analysis) FOR UPDATE;
    IF $header=NONE {
        LET $parts=string::split($analysis,':');
        IF array::len($parts)!=4 OR $parts[0]!='pse.analysis.v2' OR string::len($parts[1])!=36 OR string::len($parts[2])!=36 { THROW 'PSE_REFUSAL:unknown_analysis_key_has_no_creation_authority'; };
        LET $authorities=SELECT key FROM canonical_guards WITH INDEX guard_incarnation WHERE incarnation=$parts[1] LIMIT 2;
        IF array::len($authorities)!=1 OR !string::starts_with($authorities[0].key,'retention:') { THROW 'PSE_REFUSAL:analysis_creation_authority_unavailable'; };
        LET $intent={key:$analysis,primary_problem:string::slice($authorities[0].key,10),primary_authority:$parts[1],creation_nonce:$parts[2],creation_expires_at:<decimal>$parts[3]};
        RETURN fn::pse_retention_v1::settle_analysis($rpc_expiry,$intent);
    };
    UPDATE ONLY type::record('canonical_analyses',$analysis) SET retiring=true;
    LET $edges=SELECT id FROM canonical_analysis_edges WHERE analysis=$analysis ORDER BY key LIMIT 64;
    IF array::len($edges)!=0 { DELETE $edges.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    LET $nodes=SELECT id FROM canonical_analysis_nodes WHERE analysis=$analysis ORDER BY key LIMIT 64;
    IF array::len($nodes)!=0 { DELETE $nodes.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    LET $inputs=SELECT id,artifact FROM canonical_analysis_inputs WHERE analysis=$analysis ORDER BY key LIMIT 64;
    IF array::len($inputs)!=0 { FOR $input IN $inputs { LET $owners=SELECT * FROM canonical_artifact_obligations WHERE artifact=$input.artifact AND owner_kind='analysis' AND owner=$analysis LIMIT 1; FOR $owner IN $owners { fn::pse_artifact_v1::release($rpc_expiry,object::remove($owner,['id'])); }; }; DELETE $inputs.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    LET $roots=SELECT id,problem FROM canonical_roots WHERE owner_kind='analysis' AND owner=$analysis ORDER BY key LIMIT 64;
    IF array::len($roots)!=0 {
        FOR $root IN $roots {
            LET $source=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$root.problem) FOR UPDATE;
            IF $source=NONE { THROW 'PSE_REFUSAL:analysis_cleanup_source_authority_unavailable'; };
        };
        DELETE $roots.id;
        fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false};
    };
    LET $authority=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$header.primary_problem) FOR UPDATE;
    IF $authority=NONE { THROW 'PSE_REFUSAL:analysis_original_settlement_authority_unavailable'; };
    IF $authority.incarnation=$header.primary_authority AND time::micros()<$header.creation_expires_at { fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:true}; };
    RETURN fn::pse_retention_v1::settle_analysis($rpc_expiry,$header);
};

DEFINE FUNCTION fn::pse_retention_v1::settle_analysis($rpc_expiry:int,$intent:object) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $header=SELECT * FROM ONLY type::record('canonical_analyses',$intent.key) FOR UPDATE;
    LET $guard=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$intent.primary_problem) FOR UPDATE;
    IF $guard=NONE OR ($guard.incarnation!=$intent.primary_authority AND $header=NONE) { THROW 'PSE_REFUSAL:analysis_settlement_authority_unavailable'; };
    IF $intent.key!='pse.analysis.v2:'+$intent.primary_authority+':'+$intent.creation_nonce+':'+<string><int>$intent.creation_expires_at { THROW 'PSE_REFUSAL:analysis_settlement_key_binding'; };
    IF $guard.incarnation=$intent.primary_authority AND time::micros()<$intent.creation_expires_at { fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:true}; };
    IF $header!=NONE AND object::remove($header,['id','active','retiring'])!=object::remove($intent,['id','active','retiring']) { THROW 'PSE_REFUSAL:analysis_settlement_requires_exact_original_occurrence'; };
    IF $header!=NONE AND !$header.retiring { UPDATE ONLY type::record('canonical_analyses',$intent.key) SET retiring=true; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    LET $edges=SELECT key FROM canonical_analysis_edges WHERE analysis=$intent.key LIMIT 1;
    LET $nodes=SELECT key FROM canonical_analysis_nodes WHERE analysis=$intent.key LIMIT 1;
    LET $inputs=SELECT key FROM canonical_analysis_inputs WHERE analysis=$intent.key LIMIT 1;
    LET $roots=SELECT key FROM canonical_roots WHERE owner_kind='analysis' AND owner=$intent.key LIMIT 1;
    IF array::len($edges)+array::len($nodes)+array::len($inputs)+array::len($roots)!=0 { fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    IF $guard.incarnation=$intent.primary_authority {
        UPDATE ONLY type::record('canonical_guards','retention:'+$intent.primary_problem) SET generation=generation+1dec, analysis_creation_closed_through=math::max([analysis_creation_closed_through ?? 0dec,$intent.creation_expires_at]);
        DELETE ONLY type::record('canonical_analyses',$intent.key);
    } ELSE {
        UPDATE ONLY type::record('canonical_analyses',$intent.key) SET active=false,retiring=true;
    };
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN {complete:true,waiting:false};
};

DEFINE FUNCTION fn::pse_retention_v1::forget_run($rpc_expiry: int, $run:string) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:'+$run);
    fn::pse_execution_v1::register($rpc_expiry,'result-creators:'+$run);
    LET $old=SELECT * FROM ONLY type::record('canonical_result_retirements',$run) FOR UPDATE;
    IF $old!=NONE { LET $rpc_result = $old; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    LET $header=SELECT * FROM ONLY type::record('canonical_runs',$run);
    IF $header=NONE { THROW 'PSE_REFUSAL:retired_run_unavailable'; };
    fn::pse_execution_v1::register($rpc_expiry, 'retention:'+$header.problem);
    LET $live=SELECT key FROM canonical_attempts WHERE run=$run AND phase NOT IN ['terminal','terminal_compacted'] LIMIT 1;
    IF array::len($live)!=0 OR ($header.terminal_attempt=NONE AND (SELECT * FROM ONLY type::record('canonical_history_identities','effect-free-run:'+$run))=NONE) { THROW 'PSE_REFUSAL:run_recovery_must_finish_before_retirement'; };
    LET $reader_page=SELECT key FROM canonical_result_protections WHERE run=$run AND type::record('canonical_protections',key).released=false ORDER BY key LIMIT 64;
    LET $readers=$reader_page.filter(|$reader|type::record('canonical_protections',$reader.key).expires_at>time::micros() OR fn::pse_files_v1::ticket_open($rpc_expiry,$reader.key));
    FOR $reader IN $reader_page {
        LET $pin=SELECT * FROM ONLY type::record('canonical_protections',$reader.key) FOR UPDATE;
        IF $pin!=NONE AND !$pin.released AND $pin.expires_at<=time::micros() AND !fn::pse_files_v1::ticket_open($rpc_expiry,$reader.key) { UPDATE ONLY type::record('canonical_protections',$reader.key) SET released=true; };
    };
    IF array::len($readers)!=0 { THROW 'PSE_REFUSAL:run_results_have_protected_readers'; };
    IF array::len($reader_page)=64 { RETURN {pending:true}; };
    LET $point=SELECT study FROM canonical_study_points WHERE run=$run LIMIT 1;
    LET $parent=SELECT key FROM canonical_studies WHERE run=$run LIMIT 1;
    LET $studies=array::distinct(array::concat($point.study,$parent.key));
    FOR $study IN $studies {
        SELECT * FROM ONLY type::record('canonical_study_retirements',$study) FOR UPDATE;
        IF (SELECT * FROM ONLY type::record('canonical_study_retirements',$study))=NONE { THROW 'PSE_REFUSAL:run_results_are_retained_by_a_study'; };
    };
    LET $staging=SELECT key FROM canonical_artifact_staging_inputs WHERE run=$run LIMIT 1;
    IF array::len($staging)!=0 { THROW 'PSE_REFUSAL:run_results_have_unsettled_artifact_transfer'; };

    LET $project_refs=SELECT key FROM canonical_research_references WITH INDEX project_research_run WHERE run=$run LIMIT 1;
    IF array::len($project_refs)!=0 { THROW 'PSE_REFUSAL:project_research_retains_results'; };
    LET $roots=SELECT key,problem FROM canonical_roots WHERE owner_kind='run' AND owner=$run ORDER BY key LIMIT 66;
    IF array::len($roots)>65 { THROW 'PSE_REFUSAL:run_source_retention_limit'; };
    FOR $root IN $roots { fn::pse_execution_v1::source_creator($rpc_expiry,$root.problem,$root.key); };
    DELETE $roots.map(|$root|type::record('canonical_roots',$root.key));
    LET $rpc_result = CREATE ONLY type::record('canonical_result_retirements',$run) SET key=$run,run=$run,after_generation=0dec,complete=false;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_retention_v1::collect_run($rpc_expiry: int, $run:string) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::touch($rpc_expiry, 'execution-run:'+$run);
    LET $retirement=SELECT * FROM ONLY type::record('canonical_result_retirements',$run);
    IF $retirement=NONE { THROW 'PSE_REFUSAL:explicit_run_retirement_required'; };
    IF $retirement.complete { RETURN {complete:true,batches:0dec,indexes:0dec,sets:0dec}; };
    LET $attempts=SELECT key,generation FROM canonical_attempts WHERE run=$run AND generation>$retirement.after_generation ORDER BY generation LIMIT 1;
    IF array::len($attempts)=0 {
        UPDATE ONLY type::record('canonical_result_retirements',$run) SET complete=true;
        LET $rpc_result = {complete:true,batches:0dec,indexes:0dec,sets:0dec};
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    };
    LET $attempt=$attempts[0];
    LET $sets=SELECT key FROM canonical_result_sets WHERE attempt=$attempt.key ORDER BY name LIMIT 1;
    IF array::len($sets)!=0 {
        LET $set=$sets[0].key;
        LET $batches=SELECT key FROM canonical_result_batches WHERE result_set=$set ORDER BY ordinal LIMIT 1;
        IF array::len($batches)!=0 {
            LET $batch=$batches[0].key;
            LET $outputs=SELECT key FROM canonical_result_block_outputs WHERE batch=$batch ORDER BY key LIMIT 64;
            DELETE $outputs.map(|$row|type::record('canonical_result_block_outputs',$row.key));
            LET $remaining_outputs=SELECT key FROM canonical_result_block_outputs WHERE batch=$batch LIMIT 1;
            LET $deleted=array::len($remaining_outputs)=0;
            IF $deleted { fn::pse_files_v1::release_borrower($rpc_expiry,'result:'+$batch); DELETE ONLY type::record('canonical_result_blocks',$batch); DELETE ONLY type::record('canonical_result_batches',$batch); };
            LET $rpc_result = {complete:false,batches:IF $deleted {1dec} ELSE {0dec},indexes:<decimal>array::len($outputs),sets:0dec};
            fn::pse_execution_v1::deadline($rpc_expiry);
            RETURN $rpc_result;
        };
        DELETE ONLY type::record('canonical_result_sets',$set);
        LET $rpc_result = {complete:false,batches:0dec,indexes:0dec,sets:1dec};
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    };
    LET $seeds=SELECT key FROM canonical_result_seeds WHERE attempt=$attempt.key ORDER BY step LIMIT 64;
    DELETE $seeds.map(|$row|type::record('canonical_result_seeds',$row.key));
    IF array::len($seeds)=64 { RETURN {complete:false,batches:0dec,indexes:<decimal>array::len($seeds),sets:0dec}; };
    // Operation identities and full detail belong to explicit history release.
    // Payload collection never deletes a receipt that a delayed caller can replay.
    LET $manifest=SELECT closed_manifest FROM ONLY type::record('canonical_attempts',$attempt.key);
    IF $manifest.closed_manifest!=NONE { DELETE ONLY type::record('canonical_result_manifests',$manifest.closed_manifest); };
    // Inline observations and operation response bytes are scientific payloads,
    // while the effect identity/request and actual terminal class remain receipts.
    UPDATE ONLY type::record('canonical_attempts',$attempt.key) SET phase='terminal_compacted',completion=NONE;
    LET $operations=SELECT key FROM canonical_execution_operations WHERE run=$run AND kind='seal' AND attempt=$attempt.key LIMIT 1;
    FOR $operation IN $operations { UPDATE ONLY type::record('canonical_execution_operations',$operation.key) SET result=type::bytes(''); };
    UPDATE ONLY type::record('canonical_result_retirements',$run) SET after_generation=$attempt.generation;
    LET $rpc_result = {complete:false,batches:0dec,indexes:<decimal>array::len($seeds),sets:0dec};
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_analysis_v1::available($rpc_expiry: int, $key: string) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $row=SELECT * FROM ONLY type::record('canonical_analyses',$key) FOR UPDATE;
    IF $row=NONE OR $row.retiring { THROW 'PSE_REFUSAL:analysis_unavailable'; };
    LET $rpc_result = $row;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_analysis_v1::begin($rpc_expiry: int, $row: object,$sources: array<object>,$inputs: array<object>) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $authority=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$row.primary_problem) FOR UPDATE;
    LET $now=time::micros();
    IF $authority=NONE OR $authority.incarnation=NONE OR $authority.incarnation!=$row.primary_authority { THROW 'PSE_REFUSAL:analysis_primary_authority_unavailable'; };
    IF $row.key!='pse.analysis.v2:'+$row.primary_authority+':'+$row.creation_nonce+':'+<string><int>$row.creation_expires_at OR string::len($row.creation_nonce)!=36 { THROW 'PSE_REFUSAL:analysis_immutable_creation_binding'; };
    IF $row.creation_expires_at<=$now OR $row.creation_expires_at>$now+60000000 OR $row.creation_expires_at<=($authority.analysis_creation_closed_through ?? 0dec) { THROW 'PSE_REFUSAL:analysis_creation_window_closed'; };
    IF array::len($sources)=0 OR array::len($sources)>65 OR array::len($inputs)>64 OR $row.node_count>4096dec OR $row.edge_count>8192dec OR string::len($row.creation_request_digest)!=64 OR $row.active OR $row.retiring { THROW 'PSE_REFUSAL:analysis_admission_bound'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_analyses',$row.key) FOR UPDATE;
    IF $old!=NONE {
        IF $old.retiring OR object::remove($old,['id','active'])!=object::remove($row,['active']) { THROW 'PSE_REFUSAL:immutable_analysis_identity_changed'; };
        LET $retained_sources=SELECT key FROM canonical_roots WHERE owner_kind='analysis' AND owner=$row.key LIMIT 66;
        LET $retained_inputs=SELECT key FROM canonical_analysis_inputs WHERE analysis=$row.key LIMIT 65;
        IF array::len($retained_sources)!=array::len($sources) OR array::len($retained_inputs)!=array::len($inputs) { THROW 'PSE_REFUSAL:immutable_analysis_lineage_coverage_changed'; };
        FOR $source IN $sources {
            LET $root=SELECT * FROM ONLY type::record('canonical_roots',$source.key);
            IF $root=NONE OR $root.owner_kind!='analysis' OR $root.owner!=$row.key OR $root.problem!=$source.problem OR $root.revision!=$source.revision OR $root.sequence!=$source.sequence { THROW 'PSE_REFUSAL:immutable_analysis_source_changed'; };
        };
        FOR $input IN $inputs {
            LET $selected=SELECT * FROM ONLY type::record('canonical_analysis_inputs',$input.key);
            IF $selected=NONE OR $selected.analysis!=$row.key OR $selected.artifact!=$input.artifact { THROW 'PSE_REFUSAL:immutable_analysis_input_changed'; };
        };
        LET $rpc_result = $old;
        fn::pse_execution_v1::deadline($rpc_expiry);
        RETURN $rpc_result;
    };
    FOR $source IN $sources {
        fn::pse_execution_v1::source_creator($rpc_expiry,$source.problem,$source.key);
        LET $guard=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$source.problem) FOR UPDATE;
        IF $guard=NONE { THROW 'PSE_REFUSAL:analysis_source_authority_unavailable'; };
        LET $revision=SELECT * FROM ONLY type::record('canonical_revisions',$source.revision);
        IF $revision=NONE OR $revision.problem!=$source.problem OR $revision.sequence!=$source.sequence OR $revision.interpretation!=$row.interpretation { THROW 'PSE_REFUSAL:analysis_source_unavailable'; };
        LET $pruned=SELECT key FROM canonical_reclaimed_ranges WHERE problem=$source.problem AND from_sequence<=$source.sequence AND to_sequence>$source.sequence LIMIT 1;
        IF array::len($pruned)!=0 { THROW 'PSE_REFUSAL:analysis_source_reclaimed'; };
    };
    IF array::len($sources[WHERE revision=$row.revision AND problem=$row.primary_problem])!=1 OR $row.revision NOT IN $sources.revision { THROW 'PSE_REFUSAL:analysis_primary_source_omitted'; };
    FOR $input IN $inputs {
        LET $artifact=fn::pse_artifact_v1::available($rpc_expiry,$input.artifact);
        LET $pin=SELECT * FROM ONLY type::record('canonical_protections',$input.protection) FOR UPDATE;
        LET $read=SELECT * FROM ONLY type::record('canonical_artifact_reads',$input.protection);
        IF $pin=NONE OR $pin.released OR ($pin.expires_at<=time::micros() AND !fn::pse_files_v1::ticket_open($rpc_expiry,$input.protection)) OR $pin.revision!=$artifact.revision OR $read=NONE OR $read.artifact!=$input.artifact OR $input.analysis!=$row.key { THROW 'PSE_REFUSAL:analysis_artifact_input_not_admitted'; };
        LET $selected=SELECT revision FROM canonical_roots WHERE owner_kind='artifact' AND owner=$input.artifact LIMIT 66;
        IF array::len($selected)=0 OR array::len($selected)>65 OR array::len(array::complement($selected.revision,$sources.revision))!=0 { THROW 'PSE_REFUSAL:analysis_omitted_artifact_source'; };
    };
    LET $saved=CREATE ONLY type::record('canonical_analyses',$row.key) CONTENT $row;
    FOR $source IN $sources {
        CREATE ONLY type::record('canonical_roots',$source.key) SET key=$source.key,problem=$source.problem,revision=$source.revision,sequence=$source.sequence,owner_kind='analysis',owner=$row.key;
    };
    FOR $input IN $inputs {
        fn::pse_artifact_v1::attach($rpc_expiry,$input.artifact,$input.obligation,true);
        INSERT RELATION INTO canonical_analysis_inputs object::extend(object::remove($input,['protection','obligation']),{id:type::record('canonical_analysis_inputs',$input.key),in:type::record('canonical_analyses',$row.key),out:type::record('canonical_artifacts',$input.artifact)}) RETURN NONE;
    };
    LET $rpc_result = $saved;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_analysis_v1::append($rpc_expiry: int, $key: string,$nodes: array<object>,$edges: array<object>) -> bool {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $row=fn::pse_analysis_v1::available($rpc_expiry, $key);
    IF array::len($nodes)>64 OR array::len($edges)>64 { THROW 'PSE_REFUSAL:analysis_stage_batch_bound'; };
    FOR $node IN $nodes {
        IF $node.analysis!=$key { THROW 'PSE_REFUSAL:analysis_node_membership'; };
        LET $old=SELECT * FROM ONLY type::record('canonical_analysis_nodes',$node.key);
        IF $old!=NONE { IF object::remove($old,['id'])!=$node { THROW 'PSE_REFUSAL:immutable_analysis_node_changed'; }; }
        ELSE { IF $row.active { THROW 'PSE_REFUSAL:analysis_graph_closed'; }; CREATE ONLY type::record('canonical_analysis_nodes',$node.key) CONTENT $node; };
    };
    LET $endpoint_keys=array::distinct(array::concat($edges.source,$edges.target));
    LET $endpoints=$endpoint_keys.map(|$endpoint| SELECT key,analysis FROM ONLY type::record('canonical_analysis_nodes',$endpoint));
    LET $evidenced=$edges.filter(|$edge| $edge.evidence_artifact!=NONE);
    LET $artifacts=array::distinct($evidenced.evidence_artifact);
    LET $inputs=$artifacts.map(|$artifact| {artifact:$artifact,matches:(SELECT key FROM canonical_analysis_inputs WHERE analysis=$key AND artifact=$artifact LIMIT 1)});
    LET $coordinates=array::distinct($evidenced.map(|$edge| {artifact:$edge.evidence_artifact,ordinal:$edge.evidence_block}));
    LET $blocks=$coordinates.map(|$coordinate| {artifact:$coordinate.artifact,ordinal:$coordinate.ordinal,matches:(SELECT rows FROM canonical_artifact_blocks WHERE artifact=$coordinate.artifact AND ordinal=$coordinate.ordinal LIMIT 1)});
    FOR $edge IN $edges {
        IF $edge.analysis!=$key OR array::len($endpoints.filter(|$endpoint| $endpoint.key=$edge.source AND $endpoint.analysis=$key))!=1 OR array::len($endpoints.filter(|$endpoint| $endpoint.key=$edge.target AND $endpoint.analysis=$key))!=1 { THROW 'PSE_REFUSAL:analysis_edge_membership'; };
        IF ($edge.evidence_artifact=NONE)!=($edge.evidence_block=NONE) OR ($edge.evidence_artifact=NONE AND ($edge.evidence_row!=NONE OR $edge.evidence_field!=NONE)) { THROW 'PSE_REFUSAL:analysis_typed_evidence_incomplete'; };
        IF $edge.evidence_artifact!=NONE {
            LET $input=$inputs.filter(|$input| $input.artifact=$edge.evidence_artifact);
            LET $block=$blocks.filter(|$block| $block.artifact=$edge.evidence_artifact AND $block.ordinal=$edge.evidence_block);
            IF array::len($input)!=1 OR array::len($input[0].matches)!=1 OR array::len($block)!=1 OR array::len($block[0].matches)!=1 OR ($edge.evidence_row!=NONE AND $edge.evidence_row>=$block[0].matches[0].rows) { THROW 'PSE_REFUSAL:analysis_evidence_outside_retained_artifact'; };
        };
        LET $old=SELECT * FROM ONLY type::record('canonical_analysis_edges',$edge.key);
        IF $old!=NONE { IF $old.key!=$edge.key OR $old.analysis!=$edge.analysis OR $old.source!=$edge.source OR $old.target!=$edge.target OR $old.kind!=$edge.kind OR $old.evidence_artifact!=$edge.evidence_artifact OR $old.evidence_block!=$edge.evidence_block OR $old.evidence_row!=$edge.evidence_row OR $old.evidence_field!=$edge.evidence_field { THROW 'PSE_REFUSAL:immutable_analysis_edge_changed'; }; }
        ELSE { IF $row.active { THROW 'PSE_REFUSAL:analysis_graph_closed'; }; INSERT RELATION INTO canonical_analysis_edges object::extend($edge,{id:type::record('canonical_analysis_edges',$edge.key),in:type::record('canonical_analysis_nodes',$edge.source),out:type::record('canonical_analysis_nodes',$edge.target)}) RETURN NONE; };
    };
    LET $rpc_result = true;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_analysis_v1::activate($rpc_expiry: int, $key: string) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $row=fn::pse_analysis_v1::available($rpc_expiry, $key);
    LET $nodes=SELECT key FROM canonical_analysis_nodes WHERE analysis=$key LIMIT 4097;
    LET $edges=SELECT key FROM canonical_analysis_edges WHERE analysis=$key LIMIT 8193;
    IF array::len($nodes)!=$row.node_count OR array::len($edges)!=$row.edge_count { THROW 'PSE_REFUSAL:analysis_membership_incomplete'; };
    LET $rpc_result = UPDATE ONLY type::record('canonical_analyses',$key) SET active=true;
    fn::pse_execution_v1::deadline($rpc_expiry);
    RETURN $rpc_result;
};

DEFINE FUNCTION fn::pse_analysis_v1::read($rpc_expiry: int, $key: string,$after: string,$kind: string) -> array<object> {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $row=fn::pse_analysis_v1::available($rpc_expiry, $key);
    IF !$row.active { THROW 'PSE_REFUSAL:analysis_graph_incomplete'; };
    IF $kind='nodes' { LET $rpc_result = SELECT * FROM canonical_analysis_nodes WHERE analysis=$key AND key>$after ORDER BY key LIMIT 64; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    IF $kind='edges' { LET $rpc_result = SELECT * FROM canonical_analysis_edges WHERE analysis=$key AND key>$after ORDER BY key LIMIT 64; fn::pse_execution_v1::deadline($rpc_expiry); RETURN $rpc_result; };
    THROW 'PSE_REFUSAL:analysis_page_kind';
};

DEFINE FUNCTION fn::pse_artifact_v1::abandon_study_inputs($rpc_expiry:int,$study:string) -> bool {
    fn::pse_execution_v1::touch($rpc_expiry,'study:'+$study);
    LET $header=SELECT * FROM ONLY type::record('canonical_studies',$study) FOR UPDATE;
    IF $header!=NONE { THROW 'PSE_REFUSAL:study_input_abandonment_requires_absent_header'; };
    UPSERT type::record('canonical_study_retirements',$study) SET key=$study,study=$study;
    LET $owners=SELECT * FROM canonical_artifact_obligations WHERE owner_kind='study' AND owner=$study ORDER BY key LIMIT 64;
    FOR $owner IN $owners { fn::pse_artifact_v1::release($rpc_expiry,object::remove($owner,['id'])); };
    LET $inputs=SELECT id FROM canonical_study_inputs WHERE study=$study ORDER BY key LIMIT 64;
    DELETE $inputs.id;
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN array::len($owners)<64 AND array::len($inputs)<64;
};
DEFINE FUNCTION fn::pse_artifact_v1::authority($rpc_expiry:int,$row:object) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $guard=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$row.primary_problem) FOR UPDATE;
    IF $guard=NONE OR $guard.incarnation!=$row.primary_authority OR $row.key!='pse.artifact.v1:'+$row.primary_authority+':'+$row.creation_nonce+':'+<string><int>$row.creation_expires_at { THROW 'PSE_REFUSAL:artifact_creation_authority_differs'; };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $guard;
};
// Recovery validates the original immutable intent without granting content access.
DEFINE FUNCTION fn::pse_artifact_v1::original($rpc_expiry:int,$intent:object) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $guard=SELECT * FROM ONLY type::record('canonical_guards','retention:'+$intent.primary_problem) FOR UPDATE;
    LET $row=SELECT * FROM ONLY type::record('canonical_artifacts',$intent.key) FOR UPDATE;
    IF $guard=NONE OR $intent.key!='pse.artifact.v1:'+$intent.primary_authority+':'+$intent.creation_nonce+':'+<string><int>$intent.creation_expires_at { THROW 'PSE_REFUSAL:artifact_original_settlement_authority_unavailable'; };
    IF $row!=NONE AND object::remove($row,['id','active','retiring'])!=object::remove($intent,['id','active','retiring']) { THROW 'PSE_REFUSAL:artifact_recovery_requires_exact_original_intent'; };
    IF $guard.incarnation!=$intent.primary_authority AND $row=NONE { THROW 'PSE_REFUSAL:historical_artifact_settlement_receipt_unavailable'; };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $guard;
};
DEFINE FUNCTION fn::pse_artifact_v1::available($rpc_expiry:int,$key:string) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $row=SELECT * FROM ONLY type::record('canonical_artifacts',$key) FOR UPDATE;
    IF $row=NONE OR !$row.active OR $row.retiring { THROW 'PSE_REFUSAL:artifact_unavailable'; };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $row;
};
DEFINE FUNCTION fn::pse_artifact_v1::producer($rpc_expiry:int,$input:object) -> bool {
    fn::pse_execution_v1::result_creator($rpc_expiry,$input.run);
    fn::pse_execution_v1::available($rpc_expiry,$input.run);
    LET $attempt=SELECT * FROM ONLY type::record('canonical_attempts',$input.attempt);
    LET $manifest=SELECT * FROM ONLY type::record('canonical_result_manifests',$input.manifest);
    IF $attempt=NONE OR $manifest=NONE OR $attempt.run!=$input.run OR ($attempt.phase NOT IN ['terminal','terminal_compacted']) OR $attempt.closed_manifest!=$input.manifest OR $manifest.attempt!=$input.attempt OR $manifest.generation!=$attempt.generation { THROW 'PSE_REFUSAL:artifact_producer_inventory_unavailable'; };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_artifact_v1::begin($rpc_expiry:int,$row:object,$sources:array<object>,$inputs:array<object>) -> object {
    LET $guard=fn::pse_artifact_v1::authority($rpc_expiry,$row);
    LET $now=time::micros();
    IF $row.creation_expires_at<=$now OR $row.creation_expires_at>$now+60000000 OR $row.creation_expires_at<=($guard.artifact_creation_closed_through ?? 0dec) { THROW 'PSE_REFUSAL:artifact_creation_window_closed'; };
    IF $row.active OR $row.retiring OR string::len($row.creation_nonce)!=36 OR string::len($row.creation_request_digest)!=64 OR array::len($sources)=0 OR array::len($sources)>65 OR array::len($inputs)>64 OR $row.block_count=0dec OR bytes::len($row.provenance)>131072 { THROW 'PSE_REFUSAL:artifact_closure_admission_bound'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_artifacts',$row.key) FOR UPDATE;
    IF $old!=NONE {
        IF $old.retiring OR object::remove($old,['id','active'])!=object::remove($row,['active']) { THROW 'PSE_REFUSAL:immutable_artifact_request_changed'; };
        fn::pse_execution_v1::deadline($rpc_expiry); RETURN $old;
    };
    FOR $source IN $sources {
        fn::pse_execution_v1::source_creator($rpc_expiry,$source.problem,$source.key);
        LET $revision=SELECT * FROM ONLY type::record('canonical_revisions',$source.revision);
        LET $pruned=SELECT key FROM canonical_reclaimed_ranges WHERE problem=$source.problem AND from_sequence<=$source.sequence AND to_sequence>$source.sequence LIMIT 1;
        IF $revision=NONE OR $revision.problem!=$source.problem OR $revision.sequence!=$source.sequence OR $revision.interpretation!=$row.interpretation OR array::len($pruned)!=0 { THROW 'PSE_REFUSAL:artifact_source_unavailable'; };
    };
    IF array::len($sources[WHERE revision=$row.revision AND problem=$row.primary_problem])!=1 { THROW 'PSE_REFUSAL:artifact_primary_source_omitted'; };
    FOR $input IN $inputs {
        fn::pse_artifact_v1::producer($rpc_expiry,$input);
        LET $pin=SELECT * FROM ONLY type::record('canonical_protections',$input.protection) FOR UPDATE;
        LET $selected=SELECT * FROM ONLY type::record('canonical_result_protections',$input.protection);
        IF $pin=NONE OR $pin.released OR ($pin.expires_at<=time::micros() AND !fn::pse_files_v1::ticket_open($rpc_expiry,$input.protection)) OR $selected=NONE OR $selected.run!=$input.run OR $selected.attempt!=$input.attempt OR $selected.manifest!=$input.manifest { THROW 'PSE_REFUSAL:artifact_exact_producer_protection_absent'; };
        LET $actual=SELECT revision FROM canonical_run_sources WHERE run=$input.run LIMIT 66;
        IF array::len($actual)=0 OR array::len($actual)>65 OR array::len(array::complement($actual.revision,$sources.revision))!=0 { THROW 'PSE_REFUSAL:artifact_actual_source_omitted'; };
    };
    CREATE ONLY type::record('canonical_artifacts',$row.key) CONTENT $row;
    FOR $source IN $sources { CREATE ONLY type::record('canonical_roots',$source.key) SET key=$source.key,problem=$source.problem,revision=$source.revision,sequence=$source.sequence,owner_kind='artifact',owner=$row.key; };
    FOR $input IN $inputs { CREATE ONLY type::record('canonical_artifact_staging_inputs',$input.key) CONTENT object::remove($input,['protection']); };
    FOR $input IN $inputs {
        LET $pin=SELECT * FROM ONLY type::record('canonical_protections',$input.protection) FOR UPDATE;
        IF $pin=NONE OR $pin.released { THROW 'PSE_REFUSAL:artifact_transfer_protection_unavailable'; };
        IF !fn::pse_files_v1::ticket_open($rpc_expiry,$input.protection) { fn::pse_execution_v1::lease($rpc_expiry,$pin.expires_at); };
    };
    fn::pse_execution_v1::lease($rpc_expiry,<int>$row.creation_expires_at);
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $row;
};
DEFINE FUNCTION fn::pse_artifact_v1::append($rpc_expiry:int,$key:string,$block:object) -> bool {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $row=SELECT * FROM ONLY type::record('canonical_artifacts',$key) FOR UPDATE;
    IF $row=NONE OR $row.retiring OR $block.artifact!=$key OR $block.ordinal>=$row.block_count OR $block.payload_bytes>33554432dec OR string::len($block.digest)!=64 { THROW 'PSE_REFUSAL:artifact_block_admission'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_artifact_blocks',$block.key);
    IF $old!=NONE { IF object::remove($old,['id'])!=$block { THROW 'PSE_REFUSAL:immutable_artifact_block_changed'; }; }
    ELSE { IF $row.active { THROW 'PSE_REFUSAL:artifact_content_sealed'; }; fn::pse_files_v1::attach($rpc_expiry,$block,'artifact',$key,'artifact:'+$block.key); CREATE ONLY type::record('canonical_artifact_blocks',$block.key) CONTENT $block; };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};
// All rows attach under the caller's single metadata-only transaction. File
// reservation/sealing has already completed outside this transaction.
DEFINE FUNCTION fn::pse_artifact_v1::append_many($rpc_expiry:int,$key:string,$blocks:array) -> array {
    fn::pse_execution_v1::deadline($rpc_expiry);
    IF array::len($blocks)=0 OR array::len($blocks)>64 OR array::len(array::distinct($blocks.key))!=array::len($blocks) { THROW 'PSE_REFUSAL:artifact_metadata_group_extent_or_identity'; };
    FOR $block IN $blocks { fn::pse_artifact_v1::append($rpc_expiry,$key,$block); };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $blocks.key;
};
DEFINE FUNCTION fn::pse_artifact_v1::activate($rpc_expiry:int,$key:string,$obligation:object) -> object {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $row=SELECT * FROM ONLY type::record('canonical_artifacts',$key) FOR UPDATE;
    IF $row=NONE OR $row.retiring { THROW 'PSE_REFUSAL:artifact_staging_unavailable'; };
    fn::pse_artifact_v1::authority($rpc_expiry,$row);
    IF !$row.active AND $row.creation_expires_at<=time::micros() { THROW 'PSE_REFUSAL:artifact_creation_expired_before_activation'; };
    LET $inputs=SELECT * FROM canonical_artifact_staging_inputs WHERE artifact=$key ORDER BY key LIMIT 65;
    IF array::len($inputs)>64 { THROW 'PSE_REFUSAL:artifact_input_bound'; };
    FOR $input IN $inputs { fn::pse_artifact_v1::producer($rpc_expiry,$input); };
    LET $coverage=SELECT count() AS n, math::sum(payload_bytes) AS bytes FROM canonical_artifact_blocks WHERE artifact=$key GROUP ALL;
    IF $coverage[0].n!=$row.block_count OR $coverage[0].bytes!=$row.payload_bytes { THROW 'PSE_REFUSAL:artifact_content_incomplete'; };
    fn::pse_artifact_v1::attach($rpc_expiry,$key,$obligation,false);
    DELETE $inputs.id;
    LET $saved=UPDATE ONLY type::record('canonical_artifacts',$key) SET active=true;
    IF !$row.active { fn::pse_execution_v1::lease($rpc_expiry,<int>$row.creation_expires_at); };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $saved;
};
DEFINE FUNCTION fn::pse_artifact_v1::attach($rpc_expiry:int,$key:string,$obligation:object,$require_active:bool) -> bool {
    fn::pse_execution_v1::deadline($rpc_expiry);
    LET $row=SELECT * FROM ONLY type::record('canonical_artifacts',$key) FOR UPDATE;
    IF $row=NONE OR $row.retiring OR ($require_active AND !$row.active) OR $obligation.artifact!=$key OR $obligation.owner_kind NOT IN ['study','analysis','user','project','audit'] OR string::len($obligation.owner)=0 { THROW 'PSE_REFUSAL:artifact_obligation_unavailable'; };
    IF $obligation.owner_kind='study' { fn::pse_execution_v1::register($rpc_expiry,'study:'+$obligation.owner); IF (SELECT * FROM ONLY type::record('canonical_study_retirements',$obligation.owner))!=NONE { THROW 'PSE_REFUSAL:study_artifact_owner_retired'; }; };
IF $obligation.owner_kind='analysis' { LET $analysis=SELECT * FROM ONLY type::record('canonical_analyses',$obligation.owner) FOR UPDATE; IF $analysis=NONE OR $analysis.retiring { THROW 'PSE_REFUSAL:analysis_artifact_owner_retired'; }; };
    IF (SELECT * FROM ONLY type::record('canonical_artifact_releases',$obligation.key) FOR UPDATE)!=NONE { THROW 'PSE_REFUSAL:artifact_obligation_permanently_released'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_artifact_obligations',$obligation.key) FOR UPDATE;
    IF $old!=NONE { IF object::remove($old,['id'])!=$obligation { THROW 'PSE_REFUSAL:artifact_obligation_identity_changed'; }; }
    ELSE { CREATE ONLY type::record('canonical_artifact_obligations',$obligation.key) CONTENT $obligation; };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_artifact_v1::release($rpc_expiry:int,$obligation:object) -> bool {
    fn::pse_execution_v1::deadline($rpc_expiry);
    SELECT * FROM ONLY type::record('canonical_artifacts',$obligation.artifact) FOR UPDATE;
    LET $old=SELECT * FROM ONLY type::record('canonical_artifact_obligations',$obligation.key) FOR UPDATE;
    IF $old!=NONE AND object::remove($old,['id'])!=$obligation { THROW 'PSE_REFUSAL:artifact_release_owner_differs'; };
    LET $released=SELECT * FROM ONLY type::record('canonical_artifact_releases',$obligation.key) FOR UPDATE;
    IF $released!=NONE {
        IF object::remove($released,['id'])!=$obligation { THROW 'PSE_REFUSAL:artifact_release_identity_changed'; };
        // Exact settled replay remains available after its retiring header is removed.
        // An inconsistent live obligation fails closed instead of being silently released.
        IF $old!=NONE { THROW 'PSE_REFUSAL:artifact_release_owner_differs'; };
        fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
    };
    IF $obligation.owner_kind='study' { fn::pse_execution_v1::register($rpc_expiry,'study:'+$obligation.owner); IF (SELECT * FROM ONLY type::record('canonical_study_retirements',$obligation.owner))=NONE { THROW 'PSE_REFUSAL:study_input_release_requires_explicit_study_retirement'; }; };
IF $obligation.owner_kind='analysis' { LET $analysis=SELECT * FROM ONLY type::record('canonical_analyses',$obligation.owner) FOR UPDATE; IF $analysis=NONE OR !$analysis.retiring { THROW 'PSE_REFUSAL:analysis_input_release_requires_explicit_analysis_retirement'; }; };
    CREATE ONLY type::record('canonical_artifact_releases',$obligation.key) CONTENT $obligation;
    DELETE ONLY type::record('canonical_artifact_obligations',$obligation.key);
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};
DEFINE FUNCTION fn::pse_artifact_v1::acquire($rpc_expiry:int,$key:string,$protection:string) -> object {
    LET $row=fn::pse_artifact_v1::available($rpc_expiry,$key);
    LET $pin=SELECT * FROM ONLY type::record('canonical_protections',$protection) FOR UPDATE;
    IF $pin=NONE OR $pin.released OR $pin.expires_at<=time::micros() OR $pin.revision!=$row.revision { THROW 'PSE_REFUSAL:artifact_read_protection_absent'; };
    UPSERT type::record('canonical_artifact_reads',$protection) SET key=$protection,artifact=$key;
    fn::pse_execution_v1::lease($rpc_expiry,$pin.expires_at);
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $row;
};
DEFINE FUNCTION fn::pse_artifact_v1::read($rpc_expiry:int,$key:string,$protection:string,$ordinal:decimal) -> object {
    LET $row=fn::pse_artifact_v1::available($rpc_expiry,$key);
    LET $pin=SELECT * FROM ONLY type::record('canonical_protections',$protection) FOR UPDATE;
    LET $read=SELECT * FROM ONLY type::record('canonical_artifact_reads',$protection);
    IF $pin=NONE OR $pin.released OR ($pin.expires_at<=time::micros() AND !fn::pse_files_v1::ticket_open($rpc_expiry,$protection)) OR $pin.revision!=$row.revision OR $read=NONE OR $read.artifact!=$key { THROW 'PSE_REFUSAL:artifact_read_grant_unavailable'; };
    LET $blocks=SELECT * FROM canonical_artifact_blocks WHERE artifact=$key AND ordinal=$ordinal LIMIT 1;
    IF array::len($blocks)!=1 { THROW 'PSE_REFUSAL:artifact_block_unavailable'; };
    IF !fn::pse_files_v1::ticket_open($rpc_expiry,$protection) { fn::pse_execution_v1::lease($rpc_expiry,$pin.expires_at); };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $blocks[0];
};
DEFINE FUNCTION fn::pse_artifact_v1::collect($rpc_expiry:int,$intent:object) -> object {
    LET $guard=fn::pse_artifact_v1::original($rpc_expiry,$intent);
    LET $row=SELECT * FROM ONLY type::record('canonical_artifacts',$intent.key) FOR UPDATE;
    LET $owners=SELECT key FROM canonical_artifact_obligations WHERE artifact=$intent.key LIMIT 1;
    IF array::len($owners)!=0 { THROW 'PSE_REFUSAL:artifact_has_retained_obligations'; };
    IF $row!=NONE AND ($row.creation_request_digest!=$intent.creation_request_digest OR $row.creation_expires_at!=$intent.creation_expires_at) { THROW 'PSE_REFUSAL:artifact_settlement_requires_original_intent'; };
    LET $reads=SELECT key FROM canonical_artifact_reads WHERE artifact=$intent.key ORDER BY key LIMIT 64;
    FOR $read IN $reads {
        LET $settlement=fn::pse_retention_v1::settle_protection($rpc_expiry,$intent.primary_problem,$read.key);
        IF !$settlement.complete { fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:true}; };
        DELETE ONLY type::record('canonical_artifact_reads',$read.key);
    };
    IF array::len($reads)=64 { fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    IF $row!=NONE { UPDATE ONLY type::record('canonical_artifacts',$intent.key) SET retiring=true; };
    IF $guard.incarnation=$intent.primary_authority AND time::micros()<$intent.creation_expires_at { fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:true}; };
    LET $blocks=SELECT id,key FROM canonical_artifact_blocks WHERE artifact=$intent.key ORDER BY ordinal LIMIT 64;
    IF array::len($blocks)!=0 { FOR $block IN $blocks { fn::pse_files_v1::release_borrower($rpc_expiry,'artifact:'+$block.key); }; DELETE $blocks.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    LET $inputs=SELECT id,run FROM canonical_artifact_staging_inputs WHERE artifact=$intent.key ORDER BY key LIMIT 64;
    FOR $input IN $inputs { fn::pse_execution_v1::result_creator($rpc_expiry,$input.run); };
    IF array::len($inputs)!=0 { DELETE $inputs.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    LET $roots=SELECT id,problem FROM canonical_roots WHERE owner_kind='artifact' AND owner=$intent.key ORDER BY key LIMIT 64;
    FOR $root IN $roots { SELECT * FROM ONLY type::record('canonical_guards','retention:'+$root.problem) FOR UPDATE; };
    IF array::len($roots)!=0 { DELETE $roots.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,waiting:false}; };
    IF $guard.incarnation=$intent.primary_authority {
        UPDATE ONLY type::record('canonical_guards','retention:'+$intent.primary_problem) SET artifact_creation_closed_through=math::max([artifact_creation_closed_through ?? 0dec,$intent.creation_expires_at]);
        DELETE ONLY type::record('canonical_artifacts',$intent.key);
    } ELSE {
        // Original historical authority is already fenced. Retain its exact
        // terminal receipt for lost-reply settlement, without touching a new floor.
        UPDATE ONLY type::record('canonical_artifacts',$intent.key) SET active=false,retiring=true;
    };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:true,waiting:false};
};

DEFINE FUNCTION fn::pse_history_v1::owner_key($kind:string,$owner:string) -> string {
    IF $kind NOT IN ['run','study'] OR $owner='' { THROW 'PSE_REFUSAL:history_owner_must_identify_a_run_or_study'; };
    RETURN $kind+':'+$owner;
};

// Registration covers absence too. Release writes the same guard before fencing.
DEFINE FUNCTION fn::pse_history_v1::check_owner($rpc_expiry:int,$kind:string,$owner:string) -> bool {
    LET $key=fn::pse_history_v1::owner_key($kind,$owner);
    fn::pse_execution_v1::register($rpc_expiry,'history:'+$key);
    IF (SELECT * FROM ONLY type::record('canonical_history_retirements',$key) FOR UPDATE)!=NONE { THROW 'PSE_REFUSAL:history_explicitly_retired_detailed_response_unavailable'; };
    RETURN true;
};

DEFINE FUNCTION fn::pse_history_v1::run($rpc_expiry:int,$run:string) -> bool {
    fn::pse_history_v1::check_owner($rpc_expiry,'run',$run);
    LET $parents=SELECT study FROM canonical_history_locators WHERE run=$run LIMIT 3;
    IF array::len($parents)>2 { THROW 'PSE_REFUSAL:history_run_association_bound_exceeded'; };
    FOR $parent IN $parents { fn::pse_history_v1::check_owner($rpc_expiry,'study',$parent.study); };
    RETURN true;
};

DEFINE FUNCTION fn::pse_history_v1::point($rpc_expiry:int,$point:string) -> option<object> {
    LET $locator=SELECT * FROM ONLY type::record('canonical_history_locators','point:'+$point);
    IF $locator!=NONE {
        IF $locator.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store { THROW 'PSE_REFUSAL:history_locator_issuing_authority_differs'; };
        fn::pse_history_v1::check_owner($rpc_expiry,'study',$locator.study);
        fn::pse_history_v1::run($rpc_expiry,$locator.run);
    };
    RETURN $locator;
};

// Only membership admission calls this, in the same transaction as membership.
DEFINE FUNCTION fn::pse_history_v1::associate($rpc_expiry:int,$study:string,$run:string,$point:option<string>) -> bool {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_history_v1::run($rpc_expiry,$run);
    fn::pse_execution_v1::touch($rpc_expiry,'history:run:'+$run);
    fn::pse_execution_v1::touch($rpc_expiry,'history:study:'+$study);
    LET $key=IF $point=NONE {'summary:'+$study} ELSE {'point:'+$point};
    LET $old=SELECT * FROM ONLY type::record('canonical_history_locators',$key) FOR UPDATE;
    LET $issuing=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store;
    IF $old!=NONE {
        IF $old.study!=$study OR $old.run!=$run OR $old.point!=$point OR $old.issuing_store!=$issuing { THROW 'PSE_REFUSAL:history_membership_locator_reused'; };
    } ELSE {
        CREATE ONLY type::record('canonical_history_locators',$key) SET key=$key,study=$study,run=$run,point=$point,issuing_store=$issuing;
    };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};

// The stored owner dominates request comparison, including a caller supplying a new run.
DEFINE FUNCTION fn::pse_history_v1::operation($rpc_expiry:int,$key:string,$expected_run:option<string>) -> option<object> {
    LET $old=SELECT * FROM ONLY type::record('canonical_execution_operations',$key) FOR UPDATE;
    IF $old!=NONE {
        fn::pse_history_v1::run($rpc_expiry,$old.run);
        IF (SELECT * FROM ONLY type::record('canonical_result_retirements',$old.run) FOR UPDATE)!=NONE { THROW 'PSE_REFUSAL:execution_results_explicitly_retired'; };
        IF $old.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store { THROW 'PSE_REFUSAL:operation_issuing_authority_differs'; };
        IF $old.minimal { THROW 'PSE_REFUSAL:operation_history_unavailable_minimal_settled_attribution_only'; };
        IF $expected_run!=NONE AND $old.run!=$expected_run { THROW 'PSE_REFUSAL:execution_operation_owner_reused'; };
    };
    IF $expected_run!=NONE { fn::pse_history_v1::run($rpc_expiry,$expected_run); IF (SELECT * FROM ONLY type::record('canonical_result_retirements',$expected_run) FOR UPDATE)!=NONE { THROW 'PSE_REFUSAL:execution_results_explicitly_retired'; }; };
    RETURN $old;
};

// Narrow maintenance readback: payload retirement does not release exact
// readiness settlement evidence, but detailed history release still fences it.
DEFINE FUNCTION fn::pse_history_v1::study_repair_operation($rpc_expiry:int,$key:string,$study:string,$run:string,$request:option<bytes>) -> option<object> {
    fn::pse_history_v1::check_owner($rpc_expiry,'study',$study);
    fn::pse_history_v1::run($rpc_expiry,$run);
    LET $locator=SELECT * FROM ONLY type::record('canonical_history_locators','summary:'+$study);
    IF $locator=NONE OR $locator.study!=$study OR $locator.run!=$run OR $locator.point!=NONE OR $locator.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store { THROW 'PSE_REFUSAL:study_readiness_receipt_owner_differs'; };
    LET $old=SELECT * FROM ONLY type::record('canonical_execution_operations',$key) FOR UPDATE;
    IF $old!=NONE {
        IF $old.minimal AND NOT ($old.disposition IN ['no-effect','refused'] AND $request=NONE) { THROW 'PSE_REFUSAL:operation_history_unavailable_minimal_settled_attribution_only'; };
        IF $old.kind!='study-readiness-repair-page' OR $old.run!=$run OR $old.study!=$study OR $old.point!=NONE OR $old.attempt!=NONE OR ($request!=NONE AND $old.request!=$request) OR $old.issuing_store!=$locator.issuing_store { THROW 'PSE_REFUSAL:study_readiness_receipt_request_differs'; };
    };
    RETURN $old;
};

DEFINE FUNCTION fn::pse_history_v1::record_operation($rpc_expiry:int,$key:string,$run:string,$attempt:option<string>,$kind:string,$request:bytes,$result:bytes,$study:option<string>,$point:option<string>) -> bool {
    fn::pse_history_v1::run($rpc_expiry,$run);
    LET $parents=SELECT study,point FROM canonical_history_locators WHERE run=$run LIMIT 3;
    IF array::len($parents)>2 { THROW 'PSE_REFUSAL:operation_association_bound_exceeded'; };
    LET $finalization=IF $attempt=NONE {NONE} ELSE {(SELECT finalization_study FROM ONLY type::record('canonical_attempts',$attempt)).finalization_study};
    LET $selected_study=$study ?? $finalization;
    LET $applicable=IF $point!=NONE {$parents.filter(|$parent|$parent.study=$selected_study AND $parent.point=$point)} ELSE IF $selected_study!=NONE {$parents.filter(|$parent|$parent.study=$selected_study AND $parent.point=NONE)} ELSE {
        LET $points=$parents.filter(|$parent|$parent.point!=NONE);
        IF array::len($points)!=0 {$points} ELSE {$parents}
    };
    IF array::len($applicable)>1 OR (($study!=NONE OR $point!=NONE OR $finalization!=NONE) AND array::len($applicable)!=1) { THROW 'PSE_REFUSAL:operation_exact_study_point_attribution_differs'; };
    LET $parent=IF array::len($applicable)=0 {NONE} ELSE {$applicable[0]};
    CREATE ONLY type::record('canonical_execution_operations',$key) SET key=$key,run=$run,attempt=$attempt,kind=$kind,request=$request,result=$result,
        issuing_store=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store,
        study=$parent.study,point=$parent.point,minimal=false,disposition='settled';
    IF $attempt!=NONE { fn::pse_history_v1::identity($rpc_expiry,'attempt',$attempt,$run); };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};

DEFINE FUNCTION fn::pse_history_v1::identity($rpc_expiry:int,$category:string,$identity:string,$run:string) -> bool {
    fn::pse_history_v1::run($rpc_expiry,$run);
    LET $key=$category+':'+$identity;
    LET $old=SELECT * FROM ONLY type::record('canonical_history_identities',$key) FOR UPDATE;
    LET $issuing=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store;
    IF $old!=NONE {
        IF $old.run!=$run OR $old.issuing_store!=$issuing { THROW 'PSE_REFUSAL:history_identity_owner_reused'; };
    } ELSE {
        CREATE ONLY type::record('canonical_history_identities',$key) SET key=$key,category=$category,identity=$identity,run=$run,issuing_store=$issuing;
    };
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};

DEFINE FUNCTION fn::pse_history_v1::check_identity($rpc_expiry:int,$category:string,$identity:string) -> bool {
    LET $old=SELECT * FROM ONLY type::record('canonical_history_identities',$category+':'+$identity);
    IF $old!=NONE {
        IF $old.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store { THROW 'PSE_REFUSAL:history_identity_issuing_authority_differs'; };
        fn::pse_history_v1::run($rpc_expiry,$old.run);
    };
    RETURN true;
};

DEFINE FUNCTION fn::pse_history_v1::effect_free($rpc_expiry:int,$point:object) -> bool {
    fn::pse_history_v1::run($rpc_expiry,$point.run);
    fn::pse_execution_v1::touch($rpc_expiry,'execution-run:'+$point.run);
    LET $run=SELECT * FROM ONLY type::record('canonical_runs',$point.run) FOR UPDATE;
    IF !$point.settled OR $point.assigned OR $point.attempt!=NONE OR $run=NONE OR $run.current_attempt!=NONE OR $run.current_generation!=0dec { THROW 'PSE_REFUSAL:effect_free_settlement_requires_original_unclaimed_occurrence'; };
    fn::pse_history_v1::identity($rpc_expiry,'effect-free-run',$point.run,$point.run);
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};

// Inventory pages omit released detail while exact identity reads refuse it.
DEFINE FUNCTION fn::pse_history_v1::visible_run($rpc_expiry:int,$run:string) -> bool {
    fn::pse_execution_v1::register($rpc_expiry,'history:run:'+$run);
    IF (SELECT * FROM ONLY type::record('canonical_history_retirements','run:'+$run) FOR UPDATE)!=NONE { RETURN false; };
    LET $parents=SELECT study FROM canonical_history_locators WHERE run=$run LIMIT 3;
    IF array::len($parents)>2 { THROW 'PSE_REFUSAL:history_inventory_association_bound'; };
    FOR $parent IN $parents {
        fn::pse_execution_v1::register($rpc_expiry,'history:study:'+$parent.study);
        IF (SELECT * FROM ONLY type::record('canonical_history_retirements','study:'+$parent.study) FOR UPDATE)!=NONE { RETURN false; };
    };
    RETURN true;
};

// A release must not invalidate a shared child's other parent's audit.
DEFINE FUNCTION fn::pse_history_v1::parent_obligated($rpc_expiry:int,$run:string) -> bool {
    LET $parents=SELECT study FROM canonical_history_locators WHERE run=$run LIMIT 3;
    IF array::len($parents)>2 { THROW 'PSE_REFUSAL:history_obligation_association_bound'; };
    FOR $parent IN $parents {
        fn::pse_execution_v1::register($rpc_expiry,'history:study:'+$parent.study);
        LET $count=SELECT * FROM ONLY type::record('canonical_history_obligation_counts','study:'+$parent.study) FOR UPDATE;
        IF ($count.count ?? 0dec)>0dec { RETURN true; };
    };
    RETURN false;
};

DEFINE FUNCTION fn::pse_history_v1::read_seed($rpc_expiry:int,$key:string) -> option<object> {
    fn::pse_history_v1::check_identity($rpc_expiry,'seed',$key);
    LET $row=SELECT * FROM ONLY type::record('canonical_result_seeds',$key);
    IF $row!=NONE { fn::pse_history_v1::run($rpc_expiry,$row.run); };
    RETURN $row;
};

DEFINE FUNCTION fn::pse_history_v1::read_run($rpc_expiry:int,$key:string) -> option<object> {
    fn::pse_history_v1::run($rpc_expiry,$key);
    RETURN SELECT * FROM ONLY type::record('canonical_runs',$key);
};

DEFINE FUNCTION fn::pse_history_v1::read_attempt($rpc_expiry:int,$key:string) -> option<object> {
    fn::pse_history_v1::check_identity($rpc_expiry,'attempt',$key);
    LET $row=SELECT * FROM ONLY type::record('canonical_attempts',$key);
    IF $row!=NONE { fn::pse_history_v1::run($rpc_expiry,$row.run); };
    RETURN $row;
};

DEFINE FUNCTION fn::pse_history_v1::read_manifest($rpc_expiry:int,$key:string) -> option<object> {
    fn::pse_history_v1::check_identity($rpc_expiry,'manifest',$key);
    RETURN SELECT * FROM ONLY type::record('canonical_result_manifests',$key);
};

DEFINE FUNCTION fn::pse_history_v1::retain($rpc_expiry:int,$key:string,$kind:string,$owner:string,$purpose:string,$attribution:string) -> bool {
    IF $key='' OR $purpose NOT IN ['audit','unsettled'] OR $attribution='' { THROW 'PSE_REFUSAL:history_obligation_requires_exact_owner_and_attribution'; };
    LET $scope=fn::pse_history_v1::owner_key($kind,$owner);
    fn::pse_history_v1::check_owner($rpc_expiry,$kind,$owner);
    IF $kind='run' {
        fn::pse_history_v1::run($rpc_expiry,$owner);
        LET $parents=SELECT study FROM canonical_history_locators WHERE run=$owner LIMIT 3;
        IF array::len($parents)>2 { THROW 'PSE_REFUSAL:history_obligation_association_bound'; };
        FOR $parent IN $parents { fn::pse_execution_v1::touch($rpc_expiry,'history:study:'+$parent.study); };
    };
    fn::pse_execution_v1::touch($rpc_expiry,'history:'+$scope);
    LET $header=IF $kind='run' {SELECT key FROM ONLY type::record('canonical_runs',$owner)} ELSE {SELECT key FROM ONLY type::record('canonical_studies',$owner)};
    IF $header=NONE { THROW 'PSE_REFUSAL:history_obligation_owner_unavailable'; };
    IF $kind='study' {
        LET $retired=SELECT key FROM canonical_history_locators WHERE study=$owner AND !fn::pse_history_v1::visible_run($rpc_expiry,run) LIMIT 1;
        IF array::len($retired)!=0 { THROW 'PSE_REFUSAL:study_audit_cannot_restore_retired_member_history'; };
    };
    LET $old=SELECT * FROM ONLY type::record('canonical_history_obligations',$key) FOR UPDATE;
    IF $old!=NONE {
        IF $old.owner_kind!=$kind OR $old.owner!=$owner OR $old.purpose!=$purpose OR $old.attribution!=$attribution { THROW 'PSE_REFUSAL:history_obligation_identity_reused'; };
        IF $old.released { THROW 'PSE_REFUSAL:history_obligation_explicitly_released'; };
        fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
    };
    CREATE ONLY type::record('canonical_history_obligations',$key) SET key=$key,owner_kind=$kind,owner=$owner,purpose=$purpose,attribution=$attribution,released=false,issuing_store=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store;
    LET $count=SELECT * FROM ONLY type::record('canonical_history_obligation_counts',$scope) FOR UPDATE;
    UPSERT ONLY type::record('canonical_history_obligation_counts',$scope) SET key=$scope,count=($count.count ?? 0dec)+1dec;
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};

DEFINE FUNCTION fn::pse_history_v1::drop_obligation($rpc_expiry:int,$key:string,$kind:string,$owner:string,$purpose:string,$attribution:string) -> bool {
    LET $scope=fn::pse_history_v1::owner_key($kind,$owner);
    fn::pse_execution_v1::touch($rpc_expiry,'history:'+$scope);
    LET $old=SELECT * FROM ONLY type::record('canonical_history_obligations',$key) FOR UPDATE;
    IF $old=NONE {
        CREATE ONLY type::record('canonical_history_obligations',$key) SET key=$key,owner_kind=$kind,owner=$owner,purpose=$purpose,attribution=$attribution,released=true,issuing_store=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store;
        fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
    };
    IF $old.owner_kind!=$kind OR $old.owner!=$owner OR $old.purpose!=$purpose OR $old.attribution!=$attribution OR $old.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store { THROW 'PSE_REFUSAL:history_obligation_release_differs'; };
    IF $old.released { fn::pse_execution_v1::deadline($rpc_expiry); RETURN true; };
    LET $count=SELECT * FROM ONLY type::record('canonical_history_obligation_counts',$scope) FOR UPDATE;
    IF $count=NONE OR $count.count<1dec { THROW 'PSE_REFUSAL:history_obligation_count_unavailable'; };
    UPDATE ONLY type::record('canonical_history_obligations',$key) SET released=true;
    UPDATE ONLY type::record('canonical_history_obligation_counts',$scope) SET count-=1dec;
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN true;
};

DEFINE FUNCTION fn::pse_history_v1::release($rpc_expiry:int,$kind:string,$owner:string) -> object {
    LET $key=fn::pse_history_v1::owner_key($kind,$owner);
    fn::pse_execution_v1::touch($rpc_expiry,'history:'+$key);
    LET $old=SELECT * FROM ONLY type::record('canonical_history_retirements',$key) FOR UPDATE;
    IF $old!=NONE { fn::pse_execution_v1::deadline($rpc_expiry); RETURN $old; };
    LET $count=SELECT * FROM ONLY type::record('canonical_history_obligation_counts',$key) FOR UPDATE;
    IF ($count.count ?? 0dec)!=0dec { THROW 'PSE_REFUSAL:selected_audit_or_unsettled_history_obligation_remains'; };
    LET $header=IF $kind='run' {SELECT * FROM ONLY type::record('canonical_runs',$owner)} ELSE {SELECT * FROM ONLY type::record('canonical_studies',$owner)};
    IF $header=NONE { THROW 'PSE_REFUSAL:history_release_requires_its_original_owner'; };
    IF $kind='run' {
        fn::pse_execution_v1::touch($rpc_expiry,'execution-run:'+$owner);
        LET $retired=SELECT * FROM ONLY type::record('canonical_result_retirements',$owner) FOR UPDATE;
        IF $retired=NONE OR !$retired.complete OR ($header.terminal_attempt=NONE AND (SELECT * FROM ONLY type::record('canonical_history_identities','effect-free-run:'+$owner))=NONE) { THROW 'PSE_REFUSAL:history_release_requires_settled_retired_run_payloads'; };
        LET $parents=SELECT study FROM canonical_history_locators WHERE run=$owner LIMIT 3;
        IF array::len($parents)>2 { THROW 'PSE_REFUSAL:history_release_association_bound'; };
        FOR $parent IN $parents {
            fn::pse_execution_v1::register($rpc_expiry,'history:study:'+$parent.study);
            LET $parent_count=SELECT * FROM ONLY type::record('canonical_history_obligation_counts','study:'+$parent.study) FOR UPDATE;
            IF ($parent_count.count ?? 0dec)!=0dec { THROW 'PSE_REFUSAL:study_audit_retains_run_history'; };
        };
    } ELSE {
        fn::pse_execution_v1::touch($rpc_expiry,'study:'+$owner);
        IF !$header.terminal OR (SELECT * FROM ONLY type::record('canonical_study_retirements',$owner) FOR UPDATE)=NONE { THROW 'PSE_REFUSAL:history_release_requires_terminal_retired_study'; };
        LET $protected=SELECT key FROM canonical_history_locators WHERE study=$owner AND (type::record('canonical_history_obligation_counts','run:'+run).count ?? 0dec)>0dec LIMIT 1;
        IF array::len($protected)!=0 { THROW 'PSE_REFUSAL:point_or_summary_audit_retains_study_history'; };
        LET $shared=SELECT key FROM canonical_history_locators WHERE study=$owner AND fn::pse_history_v1::parent_obligated($rpc_expiry,run) LIMIT 1;
        IF array::len($shared)!=0 { THROW 'PSE_REFUSAL:another_parent_study_audit_retains_shared_run_history'; };
        LET $unsettled=SELECT key FROM canonical_history_locators WHERE study=$owner AND (type::record('canonical_result_retirements',run).complete ?? false)=false LIMIT 1;
        IF array::len($unsettled)!=0 { THROW 'PSE_REFUSAL:study_history_requires_all_linked_run_payloads_settled'; };
    };
    LET $outcome=IF $kind='run' {$header.terminal_class ?? 'not-executed'} ELSE {IF $header.cancelled {'cancelled'} ELSE {'terminal'}};
    LET $result=CREATE ONLY type::record('canonical_history_retirements',$key) SET key=$key,owner_kind=$kind,owner=$owner,issuing_store=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store,outcome=$outcome,complete=false,after_locator=NONE;
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN $result;
};

DEFINE FUNCTION fn::pse_history_v1::collect($rpc_expiry:int,$kind:string,$owner:string) -> object {
    LET $key=fn::pse_history_v1::owner_key($kind,$owner);
    fn::pse_execution_v1::touch($rpc_expiry,'history:'+$key);
    LET $fence=SELECT * FROM ONLY type::record('canonical_history_retirements',$key) FOR UPDATE;
    IF $fence=NONE { THROW 'PSE_REFUSAL:explicit_history_release_required'; };
    IF $fence.issuing_store!=(SELECT * FROM ONLY canonical_interpretations:current).issuing_store { THROW 'PSE_REFUSAL:history_collector_issuing_authority_differs'; };
    IF $fence.complete { fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:true,removed:0dec,compacted:0dec}; };
    IF $kind='run' {
        LET $operations=SELECT key FROM canonical_execution_operations WHERE run=$owner AND minimal=false ORDER BY key LIMIT 64;
        IF array::len($operations)!=0 {
            FOR $operation IN $operations { UPDATE ONLY type::record('canonical_execution_operations',$operation.key) SET request=type::bytes(''),result=type::bytes(''),minimal=true; };
            fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:0dec,compacted:<decimal>array::len($operations)};
        };
        LET $attempts=SELECT id FROM canonical_attempts WHERE run=$owner ORDER BY generation LIMIT 64;
        IF array::len($attempts)!=0 { DELETE $attempts.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:<decimal>array::len($attempts),compacted:0dec}; };
        LET $sources=SELECT id FROM canonical_run_sources WHERE run=$owner LIMIT 64;
        IF array::len($sources)!=0 { DELETE $sources.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:<decimal>array::len($sources),compacted:0dec}; };
        LET $edges=SELECT id FROM canonical_problem_runs WHERE run=$owner LIMIT 64;
        IF array::len($edges)!=0 { DELETE $edges.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:<decimal>array::len($edges),compacted:0dec}; };
        DELETE ONLY type::record('canonical_runs',$owner);
    } ELSE {
        LET $children=SELECT key,run FROM canonical_history_locators WHERE study=$owner AND key>($fence.after_locator ?? '') ORDER BY key LIMIT 1;
        IF array::len($children)!=0 {
            LET $child=$children[0];
            fn::pse_history_v1::release($rpc_expiry,'run',$child.run);
            LET $page=fn::pse_history_v1::collect($rpc_expiry,'run',$child.run);
            IF $page.complete { UPDATE ONLY type::record('canonical_history_retirements',$key) SET after_locator=$child.key; };
            fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:$page.removed,compacted:$page.compacted};
        };
        LET $inputs=SELECT id FROM canonical_study_inputs WHERE study=$owner ORDER BY key LIMIT 64;
        IF array::len($inputs)!=0 { DELETE $inputs.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:<decimal>array::len($inputs),compacted:0dec}; };
        LET $dependencies=SELECT id FROM canonical_study_dependencies WHERE study=$owner ORDER BY key LIMIT 64;
        IF array::len($dependencies)!=0 { DELETE $dependencies.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:<decimal>array::len($dependencies),compacted:0dec}; };
        LET $readiness=SELECT id FROM canonical_study_readiness WHERE study=$owner ORDER BY ordinal LIMIT 64;
        IF array::len($readiness)!=0 { DELETE $readiness.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:<decimal>array::len($readiness),compacted:0dec}; };
        LET $points=SELECT id FROM canonical_study_points WHERE study=$owner ORDER BY ordinal LIMIT 64;
        IF array::len($points)!=0 { DELETE $points.id; fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:false,removed:<decimal>array::len($points),compacted:0dec}; };
        DELETE ONLY type::record('canonical_study_readiness_cursors',$owner);
        DELETE ONLY type::record('canonical_studies',$owner);
    };
    UPDATE ONLY type::record('canonical_history_retirements',$key) SET complete=true;
    fn::pse_execution_v1::deadline($rpc_expiry);
    fn::pse_execution_v1::deadline($rpc_expiry); RETURN {complete:true,removed:1dec,compacted:0dec};
};
