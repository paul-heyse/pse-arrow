DEFINE FIELD descriptor ON canonical_study_points TYPE bytes;
DEFINE FIELD facts ON canonical_study_points TYPE bytes;
DEFINE FIELD outcome ON canonical_study_points TYPE option<bytes>;
DEFINE FIELD run ON canonical_study_points TYPE string;
DEFINE FIELD revision ON canonical_study_points TYPE decimal ASSERT $value = NONE OR ($value >= 0dec AND $value <= 18446744073709551615dec AND math::floor($value) = $value);
DEFINE FIELD assigned ON canonical_study_points TYPE bool;
DEFINE FIELD settled ON canonical_study_points TYPE bool;
DEFINE FIELD attempt ON canonical_study_points TYPE option<string>;
DEFINE FIELD start ON canonical_study_points TYPE option<bytes>;
DEFINE INDEX canonical_study_points_key ON canonical_study_points FIELDS key UNIQUE;

DEFINE TABLE canonical_study_retirements SCHEMAFULL;
DEFINE FIELD key ON canonical_study_retirements TYPE string;
DEFINE FIELD study ON canonical_study_retirements TYPE string;
DEFINE INDEX canonical_study_retirements_key ON canonical_study_retirements FIELDS key UNIQUE;

