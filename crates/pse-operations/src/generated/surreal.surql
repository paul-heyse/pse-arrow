DEFINE TYPE pse_canonical_study_readiness_cursors_merge AS object ASSERT object::keys($value) ALLINSIDE ['study', 'revision', 'rebuild_pending', 'rebuild_after', 'notify_after', 'verify_after', 'pending_operation'] AND ('study' NOT IN object::keys($value) OR ($value.study!=NONE AND ((<string>$value.study)=$value.study))) AND ('revision' NOT IN object::keys($value) OR ($value.revision!=NONE AND ((<u64>$value.revision)=$value.revision))) AND ('rebuild_pending' NOT IN object::keys($value) OR ($value.rebuild_pending!=NONE AND ((<bool>$value.rebuild_pending)=$value.rebuild_pending))) AND ('rebuild_after' NOT IN object::keys($value) OR ($value.rebuild_after=NONE OR ((<u64>$value.rebuild_after)=$value.rebuild_after))) AND ('notify_after' NOT IN object::keys($value) OR ($value.notify_after=NONE OR ((<u64>$value.notify_after)=$value.notify_after))) AND ('verify_after' NOT IN object::keys($value) OR ($value.verify_after=NONE OR ((<u64>$value.verify_after)=$value.verify_after))) AND ('pending_operation' NOT IN object::keys($value) OR ($value.pending_operation=NONE OR ((<string>$value.pending_operation)=$value.pending_operation)));
DEFINE TYPE pse_canonical_study_retirements_create AS {key: string, study: string};
DEFINE TYPE pse_canonical_study_retirements_replace AS {study: string};
DEFINE TYPE pse_canonical_study_retirements_merge AS object ASSERT object::keys($value) ALLINSIDE ['study'] AND ('study' NOT IN object::keys($value) OR ($value.study!=NONE AND ((<string>$value.study)=$value.study)));
DEFINE TYPE pse_canonical_version_manifests_create AS {key: string, logical: string, kind: string, interpretation: string, payload_digest: string, payload_len: u64, block_count: u64, reference_count: u64, creator_stage: string, closed: bool};
DEFINE TYPE pse_canonical_version_manifests_replace AS {logical: string, kind: string, interpretation: string, payload_digest: string, payload_len: u64, block_count: u64, reference_count: u64, creator_stage: string, closed: bool};
DEFINE TYPE pse_canonical_version_manifests_merge AS object ASSERT object::keys($value) ALLINSIDE ['logical', 'kind', 'interpretation', 'payload_digest', 'payload_len', 'block_count', 'reference_count', 'creator_stage', 'closed'] AND ('logical' NOT IN object::keys($value) OR ($value.logical!=NONE AND ((<string>$value.logical)=$value.logical))) AND ('kind' NOT IN object::keys($value) OR ($value.kind!=NONE AND ((<string>$value.kind)=$value.kind))) AND ('interpretation' NOT IN object::keys($value) OR ($value.interpretation!=NONE AND ((<string>$value.interpretation)=$value.interpretation))) AND ('payload_digest' NOT IN object::keys($value) OR ($value.payload_digest!=NONE AND ((<string>$value.payload_digest)=$value.payload_digest))) AND ('payload_len' NOT IN object::keys($value) OR ($value.payload_len!=NONE AND ((<u64>$value.payload_len)=$value.payload_len))) AND ('block_count' NOT IN object::keys($value) OR ($value.block_count!=NONE AND ((<u64>$value.block_count)=$value.block_count))) AND ('reference_count' NOT IN object::keys($value) OR ($value.reference_count!=NONE AND ((<u64>$value.reference_count)=$value.reference_count))) AND ('creator_stage' NOT IN object::keys($value) OR ($value.creator_stage!=NONE AND ((<string>$value.creator_stage)=$value.creator_stage))) AND ('closed' NOT IN object::keys($value) OR ($value.closed!=NONE AND ((<bool>$value.closed)=$value.closed)));
DEFINE TYPE pse_canonical_version_receipts_create AS {key: string, content_digest: string};
DEFINE TYPE pse_canonical_version_receipts_replace AS {content_digest: string};
DEFINE TYPE pse_canonical_version_receipts_merge AS object ASSERT object::keys($value) ALLINSIDE ['content_digest'] AND ('content_digest' NOT IN object::keys($value) OR ($value.content_digest!=NONE AND ((<string>$value.content_digest)=$value.content_digest)));
DEFINE TYPE pse_canonical_versions_create AS {key: string, logical: string, kind: string, payload: bytes, interpretation: string};
DEFINE TYPE pse_canonical_versions_replace AS {logical: string, kind: string, payload: bytes, interpretation: string};
DEFINE TYPE pse_canonical_versions_merge AS object ASSERT object::keys($value) ALLINSIDE ['logical', 'kind', 'payload', 'interpretation'] AND ('logical' NOT IN object::keys($value) OR ($value.logical!=NONE AND ((<string>$value.logical)=$value.logical))) AND ('kind' NOT IN object::keys($value) OR ($value.kind!=NONE AND ((<string>$value.kind)=$value.kind))) AND ('payload' NOT IN object::keys($value) OR ($value.payload!=NONE AND ((<bytes>$value.payload)=$value.payload))) AND ('interpretation' NOT IN object::keys($value) OR ($value.interpretation!=NONE AND ((<string>$value.interpretation)=$value.interpretation)));
