DEFINE TABLE canonical_attempts SCHEMAFULL;
DEFINE FIELD key ON canonical_attempts TYPE string READONLY ASSERT $value = record::id($this.id);
DEFINE FIELD run ON canonical_attempts TYPE string READONLY;
DEFINE FIELD generation ON canonical_attempts TYPE u64 READONLY;
DEFINE FIELD claim_operation ON canonical_attempts TYPE string READONLY;
DEFINE FIELD request ON canonical_attempts TYPE bytes READONLY;
DEFINE FIELD worker ON canonical_attempts TYPE string READONLY;
DEFINE FIELD expires_at ON canonical_attempts TYPE int;
DEFINE FIELD phase ON canonical_attempts TYPE pse_canonical_attempt_phase ASSERT (($before=NONE AND $value='ingesting') OR $before=$value OR ($before='ingesting' AND $value='closed_awaiting_manifest') OR ($before='ingesting' AND $value='closed_with_manifest') OR ($before='closed_awaiting_manifest' AND $value='closed_with_manifest') OR ($before='closed_with_manifest' AND $value='terminal') OR ($before='terminal' AND $value='terminal_compacted') OR (type::record('canonical_runs',$this.run).purpose='study_admission' AND $before IN ['ingesting','closed_awaiting_manifest','closed_with_manifest'] AND $value='terminal')) AND ((($value='ingesting' AND $this.close_generation=NONE AND $this.closed_manifest=NONE AND $this.outcome=NONE AND $this.completion=NONE AND $this.seed_manifest=NONE) OR ($value='closed_awaiting_manifest' AND $this.close_generation!=NONE AND $this.closed_manifest=NONE AND $this.outcome=NONE AND $this.completion=NONE AND $this.seed_manifest=NONE) OR ($value='closed_with_manifest' AND $this.close_generation!=NONE AND $this.closed_manifest!=NONE AND $this.outcome=NONE AND $this.completion=NONE AND $this.seed_manifest=NONE) OR ($value IN ['terminal','terminal_compacted'] AND (($value='terminal_compacted' AND $this.completion=NONE) OR ($value='terminal' AND ((type::record('canonical_runs',$this.run).purpose='study_admission' AND $this.outcome='failed' AND $this.completion=NONE) OR ($this.completion!=NONE AND !(type::record('canonical_runs',$this.run).purpose='study_admission' AND $this.outcome='failed'))))) AND $this.outcome IN ['succeeded','failed','partial','cancelled'] AND (type::record('canonical_runs',$this.run).purpose='study_admission' OR ($this.close_generation!=NONE AND $this.closed_manifest!=NONE)))));
DEFINE FIELD close_generation ON canonical_attempts TYPE option<u64>;
DEFINE FIELD outcome ON canonical_attempts TYPE option<pse_canonical_terminal_outcome> ASSERT ($before=NONE OR $before=$value);
DEFINE FIELD closed_manifest ON canonical_attempts TYPE option<string> ASSERT (($value=NONE OR $value=$this.key) AND ($before=NONE OR $before=$value));
DEFINE FIELD completion ON canonical_attempts TYPE option<bytes> ASSERT (($this.phase!='terminal_compacted' OR $value=NONE) AND ($before=NONE OR $before=$value OR ($value=NONE AND $this.phase='terminal_compacted')));
DEFINE FIELD seed_manifest ON canonical_attempts TYPE option<string>;
DEFINE FIELD finalization_study ON canonical_attempts TYPE option<string> READONLY;
