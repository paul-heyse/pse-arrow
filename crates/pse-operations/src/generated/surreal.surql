DEFINE FIELD payload_digest ON canonical_version_manifests TYPE string;
DEFINE FIELD payload_len ON canonical_version_manifests TYPE decimal ASSERT $value = NONE OR ($value >= 0dec AND $value <= 18446744073709551615dec AND math::floor($value) = $value);
DEFINE FIELD block_count ON canonical_version_manifests TYPE decimal ASSERT $value = NONE OR ($value >= 0dec AND $value <= 18446744073709551615dec AND math::floor($value) = $value);
DEFINE FIELD reference_count ON canonical_version_manifests TYPE decimal ASSERT $value = NONE OR ($value >= 0dec AND $value <= 18446744073709551615dec AND math::floor($value) = $value);
DEFINE FIELD creator_stage ON canonical_version_manifests TYPE string;
DEFINE FIELD closed ON canonical_version_manifests TYPE bool;
DEFINE INDEX canonical_version_manifests_key ON canonical_version_manifests FIELDS key UNIQUE;

