"""Validated Python scalar identities and mechanical field validators."""

import builtins as b
import math
from collections.abc import Callable
from datetime import UTC, datetime
from typing import Never, Self

import attrs

from pse._build import (
    content_hash_from_prefixed,
    content_hash_to_prefixed,
    semantic_id_from_hex,
    semantic_id_to_hex,
)
from pse.contracts import enums as e

# Exact source field spelling for attributes escaped by the Python generator.
FIELD_NAME_METADATA = "pse.field_name"


def _reject(message: str) -> Never:
    raise ValueError(message)


class SemanticId(bytes):
    """Exactly sixteen identity bytes, with an explicit hexadecimal text codec."""

    def __new__(cls, value: bytes) -> Self:
        if not isinstance(value, bytes) or len(value) != @SEMANTIC_WIDTH@:
            _reject("semantic identity requires exactly @SEMANTIC_WIDTH@ bytes")
        return super().__new__(cls, value)

    @classmethod
    def from_hex(cls, value: str) -> Self:
        return cls(semantic_id_from_hex(value))

    def to_hex(self) -> str:
        return semantic_id_to_hex(self)


class ContentHash(bytes):
    """Exactly thirty-two digest bytes; no validity assertion is implied."""

    def __new__(cls, value: bytes) -> Self:
        if not isinstance(value, bytes) or len(value) != @CONTENT_WIDTH@:
            _reject("content digest requires exactly @CONTENT_WIDTH@ bytes")
        return super().__new__(cls, value)

    @classmethod
    def from_prefixed(cls, value: str) -> Self:
        return cls(content_hash_from_prefixed(value))

    def to_prefixed(self) -> str:
        return content_hash_to_prefixed(self)


# These validators inspect only the value. Accept the unused callback context as
# object; attrs.Attribute is generic in type stubs, but not at runtime on Python 3.13.
def exact_type(expected: type[object]) -> Callable[[object, object, object], None]:
    def validate(_instance: object, _attribute: object, value: object) -> None:
        if type(value) is not expected:
            _reject(f"expected exact type {expected.__name__}")

    return validate


def integer_range(lower: int, upper: int) -> Callable[[object, object, object], None]:
    def validate(_instance: object, _attribute: object, value: object) -> None:
        if type(value) is not int or not lower <= value <= upper:
            _reject(f"integer must be in [{lower}, {upper}]")

    return validate


def collection(minimum: int, maximum: int | None, *, unique: bool) -> Callable[[object, object, object], None]:
    """Validate visible collection cardinality and declared member uniqueness."""
    def validate(_instance: object, _attribute: object, value: object) -> None:
        if not isinstance(value, tuple):
            _reject("collection requires a tuple")
        if len(value) < minimum or (maximum is not None and len(value) > maximum):
            _reject("collection violates cardinality")
        if unique and any(item in value[:index] for index, item in enumerate(value)):
            _reject("collection violates uniqueness")
    return validate


def finite_float(_instance: object, _attribute: object, value: object) -> None:
    if type(value) is not float or not math.isfinite(value):
        _reject("expected a finite Float64 value")


def utc_timestamp(_instance: object, _attribute: object, value: object) -> None:
    if not isinstance(value, datetime) or value.tzinfo is None or value.utcoffset() != UTC.utcoffset(None):
        _reject("timestamp must be an aware UTC datetime")
