"""Passive Arrow registration and strict versioned extension metadata codecs."""

import contextlib
from types import NotImplementedType
from typing import Never, Self

import msgspec
import msgspec.json
import pyarrow as pa


class _VersionMetadata(msgspec.Struct, frozen=True, forbid_unknown_fields=True):
    v: int


class _EnumMetadata(msgspec.Struct, frozen=True, forbid_unknown_fields=True):
    v: int
    enum_id: str


class _OrdinalMetadata(msgspec.Struct, frozen=True, forbid_unknown_fields=True):
    v: int
    target_relation_id: str


def _reject(message: str) -> Never:
    raise ValueError(message)


def _identity(value: str | None) -> str:
    if value is None or len(value) != 32 or any(char not in "0123456789abcdef" for char in value):
        _reject("extension binding must be a 32-character lowercase hexadecimal identity")
    return value


class _PseExtensionType(pa.ExtensionType):
    _extension_name = ""
    _metadata_version = 1
    _binding_key: str | None = None
    _prototype_binding: str | None = None

    @classmethod
    def _declared_storage(cls) -> pa.DataType:
        return pa.null()

    def __init__(self, binding_id: str | None = None) -> None:
        if self._binding_key is None:
            if binding_id is not None:
                _reject("this extension has no identity parameter")
            self.binding_id = None
        else:
            self.binding_id = _identity(binding_id)
        super().__init__(self._declared_storage(), self._extension_name)

    def __eq__(self, other: object) -> bool | NotImplementedType:
        if not isinstance(other, _PseExtensionType):
            return NotImplemented
        return (
            type(self) is type(other)
            and self.extension_name == other.extension_name
            and self.__arrow_ext_serialize__() == other.__arrow_ext_serialize__()
            and self.storage_type.equals(other.storage_type, check_metadata=True)
        )

    def __hash__(self) -> int:
        return hash((type(self), self.extension_name, self.__arrow_ext_serialize__(), self.storage_type))

    def __ne__(self, other: object) -> bool | NotImplementedType:
        equal = self.__eq__(other)
        return NotImplemented if equal is NotImplemented else not equal

    def __arrow_ext_serialize__(self) -> bytes:
        if self._binding_key == "enum_id":
            return msgspec.json.encode(_EnumMetadata(self._metadata_version, _identity(self.binding_id)))
        if self._binding_key == "target_relation_id":
            return msgspec.json.encode(_OrdinalMetadata(self._metadata_version, _identity(self.binding_id)))
        return msgspec.json.encode(_VersionMetadata(self._metadata_version))

    @classmethod
    def __arrow_ext_deserialize__(cls, storage_type: pa.DataType, serialized: bytes) -> Self:
        actual = pa.schema([pa.field("value", storage_type)])
        expected = pa.schema([pa.field("value", cls._declared_storage())])
        if not actual.equals(expected, check_metadata=True):
            _reject(f"{cls._extension_name} storage does not match its declared physical fields")
        try:
            if cls._binding_key == "enum_id":
                enum_metadata = msgspec.json.decode(serialized, type=_EnumMetadata)
                version = enum_metadata.v
                binding: str | None = _identity(enum_metadata.enum_id)
            elif cls._binding_key == "target_relation_id":
                ordinal_metadata = msgspec.json.decode(serialized, type=_OrdinalMetadata)
                version = ordinal_metadata.v
                binding = _identity(ordinal_metadata.target_relation_id)
            else:
                version = msgspec.json.decode(serialized, type=_VersionMetadata).v
                binding = None
        except msgspec.MsgspecError as exc:
            message = "malformed or unknown extension metadata"
            raise ValueError(message) from exc
        if version != cls._metadata_version:
            _reject(f"unsupported extension metadata generation {version}")
        result = cls(binding)
        if result.__arrow_ext_serialize__() != serialized:
            _reject("extension metadata must use the canonical encoding without duplicate keys")
        return result
