        "which",
        "rustc"
      ],
      "exit": 0,
      "stdout": "$HOME/.rustup/toolchains/nightly-2026-09-29-x86_64-unknown-linux-gnu/bin/rustc\n",
      "stderr": ""
    },
    {
      "cwd": "$HOME/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/suitesparse_sys-0.1.4",
