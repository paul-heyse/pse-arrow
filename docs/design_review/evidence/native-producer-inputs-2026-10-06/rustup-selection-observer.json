{
  "scope": "Current read-only rustup observer of bindgen default Rustfmt lookup. Not historical Cargo child env evidence.",
  "RUSTUP_TOOLCHAIN_present": false,
  "commands": [
    {
      "cwd": "$WORKSPACE",
      "args": [
        "show",
        "active-toolchain"
      ],
      "exit": 0,
      "stdout": "nightly-2026-09-29-x86_64-unknown-linux-gnu (overridden by '$WORKSPACE/rust-toolchain.toml')\n",
      "stderr": ""
    },
    {
      "cwd": "$WORKSPACE",
      "args": [
        "which",
        "rustfmt"
      ],
      "exit": 0,
      "stdout": "$HOME/.rustup/toolchains/nightly-2026-09-29-x86_64-unknown-linux-gnu/bin/rustfmt\n",
      "stderr": ""
    },
    {
      "cwd": "$WORKSPACE",
