  "verified_source_corrections": {
    "N01": "FileMetadataCache key is Path; entry validity compares size and last_modified. Store/root identity must be supplied by the integration.",
    "N02": "Cache put/update limits are infallible; DefaultCache eviction is internal. Simple external put/remove callbacks do not establish eviction accounting.",
    "N03": "reset_plan_states calls reset_state throughout the tree; documented dynamic-filter/recursive-query limitations require caller eligibility checks.",
    "N05": "SnapshotIdentity and materialized_files are private in delta-rs; the public outer Snapshot method list does not expose complete owned-heap size.",
    "N09": "Kernel IncrementalReplay documentation limits CRC benefits to summary statistics, metadata and transactions; this does not replace all Add-action materialization.",
    "N12": "Scoped RuntimeEnv shares parent cache_manager and object-store registry; separate cache allocation per scope would conflict with current sharing."
  },
  "design_inferences": [
    "Cross-process maintenance needs a validation fence in addition to local map invalidation.",
    "Consumed-column reuse requires actual access enforcement and separation of operation-instance identity from implementation generation.",
    "Eligible resident selection keys must include selection, schema and admission semantics; plain provider reads need an integration route beyond explicit df.cache()."
  ],
