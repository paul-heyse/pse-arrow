CREATE studies:s1; CREATE studies:s2 SET retired=true; CREATE analyses:x1; CREATE other:o1;
CREATE obligations:1 SET owner=studies:s1;
CREATE obligations:2 SET owner=analyses:x1;
CREATE obligations:3;
CREATE obligations:4 SET owner=studies:s2;
CREATE obligations:5 SET owner=other:o1;
CREATE obligations:6 SET owner=studies:ghost;
CREATE obligations:7 SET owner='studies:s1';
SELECT id, owner, owner.retired AS r, record::tb(owner) AS kind FROM obligations ORDER BY id;
SELECT id FROM obligations WHERE owner != NONE AND !owner.retired ORDER BY id;
LET $o = (SELECT * FROM ONLY obligations:2); RETURN $o.owner.retired;
SELECT id, <~obligations AS refs FROM studies:s1;
SELECT id, <~obligations AS refs FROM analyses:x1;
DELETE studies:s1;
DELETE analyses:x1;
DELETE studies:ghost;
DELETE studies WHERE id = studies:s1;
SELECT id FROM studies ORDER BY id;
UPDATE obligations:1 SET owner = NONE; DELETE studies:s1; SELECT id FROM studies ORDER BY id;
