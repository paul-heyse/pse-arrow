+/// PROBE C: caller cancellation after admission must reach the running horizon.
+#[tokio::test]
+async fn probe_c_caller_cancel_after_admission_stops_horizon() {
+    use std::time::{Duration, Instant};
+    let steps = 20;
+    let runtime = horizon_runtime();
+    let (package, [root, whole, _]) = package(runtime.clone()).await;
+    let (plant, actuator, x) = plant(&package, whole, 0., steps).await;
+    let setpoints = (0..steps)
+        .map(|k| if k < 12 { 1. } else { 0.6 })
+        .collect::<Vec<_>>();
+    let controller = controller(&package, root, x, setpoints);
+    let horizon = Horizon {
+        output: crate::workflow::StudyOutputDemand::Full {},
+        plant,
+        period: PERIOD,
+        steps,
+        inputs: vec![HorizonInput {
+            parameter: actuator,
+            initial: 0.,
+        }],
+        estimator: None,
+        controller: Some(controller),
+    };
+    let baseline = runtime.shared.math().test_admission_snapshot();
+    let caller = crate::CancelSource::new();
+    let started = Instant::now();
+    let handle = runtime.start_horizon(horizon, &caller).await.unwrap();
+    // Wait for the first progress event (admitted and stepping).
+    let deadline = Instant::now() + Duration::from_secs(120);
+    loop {
+        if !handle.progress().0.is_empty() || handle.result().is_some() {
+            break;
+        }
+        assert!(Instant::now() < deadline, "no progress");
+        tokio::time::sleep(Duration::from_millis(5)).await;
+    }
+    let progressed_at = started.elapsed();
+    let events_at_cancel = handle.progress().0.len();
+    let finished_before_cancel = handle.result().is_some();
+    let during = runtime.shared.math().test_admission_snapshot();
+    caller.cancel();
+    let cancelled_at = started.elapsed();
+    let result = tokio::time::timeout(Duration::from_secs(600), handle.wait())
+        .await
+        .unwrap()
+        .unwrap();
+    let joined_at = started.elapsed();
+    let drained = runtime.shared.math().test_admission_snapshot();
+    let completed = match result.report() {
+        Ok(RunReport::Modeling(steps)) => Some(steps.len()),
+        _ => None,
+    };
+    println!(
+        "PROBE_C steps={steps} progressed_at={progressed_at:?} events_at_cancel={events_at_cancel} finished_before_cancel={finished_before_cancel} cancelled_at={cancelled_at:?} joined_at={joined_at:?}"
+    );
+    println!(
+        "PROBE_C report_ok={} report_err={:?} completed_modeling_steps={completed:?} horizon_completed={:?} usable={}",
+        result.report().is_ok(),
+        result.report().err().map(|e| e.to_string()),
+        result.horizon().map(|h| h.completed_steps),
+        result.usable()
+    );
+    println!("PROBE_C admission baseline={baseline:?} during={during:?} drained={drained:?}");
+    assert!(!finished_before_cancel, "horizon finished before cancel; probe inconclusive");
+    assert!(
+        result.report().is_err(),
+        "caller cancellation after admission did not stop the horizon: completed {completed:?} of {steps}"
+    );
+    assert_eq!((drained.1, drained.2), (baseline.1, baseline.2));
+}
