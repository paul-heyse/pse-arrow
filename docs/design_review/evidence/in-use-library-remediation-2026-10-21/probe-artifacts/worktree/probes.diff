+        "selected(root) equal_across_edit={} checked_equal={} select_debug_len {} -> {} first_differing_line={:?} context={:?}\n",
+        s0 == s1,
+        rev0.checked == rev1.checked,
+        d0.len(),
+        d1.len(),
+        first_diff,
+        first_diff.map(|i| d0.lines().skip(i.saturating_sub(6)).take(8).collect::<Vec<_>>().join(" | ")),
+    ));
+    let publish1 = std::mem::take(&mut *executed.lock().unwrap());
+    log.push_str(&format!("  after_edit_publish: generation={} retention_usage={:?} limits=({},{})\n", workspace.generation, workspace.retention_usage(), workspace.limits.retained_entries, workspace.limits.retained_bytes));
+    let t2 = std::time::Instant::now();
+    let again = probe_prepare(&mut workspace, id, bindings.clone());
+    let prep_elapsed = t2.elapsed();
+    let prep1 = std::mem::take(&mut *executed.lock().unwrap());
+    log.push_str(&format!("  after_reprepare: generation={} retention_usage={:?} limits=({},{})\n", workspace.generation, workspace.retention_usage(), workspace.limits.retained_entries, workspace.limits.retained_bytes));
+    log.push_str(&format!("edit publish({publish1_elapsed:?}): {:?}\n", summarize(&publish1)));
+    log.push_str(&format!("re-prepare after unreached edit({prep_elapsed:?}): {:?}\n", summarize(&prep1)));
+    let shared = prepared
+        .admitted
+        .bodies
+        .iter()
+        .filter(|(k, b)| again.admitted.bodies.get(*k).is_some_and(|c| Arc::ptr_eq(&b.math, &c.math)))
+        .count();
+    log.push_str(&format!(
+        "bodies {} same_keys={} shared_math_ptr={} model_equal={} admitted_equal={}\n",
+        prepared.admitted.bodies.len(),
+        prepared.admitted.bodies.keys().eq(again.admitted.bodies.keys()),
+        shared,
+        *prepared.model == *again.model,
+        *prepared.admitted == *again.admitted,
+    ));
+    let t3 = std::time::Instant::now();
+    let _ = probe_prepare(&mut workspace, id, bindings);
+    let prep2_elapsed = t3.elapsed();
+    let prep2 = std::mem::take(&mut *executed.lock().unwrap());
+    log.push_str(&format!("re-prepare with no edit({prep2_elapsed:?}): {:?}\n", summarize(&prep2)));
+    log
+}
+fn probe_prepare(workspace: &mut CompilerWorkspace, id: DeclarationId, bindings: Bindings) -> PreparedModeling {
+    workspace
+        .prepare_modeling_cancellable(
+            id,
+            pse_modeling::specialize::root_instance(id),
+            bindings,
+            Limits::default(),
+            Arc::new(AtomicBool::new(false)),
+        )
+        .unwrap()
+}
+fn probe_differing(a: &SpecializedModel, b: &SpecializedModel) -> Vec<&'static str> {
+    let mut out = Vec::new();
+    macro_rules! cmp {
+        ($($name:ident),* $(,)?) => {$( if a.$name != b.$name { out.push(stringify!($name)); } )*};
+    }
+    cmp!(
+        root_selections, selection_closures, regimes, fixtures, integrated, derivatives,
+        integrals, initial_equations, expectations, paths, elastic, continuation, meshes,
+        implicit, symbols, equations, closures, exchanges, instances, groups, ports,
+        connectivity, state_specifications, material_ports, inventory_balances,
+        inventory_initial_conditions, connections, functions, annotations, engineering_rules,
+        lowerings, native, derived, unit_interval, objectives, nonnegative, requirements,
+    );
+    if format!("{a:?}").len() != format!("{b:?}").len() && out.is_empty() {
+        out.push("private:source_occurrences?");
+    }
+    out
+}
