            }
          },
          "required": [
            "kind",
            "predecessor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The continuation predecessor is neither usable nor explicitly seed-eligible.",
          "properties": {
            "kind": {
              "const": "seed_permission",
              "type": "string"
            },
            "predecessor": {
              "$ref": "#/$defs/OccurrenceKey",
