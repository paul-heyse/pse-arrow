      "required": [
        "artifact",
        "block",
        "row",
        "field"
      ],
      "type": "object"
    },
    "GraphNodeOutput": {
      "additionalProperties": false,
      "description": "A metadata node; absent revision means that endpoint's revision was not fetched.",
      "properties": {
        "identity": {
          "description": "Exact table-qualified node identity.",
          "type": "string"
        },
        "revision": {
          "description": "Selected source or concurrency revision, when actually observed.",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Source declaration/owner role.",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "role",
        "revision"
      ],
      "type": "object"
    },
    "GraphScope": {
      "description": "The requested local question; no transitive or all-path completeness is implied.",
      "oneOf": [
        {
          "const": "immediate_blockers",
          "description": "Immediate study prerequisites and the shared policy's observed blocker.",
          "type": "string"
        },
        {
          "const": "recorded_sources",
          "description": "Immediate predecessor/source references.",
          "type": "string"
        },
        {
          "const": "retained_consumers",
