              "$ref": "#/$defs/OccurrenceKey",
              "description": "Source occurrence."
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Selected role."
            },
            "seed": {
              "description": "Seed artifact.",
              "pattern": "^[0-9a-fA-F]{32}$",
              "type": "string",
              "x-pse-identity": "SolutionId"
            }
          },
          "required": [
            "kind",
            "predecessor",
            "role",
            "seed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An explicit supplied seed was compatible.",
          "properties": {
            "kind": {
              "const": "explicit",
              "type": "string"
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Selected role."
            },
            "seed": {
              "description": "Seed artifact.",
              "pattern": "^[0-9a-fA-F]{32}$",
              "type": "string",
              "x-pse-identity": "SolutionId"
            }
          },
          "required": [
            "kind",
            "role",
            "seed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit fresh fallback and its attributable absence/incompatibility.",
          "properties": {
            "kind": {
              "const": "fresh_fallback",
              "type": "string"
            },
            "predecessor": {
              "$ref": "#/$defs/OccurrenceKey",
              "description": "Selected predecessor."
            },
            "reason": {
              "$ref": "#/$defs/StudySeedUnavailable",
              "description": "Reason a continuation seed could not be used."
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Selected role."
            }
          },
          "required": [
            "kind",
            "predecessor",
            "role",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "StudySeedRole": {
      "enum": [
        "primal_solution",
        "parameter_estimates",
        "trajectory",
        "horizon_state"
      ],
      "type": "string"
    },
    "StudySeedUnavailable": {
      "enum": [
        "absent",
        "incompatible"
      ],
      "type": "string"
    },
    "WaitReason": {
      "description": "Reason for waiting; terminal observations produce no new effect.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Dependencies permit selected source/overlay admission, before any native claim.",
          "properties": {
            "kind": {
              "const": "scientific_admission",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Queue admission grants acquisition only; no native start has been chosen.",
          "properties": {
            "kind": {
              "const": "seed_resolution",
              "type": "string"
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Consumer input role whose compatibility remains unresolved."
            }
          },
          "required": [
            "kind",
            "role"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Earlier occurrence is not yet terminal.",
          "properties": {
            "kind": {
              "const": "dependency",
              "type": "string"
            },
            "predecessor": {
              "$ref": "#/$defs/OccurrenceKey",
              "description": "Earlier occurrence."
            }
          },
          "required": [
            "kind",
            "predecessor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An attempt is executing.",
          "properties": {
            "kind": {
              "const": "assigned",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Occurrence has ended and no safe retry is available.",
          "properties": {
            "kind": {
              "const": "terminal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded metadata response with explicit local completeness and revision-bound continuation.",
  "properties": {
    "anchor": {
      "$ref": "#/$defs/GraphAnchor",
      "description": "Frozen selected owner/revision."
    },
    "complete": {
      "description": "Whether the requested immediate neighborhood was exhausted.",
      "type": "boolean"
    },
    "continuation": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphContinuation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Explicit next page, never a silent truncated success."
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/PointActionOutput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Shared study policy action, when this is a study occurrence."
    },
    "edges": {
      "description": "At most the requested count of retained original edges.",
      "items": {
        "$ref": "#/$defs/GraphEdgeOutput"
      },
      "type": "array"
    },
    "evidence_scope": {
      "description": "Scope and evidence limits, including protected acquisition.",
      "type": "string"
    },
    "examined_rows": {
      "description": "Native result rows decoded, including the page-plus-one sentinel; not physical KV work.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "nodes": {
      "description": "Selected node plus observed neighboring identities, preserving isolates.",
      "items": {
        "$ref": "#/$defs/GraphNodeOutput"
      },
      "type": "array"
    },
    "observed_blocker": {
      "description": "One blocker actually selected by shared policy, not an assertion that all blockers were enumerated.",
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "$ref": "#/$defs/GraphScope",
      "description": "Requested local question."
    },
    "version": {
      "const": 1,
      "default": 1,
      "description": "Required standalone graph-response interpretation.",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "anchor",
    "scope",
    "nodes",
    "edges",
    "decision",
    "observed_blocker",
    "examined_rows",
    "complete",
    "continuation",
    "evidence_scope"
  ],
  "title": "CanonicalGraphDocumentOutput",
  "type": "object"
}
