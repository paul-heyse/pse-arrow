        },
        "source": {
          "description": "Original directed source.",
          "type": "string"
        },
        "target": {
          "description": "Original directed target.",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "source",
        "target",
        "role",
        "evidence"
      ],
      "type": "object"
    },
    "GraphEdgeRole": {
      "description": "An existing edge's semantic role, preserving parallel relations.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Ordering prerequisite.",
          "properties": {
            "kind": {
              "const": "ordering",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Scientific usable-result prerequisite.",
          "properties": {
            "kind": {
              "const": "usable_result",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
