      "minimum": 0,
      "type": "integer"
    },
    "PointActionOutput": {
      "additionalProperties": false,
      "description": "One action derived from one exact occurrence revision.",
      "properties": {
        "expected_revision": {
          "description": "Snapshot revision to check inside the adapter's transaction/locks.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ActionKindOutput",
          "description": "Shared scientific/operational choice."
        },
        "occurrence": {
          "$ref": "#/$defs/OccurrenceKey",
          "description": "Target occurrence."
        }
      },
      "required": [
        "occurrence",
        "expected_revision",
        "kind"
      ],
      "type": "object"
    },
    "RefusalOutput": {
      "description": "Attributable policy refusal, separate from cancellation and operation diagnostics.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A terminal predecessor did not grant required scientific permission.",
          "properties": {
            "kind": {
              "const": "dependency_unusable",
              "type": "string"
            },
            "predecessor": {
              "$ref": "#/$defs/OccurrenceKey",
