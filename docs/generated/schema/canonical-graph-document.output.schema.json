          "properties": {
            "kind": {
              "const": "seed_unavailable",
              "type": "string"
            },
            "predecessor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OccurrenceKey"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Continuation producer, absent for an explicit external seed."
            },
            "reason": {
              "$ref": "#/$defs/StudySeedUnavailable",
              "description": "Typed unavailability."
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Explicit selected role."
            }
          },
          "required": [
            "kind",
            "predecessor",
            "role",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Seed acquisition/checking failed internally; never fresh fallback.",
          "properties": {
            "kind": {
              "const": "seed_internal",
              "type": "string"
            },
            "predecessor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OccurrenceKey"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Continuation producer, absent for an explicit external seed."
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Selected role."
            }
          },
          "required": [
            "kind",
            "predecessor",
            "role"
          ],
          "type": "object"
        }
      ]
    },
    "StartProvenance": {
      "description": "Actual start selected by pure policy and retained by either executor.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Declared fresh start.",
          "properties": {
            "kind": {
              "const": "fresh",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Constant/seed-free operation; no seed was requested.",
          "properties": {
            "kind": {
              "const": "not_needed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
