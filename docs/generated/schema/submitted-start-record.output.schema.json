{
  "$comment": "@generated by pse-schema; do not edit",
  "$defs": {
    "ActiveSetSnapshot": {
      "additionalProperties": false,
      "description": "Native activity vectors in source order.",
      "properties": {
        "bounds": {
          "description": "Native variable-bound statuses in source order.",
          "items": {
            "$ref": "#/$defs/BoundActivity"
          },
          "type": "array"
        },
        "constraints": {
          "description": "Native constraint statuses in source order.",
          "items": {
            "$ref": "#/$defs/RowActivity"
          },
          "type": "array"
        }
      },
      "required": [
        "bounds",
        "constraints"
      ],
      "type": "object"
    },
    "AppliedRestart": {
      "additionalProperties": false,
      "description": "The interior-point restart an adapter applied to a submitted primal-dual seed.",
      "properties": {
        "mu_init": {
          "description": "Initial barrier parameter set, in native coordinates; `None` left the native default.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "profile": {
          "$ref": "#/$defs/WarmRestart",
          "description": "The restart profile that produced it."
        }
      },
      "required": [
        "mu_init",
        "profile"
      ],
      "type": "object"
    },
    "Basis": {
      "additionalProperties": false,
      "description": "Native basis values retain their original integer codes.",
      "properties": {
        "columns": {
          "description": "Native column basis statuses.",
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "type": "array"
        },
        "rows": {
          "description": "Native row basis statuses.",
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "type": "object"
    },
    "BoundActivity": {
      "enum": [
        "inactive",
        "at_lower",
        "at_upper",
        "fixed"
      ],
      "type": "string"
    },
    "DiagnosticNonfiniteObservation": {
      "enum": [
        "nan",
        "positive_infinity",
        "negative_infinity"
      ],
      "type": "string"
    },
    "Fraction": {
      "description": "A finite fraction in (0, 1]: a damping factor, a step fraction or a relative push.",
      "exclusiveMinimum": 0.0,
      "format": "double",
      "maximum": 1.0,
      "type": "number"
    },
    "NativeBackend": {
      "enum": [
        "ipopt",
        "pounce",
        "kinsol",
        "highs",
        "clarabel",
        "diffsol",
        "idas",
        "scip",
        "pounce_convex",
        "uno",
        "petsc"
      ],
      "type": "string"
    },
    "Observation": {
      "description": "Evidence distinguishes absence, finite numerical/physical values and nonfinite failures.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Evidence was not available.",
          "properties": {
            "kind": {
              "const": "missing",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A finite numerical observation (not necessarily a physical magnitude).",
          "properties": {
            "kind": {
              "const": "real",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicitly tagged nonfinite numerical failure evidence.",
          "properties": {
            "kind": {
              "const": "nonfinite",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DiagnosticNonfiniteObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite physical evidence bound to its complete immutable quantity contract.",
          "properties": {
            "kind": {
              "const": "physical",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PhysicalObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact counts or native codes.",
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A checked predicate.",
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native status or explanatory detail.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered physical operand/free-index contracts, preserved structurally.",
          "properties": {
            "kind": {
              "const": "contracts",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/OperandContract"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "OperandContract": {
      "additionalProperties": false,
      "description": "A complete registered quantity type plus its free-index obligations.",
      "properties": {
        "indices": {
          "description": "Ordered bound-index, domain and entity-kind identities.",
          "items": {
            "items": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 16,
              "minItems": 16,
              "type": "array"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "type": "array"
        },
        "quantity": {
          "description": "Immutable complete quantity-type identity.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "indices"
      ],
      "type": "object"
    },
    "PhysicalObservation": {
      "additionalProperties": false,
      "description": "Finite physical evidence bound to its complete immutable quantity contract.",
      "properties": {
        "context": {
          "description": "Immutable interpretation context.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string",
          "x-pse-identity": "ContentHash"
        },
        "magnitude": {
          "description": "Finite canonical magnitude.",
          "format": "double",
          "type": "number"
        },
        "quantity": {
          "description": "Registered complete quantity contract.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string",
          "x-pse-identity": "SemanticId"
        },
        "unit": {
          "description": "Declared canonical unit.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string",
          "x-pse-identity": "SemanticId"
        }
      },
      "required": [
        "magnitude",
        "quantity",
        "unit",
        "context"
      ],
      "type": "object"
    },
    "PresolvePass": {
      "enum": [
        "linear_bounds",
        "redundant_rows",
        "affine_elimination",
        "fbbt",
        "rank_diagnostics",
        "auxiliary"
      ],
      "type": "string"
    },
    "PresolveSeedTransformation": {
      "additionalProperties": false,
      "description": "Actual presolve coordinate transform submitted with a seed.",
      "properties": {
        "passes": {
          "description": "Passes the library actually installed.",
          "items": {
            "$ref": "#/$defs/PresolvePass"
          },
          "type": "array"
        },
        "transformation": {
          "description": "Native coordinate identity of the projection.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string",
          "x-pse-identity": "ContentHash"
        }
      },
      "required": [
        "transformation",
        "passes"
      ],
      "type": "object"
    },
    "RestartBarrier": {
      "description": "The initial barrier parameter of an interior-point restart.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The final barrier value the producing interior-point solve recorded with the seed. A\nseed without one (an authored seed) leaves the native default in force, and the\nreceipt says so.",
          "properties": {
            "kind": {
              "const": "seed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A stated positive value.",
          "properties": {
            "kind": {
              "const": "value",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Tolerance",
              "description": "The initial barrier parameter."
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "RowActivity": {
      "enum": [
        "inactive",
        "at_lower",
        "at_upper",
        "equality"
      ],
      "type": "string"
    },
    "SeedOrigin": {
      "additionalProperties": false,
      "description": "Portable provenance of an output seed, distinct from its coordinate compatibility.",
      "properties": {
        "attempt": {
          "description": "Zero-based original attempt.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "run": {
          "description": "Public run identity when one exists.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ],
          "x-pse-identity": "RunId"
        }
      },
      "required": [
        "run",
        "attempt"
      ],
      "type": "object"
    },
    "SeedTransformation": {
      "description": "One transformation a submitted seed passed through between its source coordinates and\nthe native API, recorded from what actually ran (F25).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Model coordinate normalization, by its identity.",
          "properties": {
            "kind": {
              "const": "normalization",
              "type": "string"
            },
            "value": {
              "pattern": "^blake3:[0-9a-fA-F]{64}$",
              "type": "string",
              "x-pse-identity": "ContentHash"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Library presolve: its transformation identity and the passes it applied.",
          "properties": {
            "kind": {
              "const": "presolve",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PresolveSeedTransformation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An active-set working set checked against the native transformation.",
          "properties": {
            "kind": {
              "const": "working_set",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/WorkingSetTransfer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The interior-point restart the adapter applied to a primal-dual seed.",
          "properties": {
            "kind": {
              "const": "interior_restart",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/AppliedRestart"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Tolerance": {
      "description": "A finite, strictly positive tolerance, budget or push.",
      "exclusiveMinimum": 0.0,
      "format": "double",
      "type": "number"
    },
    "WarmPayloadSnapshot": {
      "description": "Portable seed data with explicit numerical observations.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Root-system source coordinates.",
          "properties": {
            "kind": {
              "const": "root",
              "type": "string"
            },
            "primal": {
              "description": "Source-coordinate primal values, including explicit special floats.",
              "items": {
                "$ref": "#/$defs/Observation"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "primal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "NLP source coordinates and optional restart state.",
          "properties": {
            "barrier": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Observation"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Barrier parameter when supplied by the native owner."
            },
            "bound_duals": {
              "description": "Lower and upper bound duals in source order.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "items": {
                    "$ref": "#/$defs/Observation"
                  },
                  "type": "array"
                },
                {
                  "items": {
                    "$ref": "#/$defs/Observation"
                  },
                  "type": "array"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            },
            "kind": {
              "const": "nlp",
              "type": "string"
            },
            "primal": {
              "description": "Source-coordinate primal values.",
              "items": {
                "$ref": "#/$defs/Observation"
              },
              "type": "array"
            },
            "row_duals": {
              "description": "Constraint duals in source order.",
              "items": {
                "$ref": "#/$defs/Observation"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "working_set": {
              "anyOf": [
                {
                  "$ref": "#/$defs/WorkingSetSnapshot"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Active-set state and its coordinate transformation."
            }
          },
          "required": [
            "kind",
            "primal",
            "bound_duals",
            "row_duals",
            "barrier",
            "working_set"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "LP/QP source coordinates and native simplex status codes.",
          "properties": {
            "basis": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Basis"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional simplex basis status codes."
            },
            "dual": {
              "description": "Optional column and constraint dual starts.",
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "items": {
                    "$ref": "#/$defs/Observation"
                  },
                  "type": "array"
                },
                {
                  "items": {
                    "$ref": "#/$defs/Observation"
                  },
                  "type": "array"
                }
              ],
              "type": [
                "array",
                "null"
              ]
            },
            "kind": {
              "const": "highs",
              "type": "string"
            },
            "primal": {
              "description": "Optional source-coordinate primal start.",
              "items": {
                "$ref": "#/$defs/Observation"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "primal",
            "dual",
            "basis"
          ],
          "type": "object"
        }
      ]
    },
    "WarmRestart": {
      "additionalProperties": false,
      "description": "How an interior-point method re-centres a complete primal-dual seed (L-N3). With the\ncold-start defaults a seeded restart is pushed back towards the analytic centre and loses\nmost of its benefit, so a restart states its barrier and its pushes. Absent fields take\nthese defaults across the Python boundary (ADR-0113).",
      "properties": {
        "barrier": {
          "$ref": "#/$defs/RestartBarrier",
          "default": {
            "kind": "seed"
          },
          "description": "Initial barrier parameter of the restart (`mu_init`)."
        },
        "bound_frac": {
          "$ref": "#/$defs/Fraction",
          "default": 1e-9,
          "description": "Relative push of the primal seed from its bounds (`warm_start_bound_frac`); at most\none half."
        },
        "bound_push": {
          "$ref": "#/$defs/Tolerance",
          "default": 1e-9,
          "description": "Absolute push of the primal seed from its bounds (`warm_start_bound_push`)."
        },
        "mult_bound_push": {
          "$ref": "#/$defs/Tolerance",
          "default": 1e-9,
          "description": "Push of the bound multipliers from zero (`warm_start_mult_bound_push`)."
        },
        "slack_bound_frac": {
          "$ref": "#/$defs/Fraction",
          "default": 1e-9,
          "description": "Relative push of the slack seed from its bounds (`warm_start_slack_bound_frac`); at\nmost one half."
        },
        "slack_bound_push": {
          "$ref": "#/$defs/Tolerance",
          "default": 1e-9,
          "description": "Absolute push of the slack seed from its bounds (`warm_start_slack_bound_push`)."
        }
      },
      "required": [
        "barrier",
        "bound_push",
        "bound_frac",
        "slack_bound_push",
        "slack_bound_frac",
        "mult_bound_push"
      ],
      "type": "object"
    },
    "WarmStartSnapshotBody": {
      "additionalProperties": false,
      "description": "Typed semantic seed snapshot. Nonfinite numbers have explicit observations; zero's\nsign survives in real observations. Snapshot attribution is separate from content identity.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/NativeBackend",
          "description": "Registry backend spelling."
        },
        "data": {
          "description": "Numeric input content compatibility.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string",
          "x-pse-identity": "ContentHash"
        },
        "layout": {
          "description": "Exact source coordinate compatibility.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string",
          "x-pse-identity": "ContentHash"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeedOrigin"
            },
            {
              "type": "null"
            }
          ],
          "description": "Producing occurrence, when there is one."
        },
        "payload": {
          "$ref": "#/$defs/WarmPayloadSnapshot",
          "description": "Complete portable seed data."
        },
        "profile": {
          "description": "Effective native profile compatibility.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string",
          "x-pse-identity": "ContentHash"
        }
      },
      "required": [
        "origin",
        "layout",
        "profile",
        "data",
        "backend",
        "payload"
      ],
      "type": "object"
    },
    "WorkingSetSnapshot": {
      "additionalProperties": false,
      "description": "Typed active set with the transformation under which its indices are meaningful.",
      "properties": {
        "active": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActiveSetSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native activities when compiled with active-set support."
        },
        "transformation": {
          "description": "Presolve coordinate transformation.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string",
          "x-pse-identity": "ContentHash"
        }
      },
      "required": [
        "transformation",
        "active"
      ],
      "type": "object"
    },
    "WorkingSetTransfer": {
      "additionalProperties": false,
      "description": "What became of a submitted working set at the presolve boundary: it reaches the native\nsolver only under the transformation that produced it.",
      "properties": {
        "retained": {
          "description": "It equals this attempt's transformation and was passed through.",
          "type": "boolean"
        },
        "transformation": {
          "description": "The transformation the working set was produced under.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string",
          "x-pse-identity": "ContentHash"
        }
      },
      "required": [
        "transformation",
        "retained"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Actual submitted source-coordinate seed, distinct from an output or native checkpoint.",
  "properties": {
    "document_version": {
      "const": 1,
      "default": 1,
      "type": "integer"
    },
    "previous_attempt": {
      "description": "Original predecessor attempt selection.",
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "seed": {
      "anyOf": [
        {
          "$ref": "#/$defs/WarmStartSnapshotBody"
        },
        {
          "type": "null"
        }
      ],
      "description": "Full actual source-coordinate seed with explicit nonfinite observations."
    },
    "sparse_seed": {
      "additionalProperties": false,
      "description": "Full partial coordinate start, retaining exact IEEE bits including signed zero.",
      "patternProperties": {
        "^[0-9a-fA-F]{32}$": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "propertyNames": {
        "pattern": "^[0-9a-fA-F]{32}$",
        "type": "string",
        "x-pse-identity": "SemanticId"
      },
      "type": [
        "object",
        "null"
      ]
    },
    "submitted": {
      "description": "Actual API submission; native internal use remains separately observed.",
      "type": "boolean"
    },
    "transformations": {
      "description": "Complete transformations actually applied before API submission.",
      "items": {
        "$ref": "#/$defs/SeedTransformation"
      },
      "type": "array"
    }
  },
  "required": [
    "previous_attempt",
    "seed",
    "sparse_seed",
    "transformations",
    "submitted",
    "document_version"
  ],
  "title": "SubmittedStartRecord",
  "type": "object"
}
