{
  "$comment": "@generated by pse-schema; do not edit",
  "$defs": {
    "AnalysisEventIdentityOutput": {
      "additionalProperties": false,
      "description": "Whole event identity; time, family and iteration alone cannot identify a source event.",
      "properties": {
        "family_sequence": {
          "description": "Independent sequence within the declared source family.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "field_ordinal": {
          "description": "Exact source field ordinal, absent for a whole-event fact.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "generation": {
          "description": "Source reset/attempt generation.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "producer": {
          "$ref": "#/$defs/ProducerId",
          "description": "Includes operation and exact performing producer instance."
        },
        "sequence": {
          "description": "Source-issued event sequence before fanout.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "producer",
        "generation",
        "sequence",
        "family_sequence",
        "field_ordinal"
      ],
      "type": "object"
    },
    "AnalysisQuestion": {
      "description": "Named review questions. They are independent of optional profiler availability.",
      "oneOf": [
        {
          "const": "preparation",
          "description": "Stable construction versus value binding.",
          "type": "string"
        },
        {
          "const": "evaluator_work",
          "description": "Demand versus actual work and derivative order.",
          "type": "string"
        },
        {
          "const": "evaluation_cost",
          "description": "Matched complete inclusive call populations.",
          "type": "string"
        },
        {
          "const": "root_progress",
          "description": "Accepted/trial/raw-map and physical error progress.",
          "type": "string"
        },
        {
          "const": "dynamic_work",
          "description": "Forward/sensitivity/quadrature/backward/replay work.",
          "type": "string"
        },
        {
          "const": "dependency_readiness",
          "description": "Exact study membership and readiness.",
          "type": "string"
        },
        {
          "const": "factor_recovery",
          "description": "Parent factor recovery versus substitutions.",
          "type": "string"
        },
        {
          "const": "waiting",
          "description": "Actual interval populations, without inferred scheduler blocking.",
          "type": "string"
        },
        {
          "const": "comparability",
          "description": "Existing invocation comparison policy and refusals.",
          "type": "string"
        },
        {
          "const": "physical_attribution",
          "description": "Actual source coordinates and retained mapping witnesses.",
          "type": "string"
        }
      ]
    },
    "AnalysisRequestOutput": {
      "additionalProperties": false,
      "description": "Explicit finite review policy; thresholds are forwarded to the existing numerical owner.",
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperationId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional exact baseline, never selected by name or a current pointer."
        },
        "inventory_members": {
          "default": [],
          "description": "Exact supplied inventory indices; empty uses exact operation/run/attempt associations.",
          "items": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "numerical_history_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/NumericalHistoryPolicyOutput"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit existing numerical interpretation policy, never a convergence policy."
        },
        "operation": {
          "$ref": "#/$defs/OperationId",
          "description": "Exact selected original operation."
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisQuestion"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One bounded question; absent selects all ten."
        },
        "source_items": {
          "default": 1024,
          "description": "Unique source records/scalars inspected, capped at 4096.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "statements": {
          "default": 128,
          "description": "Returned statements, capped at 256; all ten questions remain represented.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "const": 2,
          "default": 2,
          "description": "Current request contract; unsupported versions refuse at decode.",
          "type": "integer"
        },
        "window": {
          "$ref": "#/$defs/RecordedWindow",
          "default": {
            "kind": "recorded"
          },
          "description": "Original source-clock selection."
        }
      },
      "required": [
        "version",
        "operation",
        "baseline",
        "inventory_members",
        "question",
        "window",
        "source_items",
        "statements",
        "numerical_history_policy"
      ],
      "type": "object"
    },
    "AnalysisSelectionOutput": {
      "additionalProperties": false,
      "description": "Actual selection, retaining clock and interval uncertainty without a reader-time anchor.",
      "properties": {
        "aligned_to_request": {
          "description": "Whether absolute requested-clock window claims can be made for this selection.",
          "type": "boolean"
        },
        "interval_end": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClosedDuration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual upper bound, absent for unknown coverage."
        },
        "interval_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClosedDuration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual lower bound, absent for unknown coverage."
        },
        "operation": {
          "$ref": "#/$defs/OperationId",
          "description": "Exact selected original operation."
        },
        "process_clock": {
          "description": "Original process-clock identity; equal numeric timestamps do not align other clocks.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/AnalysisSelectionScope",
          "description": "Direct, independently selected, or unknown source coverage."
        }
      },
      "required": [
        "operation",
        "process_clock",
        "interval_start",
        "interval_end",
        "scope",
        "aligned_to_request"
      ],
      "type": "object"
    },
    "AnalysisSelectionScope": {
      "description": "Relation of an actual source-clock selection to the requested operation.",
      "oneOf": [
        {
          "const": "direct",
          "description": "The requested process clock supplies the interval.",
          "type": "string"
        },
        {
          "const": "independent",
          "description": "A related or baseline operation retains its own independent interval.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "No operation snapshot supplies a coverage interval; supplied records remain readable.",
          "type": "string"
        }
      ]
    },
    "AnalysisSourceReferenceOutput": {
      "additionalProperties": false,
      "description": "Reference into the original supplied set, independent of its filesystem location.",
      "properties": {
        "event": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisEventIdentityOutput"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact coherent-event identity when applicable."
        },
        "member": {
          "description": "Explicit pack member identity; `frozen` names the supplied immutable set.",
          "type": "string"
        },
        "partial": {
          "description": "Original coverage or availability limits this fact.",
          "type": "boolean"
        },
        "pointer": {
          "description": "RFC 6901 pointer relative to this member; empty addresses the whole member.",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Value",
          "description": "Source-native value category; UInt64 never passes through floating point."
        }
      },
      "required": [
        "member",
        "pointer",
        "event",
        "value",
        "partial"
      ],
      "type": "object"
    },
    "AnalysisStatementOutput": {
      "additionalProperties": false,
      "description": "A source-linked fact, qualified hypothesis or explicit limitation.",
      "properties": {
        "code": {
          "description": "Stable semantic code.",
          "type": "string"
        },
        "evidence": {
          "description": "Actual members supporting this explanation.",
          "items": {
            "$ref": "#/$defs/AnalysisSourceReferenceOutput"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/StatementKind",
          "description": "Existing shared interpretation strength."
        },
        "message": {
          "description": "Bounded explanation generated from the typed source facts.",
          "type": "string"
        },
        "next": {
          "description": "Optional discriminating observations; analysis never performs them.",
          "items": {
            "$ref": "#/$defs/NextObservation"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "code",
        "message",
        "evidence",
        "next"
      ],
      "type": "object"
    },
    "ClosedDuration": {
      "additionalProperties": false,
      "properties": {
        "nanos": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "secs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "secs",
        "nanos"
      ],
      "type": "object"
    },
    "ExplanatoryRequirementOutput": {
      "additionalProperties": false,
      "description": "A bounded prerequisite for one exact question and subject.",
      "properties": {
        "fact": {
          "$ref": "#/$defs/RequiredFact",
          "description": "Required semantic premise."
        },
        "missing_reason": {
          "description": "Explicit bounded reason when the premise is absent.",
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "$ref": "#/$defs/AnalysisQuestion",
          "description": "Question whose explanation depends on this fact."
        },
        "sources": {
          "description": "At most eight real pointers into supplied bytes, not decoded payload shortcuts.",
          "items": {
            "$ref": "#/$defs/AnalysisSourceReferenceOutput"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/RequirementStatus",
          "description": "Actual supplied-fact availability."
        },
        "subject": {
          "$ref": "#/$defs/OperationId",
          "description": "Exact original operation, never a current-run alias."
        }
      },
      "required": [
        "question",
        "subject",
        "fact",
        "status",
        "sources",
        "missing_reason"
      ],
      "type": "object"
    },
    "NextObservation": {
      "enum": [
        "InspectRelated",
        "CpuProfile",
        "TimelineCapture",
        "OptionalAllocationProbe",
        "OptionalWaitProbe",
        "AwaitOwnerCheckpoint"
      ],
      "type": "string"
    },
    "NonFinite": {
      "enum": [
        "Nan",
        "PositiveInfinity",
        "NegativeInfinity"
      ],
      "type": "string"
    },
    "NumericalHistoryPolicyOutput": {
      "additionalProperties": false,
      "description": "Explicit operator-selected thresholds, not universal convergence criteria.\nThe enclosing inspection request retains this policy beside its statements.",
      "properties": {
        "barrier_progress_minimum": {
          "description": "Minimum relative decrease in barrier accompanying a primal-stall question.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "inertia_fraction_minimum": {
          "description": "Selected inertia-correction fraction, under one complete factor population.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "minimum_events": {
          "description": "Required consecutive source events, at least two.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "primal_progress_maximum": {
          "description": "Maximum relative reduction in the same native primal measure.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "raw_recycle_ratio_minimum": {
          "description": "Selected consecutive absolute residual ratio for each captured raw-map\ncoordinate. Native input points may be accelerated; this is no contraction norm.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "repeated_worst_row": {
          "description": "Ask whether the same owner-supplied original worst row recurs.",
          "type": "boolean"
        },
        "tiny_step_maximum": {
          "description": "Tiny native-step question, in the source's declared norm/coordinates.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "version": {
          "description": "Interpretation version; only version 1 is supported.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "minimum_events",
        "tiny_step_maximum",
        "primal_progress_maximum",
        "barrier_progress_minimum",
        "inertia_fraction_minimum",
        "raw_recycle_ratio_minimum",
        "repeated_worst_row"
      ],
      "type": "object"
    },
    "OperationId": {
      "additionalProperties": false,
      "description": "Process instance plus local sequence; never a semantic or cache identity.",
      "properties": {
        "process_instance": {
          "description": "Process-local instance locator; not a semantic identity or attestation.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "sequence": {
          "description": "Unique local operation sequence.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "process_instance",
        "sequence"
      ],
      "type": "object"
    },
    "ProducerId": {
      "additionalProperties": false,
      "description": "A performing instance, not a scientific or cache identity.",
      "properties": {
        "operation": {
          "$ref": "#/$defs/OperationId",
          "description": "Actual enclosing diagnostic operation."
        },
        "sequence": {
          "description": "Unique performing instance within this process.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "operation",
        "sequence"
      ],
      "type": "object"
    },
    "QuestionAnalysisOutput": {
      "additionalProperties": false,
      "description": "Independent answer, present even when all its required sources are unavailable.",
      "properties": {
        "question": {
          "$ref": "#/$defs/AnalysisQuestion",
          "description": "The selected bounded question."
        },
        "statements": {
          "description": "Facts and limits, with no silent empty-success substitution.",
          "items": {
            "$ref": "#/$defs/AnalysisStatementOutput"
          },
          "type": "array"
        }
      },
      "required": [
        "question",
        "statements"
      ],
      "type": "object"
    },
    "RecordedWindow": {
      "description": "Recorded source-clock selection; no variant consults a reader clock.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Anchor at the selected snapshot's recorded read_at with InspectionRequest.window.",
          "properties": {
            "kind": {
              "const": "recorded",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit endpoint on the selected operation's source clock.",
          "properties": {
            "at": {
              "$ref": "#/$defs/ClosedDuration",
              "description": "Recorded source-clock endpoint."
            },
            "kind": {
              "const": "ending_at",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit closed source-clock range, retaining predecessor baselines.",
          "properties": {
            "end": {
              "$ref": "#/$defs/ClosedDuration",
              "description": "Requested source-clock end."
            },
            "kind": {
              "const": "interval",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/ClosedDuration",
              "description": "Requested source-clock start."
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "type": "object"
        }
      ]
    },
    "RequiredFact": {
      "description": "One scientific or diagnostic premise required by a selected question.",
      "oneOf": [
        {
          "const": "model",
          "description": "Original authored model and its source interpretation.",
          "type": "string"
        },
        {
          "const": "input",
          "description": "Actual submitted physical inputs, including constructor inputs.",
          "type": "string"
        },
        {
          "const": "effective_settings",
          "description": "Materialized solver/runtime settings rather than a current default.",
          "type": "string"
        },
        {
          "const": "physical_coordinates",
          "description": "Original retained coordinate witness.",
          "type": "string"
        },
        {
          "const": "invocation",
          "description": "Exact original invocation facts for comparison.",
          "type": "string"
        },
        {
          "const": "operation_evidence",
          "description": "An actual supplied observation for the selected question.",
          "type": "string"
        }
      ]
    },
    "RequirementStatus": {
      "description": "Missing premises remain separate from statement confidence and publication status.",
      "oneOf": [
        {
          "const": "available",
          "description": "At least one original supplied source supports this premise.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "The premise is absent or its interpretation is unavailable.",
          "type": "string"
        }
      ]
    },
    "StatementKind": {
      "enum": [
        "Established",
        "Hypothesis",
        "Limitation"
      ],
      "type": "string"
    },
    "Value": {
      "description": "A value and its availability are inseparable.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Exact unsigned additive counter.",
          "properties": {
            "kind": {
              "const": "Count",
              "type": "string"
            },
            "value": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact signed native checkpoint.",
          "properties": {
            "kind": {
              "const": "Integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite numeric checkpoint.",
          "properties": {
            "kind": {
              "const": "Number",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Producer-owned predicate.",
          "properties": {
            "kind": {
              "const": "Boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Bounded copied textual checkpoint.",
          "properties": {
            "kind": {
              "const": "Text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit absence with a bounded explanation.",
          "properties": {
            "kind": {
              "const": "Unavailable",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Original nonfinite category.",
          "properties": {
            "kind": {
              "const": "NonFinite",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/NonFinite"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact value exceeded fixed-width representation.",
          "properties": {
            "kind": {
              "const": "Overflow",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Shared typed product for live-copy, frozen, CLI and offline pack consumers.",
  "properties": {
    "inspected_source_items": {
      "description": "Unique original source items inspected; shared facts are counted once.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "omitted_source_items": {
      "description": "Unique eligible source items not inspected due to the selected allowance.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "omitted_statements": {
      "description": "Derived statements omitted by the response allowance.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "questions": {
      "description": "Requested independent questions in stable order; all ten when no selector is supplied.",
      "items": {
        "$ref": "#/$defs/QuestionAnalysisOutput"
      },
      "type": "array"
    },
    "request": {
      "$ref": "#/$defs/AnalysisRequestOutput",
      "description": "Effective bounded policy actually used."
    },
    "requirements": {
      "description": "Question-dependent explanatory premises over the supplied set.",
      "items": {
        "$ref": "#/$defs/ExplanatoryRequirementOutput"
      },
      "type": "array"
    },
    "selections": {
      "description": "Actual source-clock interval used for every selected operation.",
      "items": {
        "$ref": "#/$defs/AnalysisSelectionOutput"
      },
      "type": "array"
    },
    "version": {
      "const": 2,
      "default": 2,
      "description": "Current result contract.",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "request",
    "questions",
    "selections",
    "requirements",
    "inspected_source_items",
    "omitted_source_items",
    "omitted_statements"
  ],
  "title": "AnalysisDocumentOutput",
  "type": "object"
}
