    "ScheduledInput": {
      "additionalProperties": false,
      "description": "One contract parameter held piecewise constant: it takes a new value at each change\ntime. The integration parameter vector holds one value per interval, `times.len() + 1`\nof them, and a sensitivity column for each, so sensitivities cross every change\n(ADR-0119, I6).\n\n```\nuse pse_backend_native::dynamics::{Profile, ScheduledInput};\n\n// Two contract parameters; the second changes at t = 0.5.\nlet profile = Profile {\n    schedule: vec![ScheduledInput { parameter: 1, times: vec![0.5] }],\n    ..Profile::default()\n};\n// The static parameter comes first, then one value per interval.\nassert_eq!(profile.integration_width(2), 3);\nassert_eq!(profile.integration_parameters(&[4.0, 7.0]), vec![4.0, 7.0, 7.0]);\nassert_eq!(profile.parameters_at(&[4.0, 7.0, 9.0], 0.25), vec![4.0, 7.0]);\n// A change takes effect at its time.\nassert_eq!(profile.parameters_at(&[4.0, 7.0, 9.0], 0.5), vec![4.0, 9.0]);\n```",
      "properties": {
        "parameter": {
          "description": "Position of the input in the contract's parameter order.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "times": {
          "description": "Strictly increasing change times after the start and up to the end; a change at\nthe end is observed by the final sample only.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "parameter",
        "times"
      ],
      "type": "object"
    },
