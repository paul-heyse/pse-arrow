        "numerical",
        "inconclusive"
      ],
      "type": "string"
    },
    "NumericObservation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "real"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "nonfinite"
            },
            "value": {
              "$ref": "#/$defs/DiagnosticNonfiniteObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Observation": {
      "description": "Evidence distinguishes absence, finite numerical/physical values and nonfinite failures.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Evidence was not available.",
          "properties": {
            "kind": {
              "const": "missing",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A finite numerical observation (not necessarily a physical magnitude).",
          "properties": {
            "kind": {
              "const": "real",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicitly tagged nonfinite numerical failure evidence.",
          "properties": {
            "kind": {
              "const": "nonfinite",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DiagnosticNonfiniteObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite physical evidence bound to its complete immutable quantity contract.",
          "properties": {
            "kind": {
              "const": "physical",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PhysicalObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact counts or native codes.",
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A checked predicate.",
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native status or explanatory detail.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered physical operand/free-index contracts, preserved structurally.",
          "properties": {
            "kind": {
              "const": "contracts",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/OperandContract"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "OccurrenceKey": {
      "description": "Position-independent identity within one study; equal bindings do not merge keys.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "OperandContract": {
      "additionalProperties": false,
      "description": "A complete registered quantity type plus its free-index obligations.",
      "properties": {
        "indices": {
          "description": "Ordered bound-index, domain and entity-kind identities.",
          "items": {
            "items": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 16,
              "minItems": 16,
              "type": "array"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "type": "array"
        },
        "quantity": {
          "description": "Immutable complete quantity-type identity.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "indices"
      ],
      "type": "object"
    },
    "PhysicalObservation": {
      "additionalProperties": false,
      "description": "Finite physical evidence bound to its complete immutable quantity contract.",
      "properties": {
        "context": {
          "description": "Immutable interpretation context.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "magnitude": {
          "description": "Finite canonical magnitude.",
          "format": "double",
          "type": "number"
        },
        "quantity": {
          "description": "Registered complete quantity contract.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "unit": {
          "description": "Declared canonical unit.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        }
      },
      "required": [
        "magnitude",
        "quantity",
        "unit",
        "context"
      ],
      "type": "object"
    },
    "PointAttemptOutcome": {
      "additionalProperties": false,
      "description": "One retained try; attempt identity is distinct from the requested occurrence.",
      "properties": {
        "attempt_id": {
          "description": "Present for a durable attempt; ephemeral tries still retain their ordered history.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "diagnostic": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundaryDiagnostic"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original detailed diagnostic, including admission failures without result tables."
        },
        "effect": {
          "$ref": "#/$defs/StudyEffectState",
          "description": "Knowledge of effects for this try."
        },
        "lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptState"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual try lifecycle; absent when no operational attempt was made."
        },
        "scientific": {
          "$ref": "#/$defs/ScientificFacts",
          "description": "Original operation-owned scientific permission."
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/StartProvenance"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual chosen start, if dispatch was attempted."
        }
      },
      "required": [
        "scientific",
        "effect"
      ],
      "type": "object"
    },
    "ScientificFacts": {
      "additionalProperties": false,
      "description": "E supplies aggregate decisions; the study never counts result tables to infer these.",
      "properties": {
        "candidate_use": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateUse"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original scientific classification, when an assessment exists."
        },
        "seed_permission": {
          "description": "Independent seed permission from the owning operation.",
          "type": "boolean"
        },
        "usable": {
          "description": "Aggregate usable-result permission from the owning operation.",
          "type": "boolean"
        }
      },
      "required": [
        "usable",
        "seed_permission"
      ],
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "Authored location attached by the owner that has the source map.",
      "properties": {
        "end": {
          "description": "UTF-8 exclusive ending byte offset.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "Optional authored display name.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Definition or document path, never a backend-local node identifier.",
          "type": "string"
        },
        "revision": {
          "default": null,
          "description": "Immutable source interpretation context; absence is explicitly unattributed.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Original semantic occurrence or instance identity.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "start": {
          "description": "UTF-8 starting byte offset, when supplied by the parser/compiler.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "path"
      ],
      "type": "object"
    },
    "StartProvenance": {
      "description": "Actual start selected by pure policy and retained by either executor.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Declared fresh start.",
          "properties": {
            "kind": {
              "const": "fresh",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Constant/seed-free operation; no seed was requested.",
          "properties": {
            "kind": {
              "const": "not_needed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Selected predecessor supplied the compatible artifact.",
          "properties": {
            "kind": {
              "const": "continuation",
              "type": "string"
            },
            "predecessor": {
              "$ref": "#/$defs/OccurrenceKey",
              "description": "Source occurrence."
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Selected role."
            },
            "seed": {
              "description": "Seed artifact.",
              "pattern": "^[0-9a-fA-F]{32}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "predecessor",
            "role",
            "seed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An explicit supplied seed was compatible.",
          "properties": {
            "kind": {
              "const": "explicit",
              "type": "string"
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Selected role."
            },
            "seed": {
              "description": "Seed artifact.",
              "pattern": "^[0-9a-fA-F]{32}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "role",
            "seed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit fresh fallback and its attributable absence/incompatibility.",
          "properties": {
            "kind": {
              "const": "fresh_fallback",
              "type": "string"
            },
            "predecessor": {
              "$ref": "#/$defs/OccurrenceKey",
              "description": "Selected predecessor."
            },
            "reason": {
              "$ref": "#/$defs/StudySeedUnavailable",
              "description": "Reason a continuation seed could not be used."
            },
            "role": {
              "$ref": "#/$defs/StudySeedRole",
              "description": "Selected role."
            }
          },
          "required": [
            "kind",
            "predecessor",
            "role",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "StudyEffectState": {
      "enum": [
        "absent",
        "present",
        "unknown",
        "idempotent"
      ],
      "type": "string"
    },
    "StudyRetryFailure": {
      "enum": [
        "transient",
        "deterministic"
      ],
      "type": "string"
    },
    "StudySeedRole": {
      "enum": [
        "primal_solution",
        "parameter_estimates",
        "trajectory",
        "horizon_state"
      ],
      "type": "string"
    },
    "StudySeedUnavailable": {
      "enum": [
        "absent",
        "incompatible"
      ],
      "type": "string"
    },
    "TerminationCause": {
      "description": "The cause of a try's end, beside its typed termination code.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The run failed with an error, or cancellation stopped it.",
          "properties": {
            "diagnostic": {
              "$ref": "#/$defs/BoundaryDiagnostic",
              "description": "The error's message."
            },
            "kind": {
              "const": "error",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diagnostic"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Infrastructure failed the try; authored point policy decides whether retry is permitted.",
          "properties": {
            "diagnostic": {
              "$ref": "#/$defs/BoundaryDiagnostic",
              "description": "Preserved original typed cause and observations."
            },
            "kind": {
              "const": "infrastructure",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "diagnostic"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The joined run was assessed.",
          "properties": {
            "candidate_use": {
              "description": "The use of each requested candidate, in request order.",
              "items": {
                "$ref": "#/$defs/CandidateUse"
              },
              "type": "array"
            },
            "diagnostics": {
              "description": "Original scientific diagnostic envelopes, retained without rendered-string reconstruction.",
              "items": {
                "$ref": "#/$defs/BoundaryDiagnostic"
              },
              "type": "array"
            },
            "kind": {
              "const": "assessment",
              "type": "string"
            },
            "usable": {
              "description": "Every requested candidate is a result.",
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "usable",
            "candidate_use",
            "diagnostics"
          ],
          "type": "object"
        }
      ]
    },
    "ValidityLineage": {
      "additionalProperties": false,
      "description": "What a rejected authored validity predicate guards (ADR-0123 Outcome 4, Plan 23 H5): its\nlayer and the declaration stating it; for the form and data layers the form it belongs\nto, the parameter sets whose values bound it and the form's declared arguments it\nconstrains; for the closure layer the model members its range bounds. A fixture's\nexpected validity failure is matched against this lineage, not against a rule text.",
      "properties": {
        "form": {
          "description": "The form: the function declaration whose evaluation was rejected; absent on the\nclosure layer.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "layer": {
          "$ref": "#/$defs/ModelingValidityLayer",
          "description": "The form layer (a function's own domain), the data layer (a declared envelope) or\nthe closure layer (an annotated range)."
        },
        "members": {
          "description": "The model members a closure range bounds; empty on the form and data layers.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "sets": {
          "description": "The table rows or entities whose values bound the predicate, in order.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "description": "The form itself, the relation or kind declaration declaring the envelope, or the\nclosure range's annotation.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "variables": {
          "description": "Positions of the constrained arguments among the form's declared arguments.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "layer",
        "source",
        "sets",
        "variables",
        "members"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Version 1 of the typed detail of an attempt's termination, stored as the attempt's\ntermination-detail document (ADR-0116 Outcome 6): the typed values that explain why the\ntry ended as it did.",
  "properties": {
    "cause": {
      "$ref": "#/$defs/TerminationCause",
      "description": "Why the try ended."
    },
    "effect": {
      "$ref": "#/$defs/StudyEffectState",
      "description": "Effect knowledge is independent of attempt lifecycle."
    },
    "point": {
      "anyOf": [
        {
          "$ref": "#/$defs/PointAttemptOutcome"
        },
        {
          "type": "null"
        }
      ],
      "description": "Typed occurrence try, including failures before native admission."
    },
    "retry_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/StudyRetryFailure"
        },
        {
          "type": "null"
        }
      ],
      "description": "Purpose-specific retry classification; severity does not grant retries."
    },
    "version": {
      "const": 2,
      "default": 2,
      "description": "Document version.",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "cause",
    "effect"
  ],
  "title": "TerminationDetail",
  "type": "object"
}
