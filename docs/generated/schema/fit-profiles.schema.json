{
  "$comment": "@generated by pse-schema; do not edit",
  "$defs": {
    "ApplicabilityClaim": {
      "additionalProperties": false,
      "description": "Immutable attribution of an instantiated scientific claim.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelingApplicabilityBasis"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fitted, recommended or validated region; none for unknown/unrestricted/union."
        },
        "call": {
          "description": "Distinguishes actual bound applications, including derived arguments.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "coverage": {
          "description": "Joint whole-interval application, only for a verified declared interval.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "description": "Required claim identities.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "description": "Evidence source; absent for an undeclared claim.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "form": {
          "description": "Form whose actual application demanded this evidence.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "id": {
          "description": "Absent exactly for undeclared evidence, which is unknown.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "layer": {
          "$ref": "#/$defs/ModelingValidityLayer",
          "description": "Evidence layer, distinct from a mathematical domain."
        },
        "owner": {
          "description": "Declared scientific family or model owner.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "owner_lineage": {
          "description": "Checked nominal owner and its entity-kind ancestors, in most-derived order.\nNon-kind owners have only themselves; callers cannot author this witness.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "Explicit unknown reason, never a numerical predicate result.",
          "type": [
            "string",
            "null"
          ]
        },
        "records": {
          "description": "Distinct scientific records selected by this application.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "owner",
        "owner_lineage",
        "form",
        "call",
        "records",
        "dependencies",
        "layer"
      ],
      "type": "object"
    },
    "ApplicabilityInput": {
      "additionalProperties": false,
      "description": "Numerical inputs are recorded in the lowering's canonical physical units.",
      "properties": {
        "name": {
          "description": "Declared argument name.",
          "type": "string"
        },
        "quantity_type": {
          "description": "Actual physical quantity type; values use its canonical unit.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/NumericObservation",
          "description": "Actual value at the demanded application; the wire retains explicit IEEE evidence."
        }
      },
      "required": [
        "name",
        "value",
        "quantity_type"
      ],
      "type": "object"
    },
    "ApplicabilityObservation": {
      "additionalProperties": false,
      "description": "One typed observation, including alternative evidence which was not required.",
      "properties": {
        "admitted": {
          "description": "Whether the low-level evidence gate admitted this required claim.",
          "type": "boolean"
        },
        "claim": {
          "$ref": "#/$defs/ApplicabilityClaim",
          "description": "Complete scientific attribution."
        },
        "extrapolation_allowed": {
          "description": "Whether leaving this particular claim's region was permitted.",
          "type": "boolean"
        },
        "inputs": {
          "description": "Actual inputs of this claim application.",
          "items": {
            "$ref": "#/$defs/ApplicabilityInput"
          },
          "type": "array"
        },
        "instance": {
          "description": "Bound assembly instance, populated by the executing consumer.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/ModelingApplicabilityOutcome",
          "description": "Evidence classification, independent of authorization."
        },
        "permissions": {
          "description": "Authorizing declarations that matched this claim's exact target.",
          "items": {
            "$ref": "#/$defs/ApplicabilityPermission"
          },
          "type": "array"
        },
        "required": {
          "description": "This claim was required, rather than a nonwinning union alternative.",
          "type": "boolean"
        },
        "unknown_allowed": {
          "description": "Both permissions remain independent even for a mixed dependency result.",
          "type": "boolean"
        }
      },
      "required": [
        "claim",
        "inputs",
        "outcome",
        "required",
        "permissions",
        "unknown_allowed",
        "extrapolation_allowed",
        "admitted"
      ],
      "type": "object"
    },
    "ApplicabilityPermission": {
      "additionalProperties": false,
      "description": "Authorization retains its declaration and scope, with fixed named targets.",
      "properties": {
        "allow_extrapolation": {
          "description": "Independent permission for leaving a declared region.",
          "type": "boolean"
        },
        "allow_unknown": {
          "description": "Independent permission for absence of evidence.",
          "type": "boolean"
        },
        "id": {
          "description": "Authored authorization identity.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "scope": {
          "description": "Declaring lexical consumer scope, not the claim's owner.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "target_kind": {
          "$ref": "#/$defs/ModelingPermissionTarget",
          "description": "Named records or declared scientific families."
        },
        "targets": {
          "description": "Exact admitted target identities; inheritance never widens this set.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "scope",
        "target_kind",
        "targets",
        "allow_unknown",
        "allow_extrapolation"
      ],
      "type": "object"
    },
    "BoundaryDiagnostic": {
      "additionalProperties": false,
      "description": "Stable structured cause shared by Rust and the public error projection.",
      "properties": {
        "applicability": {
          "default": [],
          "description": "Complete scientific evidence on demanded paths, including refused claims.",
          "items": {
            "$ref": "#/$defs/ApplicabilityObservation"
          },
          "type": "array"
        },
        "causes": {
          "default": [],
          "description": "Ordered retained cause envelopes, preserving repeated aggregate occurrences.",
          "items": {
            "$ref": "#/$defs/BoundaryDiagnostic"
          },
          "type": "array"
        },
        "class": {
          "$ref": "#/$defs/NativeBoundaryClass",
          "description": "Machine-readable disposition; callers never parse the message."
        },
        "code": {
          "$ref": "#/$defs/DiagnosticCode",
          "description": "Detailed semantic identity, authoritative over every coarse projection."
        },
        "locations": {
          "default": [],
          "description": "Available source locations. Empty means unattributed, not a guessed source.",
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "type": "array"
        },
        "observations": {
          "additionalProperties": {
            "$ref": "#/$defs/Observation"
          },
          "description": "Values observed while checking the contract.",
          "type": "object"
        },
        "rule": {
          "$ref": "#/$defs/DiagnosticRule",
          "description": "The violated named contract, not a replacement for source identities."
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity",
          "default": "error",
          "description": "Error, warning or information; a warning never makes a model invalid."
        },
        "sources": {
          "description": "All affected authored identities, in deterministic order.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "stage": {
          "$ref": "#/$defs/DiagnosticStage",
          "description": "Operation boundary, such as selected admission or provider registration."
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidityLineage"
            },
            {
              "type": "null"
            }
          ],
          "description": "The lineage of a rejected authored validity predicate; absent on every other finding."
        }
      },
      "required": [
        "code",
        "class",
        "stage",
        "sources",
        "rule",
        "observations"
      ],
      "type": "object"
    },
