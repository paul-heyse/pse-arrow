              "$ref": "#/$defs/DiagnosticNonfiniteObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Observation": {
      "description": "Evidence distinguishes absence, finite numerical/physical values and nonfinite failures.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Evidence was not available.",
          "properties": {
            "kind": {
              "const": "missing",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A finite numerical observation (not necessarily a physical magnitude).",
          "properties": {
            "kind": {
              "const": "real",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicitly tagged nonfinite numerical failure evidence.",
          "properties": {
            "kind": {
              "const": "nonfinite",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DiagnosticNonfiniteObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite physical evidence bound to its complete immutable quantity contract.",
          "properties": {
            "kind": {
              "const": "physical",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PhysicalObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact counts or native codes.",
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A checked predicate.",
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native status or explanatory detail.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered physical operand/free-index contracts, preserved structurally.",
          "properties": {
            "kind": {
              "const": "contracts",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/OperandContract"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "OperandContract": {
      "additionalProperties": false,
      "description": "A complete registered quantity type plus its free-index obligations.",
      "properties": {
        "indices": {
          "description": "Ordered bound-index, domain and entity-kind identities.",
          "items": {
            "items": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 16,
              "minItems": 16,
              "type": "array"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "type": "array"
        },
        "quantity": {
          "description": "Immutable complete quantity-type identity.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "indices"
      ],
      "type": "object"
    },
    "PhysicalObservation": {
      "additionalProperties": false,
      "description": "Finite physical evidence bound to its complete immutable quantity contract.",
      "properties": {
        "context": {
          "description": "Immutable interpretation context.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "magnitude": {
          "description": "Finite canonical magnitude.",
          "format": "double",
          "type": "number"
        },
        "quantity": {
          "description": "Registered complete quantity contract.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "unit": {
          "description": "Declared canonical unit.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        }
      },
      "required": [
        "magnitude",
        "quantity",
        "unit",
        "context"
      ],
      "type": "object"
    },
    "ProfileChain": {
      "additionalProperties": false,
      "description": "The chain of one free parameter toward one end.",
      "properties": {
        "actual_parallelism": {
          "description": "Successfully started workers in this profile execution.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "bound": {
          "$ref": "#/$defs/IntervalBound",
          "description": "The end reached."
        },
        "detail": {
          "description": "Why the chain stopped.",
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "$ref": "#/$defs/IntervalEnd",
          "description": "The end the chain moves toward."
        },
        "estimate": {
          "description": "The fit estimate of the parameter.",
          "format": "double",
          "type": "number"
        },
        "parameter": {
          "description": "The parameter.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "points": {
          "description": "Every pinned fit, in solve order.",
          "items": {
            "$ref": "#/$defs/ProfilePoint"
          },
          "type": "array"
        },
        "scheduling_failures": {
          "description": "Worker start or environment failures for this execution, including partial starts.",
          "items": {
            "$ref": "#/$defs/ProfileWorkerFailure"
          },
          "type": "array"
        },
        "worker_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProfileWorkerFailure"
            },
            {
              "type": "null"
            }
          ],
          "description": "Typed worker failure, separate from the scientific interval outcome."
        }
      },
      "required": [
        "scheduling_failures",
        "actual_parallelism",
        "parameter",
        "end",
        "estimate",
        "bound",
        "points"
      ],
      "type": "object"
    },
    "ProfileFailure": {
      "additionalProperties": false,
      "description": "A retained source failure. Clones share the same typed witness; presentation is derived.",
      "properties": {
        "applicability": {
          "default": [],
          "description": "Complete scientific evidence on demanded paths, including refused claims.",
          "items": {
            "$ref": "#/$defs/ApplicabilityObservation"
          },
          "type": "array"
        },
        "causes": {
          "default": [],
          "description": "Ordered retained cause envelopes, preserving repeated aggregate occurrences.",
          "items": {
            "$ref": "#/$defs/BoundaryDiagnostic"
          },
          "type": "array"
        },
        "class": {
          "$ref": "#/$defs/NativeBoundaryClass",
          "description": "Machine-readable disposition; callers never parse the message."
        },
        "code": {
          "$ref": "#/$defs/DiagnosticCode",
          "description": "Detailed semantic identity, authoritative over every coarse projection."
        },
        "locations": {
          "default": [],
          "description": "Available source locations. Empty means unattributed, not a guessed source.",
          "items": {
            "$ref": "#/$defs/SourceLocation"
          },
          "type": "array"
        },
        "observations": {
          "additionalProperties": {
            "$ref": "#/$defs/Observation"
          },
          "description": "Values observed while checking the contract.",
          "type": "object"
        },
        "rule": {
          "$ref": "#/$defs/DiagnosticRule",
          "description": "The violated named contract, not a replacement for source identities."
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity",
          "default": "error",
          "description": "Error, warning or information; a warning never makes a model invalid."
        },
        "sources": {
          "description": "All affected authored identities, in deterministic order.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "stage": {
          "$ref": "#/$defs/DiagnosticStage",
          "description": "Operation boundary, such as selected admission or provider registration."
        },
        "validity": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValidityLineage"
            },
            {
              "type": "null"
            }
          ],
          "description": "The lineage of a rejected authored validity predicate; absent on every other finding."
        }
      },
      "required": [
        "code",
        "class",
        "stage",
        "sources",
        "rule",
        "observations"
      ],
      "type": "object"
    },
    "ProfilePoint": {
      "additionalProperties": false,
      "description": "One pinned fit of a profile chain.",
      "properties": {
        "accepted": {
          "description": "Qualified stationary or better and feasible, and used by the chain.",
          "type": "boolean"
        },
        "callback_terminal_failure": {
          "description": "The native callback owner latched a terminal failure, even for a trial-class cause.",
          "type": "boolean"
        },
        "detail": {
          "description": "Why the pinned fit failed or was not used.",
          "type": [
            "string",
            "null"
          ]
        },
        "failures": {
          "description": "Original typed cause; serialized through its owner's boundary diagnostic.",
          "items": {
            "$ref": "#/$defs/ProfileFailure"
          },
          "type": "array"
        },
        "objective": {
          "description": "The pinned fit's objective, half the weighted residual sum of squares.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "qualification": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeQualification"
            },
            {
              "type": "null"
            }
          ],
          "description": "The pinned fit's qualification, when the runner returned a report."
        },
        "seed": {
          "description": "The chain point whose solution seeded this fit; `None` for the fit estimate (PS-11).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "statistic": {
          "description": "`√(2·max(f - f*, 0))`.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "termination": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeTermination"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual native termination, when the runner returned a report."
        },
        "value": {
          "description": "The pinned parameter value, in the parameter's unit.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "value",
        "failures",
        "callback_terminal_failure",
        "accepted"
      ],
      "type": "object"
    },
    "ProfileWorkerFailure": {
      "description": "Infrastructure outcome of one chain; this never becomes a scientific trial rejection.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The chain began and its worker unwound. It is never replayed.",
          "properties": {
            "kind": {
              "const": "panic",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A worker could not start or enter its execution environment; an unstarted\nchain carries this outcome when no remaining worker completes it.",
          "properties": {
            "detail": {
              "type": "string"
            },
            "kind": {
              "const": "scheduling",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "detail"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entering the worker's native environment failed with an original typed cause.",
          "properties": {
            "detail": {
              "$ref": "#/$defs/ProfileFailure"
            },
            "kind": {
              "const": "environment",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "detail"
          ],
          "type": "object"
        }
      ]
    },
    "SourceLocation": {
      "additionalProperties": false,
      "description": "Authored location attached by the owner that has the source map.",
      "properties": {
        "end": {
          "description": "UTF-8 exclusive ending byte offset.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "Optional authored display name.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Definition or document path, never a backend-local node identifier.",
          "type": "string"
        },
        "revision": {
          "default": null,
          "description": "Immutable source interpretation context; absence is explicitly unattributed.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Original semantic occurrence or instance identity.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "start": {
          "description": "UTF-8 starting byte offset, when supplied by the parser/compiler.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "path"
      ],
      "type": "object"
    },
    "ValidityLineage": {
      "additionalProperties": false,
      "description": "What a rejected authored validity predicate guards (ADR-0123 Outcome 4, Plan 23 H5): its\nlayer and the declaration stating it; for the form and data layers the form it belongs\nto, the parameter sets whose values bound it and the form's declared arguments it\nconstrains; for the closure layer the model members its range bounds. A fixture's\nexpected validity failure is matched against this lineage, not against a rule text.",
      "properties": {
        "form": {
          "description": "The form: the function declaration whose evaluation was rejected; absent on the\nclosure layer.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ]
        },
        "layer": {
          "$ref": "#/$defs/ModelingValidityLayer",
          "description": "The form layer (a function's own domain), the data layer (a declared envelope) or\nthe closure layer (an annotated range)."
        },
        "members": {
          "description": "The model members a closure range bounds; empty on the form and data layers.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "sets": {
          "description": "The table rows or entities whose values bound the predicate, in order.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "description": "The form itself, the relation or kind declaration declaring the envelope, or the\nclosure range's annotation.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string"
        },
        "variables": {
          "description": "Positions of the constrained arguments among the form's declared arguments.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "layer",
        "source",
        "sets",
        "variables",
        "members"
      ],
      "type": "object"
    },
    "WithheldReason": {
      "enum": [
        "not_feasible",
        "structural_unavailable",
        "neighborhood_unavailable",
        "no_candidate",
        "no_local_analysis",
        "multipliers_unrecovered",
        "complementarity_failed",
        "not_stationary",
        "analysis_unavailable",
        "licq_failed",
        "weakly_active",
        "second_order_failed",
        "backsolve_failed",
        "rank_deficient",
        "nonunit_importance",
        "responses_unavailable",
        "parameter_at_bound",
        "upstream_withheld"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Whether profile intervals were requested, available, or withheld by native admission.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "No profile request was made.",
      "properties": {
        "status": {
          "const": "not_requested",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Every chain, including worker failures and its actual parallelism.",
      "properties": {
        "chains": {
          "description": "Every retained chain, including distinct worker failures.",
          "items": {
            "$ref": "#/$defs/ProfileChain"
          },
          "type": "array"
        },
        "status": {
          "const": "available",
          "type": "string"
        }
      },
      "required": [
        "status",
        "chains"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The native reason and retained diagnostic explanation.",
      "properties": {
        "detail": {
          "description": "Retained explanation of the refusal.",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/WithheldReason",
          "description": "Canonical native reason for withholding."
        },
        "status": {
          "const": "withheld",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "detail"
      ],
      "type": "object"
    }
  ],
  "title": "FitProfileDocument"
}
