    "Observation": {
      "description": "Evidence distinguishes absence, finite numerical/physical values and nonfinite failures.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Evidence was not available.",
          "properties": {
            "kind": {
              "const": "missing",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A finite numerical observation (not necessarily a physical magnitude).",
          "properties": {
            "kind": {
              "const": "real",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicitly tagged nonfinite numerical failure evidence.",
          "properties": {
            "kind": {
              "const": "nonfinite",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/DiagnosticNonfiniteObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite physical evidence bound to its complete immutable quantity contract.",
          "properties": {
            "kind": {
              "const": "physical",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/PhysicalObservation"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Exact counts or native codes.",
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A checked predicate.",
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native status or explanatory detail.",
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered physical operand/free-index contracts, preserved structurally.",
          "properties": {
            "kind": {
              "const": "contracts",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/OperandContract"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "OperandContract": {
      "additionalProperties": false,
      "description": "A complete registered quantity type plus its free-index obligations.",
      "properties": {
        "indices": {
          "description": "Ordered bound-index, domain and entity-kind identities.",
          "items": {
            "items": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 16,
              "minItems": 16,
              "type": "array"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "type": "array"
        },
        "quantity": {
          "description": "Immutable complete quantity-type identity.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        }
      },
      "required": [
        "quantity",
        "indices"
      ],
      "type": "object"
    },
    "PhysicalObservation": {
      "additionalProperties": false,
      "description": "Finite physical evidence bound to its complete immutable quantity contract.",
      "properties": {
        "context": {
          "description": "Immutable interpretation context.",
          "pattern": "^blake3:[0-9a-fA-F]{64}$",
          "type": "string",
          "x-pse-identity": "ContentHash"
        },
        "magnitude": {
          "description": "Finite canonical magnitude.",
          "format": "double",
          "type": "number"
        },
        "quantity": {
          "description": "Registered complete quantity contract.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string",
          "x-pse-identity": "SemanticId"
        },
        "unit": {
          "description": "Declared canonical unit.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string",
          "x-pse-identity": "SemanticId"
        }
      },
      "required": [
        "magnitude",
        "quantity",
        "unit",
        "context"
      ],
      "type": "object"
    },
    "ValidityLineageOutput": {
      "additionalProperties": false,
      "description": "What a rejected authored validity predicate guards (ADR-0123 Outcome 4, Plan 23 H5): its\nlayer and the declaration stating it; for the form and data layers the form it belongs\nto, the parameter sets whose values bound it and the form's declared arguments it\nconstrains; for the closure layer the model members its range bounds. A fixture's\nexpected validity failure is matched against this lineage, not against a rule text.",
      "properties": {
        "form": {
          "description": "The form: the function declaration whose evaluation was rejected; absent on the\nclosure layer.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": [
            "string",
            "null"
          ],
          "x-pse-identity": "SemanticId"
        },
        "layer": {
          "$ref": "#/$defs/ModelingValidityLayer",
          "description": "The form layer (a function's own domain), the data layer (a declared envelope) or\nthe closure layer (an annotated range)."
        },
        "members": {
          "description": "The model members a closure range bounds; empty on the form and data layers.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string",
            "x-pse-identity": "SemanticId"
          },
          "type": "array"
        },
        "sets": {
          "description": "The table rows or entities whose values bound the predicate, in order.",
          "items": {
            "pattern": "^[0-9a-fA-F]{32}$",
            "type": "string",
            "x-pse-identity": "SemanticId"
          },
          "type": "array"
        },
        "source": {
          "description": "The form itself, the relation or kind declaration declaring the envelope, or the\nclosure range's annotation.",
          "pattern": "^[0-9a-fA-F]{32}$",
          "type": "string",
          "x-pse-identity": "SemanticId"
        },
        "variables": {
          "description": "Positions of the constrained arguments among the form's declared arguments.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "layer",
        "source",
        "form",
        "sets",
        "variables",
        "members"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact typed failure predicate. No message parsing or broad exception matching.",
  "properties": {
    "code": {
      "$ref": "#/$defs/DiagnosticCode",
      "description": "Relevant detailed diagnostic identity."
    },
    "conditions": {
      "additionalProperties": {
        "$ref": "#/$defs/Observation"
      },
      "description": "Explicit necessary observed conditions. Exact values; no implicit tolerance.",
      "type": "object"
    },
    "document_version": {
      "const": 1,
      "default": 1,
      "type": "integer"
    },
    "rule": {
      "$ref": "#/$defs/DiagnosticRule",
      "description": "Original named contract."
    },
    "sources": {
      "description": "Exact selected original source population, including explicit absence.",
      "items": {
        "pattern": "^[0-9a-fA-F]{32}$",
        "type": "string",
        "x-pse-identity": "SemanticId"
      },
      "type": "array"
    },
    "stage": {
      "$ref": "#/$defs/DiagnosticStage",
      "description": "Original operation stage."
    },
    "validity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidityLineageOutput"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact recorded validity lineage, when present."
    }
  },
  "required": [
    "code",
    "stage",
    "rule",
    "sources",
    "validity",
    "conditions",
    "document_version"
  ],
  "title": "ReproductionPredicateOutput",
  "type": "object"
}
