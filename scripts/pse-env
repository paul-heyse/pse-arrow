# The checkout's environment and placement boundary; see scripts/pse_env.py.
script_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
checkout_python="$script_directory/../.venv/bin/python"
if [[ -x "$checkout_python" ]]; then
    exec "$checkout_python" "$script_directory/pse_env.py" "$@"
fi
# Bootstrap can prepare a checkout before its pinned environment exists.
exec python3 "$script_directory/pse_env.py" "$@"
