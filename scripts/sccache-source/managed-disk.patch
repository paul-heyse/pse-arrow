+// SPDX-License-Identifier: Apache-2.0
+// Managed Linux cache ownership. Cache contents and the wire protocol are upstream.
+use crate::client::ServerConnection;
+use crate::config::Config;
+use crate::net::SocketAddr;
+use serde::{Deserialize, Serialize};
+use std::fs::{self, DirBuilder, File, Metadata, OpenOptions, TryLockError};
+use std::io::{self, Read, Write};
+use std::os::fd::AsRawFd;
+use std::os::linux::net::SocketAddrExt;
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::{DirBuilderExt, FileTypeExt, MetadataExt, OpenOptionsExt};
+use std::os::unix::net::UnixStream;
+use std::path::{Path, PathBuf};
+
+#[derive(Debug, PartialEq, Eq, Serialize, Deserialize)]
+struct Binding {
+    pid: u32,
+    start: String,
+    root: (u64, u64),
+    configuration: String,
+}
+
+fn identity(metadata: &Metadata) -> (u64, u64) {
+    (metadata.dev(), metadata.ino())
+}
+
+fn uid() -> u32 {
+    // SAFETY: this function has no preconditions.
+    unsafe { libc::geteuid() }
+}
+
+fn invalid(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::PermissionDenied, message)
+}
+
+fn start_tick(pid: u32) -> io::Result<String> {
+    let stat = fs::read_to_string(format!("/proc/{pid}/stat"))?;
+    stat.rsplit_once(')')
+        .and_then(|(_, tail)| tail.split_whitespace().nth(19))
+        .map(str::to_owned)
+        .ok_or_else(|| invalid("managed cache peer process identity unavailable"))
+}
+
+fn binding(pid: u32, root: (u64, u64), config: &Config) -> io::Result<Binding> {
+    let mut caches = config.cache_configs.clone();
+    let mut fallback = config.fallback_cache.clone();
+    // The open directory supplies physical identity, including across aliases.
+    if let Some(disk) = &mut caches.disk {
+        disk.dir.clear();
+    }
+    fallback.dir.clear();
+    let mut fingerprint = blake3::Hasher::new();
+    fingerprint.update(&serde_json::to_vec(&(
+        caches,
+        fallback,
+        &config.basedirs,
+        config.skip_cache_check,
+        std::env::var("SCCACHE_MAX_FRAME_LENGTH").ok(),
+    ))?);
+    Ok(Binding {
+        pid,
+        start: start_tick(pid)?,
+        root,
+        configuration: fingerprint.finalize().to_hex().to_string(),
+    })
+}
+
+struct Endpoint {
+    lock_dir: PathBuf,
+    key: blake3::Hash,
+}
+
+impl Endpoint {
+    fn select(addr: &SocketAddr) -> io::Result<Self> {
+        match addr {
+            SocketAddr::Unix(path) if path.is_absolute() => {
+                let parent = path
+                    .parent()
+                    .ok_or_else(|| invalid("missing cache socket parent"))?;
+                let name = path
+                    .file_name()
+                    .ok_or_else(|| invalid("missing cache socket name"))?;
+                Ok(Self {
+                    lock_dir: parent.canonicalize()?.join(".pse-sccache"),
+                    key: blake3::hash(name.as_bytes()),
+                })
+            }
+            SocketAddr::UnixAbstract(name) => Ok(Self {
+                lock_dir: PathBuf::from(format!("/tmp/.pse-sccache-{}", uid())),
+                key: blake3::hash(name),
+            }),
+            _ => Err(invalid(
+                "managed sccache requires an absolute or abstract Unix endpoint",
+            )),
+        }
+    }
+
+    fn lock_file(&self, create: bool) -> io::Result<File> {
+        if create {
+            match DirBuilder::new().mode(0o700).create(&self.lock_dir) {
+                Ok(()) => {}
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+                Err(error) => return Err(error),
+            }
+        }
+        let directory = fs::symlink_metadata(&self.lock_dir)?;
+        if !directory.is_dir() || directory.uid() != uid() || directory.mode() & 0o077 != 0 {
+            return Err(invalid(
+                "managed sccache endpoint lock directory is not private",
+            ));
+        }
+        let file = OpenOptions::new()
+            .read(true)
+            .write(create)
+            .create(create)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+            .open(self.lock_dir.join(self.key.to_hex().as_str()))?;
+        let metadata = file.metadata()?;
+        if !metadata.is_file()
+            || metadata.uid() != uid()
+            || metadata.mode() & 0o077 != 0
+            || metadata.nlink() != 1
+        {
+            return Err(invalid(
+                "managed sccache endpoint lock is not a private regular file",
+            ));
+        }
+        Ok(file)
+    }
+}
+
+fn lock(file: &File, occupied: &'static str) -> io::Result<()> {
+    match file.try_lock() {
+        Ok(()) => Ok(()),
+        Err(TryLockError::WouldBlock) => Err(io::Error::new(io::ErrorKind::AddrInUse, occupied)),
+        Err(TryLockError::Error(error)) => Err(error),
+    }
+}
+
+pub(crate) struct Ownership {
+    _disk: File,
+    _endpoint: File,
+}
+
+impl Ownership {
+    pub(crate) fn acquire(config: &Config, addr: &SocketAddr) -> io::Result<Self> {
+        let directory = &config.fallback_cache.dir;
+        if !directory.is_absolute() {
+            return Err(invalid(
+                "managed sccache requires an absolute local cache directory",
+            ));
+        }
+        if !directory.exists() {
+            let parent = directory
+                .parent()
+                .ok_or_else(|| invalid("missing cache directory parent"))?;
+            fs::create_dir_all(parent)?;
+            match DirBuilder::new().mode(0o750).create(directory) {
+                Ok(()) => {}
+                Err(error) if error.kind() == io::ErrorKind::AlreadyExists => {}
+                Err(error) => return Err(error),
+            }
+        }
+        let disk = File::open(directory)?;
+        let root = disk.metadata()?;
+        if !root.is_dir() || root.uid() != uid() || root.mode() & 0o022 != 0 {
+            return Err(invalid(
+                "managed sccache cache directory is not owned and protected",
+            ));
+        }
+        // Lock the directory inode, outside the LRU's file population.
+        lock(
+            &disk,
+            "managed sccache cache directory already has a writer",
+        )?;
+
+        let endpoint = Endpoint::select(addr)?;
+        let mut endpoint = endpoint.lock_file(true)?;
+        lock(&endpoint, "managed sccache endpoint already has an owner")?;
+        if let SocketAddr::Unix(path) = addr {
+            remove_stale_socket(path)?;
+        }
+        let selected = binding(std::process::id(), identity(&root), config)?;
+        endpoint.set_len(0)?;
+        endpoint.write_all(&serde_json::to_vec(&selected)?)?;
+        Ok(Self {
+            _disk: disk,
+            _endpoint: endpoint,
+        })
+    }
+}
+
+fn remove_stale_socket(path: &Path) -> io::Result<()> {
+    let candidate = match fs::symlink_metadata(path) {
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+        result => result?,
+    };
+    if !candidate.file_type().is_socket() || candidate.uid() != uid() {
+        return Err(invalid(
+            "managed sccache endpoint is occupied by a foreign file",
+        ));
+    }
+    match UnixStream::connect(path) {
+        Ok(_) => {
+            return Err(invalid(
+                "managed sccache endpoint has a live, unverified listener",
+            ));
+        }
+        Err(error) if error.kind() == io::ErrorKind::ConnectionRefused => {}
+        Err(error) => return Err(error),
+    }
+    let current = fs::symlink_metadata(path)?;
+    if !current.file_type().is_socket()
+        || current.uid() != uid()
+        || identity(&current) != identity(&candidate)
+    {
+        return Err(invalid(
+            "managed sccache socket identity changed during startup",
+        ));
+    }
+    fs::remove_file(path)
+}
+
+fn peer(stream: &UnixStream) -> io::Result<u32> {
+    let mut credentials = libc::ucred {
+        pid: 0,
+        uid: 0,
+        gid: 0,
+    };
+    let mut size = std::mem::size_of_val(&credentials) as libc::socklen_t;
+    // SAFETY: the socket is open and the writable buffers match SO_PEERCRED's layout.
+    let status = unsafe {
+        libc::getsockopt(
+            stream.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            (&mut credentials as *mut libc::ucred).cast(),
+            &mut size,
+        )
+    };
+    if status != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if credentials.pid <= 0
+        || credentials.uid != uid()
+        || size as usize != std::mem::size_of_val(&credentials)
+    {
+        return Err(invalid("managed sccache endpoint peer is foreign"));
+    }
+    let pid = credentials.pid as u32;
+    let executable = fs::metadata(format!("/proc/{pid}/exe"))?;
+    if identity(&executable) != identity(&fs::metadata("/proc/self/exe")?) {
+        return Err(invalid(
+            "managed sccache endpoint runs a different executable",
+        ));
+    }
+    Ok(pid)
+}
+
+pub(crate) fn connect(addr: &SocketAddr, config: &Config) -> io::Result<ServerConnection> {
+    let stream = match addr {
+        SocketAddr::Unix(path) => UnixStream::connect(path)?,
+        SocketAddr::UnixAbstract(name) => {
+            UnixStream::connect_addr(&std::os::unix::net::SocketAddr::from_abstract_name(name)?)?
+        }
+        _ => return Err(invalid("managed sccache requires a Unix endpoint")),
+    };
+    let pid = peer(&stream).map_err(|error| {
+        io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            format!("cannot authenticate managed sccache listener: {error}"),
+        )
+    })?;
+    let endpoint = Endpoint::select(addr)?;
+    let root = fs::metadata(&config.fallback_cache.dir).map_err(|error| {
+        io::Error::new(io::ErrorKind::PermissionDenied, format!("managed sccache listener exists but the selected cache directory is unavailable: {error}"))
+    })?;
+    let expected = binding(pid, identity(&root), config)?;
+    let mut bytes = Vec::new();
+    endpoint
+        .lock_file(false)
+        .map_err(|error| {
+            io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                format!("cannot read managed sccache endpoint binding: {error}"),
+            )
+        })?
+        .take(4097)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > 4096
+        || serde_json::from_slice::<Binding>(&bytes).ok().as_ref() != Some(&expected)
+    {
+        return Err(invalid(
+            "managed sccache endpoint is bound to a different cache directory or configuration",
+        ));
+    }
+    ServerConnection::new(Box::new(stream))
+}
