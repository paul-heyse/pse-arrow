# A single native setup action; direct nextest without a correctness context is unchanged.
set -eu
if [ -z "${PSE_CORRECTNESS_REAL_CARGO-}" ]; then
    exit 0
fi
: "${PSE_CORRECTNESS_EXECUTABLE:?missing invocation correctness executable}"
exec "$PSE_CORRECTNESS_EXECUTABLE" --nextest-test-env
