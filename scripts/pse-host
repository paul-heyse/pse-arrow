# Fixed native host frontdoor; reads never construct or provision tooling.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
tool="$root/target/host-tools/current/pse-host"
if [ ! -x "$tool" ]; then
    echo "pse-host: native tools are not prepared; run scripts/bootstrap-host explicitly" >&2
    exit 125
fi
exec "$tool" "$@"
