 			return Err(Error::UnsupportedVersionedQueries);
+		}
+		// This source integration admits one persistent canonical profile.
+		// ConfigMap deliberately ignores invalid values; refuse the resulting
+		// disabled/default persistence settings rather than silently degrading.
+		#[cfg(not(target_family = "wasm"))]
+		if config.persist_path.is_some() && (
