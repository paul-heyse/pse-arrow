+	#[tokio::test]
+	async fn invalid_persistent_snapshot_and_durability_refused_before_open() {
+		use surrealdb_cnf::ConfigMap;
+		for parameters in ["aol=sync&sync=every&snapshot=1s", "aol=never&sync=every&snapshot=60s", "aol=sync&sync=never&snapshot=60s"] {
