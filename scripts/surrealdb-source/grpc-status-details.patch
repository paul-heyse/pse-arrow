+#[cfg(test)]
+mod canonical_status_tests {
+    use super::*;
+    use surrealdb_types::{QueryError, prost::Message};
+
+    #[test]
+    fn unary_conflict_keeps_native_details_in_bounded_metadata() {
+        let native = TypesError::query("conflict".to_string(), QueryError::TransactionConflict);
+        let status = to_status(&native);
+        assert_eq!(status.code(), tonic::Code::Aborted);
+        let bytes = status.metadata().get_bin("surreal-error-bin").unwrap().to_bytes().unwrap();
+        assert!(bytes.len() <= 8 << 10);
+        let decoded = proto::SurrealError::decode(bytes).unwrap();
+        assert_eq!(decoded.detail_kind(), Some("TransactionConflict"));
+        assert!(decoded.is_retryable());
+    }
+
+    #[test]
+    fn long_unary_message_keeps_conflict_details_and_internal_stays_nonretryable() {
+        let native = TypesError::query("a".repeat(64 << 10), QueryError::TransactionConflict);
+        let status = to_status(&native);
+        assert!(status.message().len() <= STATUS_MESSAGE_BYTES);
+        let bytes = status.metadata().get_bin("surreal-error-bin").unwrap().to_bytes().unwrap();
+        assert!(bytes.len() <= 8 << 10);
+        assert!(proto::SurrealError::decode(bytes).unwrap().is_retryable());
+        let status = to_status(&TypesError::internal("native failure".to_string()));
+        let bytes = status.metadata().get_bin("surreal-error-bin").unwrap().to_bytes().unwrap();
+        assert!(!proto::SurrealError::decode(bytes).unwrap().is_retryable());
+    }
+}
