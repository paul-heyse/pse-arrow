 pub struct SlotPermit {
 	_slot: OwnedSemaphorePermit,
 	_top_level: Option<OwnedSemaphorePermit>,
+	/// Process-wide bound retained until the physical Store is dropped.
+	_global: OwnedSemaphorePermit,
+}
+
+/// A datastore may own several engine pools with different memory or timeout
+/// settings. Bound their physical Stores together, independent of pool identity.
+static GLOBAL_CONTROLLER_SLOTS: OnceLock<Result<Arc<Semaphore>, String>> = OnceLock::new();
+
+fn global_controller_limit(value: Option<&str>) -> Result<usize, String> {
+	// With no PSE-specific ceiling, match the upstream server default.
+	let value = value.unwrap_or("64");
+	value
+		.parse::<usize>()
+		.ok()
+		.filter(|value| *value > 0 && *value <= Semaphore::MAX_PERMITS)
+		.ok_or_else(|| {
+			"SURREAL_SURREALISM_MAX_TOTAL_CONTROLLERS must be a finite positive semaphore capacity"
+				.to_owned()
+		})
+}
+
+fn global_controller_slots() -> SurrealismResult<&'static Arc<Semaphore>> {
+	GLOBAL_CONTROLLER_SLOTS
+		.get_or_init(|| {
+			let configured = std::env::var("SURREAL_SURREALISM_MAX_TOTAL_CONTROLLERS")
+				.map(Some)
+				.or_else(|error| match error {
+					std::env::VarError::NotPresent => Ok(None),
+					std::env::VarError::NotUnicode(_) => {
+						Err("invalid Surrealism controller capacity encoding".to_owned())
+					}
+				})?;
+			Ok(Arc::new(Semaphore::new(global_controller_limit(
+				configured.as_deref(),
+			)?)))
+		})
+		.as_ref()
+		.map_err(|error| SurrealismError::Other(anyhow::anyhow!(error.clone())))
+}
+
+/// Validate the process-wide controller limit during server startup.
+pub fn validate_global_controller_configuration() -> SurrealismResult<()> {
+	global_controller_slots().map(|_| ())
+}
+
+fn acquire_global_controller_slot() -> SurrealismResult<OwnedSemaphorePermit> {
+	try_global_controller_slot(global_controller_slots()?)
+}
+
+fn try_global_controller_slot(
+	slots: &Arc<Semaphore>,
+) -> SurrealismResult<OwnedSemaphorePermit> {
+	Arc::clone(slots)
+		.try_acquire_owned()
+		.map_err(|_| SurrealismError::ControllerCapacityExceeded)
 }
 
