 use crate::net_allow::{ResolvedNetAllow, resolve_allow_net};
 use crate::package::{AttachedFs, SurrealismPackage};
 use crate::store::StoreData;
+
+// Unlike a runtime's in-use semaphore, these permits follow physical Stores
+// through idle pooling and runtime-cache eviction. No permit is ever awaited:
+// saturation refuses before Store allocation, without another queue/deadlock.
+static GLOBAL_CONTROLLER_SLOTS: OnceLock<Result<Arc<Semaphore>, String>> = OnceLock::new();
+
+fn global_controller_limit(value: Option<&str>) -> Result<usize, String> {
+	let value = value.unwrap_or("8");
+	value.parse::<usize>().ok().filter(|value| *value > 0 && *value <= Semaphore::MAX_PERMITS)
+		.ok_or_else(|| "SURREAL_SURREALISM_MAX_TOTAL_CONTROLLERS must be a finite positive semaphore capacity".to_owned())
+}
+
+fn acquire_global_controller_slot() -> SurrealismResult<tokio::sync::OwnedSemaphorePermit> {
+	let slots = GLOBAL_CONTROLLER_SLOTS.get_or_init(|| {
+		let configured = std::env::var("SURREAL_SURREALISM_MAX_TOTAL_CONTROLLERS")
+			.map(Some).or_else(|error| match error {
+				std::env::VarError::NotPresent => Ok(None),
+				_ => Err("Invalid Surrealism controller capacity encoding".to_owned()),
+			})?;
+		Ok(Arc::new(Semaphore::new(global_controller_limit(configured.as_deref())?)))
+	});
+	let slots = slots.as_ref().map_err(|error| SurrealismError::Other(anyhow::anyhow!(error.clone())))?;
+	try_global_controller_slot(slots)
+}
+
+fn try_global_controller_slot(slots: &Arc<Semaphore>) -> SurrealismResult<tokio::sync::OwnedSemaphorePermit> {
+	Arc::clone(slots).try_acquire_owned().map_err(|_| SurrealismError::ControllerCapacityExceeded)
+}
+
+#[cfg(test)]
+mod global_controller_tests {
+	use super::*;
+
+	#[test]
+	fn global_budget_is_fail_fast_and_follows_physical_ownership() {
+		let slots = Arc::new(Semaphore::new(1));
+		let physical = try_global_controller_slot(&slots).unwrap();
+		// An evicted runtime or idle pool is just another holder of this owned
+		// permit. Dropping a facade cannot restore capacity while it remains.
+		let retained = Some(physical);
+		assert!(matches!(try_global_controller_slot(&slots), Err(SurrealismError::ControllerCapacityExceeded)));
+		drop(retained);
+		assert!(try_global_controller_slot(&slots).is_ok());
+	}
+
+	#[test]
+	fn global_budget_refuses_invalid_or_unbounded_configuration() {
+		assert_eq!(global_controller_limit(None).unwrap(), 8);
+		assert_eq!(global_controller_limit(Some("16")).unwrap(), 16);
+		for value in ["0", "-1", "max", "18446744073709551615"] {
+			assert!(global_controller_limit(Some(value)).is_err());
+		}
+	}
+}
 
