+// One original monotonic deadline covers queueing, cold start and init. A
+// refreshed relative duration at each phase must never restart that budget.
+#[derive(Clone, Copy)]
+struct ControllerDeadline {
+	deadline: Option<Instant>,
+	context_timeout: Option<Duration>,
+	module_limit: Option<Duration>,
+}
+
+impl ControllerDeadline {
+	fn new(context_timeout: Option<Duration>, module_limit: Option<Duration>) -> SurrealismResult<Self> {
+		let effective = [context_timeout, module_limit].into_iter().flatten().min();
+		let deadline = effective.map(|timeout| Instant::now().checked_add(timeout)
+			.ok_or_else(|| SurrealismError::Other(anyhow::anyhow!("Surrealism controller deadline overflow"))))
+			.transpose()?;
+		Ok(Self { deadline, context_timeout, module_limit })
+	}
+
+	fn expired(self) -> SurrealismError {
+		SurrealismError::Timeout {
+			effective: [self.context_timeout, self.module_limit].into_iter().flatten().min(),
+			context_timeout: self.context_timeout,
+			module_limit: self.module_limit,
+		}
+	}
+
+	fn remaining(self) -> SurrealismResult<Option<Duration>> {
+		let remaining = self.deadline.map(|deadline| deadline.saturating_duration_since(Instant::now()));
+		if remaining.is_some_and(|remaining| remaining.is_zero()) {
+			return Err(self.expired());
+		}
+		Ok(remaining)
+	}
+}
+
+async fn acquire_controller_slot(slots: Arc<Semaphore>, deadline: ControllerDeadline) -> SurrealismResult<tokio::sync::OwnedSemaphorePermit> {
+	deadline.remaining()?;
+	let wait = slots.acquire_owned();
+	let permit = match deadline.deadline {
+		Some(at) => tokio::time::timeout_at(tokio::time::Instant::from_std(at), wait)
+			.await.map_err(|_| deadline.expired())?,
+		None => wait.await,
+	};
+	let permit = permit.map_err(|_| SurrealismError::Other(anyhow::anyhow!("Surrealism controller semaphore closed")))?;
+	deadline.remaining()?;
+	Ok(permit)
+}
+
+#[cfg(test)]
+mod controller_deadline_tests {
+	use super::*;
+
+	#[tokio::test(flavor = "current_thread")]
+	async fn occupied_pool_wait_obeys_original_deadline_without_leaking_slot() {
+		let slots = Arc::new(Semaphore::new(1));
+		let held = slots.clone().acquire_owned().await.unwrap();
+		let budget = ControllerDeadline::new(Some(Duration::from_millis(5)), Some(Duration::from_secs(1))).unwrap();
+		assert!(matches!(acquire_controller_slot(slots.clone(), budget).await, Err(SurrealismError::Timeout { .. })));
+		drop(held);
+		assert_eq!(slots.available_permits(), 1);
+		assert!(matches!(acquire_controller_slot(slots.clone(), budget).await, Err(SurrealismError::Timeout { .. })));
+		assert_eq!(slots.available_permits(), 1);
+	}
+
+	#[test]
+	fn zero_remaining_never_admits_cold_start_or_init() {
+		let budget = ControllerDeadline::new(Some(Duration::ZERO), Some(Duration::from_secs(1))).unwrap();
+		assert!(matches!(budget.remaining(), Err(SurrealismError::Timeout { .. })));
 	}
 }
 
