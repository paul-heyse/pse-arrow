index 0000000..b7c47fb
--- /dev/null
+++ b/surrealdb/server/src/ntw/owned_connection.rs
@@ -0,0 +1,110 @@
+//! Canonical sessions belong to an authentic accepted socket, including cleanup.
+
+use std::future::{Ready, ready};
+use std::io;
+use std::pin::Pin;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::task::{Context, Poll};
+
+use axum_server::accept::Accept;
+use tokio::io::{AsyncRead, AsyncWrite, ReadBuf};
+use tokio::net::TcpStream;
+use tokio::sync::{OwnedSemaphorePermit, Semaphore};
+use tower::Layer;
+use tower_http::add_extension::{AddExtension, AddExtensionLayer};
+use uuid::Uuid;
+
+use crate::cnf::GRPC_MAX_ATTACHED_SESSIONS;
+use crate::rpc::grpc::Grpc;
+
+/// Server-created identity; no request header can select or replace it.
+pub struct ConnectionOwner {
+	pub id: Uuid,
+	closed: AtomicBool,
+	rpc: Arc<Grpc>,
+	// Held through socket shutdown, request contexts, and native cleanup.
+	_permit: OwnedSemaphorePermit,
+}
+
+impl ConnectionOwner {
+	pub fn new(rpc: Arc<Grpc>, permit: OwnedSemaphorePermit) -> Arc<Self> {
+		Arc::new(Self {
+			id: Uuid::new_v4(), closed: AtomicBool::new(false), rpc, _permit: permit,
+		})
+	}
+
+	pub fn is_closed(&self) -> bool {
+		self.closed.load(Ordering::Acquire)
+	}
+
+	fn close(self: &Arc<Self>) {
+		if self.closed.swap(true, Ordering::AcqRel) { return; }
+		let owner = Arc::clone(self);
+		if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+			runtime.spawn(async move {
+				owner.rpc.cleanup_connection(owner.id).await;
+			});
+		}
+	}
+}
+
+#[derive(Clone)]
+pub struct OwnedAcceptor {
+	rpc: Arc<Grpc>,
+	slots: Arc<Semaphore>,
+}
+
+impl OwnedAcceptor {
+	pub fn new(rpc: Arc<Grpc>) -> Self {
+		Self { rpc, slots: Arc::new(Semaphore::new(*GRPC_MAX_ATTACHED_SESSIONS)) }
+	}
+}
+
+impl<S> Accept<TcpStream, S> for OwnedAcceptor {
+	type Stream = OwnedStream;
+	type Service = AddExtension<S, Arc<ConnectionOwner>>;
+	type Future = Ready<io::Result<(Self::Stream, Self::Service)>>;
+
+	fn accept(&self, stream: TcpStream, service: S) -> Self::Future {
+		let permit = match Arc::clone(&self.slots).try_acquire_owned() {
+			Ok(permit) => permit,
+			Err(_) => return ready(Err(io::Error::other("Owned connection/cleanup capacity reached"))),
+		};
+		if let Err(error) = stream.set_nodelay(true) { return ready(Err(error)); }
+		let owner = ConnectionOwner::new(Arc::clone(&self.rpc), permit);
+		let service = AddExtensionLayer::new(Arc::clone(&owner)).layer(service);
+		ready(Ok((OwnedStream { inner: stream, owner }, service)))
+	}
+}
+
+pub struct OwnedStream {
+	inner: TcpStream,
+	owner: Arc<ConnectionOwner>,
+}
+
+impl Drop for OwnedStream {
+	fn drop(&mut self) { self.owner.close(); }
+}
+
+impl AsyncRead for OwnedStream {
+	fn poll_read(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &mut ReadBuf<'_>) -> Poll<io::Result<()>> {
+		Pin::new(&mut self.inner).poll_read(cx, buf)
+	}
+}
+
+impl AsyncWrite for OwnedStream {
+	fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &[u8]) -> Poll<io::Result<usize>> {
+		Pin::new(&mut self.inner).poll_write(cx, buf)
+	}
+	fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+		Pin::new(&mut self.inner).poll_flush(cx)
+	}
+	fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+		Pin::new(&mut self.inner).poll_shutdown(cx)
+	}
+	fn is_write_vectored(&self) -> bool { self.inner.is_write_vectored() }
+	fn poll_write_vectored(mut self: Pin<&mut Self>, cx: &mut Context<'_>, bufs: &[io::IoSlice<'_>]) -> Poll<io::Result<usize>> {
+		Pin::new(&mut self.inner).poll_write_vectored(cx, bufs)
+	}
+}
