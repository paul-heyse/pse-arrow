diff --git a/surrealdb/core/src/kvs/tests/interrupted_write_test.rs b/surrealdb/core/src/kvs/tests/interrupted_write_test.rs
index d2cb843..3cfff86 100644
--- a/surrealdb/core/src/kvs/tests/interrupted_write_test.rs
+++ b/surrealdb/core/src/kvs/tests/interrupted_write_test.rs
@@ -123,3 +123,69 @@ async fn an_api_handler_cannot_commit_a_record_its_fan_out_left_half_indexed() {
 	let _ = ds.invoke_api_handler("test", "test", "fan", &ses, req).await;
 	assert_consistent(committed(&ds).await);
 }
+
+
+/// Complete writes before an ordinary handler/middleware error must roll back,
+/// not just writes interrupted within an index fan-out.
+#[tokio::test(flavor = "multi_thread")]
+async fn api_ordinary_errors_rollback_but_explicit_responses_commit() {
+    use crate::api::request::ApiRequest;
+    use crate::catalog::ApiMethod;
+    let (ds, ses) = fan_out_ds().await;
+    let definitions = r#"
+        DEFINE FUNCTION fn::after_failure($request: object, $next: any) {
+            LET $reply = $next($request);
+            THROW 'middleware failure after handler';
+        };
+        DEFINE FUNCTION fn::bad_conversion($request: object, $next: any) {
+            LET $reply = $next($request);
+            RETURN 42;
+        };
+        DEFINE API '/handler_failure' FOR get PERMISSIONS FULL THEN {
+            CREATE t:11 SET a = [11], b = [11]; THROW 'handler failure after write';
+        };
+        DEFINE API '/conversion_failure' FOR get PERMISSIONS FULL THEN {
+            CREATE t:12 SET a = [12], b = [12]; RETURN 42;
+        };
+        DEFINE API '/middleware_failure' FOR get PERMISSIONS FULL MIDDLEWARE fn::after_failure() THEN {
+            CREATE t:13 SET a = [13], b = [13]; RETURN {status:200};
+        };
+        DEFINE API '/middleware_conversion_failure' FOR get PERMISSIONS FULL MIDDLEWARE fn::bad_conversion() THEN {
+            CREATE t:14 SET a = [14], b = [14]; RETURN {status:200};
+        };
+        DEFINE API '/explicit_refusal' FOR get PERMISSIONS FULL THEN {
+            CREATE t:15 SET a = [15], b = [15]; RETURN {status:409,body:{refused:true}};
+        };
+        DEFINE API '/success' FOR get PERMISSIONS FULL THEN {
+            CREATE t:16 SET a = [16], b = [16]; RETURN {status:200};
+        };
+    "#;
+    for response in ds.execute(definitions,&ses,None).await.unwrap() {response.result.unwrap();}
+    for path in ["handler_failure","conversion_failure","middleware_failure","middleware_conversion_failure"] {
+        let request=ApiRequest {method:ApiMethod::Get,request_id:path.into(),..Default::default()};
+        let response=ds.invoke_api_handler("test","test",path,&ses,request).await.unwrap();
+        assert!(response.status.as_u16() >= 400,"{path} must preserve an error response");
+    }
+    for (path,status) in [("explicit_refusal",409),("success",200)] {
+        let request=ApiRequest {method:ApiMethod::Get,request_id:path.into(),..Default::default()};
+        let response=ds.invoke_api_handler("test","test",path,&ses,request).await.unwrap();
+        assert_eq!(response.status.as_u16(),status);
+    }
+    let mut responses=ds.execute("RETURN (SELECT VALUE id FROM t ORDER BY id) = [t:15, t:16];",&ses,None).await.unwrap();
+    let committed=responses.remove(0).result.unwrap();
+    assert_eq!(committed,surrealdb_types::Value::Bool(true));
+}
+
+/// Internal api::invoke can also convert an error to a value inside a caller's
+/// transaction. Neither an explicit COMMIT nor another successful statement can
+/// authorize those partial writes.
+#[tokio::test(flavor = "multi_thread")]
+async fn api_error_poison_refuses_explicit_caller_commit() {
+    use crate::kvs::QueryRequest;
+    let (ds,ses)=fan_out_ds().await;
+    for response in ds.execute("DEFINE API '/caller_failure' FOR get PERMISSIONS FULL THEN {CREATE t:17 SET a=[17],b=[17]; THROW 'cancel the whole API effect';};",&ses,None).await.unwrap() {response.result.unwrap();}
+    let tx=Arc::new(ds.transaction(TransactionType::Write).await.unwrap());
+    let _=ds.run(QueryRequest::new("RETURN api::invoke('/caller_failure',{method:'get'});",&ses).with_transaction(Arc::clone(&tx))).await;
+    assert!(tx.commit().await.is_err());
+    assert_eq!(committed(&ds).await,(0,0));
+}
