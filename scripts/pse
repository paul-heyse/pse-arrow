# Agent front door over the prepared native host; reads never construct or provision tooling.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
tool="$root/target/host-tools/current/pse"
if [ ! -x "$tool" ]; then
    echo "pse: native tools are not prepared; run scripts/bootstrap-host explicitly" >&2
    exit 125
fi
exec "$tool" "$@"
