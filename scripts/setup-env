# Explicit preparation only; the native host is independent of Python environments.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# Preparation selects its own checkout; inherited project choices cannot redirect it.
unset VIRTUAL_ENV UV_PYTHON UV_PROJECT UV_WORKING_DIR UV_NO_PROJECT UV_NO_SYNC UV_FROZEN
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
mode=${1:-core}
[[ $# -le 1 ]] || exit 2
case "$mode" in
    core) scripts/bootstrap-host ;;
    tools)
        scripts/bootstrap-host
        uv sync --locked --only-group quality --no-install-project
        ;;
    reference)
        UV_PROJECT_ENVIRONMENT="$PWD/.venv-parity" uv sync --locked --only-group parity --no-install-project --python 3.13
        ;;
    docs)
        scripts/bootstrap-host
        scripts/pse-env -- cargo run --locked -p xtask --bin xtask --no-default-features -- docs install
        ;;
    *) echo 'usage: bash scripts/setup-env [core|tools|reference|docs]' >&2; exit 2 ;;
esac
