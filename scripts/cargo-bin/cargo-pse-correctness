# Cargo's external-subcommand argv convention is consumed by the native binary.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
tool="$root/target/host-tools/current/cargo-pse-correctness"
if [ ! -x "$tool" ]; then
    echo "pse-correctness: native tools are not prepared; run scripts/bootstrap-host explicitly" >&2
    exit 125
fi
exec "$tool" "$@"
