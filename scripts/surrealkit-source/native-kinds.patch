+        assert_eq!(unsigned.kind, Kind::U64);
+        assert!(unsigned.optional && unsigned.problems.is_empty());
+        let named = parse_top("array<pse_state>");
+        assert_eq!(named.kind, Kind::Array {
+            item: Box::new(Kind::Named { name: "pse_state".into() }), length: None,
+        });
+        assert!(named.problems.is_empty());
+        assert!(!parse_top("array<frob>").problems.is_empty());
+        assert!(!parse_top("pse_state<int>").problems.is_empty());
