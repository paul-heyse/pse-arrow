+// Admit only the application's generated naming domain.
+fn native_kind(source: &str) -> Option<Kind> {
+    if source == "u64" { return Some(Kind::U64); }
+    if source.starts_with("pse_") && source.len() > 4
+        && source.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'_') {
+        return Some(Kind::Named { name: source.to_owned() });
+    }
+    None
 }
 
