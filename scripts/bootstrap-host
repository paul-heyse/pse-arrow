#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright (c) 2026 Paul Heyse
# Construction only: no environment, allocation or scientific policy lives here.
set -eu
umask 077
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd -P)
usage() {
    printf 'Usage: scripts/bootstrap-host [--from CHECKOUT]\nPrepare native tools, or copy a matching prepared source generation.\n'
}
# Only the native public adapter requests a route token on stdout. Construction
# diagnostics stay on stderr and cannot become part of that bounded receipt.
emit_route=no
if [ "${1-}" = --report-route ]; then
    emit_route=yes
    shift
fi
run_bootstrap() {
    if [ "$emit_route" = yes ]; then "$@" >&2; else "$@"; fi
}
report_preparation() {
    if [ "$emit_route" = yes ]; then printf '%s\n' "$1"; fi
}
for bootstrap_arg in "$@"; do
    case "$bootstrap_arg" in --help|-h) usage; exit 0 ;; esac
done
source_checkout=
case "$#" in
    0) ;;
    1)
        case "$1" in
            --from=?*) source_checkout=${1#--from=} ;;
            *) usage >&2; exit 2 ;;
        esac ;;
    2)
        [ "$1" = --from ] || { usage >&2; exit 2; }
        case "$2" in
            -*|'') usage >&2; exit 2 ;;
            *) source_checkout=$2 ;;
        esac ;;
    *) usage >&2; exit 2 ;;
esac
if [ -n "${CARGO_TARGET_DIR-}" ] || [ -n "${CARGO_BUILD_TARGET_DIR-}" ] ||
   [ -n "${CARGO_BUILD_BUILD_DIR-}" ] || [ -n "${CARGO_BUILD_TARGET-}" ] ||
   [ -n "${RUSTUP_TOOLCHAIN-}" ]; then
    echo "bootstrap-host: remove Cargo directory, target or toolchain overrides; this seed uses the pinned checkout-local build" >&2
    exit 125
fi
if [ -n "$source_checkout" ]; then
    case "$source_checkout" in /*) ;; *) source_checkout="$(pwd)/$source_checkout" ;; esac
    set -- --from "$source_checkout"
fi
cd "$root"
reject() {
    printf 'bootstrap-host: %s\n' "$1" >&2
    exit 125
}
owned_directory() {
    [ ! -L "$1" ] && [ -d "$1" ] && [ -O "$1" ]
}
if [ -e target ] || [ -L target ]; then
    owned_directory target || reject 'target must be an owned direct directory'
fi
mkdir -- build 2>/dev/null || :
owned_directory build || reject 'build must be an owned direct directory'
coordination=build/.pse-cargo
mkdir -- "$coordination" 2>/dev/null || :
owned_directory "$coordination" || reject 'Cargo coordination requires an owned direct directory'
mode=$(stat -c %a -- "$coordination")
[ "$((0$mode & 077))" -eq 0 ] || reject 'Cargo coordination directory must be private'
check_lock_file() {
    [ ! -L "$1" ] && { [ ! -e "$1" ] || { [ -f "$1" ] && [ -O "$1" ]; }; } ||
        reject 'Cargo coordination lock must be an owned direct file'
}
preparation_lock="$coordination/preparation.lock"
check_lock_file "$preparation_lock"
exec 9>>"$preparation_lock"
if flock -n -E 75 9; then
    :
else
    [ "$?" -eq 75 ] || reject 'could not acquire the host preparation lock'
    printf '%s\n' 'bootstrap-host: waiting for checkout host preparation' >&2
    flock 9 || reject 'could not acquire the host preparation lock'
fi

# Recheck under the preparation guard. A previous caller may have published while
# this caller waited, including when both requested a copy from another checkout.
current="$root/target/host-tools/current/pse-host"
if [ -x "$current" ]; then
    set +e
    run_bootstrap "$current" __host-generation-bootstrap 9>&-
    reuse_status=$?
    set -e
    case "$reuse_status" in
        0)
            printf '%s\n' 'bootstrap-host: reused the verified current generation' >&2
            report_preparation verified-current
            exit 0 ;;
        2|79|125|126|127) ;;
        *) exit "$reuse_status" ;;
    esac
fi
# A cold destination can use the explicitly selected source's fixed published
# native entry. That helper authenticates its own generation and destination
# inputs; this seed never reads a ledger executable path or sources config.
if [ -n "$source_checkout" ]; then
    source_helper="$source_checkout/target/host-tools/current/pse-host"
    if [ -x "$source_helper" ]; then
        set +e
        PSE_BOOTSTRAP_SOURCE_HELPER="$source_checkout" run_bootstrap "$source_helper" -C "$root" __host-generation-bootstrap --from "$source_checkout" 9>&-
        source_status=$?
        set -e
        case "$source_status" in
            0)
                printf '%s\n' 'bootstrap-host: prepared a matching source generation' >&2
                report_preparation matching-source
                exit 0 ;;
            79) printf 'bootstrap-host: source inputs do not match; building a fresh local seed\n' >&2 ;;
            2|126|127) printf 'bootstrap-host: source helper unavailable or incompatible (status %s); building a local seed\n' "$source_status" >&2 ;;
            *) exit "$source_status" ;;
        esac
    else
        printf 'bootstrap-host: source helper unavailable; building a local seed\n' >&2
    fi
fi
# The independent seed compiles directly, including when Cargo home config names a wrapper.
unset CARGO_BUILD_RUSTC_WRAPPER CARGO_BUILD_RUSTC_WORKSPACE_WRAPPER
export RUSTC_WRAPPER= RUSTC_WORKSPACE_WRAPPER=
printf '%s\n' 'bootstrap-host: preparing a local seed' >&2
seed_status=2
if [ -x "$current" ]; then
    set +e
    run_bootstrap "$current" __host-generation-bootstrap --seed-only 9>&-
    seed_status=$?
    set -e
fi
case "$seed_status" in
    0) ;;
    2|126|127)
        writer_lock="$coordination/default-writer.lock"
        check_lock_file "$writer_lock"
        run_bootstrap flock --exclusive --close "$writer_lock" cargo build --locked --package pse-host --bins \
            --config 'build.target-dir="target"' --config 'build.build-dir="target"' 9>&- ;;
    *) exit "$seed_status" ;;
esac
# The freshly built seed establishes source coherence around the authoritative
# construction and publishes its manifest. It takes its own build permit while
# this shell retains preparation ownership. Neither lock is inherited by Cargo.
run_bootstrap "$root/target/debug/pse-host" __host-generation-bootstrap "$@" 9>&-
report_preparation local-seed
