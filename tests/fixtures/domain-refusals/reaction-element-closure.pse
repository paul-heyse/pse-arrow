// A reaction's stoichiometry conserves every element.
// refusal: combustion of kind reaction violates the requirement
// refusal: a reaction conserves every element
// control: [combustion, corpus.water] = [1]; => [combustion, corpus.water] = [2];
package refusal {
 use chemistry @"1.0.0";
 use corpus @"1.0.0";
 use provenance @"1.0.0";
 entity chemistry.extent_convention combustion_extent {normalization=chemistry.ExtentNormalization.AsAuthored}
 entity chemistry.reaction combustion {extent=combustion_extent}
 dataset equation: chemistry.stoichiometry provenance(corpus.bank, provenance.Role.published) {
  [combustion, corpus.methane] = [-1]; [combustion, corpus.oxygen] = [-2];
  [combustion, corpus.carbon_dioxide] = [1]; [combustion, corpus.water] = [1];
 }
}
