// A production root reads no oracle data, even through a package's selection.
// root: refusal.Root
// refusal: test-only data is read outside a test fixture
// refusal: row selection[pkg, ethane, heat_capacity, liquidPhase] supplied by choice with role published, referencing test-only data, read by root Root
// control: provenance.Role.oracle_input => provenance.Role.published
package refusal {
 use chemistry @"1.0.0";
 use corpus @"1.0.0";
 use properties @"1.0.0";
 use provenance @"1.0.0";
 dataset oracle_sets: corpus.constant_cp bind(source = corpus.oracle_release, property = properties.heat_capacity) provenance(corpus.oracle_release, provenance.Role.oracle_input) {
  [corpus.ethane, liquidPhase] = [250{K}, 400{K}, 70{J/(mol*K)}];
 }
 set components: Set<chemistry.species> = {corpus.ethane};
 dataset choice: properties.selection complete_over(k in corpus.packages, j in components, p in corpus.heat, t in corpus.liquid) provenance(corpus.bank, provenance.Role.published) {
  [corpus.pkg, corpus.ethane, properties.heat_capacity, liquidPhase] = [properties.parameter_set[corpus.ethane, properties.heat_capacity, liquidPhase, corpus.oracle_release]];
 }
 def Root { var c: MolarCp; eq e: c == properties.cp(corpus.pkg, chemistry.liquid, corpus.ethane, 300{K}); }
}
