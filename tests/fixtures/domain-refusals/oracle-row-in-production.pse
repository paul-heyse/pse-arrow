// A production root reads no oracle data, even through a package's selection.
// root: refusal.Root
// refusal: test-only data is read outside a test fixture
// refusal: entity pkg referencing test-only data, read by root Root
// control: provenance.Role.oracle_input => provenance.Role.published
package refusal {
 use chemistry @"1.0.0";
 use corpus @"1.0.0";
 use properties @"1.0.0";
 use provenance @"1.0.0";
 dataset oracle_sets: corpus.constant_cp bind(parameterization=oracle_fit,source=corpus.oracle_release,dependencies={},conventions={},property = properties.heat_capacity) provenance(corpus.oracle_release, provenance.Role.oracle_input) {
  [corpus.ethane, liquidPhase] = [250{K}, 400{K}, 70{J/(mol*K)}];
 }
 entity properties.parameterization oracle_fit {title="Synthetic independent oracle fit",source=corpus.oracle_release}
 entity properties.selection_context admitted {roots={properties.phased_parameter[corpus.ethane,properties.heat_capacity,liquidPhase,oracle_fit]},subjects={corpus.ethane},models={properties.heat_capacity},rules={}}
 entity properties.property_package pkg {admitted=admitted}
 set packages:Set<properties.property_package>={pkg};
 set components: Set<chemistry.species> = {corpus.ethane};
 dataset choice: properties.selection complete_over(k in packages, j in components, p in corpus.heat, t in corpus.liquid) provenance(corpus.bank, provenance.Role.published) {
  [pkg, corpus.ethane, properties.heat_capacity, liquidPhase] = [properties.phased_parameter[corpus.ethane, properties.heat_capacity, liquidPhase, oracle_fit]];
 }
 def Root { var c: MolarCp; eq e: c == properties.cp(pkg, chemistry.liquid, corpus.ethane, 300{K}); }
}
