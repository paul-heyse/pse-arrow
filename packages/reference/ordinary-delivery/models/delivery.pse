package ordinary_delivery {
use ordinary_bt @"1.0.0";
use recycle_flash @"1.0.0";
use exchanger_costing @"1.0.0";
use chemistry @"1.0.0";
use chem @"1.0.0";
use kinds @"1.0.0";
use equilibrium @"1.0.0";
use mixing @"1.0.0";
use units @"1.0.0";
use compatibility @"1.0.0";
use ideal_caloric_state @"1.0.0";
use heat_exchange @"1.0.0";
use cubic @"1.0.0";
use properties @"1.0.0";
use costing @"1.0.0";
use numerical_policy @"1.0.0";
use temperature_driving_force @"1.0.0";
use correlations @"1.0.0";
use references @"1.0.0";

// Reuse the process definitions and original topology; change scientific selections.
fn component_h(T:Temperature,p:chemistry.phase,j:chemistry.species)->MolarEnthalpy=if p==chemistry.liquid then ordinary_bt.liquid_h(T,j) else ordinary_bt.vapor_h(T,j);
interface RecycleModel extends recycle_flash.RecycleLoop {
override param liquid_caloric_span:Fn()->Delta<MolarEnthalpy>=ordinary_bt.liquid_enthalpy_span;
override param vapor_caloric_span:Fn()->Delta<MolarEnthalpy>=ordinary_bt.vapor_enthalpy_span;
override param phase_caloric_span:Fn()->Delta<MolarEnthalpy>=ordinary_bt.phase_enthalpy_span;
override param liquid_caloric_response:Fn()->MolarCp=ordinary_bt.liquid_precision_response;
override param components:Set<chemistry.species>=ordinary_bt.aromatics;
override child feed:units.Feed=units.Feed(pkg=ordinary_bt.Ideal(defined_state=true));
override child mixer:recycle_flash.RecycleMixer=recycle_flash.RecycleMixer(inlet_pkg=ordinary_bt.Ideal(defined_state=true),outlet_pkg=ordinary_bt.Ideal(defined_state=false),inlets=recycle_flash.mixer_inlets,momentum_mixing=compatibility.MomentumMixingType.none,recycle_package=ordinary_bt.Liquid(defined_state=true));
override child heater:recycle_flash.RecycleHeater=recycle_flash.RecycleHeater(inlet_pkg=ordinary_bt.Ideal(defined_state=true),outlet_pkg=ordinary_bt.Ideal(defined_state=false),target_value=368{K});
override child flash:recycle_flash.RecycleEquilibriumFlash=recycle_flash.RecycleEquilibriumFlash(inlet_pkg=ordinary_bt.Ideal(defined_state=true),outlet_pkg=ordinary_bt.Ideal(defined_state=false));
override child splitter:recycle_flash.RecycleSplitter=recycle_flash.RecycleSplitter(pkg=ordinary_bt.Liquid(defined_state=true),outlets=recycle_flash.liquid_outlets,component_enthalpy=component_h,purge_value=0.25);
override let tear_energy:Power=feed.state.flow*tear_fraction*ideal_caloric_state.mixture_enthalpy(tear_temperature,feed.state.z,components,ordinary_bt.liquid_h);
// Frozen conservative exposure is the feed/purge circulation bound, not the
// solved liquid flow. This local interval-average response is not an output
// error certificate. The existing Perry record extrapolation permission applies.
annotation caloric_context splitter.unit.inlet.h(ordinary_bt.liquid_precision_response(),numerical_policy.temperature,numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),splitter.unit.inlet.energy_flow,splitter.unit.inlet.flow);
annotation caloric_context mixer.unit.inlet[recycle_flash.recycled].h(ordinary_bt.liquid_precision_response(),numerical_policy.temperature,numerical_policy.power,recycle_flash.exposure_bound((1-purge)*recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),mixer.unit.inlet[recycle_flash.recycled].energy_flow,mixer.unit.inlet[recycle_flash.recycled].flow);
annotation caloric_context splitter.unit.inlet.enthalpy(ordinary_bt.liquid_precision_response(),numerical_policy.temperature,numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),splitter.unit.inlet.energy_flow,splitter.unit.inlet.flow);
annotation caloric_context mixer.unit.inlet[recycle_flash.recycled].enthalpy(ordinary_bt.liquid_precision_response(),numerical_policy.temperature,numerical_policy.power,recycle_flash.exposure_bound((1-purge)*recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),mixer.unit.inlet[recycle_flash.recycled].energy_flow,mixer.unit.inlet[recycle_flash.recycled].flow);
// Energy-only contexts constrain each remaining enthalpy without claiming a
// frozen two-phase heat capacity or a coupled flash-output error bound.
annotation energy_context feed.state.h(numerical_policy.power,recycle_flash.exposure_bound(feed.state.flow,numerical_policy.molar_flow),feed.state.energy_flow,feed.state.flow);
annotation energy_context feed.state.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(feed.state.flow,numerical_policy.molar_flow),feed.state.energy_flow,feed.state.flow);
annotation energy_context mixer.unit.inlet[recycle_flash.fresh].h(numerical_policy.power,recycle_flash.exposure_bound(feed.state.flow,numerical_policy.molar_flow),mixer.unit.inlet[recycle_flash.fresh].energy_flow,mixer.unit.inlet[recycle_flash.fresh].flow);
annotation energy_context mixer.unit.inlet[recycle_flash.fresh].enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(feed.state.flow,numerical_policy.molar_flow),mixer.unit.inlet[recycle_flash.fresh].energy_flow,mixer.unit.inlet[recycle_flash.fresh].flow);
annotation energy_context mixer.unit.outlet.h(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),mixer.unit.outlet.energy_flow,mixer.unit.outlet.flow);
annotation energy_context mixer.unit.outlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),mixer.unit.outlet.energy_flow,mixer.unit.outlet.flow);
annotation energy_context heater.unit.inlet.h(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),heater.unit.inlet.energy_flow,heater.unit.inlet.flow);
annotation energy_context heater.unit.inlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),heater.unit.inlet.energy_flow,heater.unit.inlet.flow);
annotation energy_context heater.unit.outlet.h(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),heater.unit.outlet.energy_flow,heater.unit.outlet.flow);
annotation energy_context heater.unit.outlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),heater.unit.outlet.energy_flow,heater.unit.outlet.flow);
annotation energy_context flash.unit.inlet.h(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),flash.unit.inlet.energy_flow,flash.unit.inlet.flow);
annotation energy_context flash.unit.inlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),flash.unit.inlet.energy_flow,flash.unit.inlet.flow);
annotation energy_context flash.unit.outlet.h(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),flash.unit.outlet.energy_flow,flash.unit.outlet.flow);
annotation energy_context flash.unit.outlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(recycle_flash.maximum_circulating_flow(feed.state.flow,purge),numerical_policy.molar_flow),flash.unit.outlet.energy_flow,flash.unit.outlet.flow);
stage "tear" {override connect recycle:tear_port -> mixer.inlet_ports[recycle_flash.recycled];}
// Retain the boundary values needed to check conservation independently of the
// internal balance rows. These reports do not add equations or change the physics.
annotation report feed.state.flow("ordinary feed flow");
annotation report feed.state.energy_flow("ordinary feed energy");
annotation report flash.unit.outlet.phase_energy_flow[chemistry.vapor]("ordinary vapor energy");
annotation report splitter.unit.outlet_flow[recycle_flash.purged]("ordinary purge flow");
annotation report splitter.unit.outlet_energy_flow[recycle_flash.purged]("ordinary purge energy");
annotation report heater.unit.heat("ordinary heater duty");
annotation report feed.state.component_flow[chem.benzene]("ordinary feed benzene");
annotation report feed.state.component_flow[chem.toluene]("ordinary feed toluene");
annotation report flash.unit.vapor_component_flow[chem.benzene]("ordinary vapor benzene");
annotation report flash.unit.vapor_component_flow[chem.toluene]("ordinary vapor toluene");
annotation report splitter.unit.component_flow[recycle_flash.purged,chem.benzene]("ordinary purge benzene");
annotation report splitter.unit.component_flow[recycle_flash.purged,chem.toluene]("ordinary purge toluene");
}
def Recycle:RecycleModel {}
def Overheated:RecycleModel {
let overheated_temperature:Temperature=500{K};
state overheated supplied(true) {
coordinate component[j in components]=tear_component[j];
coordinate temperature=overheated_temperature; coordinate pressure=tear_pressure;
transport component[j in components]=tear_component[j] tolerance numerical_policy.component_flow;
transport energy=tear_energy tolerance numerical_policy.power;
}
material port overheated_port=overheated;
annotation connectivity overheated_port(0,1);
stage "overheated_tear" {override connect recycle:overheated_port -> mixer.inlet_ports[recycle_flash.recycled];}
}
def Exchanger(force:temperature_driving_force.DeltaT=temperature_driving_force.LMTD,cost_design:costing.hx_design=costing.utube,cost_material:costing.hx_material=costing.stainless_stainless,cost_tubes:costing.tube_length=costing.twelve):exchanger_costing.CostedExchangerModel {
override child exchanger:heat_exchange.HeatExchanger=heat_exchange.HeatExchanger(hot_inlet_pkg=ordinary_bt.PR(defined_state=true),hot_outlet_pkg=ordinary_bt.PR(defined_state=false),cold_inlet_pkg=ordinary_bt.PR(defined_state=true),cold_outlet_pkg=ordinary_bt.PR(defined_state=false),driving_force=force,cocurrent=true);
// The same constructor selections govern actual cost and its authored reference scale.
override child cost:costing.HeatExchangerCost=costing.HeatExchangerCost(design=cost_design,material=cost_material,tubes=cost_tubes);
// These reference magnitudes are the selected rating area and fixed coefficient;
// they supply local numerical context, not a coupled output-error certificate.
annotation engineering_scale exchanger.area(kind=reference_difference,value=1{m^2});
annotation engineering_scale cost.area(kind=reference_difference,value=1{m^2});
annotation engineering_scale costed_area(kind=reference_difference,value=1{m^2});
annotation engineering_scale exchanger.coefficient(kind=reference_difference,value=100{W/(m^2*K)});
// Monetary resolution uses the existing shared engineering fraction and actual
// SSLW arithmetic at this authored reference geometry and pressure. These fixed
// premises do not depend on the solved area or assert a purchase-price error bound.
param cost_reference_area:Area=1{m^2};
param cost_reference_pressure:Pressure=101325{Pa};
let cost_reference_area_count:Scalar=cost_reference_area/costing.square_foot();
let cost_reference_base:CapitalCost=costing.currency_unit()*costing.base_amount(cost_reference_area_count*costing.oversize_factor(cost.oversize),costing.design_coefficients[cost_design].constant,costing.design_coefficients[cost_design].linear,costing.design_coefficients[cost_design].quadratic);
let cost_reference_capital:CapitalCost=cost_reference_base*costing.material_amount(cost_reference_area_count,cost_material)*costing.pressure_factor((cost_reference_pressure-costing.atmospheric_pressure())/costing.hundred_psi())*costing.length_factor[cost_tubes];
annotation engineering_scale cost.base_cost_per_unit(kind=magnitude,value=cost_reference_base);
annotation engineering_scale cost.capital_cost(kind=magnitude,value=cost_reference_capital);
// These requirements protect actual energy consumers. They do not assert an
// ideal or EOS heat-capacity response for the relational-density PR state.
annotation energy_context exchanger.hot.inlet.h(numerical_policy.power,recycle_flash.exposure_bound(exchanger.hot.inlet.flow,numerical_policy.molar_flow),exchanger.hot.inlet.energy_flow,exchanger.hot.inlet.flow);
annotation energy_context exchanger.hot.inlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(exchanger.hot.inlet.flow,numerical_policy.molar_flow),exchanger.hot.inlet.energy_flow,exchanger.hot.inlet.flow);
annotation energy_context exchanger.hot.outlet.h(numerical_policy.power,recycle_flash.exposure_bound(exchanger.hot.inlet.flow,numerical_policy.molar_flow),exchanger.hot.outlet.energy_flow,exchanger.hot.outlet.flow);
annotation energy_context exchanger.hot.outlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(exchanger.hot.inlet.flow,numerical_policy.molar_flow),exchanger.hot.outlet.energy_flow,exchanger.hot.outlet.flow);
annotation energy_context exchanger.cold.inlet.h(numerical_policy.power,recycle_flash.exposure_bound(exchanger.cold.inlet.flow,numerical_policy.molar_flow),exchanger.cold.inlet.energy_flow,exchanger.cold.inlet.flow);
annotation energy_context exchanger.cold.inlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(exchanger.cold.inlet.flow,numerical_policy.molar_flow),exchanger.cold.inlet.energy_flow,exchanger.cold.inlet.flow);
annotation energy_context exchanger.cold.outlet.h(numerical_policy.power,recycle_flash.exposure_bound(exchanger.cold.inlet.flow,numerical_policy.molar_flow),exchanger.cold.outlet.energy_flow,exchanger.cold.outlet.flow);
annotation energy_context exchanger.cold.outlet.enthalpy_binding(numerical_policy.power,recycle_flash.exposure_bound(exchanger.cold.inlet.flow,numerical_policy.molar_flow),exchanger.cold.outlet.energy_flow,exchanger.cold.outlet.flow);
// Request the original caloric output resolution before execution. The source
// power/flow allocation matches the existing consuming enthalpy context; it does
// not replace the unchanged physical residual or independent comparison budgets.
annotation accuracy_goal exchanger.hot.inlet.h(selected_output,steady,resolution=numerical_policy.power/(2*recycle_flash.exposure_bound(exchanger.hot.inlet.flow,numerical_policy.molar_flow)),required_class=estimated,use_policy=assess,refine=true);
annotation accuracy_goal exchanger.hot.outlet.h(selected_output,steady,resolution=numerical_policy.power/(2*recycle_flash.exposure_bound(exchanger.hot.inlet.flow,numerical_policy.molar_flow)),required_class=estimated,use_policy=assess,refine=true);
annotation accuracy_goal exchanger.cold.inlet.h(selected_output,steady,resolution=numerical_policy.power/(2*recycle_flash.exposure_bound(exchanger.cold.inlet.flow,numerical_policy.molar_flow)),required_class=estimated,use_policy=assess,refine=true);
annotation accuracy_goal exchanger.cold.outlet.h(selected_output,steady,resolution=numerical_policy.power/(2*recycle_flash.exposure_bound(exchanger.cold.inlet.flow,numerical_policy.molar_flow)),required_class=estimated,use_policy=assess,refine=true);
annotation report exchanger.hot.heat("ordinary hot duty");
annotation report exchanger.cold.heat("ordinary cold duty");
annotation report exchanger.coefficient("ordinary heat transfer coefficient");
annotation report cost.material_factor("ordinary material factor");
annotation report cost.pressure_factor("ordinary pressure factor");
}
case ordinary_recycle fixture {dof 0;route steady;procedure initialize;stages("tear");initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(600);fix root.feed.state.flow=1{mol/s};fix root.feed.state.T=368{K};fix root.feed.state.pressure=101325{Pa};fix root.feed.state.z[chem.benzene]=0.5{1};fix root.feed.state.z[chem.toluene]=0.5{1};policy {backend ipopt;} } {
permission unknown_cp families(ordinary_bt.feos_poling_cp) allow_unknown true allow_extrapolation false;
// The selected benzene liquid Cp publication ends at353.24K:368K is explicit
// extrapolation,14.76K beyond that range. This exact record allowance neither
// changes the source envelope nor permits unknown evidence or a hard-domain breach.
permission benzene_liquid_cp_extrapolation records(correlations.dippr100[chem.benzene,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.perry7_caloric_fit]) allow_unknown false allow_extrapolation true;
child root:Recycle=Recycle;
expect root.overall[chem.benzene]==0{mol/s} tolerance numerical_policy.component_flow;
expect root.overall[chem.toluene]==0{mol/s} tolerance numerical_policy.component_flow;
}
case ordinary_overheated fixture {dof 0;route steady;procedure initialize;stages("overheated_tear");initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(600);failure trial_rejected members(root.recycle);fix root.feed.state.flow=1{mol/s};fix root.feed.state.T=368{K};fix root.feed.state.pressure=101325{Pa};fix root.feed.state.z[chem.benzene]=0.5{1};fix root.feed.state.z[chem.toluene]=0.5{1};policy {backend ipopt;} } {
permission unknown_cp families(ordinary_bt.feos_poling_cp) allow_unknown true allow_extrapolation false;
permission benzene_liquid_cp_extrapolation records(correlations.dippr100[chem.benzene,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.perry7_caloric_fit]) allow_unknown false allow_extrapolation true;
child root:Overheated=Overheated;
}
case ordinary_exchanger fixture {dof 0;route steady;procedure solve;
fix root.exchanger.hot.inlet.flow=5{mol/s};fix root.exchanger.hot.inlet.T=365{K};fix root.exchanger.hot.inlet.pressure=101325{Pa};fix root.exchanger.hot.inlet.z[chem.benzene]=0.5{1};fix root.exchanger.hot.inlet.z[chem.toluene]=0.5{1};fix root.exchanger.hot.delta_pressure=0{Pa};
fix root.exchanger.cold.inlet.flow=1{mol/s};fix root.exchanger.cold.inlet.T=300{K};fix root.exchanger.cold.inlet.pressure=101325{Pa};fix root.exchanger.cold.inlet.z[chem.benzene]=0.5{1};fix root.exchanger.cold.inlet.z[chem.toluene]=0.5{1};fix root.exchanger.cold.delta_pressure=0{Pa};fix root.exchanger.cold.outlet.T=331.6111111111111{K};fix root.exchanger.coefficient=100{W/(m^2*K)};
policy {backend ipopt;limits body_occurrences(1000000);} } {
permission unknown_cp families(ordinary_bt.feos_poling_cp) allow_unknown true allow_extrapolation false;
permission selected_unknown_fit families(cubic.critical_point,properties.predictive_rule) allow_unknown true allow_extrapolation false;
permission area_use families(costing.base_amount,costing.material_amount) allow_unknown true allow_extrapolation false;
permission pressure_use families(costing.pressure_factor) allow_unknown false allow_extrapolation true;
child root:Exchanger=Exchanger;
expect root.capital==root.cost.capital_cost tolerance 1e-8{USD_CE500};
}
case ordinary_rating fixture {dof 0;route steady;procedure solve;
fix root.exchanger.hot.inlet.flow=5{mol/s};fix root.exchanger.hot.inlet.T=365{K};fix root.exchanger.hot.inlet.pressure=101325{Pa};fix root.exchanger.hot.inlet.z[chem.benzene]=0.5{1};fix root.exchanger.hot.inlet.z[chem.toluene]=0.5{1};fix root.exchanger.hot.delta_pressure=0{Pa};
fix root.exchanger.cold.inlet.flow=1{mol/s};fix root.exchanger.cold.inlet.T=300{K};fix root.exchanger.cold.inlet.pressure=101325{Pa};fix root.exchanger.cold.inlet.z[chem.benzene]=0.5{1};fix root.exchanger.cold.inlet.z[chem.toluene]=0.5{1};fix root.exchanger.cold.delta_pressure=0{Pa};fix root.exchanger.area=1{m^2};fix root.exchanger.coefficient=100{W/(m^2*K)};
// Ordered physical starts replace the inherited367.5K guess on both free
// outlets. They are numerical inputs, not fixed specifications or new equations.
value root.exchanger.hot.outlet.T=360{K};value root.exchanger.cold.outlet.T=330{K};
value root.exchanger.delta.first=65{K};value root.exchanger.delta.second=30{K};
policy {backend ipopt;limits body_occurrences(1000000);} } {
permission unknown_cp families(ordinary_bt.feos_poling_cp) allow_unknown true allow_extrapolation false;
permission selected_unknown_fit families(cubic.critical_point,properties.predictive_rule) allow_unknown true allow_extrapolation false;
permission area_use families(costing.base_amount,costing.material_amount) allow_unknown true allow_extrapolation false;
permission pressure_use families(costing.pressure_factor) allow_unknown false allow_extrapolation true;
child root:Exchanger=Exchanger;
expect root.capital==root.cost.capital_cost tolerance 1e-8{USD_CE500};
}
case ordinary_arithmetic_closure fixture {dof 0;route steady;procedure solve;
fix root.exchanger.hot.inlet.flow=5{mol/s};fix root.exchanger.hot.inlet.T=365{K};fix root.exchanger.hot.inlet.pressure=101325{Pa};fix root.exchanger.hot.inlet.z[chem.benzene]=0.5{1};fix root.exchanger.hot.inlet.z[chem.toluene]=0.5{1};fix root.exchanger.hot.delta_pressure=0{Pa};
fix root.exchanger.cold.inlet.flow=1{mol/s};fix root.exchanger.cold.inlet.T=300{K};fix root.exchanger.cold.inlet.pressure=101325{Pa};fix root.exchanger.cold.inlet.z[chem.benzene]=0.5{1};fix root.exchanger.cold.inlet.z[chem.toluene]=0.5{1};fix root.exchanger.cold.delta_pressure=0{Pa};fix root.exchanger.cold.outlet.T=331.6111111111111{K};fix root.exchanger.coefficient=100{W/(m^2*K)};
policy {backend ipopt;limits body_occurrences(1000000);} } {
permission unknown_cp families(ordinary_bt.feos_poling_cp) allow_unknown true allow_extrapolation false;
permission selected_unknown_fit families(cubic.critical_point,properties.predictive_rule) allow_unknown true allow_extrapolation false;
permission area_use families(costing.base_amount,costing.material_amount) allow_unknown true allow_extrapolation false;
permission pressure_use families(costing.pressure_factor) allow_unknown false allow_extrapolation true;
child root:Exchanger=Exchanger(force=temperature_driving_force.AMTD);
expect root.capital==root.cost.capital_cost tolerance 1e-8{USD_CE500};
}
}
