@id("e48722578f684dfca8b3af1cd512c61b") package teqp_oracle {
@id("0c4e469fc6204f6baceb9a276cb17a90") use chemistry @"1.0.0";
@id("2fa4404963654989b866505049ad2844") use references @"1.0.0";
@id("c888a8e5df684cb78153f3a6da46e77b") use provenance @"1.0.0";
@id("93e6d9649f2e4766ab3c80db7f32807a") table states[case:0..4]:{T:Temperature storage {K},rho:Density storage {mol/m^3},pressure:Pressure storage {Pa},enthalpy:DeltaH storage {J/mol},ideal_enthalpy:DeltaH storage {J/mol},h_residual:ResidualMolarEnthalpy storage {J/mol}} complete_over(case in 0..4);
@id("64c1aa1c8cdd49bf9b9b18d499dc2d04") dataset states_values:states provenance(references.plan14_thermo_reference,provenance.Role.oracle_input,lineage(source references.feos_gross2001_json)) from "data/states.parquet";
@id("197162a89afa476d958b2ce51c0fc0fc") table components[case:0..4,subject:chemistry.species by chemistry.cas]:{ln_phi:Scalar storage {1}} complete_over(case in 0..4,subject in light_alkanes);
@id("87ee0ebd01664d00855b0e552ac00f6a") dataset components_values:components provenance(references.plan14_thermo_reference,provenance.Role.oracle_input,lineage(source references.feos_gross2001_json)) from "data/components.parquet";
@id("f3cda36aceca4aaa841caa7d2a605217") table flash[case:0..0]:{T:Temperature storage {K},pressure:Pressure storage {Pa},liquid_density:Density storage {mol/m^3},vapor_density:Density storage {mol/m^3},beta:Scalar storage {1},maximum_scaled_residual:Scalar storage {1}} complete_over(case in 0..0);
@id("d83afb89ce8a4c5180a808b74e51bca7") dataset flash_values:flash provenance(references.plan14_thermo_reference,provenance.Role.oracle_input,lineage(source references.feos_gross2001_json)) from "data/flash.parquet";
@id("c10e0b6920df44a8b25f26e2e58f987f") table flash_components[subject:chemistry.species by chemistry.cas]:{feed:Scalar storage {1},liquid:Scalar storage {1},vapor:Scalar storage {1}} complete_over(subject in light_alkanes);
@id("f13c66fb83c8468d88787801c62e5146") dataset flash_components_values:flash_components provenance(references.plan14_thermo_reference,provenance.Role.oracle_input,lineage(source references.feos_gross2001_json)) from "data/flash_components.parquet";
@id("f0aaf72982474423873d7d047aa76c24") table entropy[case:0..4]:{T:Temperature storage {K},rho:Density storage {mol/m^3},entropy:DeltaS storage {J/(mol*K)},ideal_entropy:DeltaS storage {J/(mol*K)},residual_entropy:DeltaS storage {J/(mol*K)}} complete_over(case in 0..4);
@id("66196d58b4aa4e34b0c4c28882ca38b4") dataset entropy_values:entropy provenance(references.plan14_thermo_reference,provenance.Role.oracle_input,lineage(source references.feos_gross2001_json)) from "data/entropy.parquet";
@id("00caf548d7a248638aba5010b3304d07") use chem @"1.0.0";
@id("4c949067177c4e5b9a39c44406ee1619") set light_alkanes:Set<chemistry.species>={chem.methane,chem.ethane,chem.propane};
@id("c52a139cc06f4c9e820996d4e9e065d0") table entropy_components[case:0..4,subject:chemistry.species by chemistry.cas]:{fraction:Scalar storage {1}} missing optional;
@id("e030458ba30d4252902013b59630f055") dataset entropy_component_values:entropy_components provenance(references.plan14_thermo_reference,provenance.Role.oracle_input,lineage(source references.feos_gross2001_json)) from "data/entropy_components.parquet";
}
