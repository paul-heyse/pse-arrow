@id("01a0e1461e94708a83138819c156f1bc") test formula_weights oracle ciaaw.ciaaw_2024 fixture {dof 0; route steady; procedure check;} {
@id("01a0e1461e94708a8313881a6114d017") expect if present(benzene.molar_mass) then benzene.molar_mass else 0{kg/mol}==0.078114{kg/mol} tolerance 1e-12{kg/mol};
@id("01a0e1461e94708a8313881b23d74d45") expect if present(toluene.molar_mass) then toluene.molar_mass else 0{kg/mol}==0.092141{kg/mol} tolerance 1e-12{kg/mol};
@id("01a0e1461e94708a8313881cd92832a5") expect if present(methane.molar_mass) then methane.molar_mass else 0{kg/mol}==0.016043{kg/mol} tolerance 1e-12{kg/mol};
@id("01a0e1461e94708a8313881d8b906241") expect chemistry.formula[ethyl_acetate,ciaaw.H]+chemistry.formula[sodium_hydroxide,ciaaw.H]==chemistry.formula[sodium_acetate,ciaaw.H]+chemistry.formula[ethanol,ciaaw.H] tolerance 1e-12{1};
@id("01a0e1461e94708a8313881ec53658ec") expect chemistry.formula[ethyl_acetate,ciaaw.C]+chemistry.formula[sodium_hydroxide,ciaaw.C]==chemistry.formula[sodium_acetate,ciaaw.C]+chemistry.formula[ethanol,ciaaw.C] tolerance 1e-12{1};
@id("01a0e1461e94708a8313881fa9068f91") expect chemistry.formula[ethyl_acetate,ciaaw.N]+chemistry.formula[sodium_hydroxide,ciaaw.N]==chemistry.formula[sodium_acetate,ciaaw.N]+chemistry.formula[ethanol,ciaaw.N] tolerance 1e-12{1};
@id("01a0e1461e94708a83138820bdddc67c") expect chemistry.formula[ethyl_acetate,ciaaw.O]+chemistry.formula[sodium_hydroxide,ciaaw.O]==chemistry.formula[sodium_acetate,ciaaw.O]+chemistry.formula[ethanol,ciaaw.O] tolerance 1e-12{1};
@id("01a0e1461e94708a8313882132c245dc") expect chemistry.formula[ethyl_acetate,ciaaw.Na]+chemistry.formula[sodium_hydroxide,ciaaw.Na]==chemistry.formula[sodium_acetate,ciaaw.Na]+chemistry.formula[ethanol,ciaaw.Na] tolerance 1e-12{1};
}
}
