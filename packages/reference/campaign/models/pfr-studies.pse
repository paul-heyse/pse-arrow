@id("01a0ee447c1375339658c58254a7f0d3") package pfr_studies {
@id("3e90901bb25d4b13ac251f05f91407ca") use numerical_policy @"1.0.0";
@id("6b321c81b2634b83b1cd86103fc14c46") use correlations @"1.0.0";
@id("04b87158858c41f58a25bcafacfdfe31") use properties @"1.0.0";
@id("6b1f386217f64a2287033f32494592e6") use compatibility @"1.0.0";
@id("f99c34db8f7444aca17cedcd9c4fa3ea") use references @"1.0.0";
@id("01a0efcd84ac72f9aa089248be776452") use campaign_references @"1.0.0";
@id("01a0ee447c1375339658c583d74cee22") use chemistry @"1.0.0";
@id("01a0ee447c1375339658c584df29a97d") use chem @"1.0.0";
@id("01a0ee447c1375339658c58548afbfa8") use reactors @"1.0.0";
@id("d34f369b5f62509c88d8cc4168a7f1b8") use reaction_forms @"1.0.0";
@id("01a0ee447c1375339658c5861091527d") use saponification @"1.0.0";
@id("01a0ee447c1375339658c58736424d00") def SaponificationPFR(elements:Integer=20,radau:Boolean=false) {
@id("01a0ee447c1375339658c588d969e920") child reactor:reactors.PFR=reactors.PFR(inlet_pkg=saponification.Saponification(defined_state=true),outlet_pkg=saponification.Saponification(defined_state=false),reaction_pkg=saponification.SaponificationReactions,elements=elements,use_radau=radau);
@id("01a0ee447c1375339658c58999134cb1") eq feed_flow:reactor.state[0].volume_flow==1{m^3/s};
@id("01a0ee447c1375339658c58aa96df933") eq feed_temperature:reactor.state[0].T==303.15{K};
@id("01a0ee447c1375339658c58b1fb6f73f") eq feed_pressure:reactor.state[0].pressure==101325{Pa};
@id("01a0ee447c1375339658c58c92548ab4") eq feed_water:reactor.state[0].concentration[chem.water]==55388{mol/m^3};
@id("01a0ee447c1375339658c58d1289c5ff") eq feed_hydroxide:reactor.state[0].concentration[chem.sodium_hydroxide]==100{mol/m^3};
@id("01a0ee447c1375339658c58e240d43ec") eq feed_ester:reactor.state[0].concentration[chem.ethyl_acetate]==100{mol/m^3};
@id("01a0ee447c1375339658c58fc683784f") eq feed_salt:reactor.state[0].concentration[chem.sodium_acetate]==0{mol/m^3};
@id("01a0ee447c1375339658c59019755358") eq feed_alcohol:reactor.state[0].concentration[chem.ethanol]==0{mol/m^3};
@id("01a0ee447c1375339658c591f55fbb09") eq reactor_length:reactor.length==0.5{m};
@id("01a0ee447c1375339658c59268f5aa34") eq reactor_area:reactor.area==0.1{m^2};
@id("01a0ee447c1375339658c593b536c71c") eq adiabatic:reactor.heat_duty==0{W};
@id("01a0ee447c1375339658c5947167a910") eq isobaric:reactor.delta_pressure==0{Pa};
@id("01a0ee447c1375339658c595bafef2b2") let ester:MolarDensity=reactor.outlet_concentration[chem.ethyl_acetate];
@id("01a0ee447c1375339658c5964f775af2") let released:EnergyTransferRate=reactor.heat_of_reaction;
@id("01a0ee447c1375339658c5971e379faa") annotation report ester("outlet ethyl acetate");
@id("01a0ee447c1375339658c59843756029") annotation report released("heat of reaction over the reactor");
}
@id("b8c0fdfcdbe24ed4a2c86b36d529e29a") def MeshStudy(radau:Boolean,base:Integer) {
@id("be985ba9eb0a477fa4cc8fec15973ba3") child coarse:SaponificationPFR=SaponificationPFR(elements=base,radau=radau);
@id("6150b852170d4ea78aac3745a06f4f5f") child fine:SaponificationPFR=SaponificationPFR(elements=2*base,radau=radau);
@id("d32ed51df33d4543b9896f9a61a1eceb") let concentration_change:MolarDensity=abs(coarse.ester-fine.ester);
@id("91c1f8a5ff0d44bfaee742c0836d5034") let temperature_change:DeltaTemperature=abs(coarse.reactor.outlet_temperature-fine.reactor.outlet_temperature);
@id("0fe9c05ca22841b89b1333b2ada9c80c") annotation report concentration_change("mesh refinement outlet concentration change");
@id("607c7b9954d143bf8aaff53ff10d8c1c") annotation report temperature_change("mesh refinement outlet temperature change");
@id("2fc4937d331d49a299a750c1088a5022") annotation check concentration_change(concentration_change<=numerical_policy.concentration);
@id("a35e602e496f40789ba1c94308b483bb") annotation check temperature_change(temperature_change<=numerical_policy.temperature);
}
// Mesh refinement compares output changes at the shared physical concentration
// and temperature resolution, without ratios of tiny numerical differences.
// Backward differences use 20/40 cells; three-point Radau uses 2/4 cells.
@id("f341a18f0f284413b6b20f1309e47e6d") test pfr_mesh_stability_backward oracle campaign_references.engineering_mesh_stability fixture {dof 0; route steady; procedure solve; policy { derivatives cells(20000000); }} {
@id("41e087c15ad044858ba5271ad27f636c") permission solvent_parameter_use records(correlations.constant[chem.water,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.saponification_caloric_fit],correlations.constant_density[chem.water,properties.liquid_molar_density,compatibility.PhaseType.liquidPhase,references.saponification_density_fit]) allow_unknown true allow_extrapolation false;
@id("c43dcd2ae1c656eb9d974f20c90cd2de") permission kinetic_use families(reaction_forms.reaction_set) allow_unknown true allow_extrapolation false;
@id("44adb88503f64357b9aad8c4b2c24e0c") child root:MeshStudy=MeshStudy(radau=false,base=20);
}
@id("8f755c37ae0341349c43cfcc02a62331") test pfr_mesh_stability_radau oracle campaign_references.engineering_mesh_stability fixture {dof 0; route steady; procedure solve; policy { derivatives cells(20000000); }} {
@id("8609a0c54aa44c9cb1b2f92456646926") permission solvent_parameter_use records(correlations.constant[chem.water,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.saponification_caloric_fit],correlations.constant_density[chem.water,properties.liquid_molar_density,compatibility.PhaseType.liquidPhase,references.saponification_density_fit]) allow_unknown true allow_extrapolation false;
@id("3a3bb76099ba546f8d798492c2454e5f") permission kinetic_use families(reaction_forms.reaction_set) allow_unknown true allow_extrapolation false;
@id("12ced87f01914e4d86c919d8c27750c9") child root:MeshStudy=MeshStudy(radau=true,base=2);
}
// Physical outlet and flow comparisons use the global typed policy. Extensive
// MW heat-release comparisons additionally use its dimensionless relative
// allowance; pure conservation keeps its independent original-space checks.
@id("01a0eeb74d7e726e81ad8d65fb5e4d34") test pfr_initializers_oracle oracle campaign_references.idaes_test_pfr_initializers fixture {dof 0; route steady; procedure solve;} {
@id("cf9c69f1ad4f4698b6a37798d7341fc7") permission solvent_parameter_use records(correlations.constant[chem.water,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.saponification_caloric_fit],correlations.constant_density[chem.water,properties.liquid_molar_density,compatibility.PhaseType.liquidPhase,references.saponification_density_fit]) allow_unknown true allow_extrapolation false;
@id("ea085e1c54a4551e92c5b8773bd278fc") permission kinetic_use families(reaction_forms.reaction_set) allow_unknown true allow_extrapolation false;
@id("01a0eeb74d7e726e81ad8d66c516ac6e") child root:SaponificationPFR=SaponificationPFR(elements=20,radau=false);
@id("01a0eeb74d7e726e81ad8d67ed1fa771") expect root.reactor.outlet_pressure==101325{Pa} tolerance numerical_policy.pressure;
@id("01a0eeb74d7e726e81ad8d6863ce208c") expect root.reactor.outlet_temperature==303.593{K} tolerance numerical_policy.temperature;
@id("01a0eeb74d7e726e81ad8d691ac4a6fc") expect root.ester==62.29202{mol/m^3} tolerance numerical_policy.concentration;
@id("01a0eeb74d7e726e81ad8d6a81ff7c5a") expect root.reactor.state[1].volume_flow==root.reactor.state[0].volume_flow tolerance numerical_policy.volume_flow;
@id("01a0eeb74d7e726e81ad8d6b1091ff28") expect root.reactor.state[1].flow==root.reactor.state[0].flow tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0eeb74d7e726e81ad8d6ccafc388d") expect root.released==1847000{W} tolerance numerical_policy.energy_transfer_rate relative numerical_policy.dimensionless;
@id("01a0eeb74d7e726e81ad8d6de04ee4b3") expect root.reactor.state[0].energy_flow+root.released==root.reactor.state[1].energy_flow tolerance numerical_policy.power relative numerical_policy.dimensionless;
}
}
