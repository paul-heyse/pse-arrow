@id("01a0ee447c1375339658c58254a7f0d3") package pfr_studies {
@id("01a0ee447c1375339658c583d74cee22") use chemistry @"1.0.0";
@id("01a0ee447c1375339658c584df29a97d") use chem @"1.0.0";
@id("01a0ee447c1375339658c58548afbfa8") use reactors @"1.0.0";
@id("01a0ee447c1375339658c5861091527d") use saponification @"1.0.0";
@id("01a0ee447c1375339658c58736424d00") def SaponificationPFR(elements:Integer=20,radau:Boolean=false) {
@id("01a0ee447c1375339658c588d969e920") child reactor:reactors.PFR=reactors.PFR(inlet_pkg=saponification.Saponification(defined_state=true),outlet_pkg=saponification.Saponification(defined_state=false),reaction_pkg=saponification.SaponificationReactions,elements=elements,use_radau=radau);
@id("01a0ee447c1375339658c58999134cb1") eq feed_flow:reactor.state[0].volume_flow==1{m^3/s};
@id("01a0ee447c1375339658c58aa96df933") eq feed_temperature:reactor.state[0].T==303.15{K};
@id("01a0ee447c1375339658c58b1fb6f73f") eq feed_pressure:reactor.state[0].pressure==101325{Pa};
@id("01a0ee447c1375339658c58c92548ab4") eq feed_water:reactor.state[0].concentration[chem.water]==55388{mol/m^3};
@id("01a0ee447c1375339658c58d1289c5ff") eq feed_hydroxide:reactor.state[0].concentration[chem.sodium_hydroxide]==100{mol/m^3};
@id("01a0ee447c1375339658c58e240d43ec") eq feed_ester:reactor.state[0].concentration[chem.ethyl_acetate]==100{mol/m^3};
@id("01a0ee447c1375339658c58fc683784f") eq feed_salt:reactor.state[0].concentration[chem.sodium_acetate]==0{mol/m^3};
@id("01a0ee447c1375339658c59019755358") eq feed_alcohol:reactor.state[0].concentration[chem.ethanol]==0{mol/m^3};
@id("01a0ee447c1375339658c591f55fbb09") eq reactor_length:reactor.length==0.5{m};
@id("01a0ee447c1375339658c59268f5aa34") eq reactor_area:reactor.area==0.1{m^2};
@id("01a0ee447c1375339658c593b536c71c") eq adiabatic:reactor.heat_duty==0{W};
@id("01a0ee447c1375339658c5947167a910") eq isobaric:reactor.delta_pressure==0{Pa};
@id("01a0ee447c1375339658c595bafef2b2") let ester:MolarDensity=reactor.outlet_concentration[chem.ethyl_acetate];
@id("01a0ee447c1375339658c5964f775af2") let released:Power=reactor.heat_of_reaction;
@id("01a0ee447c1375339658c5971e379faa") annotation report ester("outlet ethyl acetate");
@id("01a0ee447c1375339658c59843756029") annotation report released("heat of reaction over the reactor");
}
@id("01a0ee447c1375339658c599f3551527") def OrderStudy(radau:Boolean,base:Integer,lower:Scalar,upper:Scalar) {
@id("01a0ee447c1375339658c59a005e16c6") child coarse:SaponificationPFR=SaponificationPFR(elements=base,radau=radau);
@id("01a0ee447c1375339658c59b5878d11a") child medium:SaponificationPFR=SaponificationPFR(elements=2*base,radau=radau);
@id("01a0ee447c1375339658c59c90886e9e") child fine:SaponificationPFR=SaponificationPFR(elements=4*base,radau=radau);
@id("01a0ee447c1375339658c59deefa774d") child finest:SaponificationPFR=SaponificationPFR(elements=8*base,radau=radau);
@id("01a0ee447c1375339658c59e4325e22e") let coarse_order:Scalar=log(abs(coarse.ester-medium.ester)/abs(medium.ester-fine.ester))/log(2);
@id("01a0ee447c1375339658c59f1625df4d") let fine_order:Scalar=log(abs(medium.ester-fine.ester)/abs(fine.ester-finest.ester))/log(2);
@id("01a0ee447c1375339658c5a08560af92") annotation report coarse_order("observed order over base, 2 base and 4 base elements");
@id("01a0ee447c1375339658c5a18c3e446e") annotation report fine_order("observed order over 2 base, 4 base and 8 base elements");
@id("01a0ee447c1375339658c5a28ada63d5") annotation check coarse_order(coarse_order>=lower and coarse_order<=upper);
@id("01a0ee447c1375339658c5a3b9a0d07d") annotation check fine_order(fine_order>=lower and fine_order<=upper);
}
@id("01a0ee447c1375339658c5a4e1c11aa5") test pfr_order_backward source "Refinement study of the IDAES 2.13 test_pfr TestInitializers specification over 5, 10, 20 and 40 backward finite-difference elements; first-order consistency" revision "1" fixture {dof 0; run steady; policy { derivatives cells(20000000); }} {
@id("01a0ee447c1375339658c5a5868e2cdc") child root:OrderStudy=OrderStudy(radau=false,base=5,lower=0.85,upper=1.15);
}
@id("01a0ee447c1375339658c5a6de76089b") test pfr_order_radau source "Refinement study of the IDAES 2.13 test_pfr TestInitializers specification over 1, 2, 4 and 8 three-point Radau elements; endpoint order five (2s-1). Finer meshes reach the solver tolerance at 8 elements (6e-9 mol/m3 from the pfr_radau SciPy reference) and exceed the opaque derivative-support bound at 20" revision "1" fixture {dof 0; run steady; policy { derivatives cells(20000000); }} {
@id("01a0ee447c1375339658c5a762738491") child root:OrderStudy=OrderStudy(radau=true,base=1,lower=4.4,upper=5.3);
}
@id("01a0eeb74d7e726e81ad8d65fb5e4d34") test pfr_initializers_oracle source "IDAES 2.13 test_pfr TestInitializers (general hierarchical and block triangularization): 20 backward elements, zero inlet products; conservation and heat of reaction as in TestSaponification.test_conservation, whose 1e-6 absolute molar and energy balances add a 1e-9 relative allowance on the 5.6e4 mol/s and 2e7 W streams for this solve's original-space tolerance" revision "2.13.0" fixture {dof 0; run steady;} {
@id("01a0eeb74d7e726e81ad8d66c516ac6e") child root:SaponificationPFR=SaponificationPFR(elements=20,radau=false);
@id("01a0eeb74d7e726e81ad8d67ed1fa771") expect root.reactor.outlet_pressure==101325{Pa} tolerance 0.000000000001{Pa} relative 0.00001;
@id("01a0eeb74d7e726e81ad8d6863ce208c") expect root.reactor.outlet_temperature==303.593{K} tolerance 0.000000000001{K} relative 0.00001;
@id("01a0eeb74d7e726e81ad8d691ac4a6fc") expect root.ester==62.29202{mol/m^3} tolerance 0.000000000001{mol/m^3} relative 0.00001;
@id("01a0eeb74d7e726e81ad8d6a81ff7c5a") expect root.reactor.state[1].volume_flow==root.reactor.state[0].volume_flow tolerance 0.000001{m^3/s};
@id("01a0eeb74d7e726e81ad8d6b1091ff28") expect root.reactor.state[1].flow==root.reactor.state[0].flow tolerance 0.000001{mol/s} relative 0.000000001;
@id("01a0eeb74d7e726e81ad8d6ccafc388d") expect root.released==1847000{W} tolerance 1000{W};
@id("01a0eeb74d7e726e81ad8d6de04ee4b3") expect root.reactor.state[0].energy_flow+root.released==root.reactor.state[1].energy_flow tolerance 0.000001{W} relative 0.000000001;
}
}
