@id("01a0eecf2935721c9fc3aa9200760eea") package bt_pr_formulations {
@id("6fc0f1488cb2435cbef17cd91f0344f3") use properties @"1.0.0";
@id("e52f2c1f6ce2471f8a536db53d92387f") use eos_data @"1.0.0";
@id("17a40b9c0a624a49a2fd4a2bf8f12418") use cubic @"1.0.0";

@id("01a0f12be021704f9c94b08fc41b874b") use bt_ideal @"1.0.0";
@id("01a0efcd84ac72f9aa089249babca62f") use provenance @"1.0.0";
@id("01a0efcd84ac72f9aa08924a96c42bf0") use campaign_references @"1.0.0";
@id("01a0eecf2935721c9fc3aa93516f292a") use chem @"1.0.0";
@id("01a0eecf2935721c9fc3aa94612a7df5") use equilibrium @"1.0.0";
@id("01a0eecf2935721c9fc3aa9523df1db3") use flashing @"1.0.0";
@id("01a0eecf2935721c9fc3aa96368cb9d7") use bt_pr @"1.0.0";
@id("01a0eef9a1b5764cac354b546cbb61b9") use chemistry @"1.0.0";
@id("01a0eef9a1b5764cac354b552088e9e5") use peng_robinson @"1.0.0";
@id("01a0eef9a1b5764cac354b56e542fad0") use phase_stability @"1.0.0";
@id("01a0eecf2935721c9fc3aa970addbbc4") test bt_pr_flash_smooth oracle campaign_references.idaes_test_flash_bt_pr fixture {dof 0; route steady; procedure initialize; stages("ideal-K"); initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(1800); fix root.inlet.flow=1{mol/s}; fix root.inlet.T=368{K}; fix root.inlet.pressure=101325{Pa}; fix root.inlet.z[chem.benzene]=0.5{1}; fix root.inlet.z[chem.toluene]=0.5{1}; fix root.heat=0{W}; fix root.delta_pressure=0{Pa};policy {limits body_occurrences(1000000); } } {
// These exact selected critical records and predictive zero rule declare unknown applicability.
@id("e289332e65244f7cabbbbd322cb1a399") permission selected_unknown_fit families(cubic.critical_point,properties.predictive_rule) allow_unknown true allow_extrapolation false;
@id("01a0eecf2935721c9fc3aa98b477b588") child root:flashing.Flash=flashing.Flash(inlet_pkg=bt_pr.BT_PR(defined_state=true,formulation=equilibrium.VleFormulation.smooth,density=peng_robinson.RelationalDensity),outlet_pkg=bt_pr.BT_PR(defined_state=false,formulation=equilibrium.VleFormulation.smooth,density=peng_robinson.RelationalDensity));
@id("01a0eecf2935721c9fc3aa9922b7d32a") expect root.liquid_flow==0.6033{mol/s} tolerance 0.001{mol/s};
@id("01a0eecf2935721c9fc3aa9abbd997e1") expect root.vapor_flow==0.3967{mol/s} tolerance 0.001{mol/s};
@id("01a0eecf2935721c9fc3aa9b5d0c491f") expect root.liquid_temperature==368{K} tolerance 0.001{K};
@id("01a0eecf2935721c9fc3aa9c089d3d64") expect root.liquid_pressure==101325{Pa} tolerance 0.001{Pa};
@id("01a0eecf2935721c9fc3aa9d17c3293d") expect root.liquid_composition[chem.benzene]==0.4157{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aa9e49a47dbb") expect root.liquid_composition[chem.toluene]==0.5843{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aa9f9c510678") expect root.vapor_composition[chem.benzene]==0.6282{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aaa02c6d89d1") expect root.vapor_composition[chem.toluene]==0.3718{1} tolerance 0.001{1};
}
@id("01a0eecf2935721c9fc3aaa1435621bf") test bt_pr_flash_complementarity oracle campaign_references.idaes_test_flash_bt_pr fixture {dof 0; route steady; procedure solve; fix root.inlet.flow=1{mol/s}; fix root.inlet.T=368{K}; fix root.inlet.pressure=101325{Pa}; fix root.inlet.z[chem.benzene]=0.5{1}; fix root.inlet.z[chem.toluene]=0.5{1}; fix root.heat=0{W}; fix root.delta_pressure=0{Pa};policy {limits body_occurrences(1000000); } } {
// These exact selected critical records and predictive zero rule declare unknown applicability.
@id("7a6f2784583d47d48815eec16ee63f43") permission selected_unknown_fit families(cubic.critical_point,properties.predictive_rule) allow_unknown true allow_extrapolation false;
@id("01a0eecf2935721c9fc3aaa2bb9f8227") child root:flashing.Flash=flashing.Flash(inlet_pkg=bt_pr.BT_PR(defined_state=true,formulation=equilibrium.VleFormulation.complementarity,density=peng_robinson.RelationalDensity),outlet_pkg=bt_pr.BT_PR(defined_state=false,formulation=equilibrium.VleFormulation.complementarity,density=peng_robinson.RelationalDensity));
@id("01a0eecf2935721c9fc3aaa3c792744e") expect root.liquid_flow==0.6033{mol/s} tolerance 0.001{mol/s};
@id("01a0eecf2935721c9fc3aaa41d69c1a5") expect root.vapor_flow==0.3967{mol/s} tolerance 0.001{mol/s};
@id("01a0eecf2935721c9fc3aaa5b0487017") expect root.liquid_temperature==368{K} tolerance 0.001{K};
@id("01a0eecf2935721c9fc3aaa651ce32c8") expect root.liquid_pressure==101325{Pa} tolerance 0.001{Pa};
@id("01a0eecf2935721c9fc3aaa7abb75e5d") expect root.liquid_composition[chem.benzene]==0.4157{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aaa8e525ac1d") expect root.liquid_composition[chem.toluene]==0.5843{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aaa93b14d8b0") expect root.vapor_composition[chem.benzene]==0.6282{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aaaa9190b0b2") expect root.vapor_composition[chem.toluene]==0.3718{1} tolerance 0.001{1};
}
@id("01a0eecf2935721c9fc3aaab14032e96") test bt_pr_flash_nested oracle campaign_references.idaes_test_flash_bt_pr fixture {dof 0; route steady; procedure solve; fix root.inlet.flow=1{mol/s}; fix root.inlet.T=368{K}; fix root.inlet.pressure=101325{Pa}; fix root.inlet.z[chem.benzene]=0.5{1}; fix root.inlet.z[chem.toluene]=0.5{1}; fix root.heat=0{W}; fix root.delta_pressure=0{Pa};policy {limits body_occurrences(1000000); } } {
// These exact selected critical records and predictive zero rule declare unknown applicability.
@id("28f75d2b99ab4cb88bd87a1d310deb65") permission selected_unknown_fit families(cubic.critical_point,properties.predictive_rule) allow_unknown true allow_extrapolation false;
@id("01a0eecf2935721c9fc3aaace35ae6a2") child root:flashing.Flash=flashing.Flash(inlet_pkg=bt_pr.BT_PR(defined_state=true,formulation=equilibrium.VleFormulation.nested,density=peng_robinson.RelationalDensity),outlet_pkg=bt_pr.BT_PR(defined_state=false,formulation=equilibrium.VleFormulation.nested,density=peng_robinson.RelationalDensity));
@id("01a0eecf2935721c9fc3aaadf027c708") expect root.liquid_flow==0.6033{mol/s} tolerance 0.001{mol/s};
@id("01a0eecf2935721c9fc3aaae3d31b8eb") expect root.vapor_flow==0.3967{mol/s} tolerance 0.001{mol/s};
@id("01a0eecf2935721c9fc3aaaf3765c6a3") expect root.liquid_temperature==368{K} tolerance 0.001{K};
@id("01a0eecf2935721c9fc3aab0ebbd8f82") expect root.liquid_pressure==101325{Pa} tolerance 0.001{Pa};
@id("01a0eecf2935721c9fc3aab15ee8ad22") expect root.liquid_composition[chem.benzene]==0.4157{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aab295f40ae0") expect root.liquid_composition[chem.toluene]==0.5843{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aab315b19576") expect root.vapor_composition[chem.benzene]==0.6282{1} tolerance 0.001{1};
@id("01a0eecf2935721c9fc3aab4f00e7637") expect root.vapor_composition[chem.toluene]==0.3718{1} tolerance 0.001{1};
}
@id("01a0eef9a1b5764cac354b57402b8dd1") table solved_liquid[j:chemistry.species]:Scalar complete_over(j in bt_ideal.aromatics);
// The flash liquid that bt_pr_flash_smooth, bt_pr_flash_complementarity and
// bt_pr_flash_nested reproduce.
@id("01a0eef9a1b5764cac354b58c6738d25") dataset flash_liquid:solved_liquid provenance(campaign_references.idaes_test_flash_bt_pr, provenance.Role.oracle_input) {
[chem.benzene]=[0.4157];
[chem.toluene]=[0.5843];
}
@id("01a0eef9a1b5764cac354b5962c36d51") fn liquid_fraction(j:chemistry.species)->Scalar=solved_liquid[j];
// Local tangent-plane reference: the original Helmholtz law, density domains and TPD
// oracle are checked at the liquid reference, with original-space stationarity and
// complementarity. Both densities start on the liquid branch; this is not a global
// stability certificate. The separate saved SCIP reproducer and contradiction controls
// retain the upstream convex-handler defect (register R-52).
@id("01a10724b8e07728811cb4d38add9952") test bt_pr_liquid_tpd_reference oracle campaign_references.analytic_equilibrium_tangent_plane fixture {dof 1; route steady; procedure solve; intent optimize; policy {backend ipopt;} value root.temperature=368{K}; value root.pressure=101325{Pa}; value root.reference_lower=5000{mol/m^3}; value root.reference_upper=11000{mol/m^3}; value root.trial_upper=10500{mol/m^3}; value root.reference.rho=9460{mol/m^3}; value root.trial.rho=9460{mol/m^3};} {
// The selected critical-point record and zero-interaction prediction declare no empirical applicability region.
@id("1a007b98216e4ac297b717da51240f66") permission selected_unknown_fit families(cubic.critical_point,properties.predictive_rule) allow_unknown true allow_extrapolation false;
@id("01a0eef9a1b5764cac354b5bc48b03c1") child root:phase_stability.TangentPlaneStability=phase_stability.TangentPlaneStability(selected=bt_ideal.aromatics,law=eos_data.potential,feed=liquid_fraction);
@id("01a0eef9a1b5764cac354b5c78b9cff2") expect root.tpd==0{1} tolerance 0.000001{1};
}
}
