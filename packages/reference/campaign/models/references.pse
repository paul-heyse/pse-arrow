// The sources the campaign's datasets and tests cite beyond those of the seed (ADR-0123
// Outcome 5). The seed's `references` module declares the IDAES 2.13 release, the
// saponification CSTR test and the SciPy CSTR/controller reference the campaign reuses.
// Titles and locators are data, never parsed; the qualification boundaries are in
// sources.md.
@id("01a0efcd84ac72f9aa08923c0f449e2e") package campaign_references {
@id("01a0efcd84ac72f9aa08923d6f4769c1") use provenance @"1.0.0";
@id("01a0efcd84ac72f9aa08923e4b6c521f") use references @"1.0.0";

// IDAES tests whose specifications and printed results the fixtures compare with.
@id("01a0efcd84ac72f9aa08923f0fb8ec09") entity provenance.oracle_test idaes_test_pfr_initializers { title = "IDAES PFR with saponification under the general hierarchical and block triangularization initializers, 20 backward finite elements", release = references.idaes_2_13, locator = "idaes/models/unit_models/tests/test_pfr.py::TestInitializers" }
@id("01a0efcd84ac72f9aa0892402743a883") entity provenance.oracle_test idaes_test_flash_bt_pr { title = "IDAES flash with modular BT_PR at 368 K and 101325 Pa under the general hierarchical and block triangularization initializers", release = references.idaes_2_13, locator = "idaes/models/unit_models/tests/test_flash.py::TestInitializersCubicModularBTX" }

// Decision resolution for mesh studies and analytic properties of solved states.
@id("0a1e516fa12d4f08b254b4c46b294a4d") entity provenance.source engineering_mesh_stability { title = "Saponification design mesh stability: doubling the element count changes outlet concentration and temperature by no more than the shared physical design allowances; this checks analysis resolution rather than asymptotic method order" }
@id("01a0efcd84ac72f9aa089243ffd5f1f4") entity provenance.source analytic_steady_state_limit { title = "At constant inputs a stable CSTR relaxes to its steady state: 40 residence times from a feed-filled start reach the steady solution of the same definition" }
@id("01a0efcd84ac72f9aa0892440ee773b7") entity provenance.source analytic_equilibrium_tangent_plane { title = "A phase in equilibrium is stable under its own law: its minimum tangent-plane distance is nonnegative, zero at itself and at each phase in equilibrium with it" }

// The recycle flash steady state and its synthetic feeds.
@id("01a0f053c28176ea84d8ee454fa7ba47") entity provenance.source analytic_recycle_flash { title = "A flash at fixed T and P whose liquid is split between a purge and a recycle to its feed produces, at steady state, the equilibrium flash of the fresh feed: V/F solves the fresh feed's Rachford-Rice equation (for a binary, the lever rule between the equilibrium phases) and the flash liquid is (F - V)/purge fraction. BTIdeal at 368 K and 101325 Pa: x benzene 0.412118, y benzene 0.633977 from the RPP4 vapor pressures of the IDAES 2.13 BT_ideal configuration, the test_BTIdeal state" }
@id("01a0f04cffc170d5aad0ed2fa0dce7c5") entity provenance.source sampled_recycle_feeds { title = "Four synthetic benzene/toluene feeds for the recycle flash study, spanning subcooled to superheated feeds and benzene fractions across the 368 K, 101325 Pa two-phase region" }

// The structure of an over-specified flash and the total-reflux limit of a cascade.
@id("01a0f0825b1773e7a424939b299d01f5") entity provenance.source analytic_overspecified_flash { title = "A flash whose inlet, heat duty and pressure change are fixed has no freedom left for its outlet temperature: fixing it too leaves one more equation than unknowns" }
@id("01a0f0825b1773e7a424939cb66f1e80") entity provenance.source analytic_total_reflux_cascade { title = "Two ideal equilibrium stages with a total condenser and a total reboiler at total reflux, BTIdeal RPP4 vapor pressures at 101325 Pa, equimolar feed split evenly: the vapor leaving each stage equals the liquid from the stage above, and y1 + x2 = 1 for benzene; x2 0.288620, x1 0.497208, y1 0.711380, T1 365.42899 K, T2 372.09922 K" }

// The SSLW correlation evaluated at an IDAES test's solved state.
@id("01a0f037426c718f919d2147b76f2c35") entity provenance.source sslw_cost_of_idaes_bt_exchanger { title = "SSLW (3rd edition) purchase cost of the IDAES 2.13 TestBT_Generic_cocurrent exchanger, evaluated by hand: its 1 m2 area, recovered from the test's 596.9 degR cold outlet, costed as a U-tube, stainless/stainless, 12 ft exchanger at its 0 psig tube-side pressure (10.7639 ft2; base 16529.14 USD_CE500; material 3.555535; pressure 0.9803; length 1.12; CEPCI 603.1 for 2018)" }
}
