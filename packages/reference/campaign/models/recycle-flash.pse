@id("01a0f042b65f749c9bbcbb4ab092671a") package recycle_flash {
@id("ce0e399b3b5449e3a0c09a1da48b3a5e") use numerical_policy @"1.0.0";
@id("01a0f042b65f749c9bbcbb4b04ab206d") use provenance @"1.0.0";
@id("01a0f042b660738c8ffef70a6c386780") use campaign_references @"1.0.0";
@id("01a0f042b660738c8ffef70b425abedc") use kinds @"1.0.0";
@id("01a0f042b660738c8ffef70c2d80ce5a") use chemistry @"1.0.0";
@id("01a0f042b660738c8ffef70d328b3561") use chem @"1.0.0";
@id("01a0f042b660738c8ffef70e64611647") use units @"1.0.0";
@id("5e0a664f217943b2a3928b86b9bdb4a4") use equilibrium @"1.0.0";
@id("01a0f042b660738c8ffef70fdd8951af") use mixing @"1.0.0";
@id("01a0f042b660738c8ffef710a3aa2e90") use flashing @"1.0.0";
@id("01a0f042b660738c8ffef711ad128262") use separation @"1.0.0";
@id("01a0f042b660738c8ffef71205396dff") use bt_ideal @"1.0.0";
@id("a75beef701444cadb7c13faa15473570") use ideal_caloric_state @"1.0.0";
@id("01a0f04b2146776f9e058f9a0693abc9") use compatibility @"1.0.0";
@id("01a0f042b660738c8ffef713d7acc942") entity kinds.port_set fresh {}
@id("01a0f042b660738c8ffef7146ce50fa3") entity kinds.port_set recycled {}
@id("01a0f042b660738c8ffef71512501cdc") entity kinds.port_set purged {}
@id("01a0f042b660738c8ffef71697e2af80") set mixer_inlets:Set<kinds.port_set>={fresh,recycled};
@id("01a0f042b660738c8ffef717a4ad6bb4") set liquid_outlets:Set<kinds.port_set>={recycled,purged};
@id("80c24da5bd3242fe9cace3c5100df935") def PhaseAwareMixer(inlet_pkg:equilibrium.ThermoPackage,outlet_pkg:equilibrium.ThermoPackage,inlets:Set<kinds.port_set>,momentum_mixing:compatibility.MomentumMixingType):mixing.MixerModel {
@id("0b36ad7ee6da4b6e822cb2bca18eac28") param recycle_pkg:equilibrium.ThermoPackage=bt_ideal.BTLiquid(defined_state=true);
@id("94e4540d35444229b3477e367f93f6e0") override param inlet_package:equilibrium.ThermoPackage=inlet_pkg;
@id("1e5774de2eef41f595068d7582553605") override param outlet_package:equilibrium.ThermoPackage=outlet_pkg;
@id("b674f0e6b849457da81c4df6a7da878f") override param inlet_membership:Set<kinds.port_set>=inlets;
@id("6d997907f4c4430aa9ffc003e3f987a5") override param momentum_policy:compatibility.MomentumMixingType=momentum_mixing;
@id("91003809120d4e37a52d0bb420bcde00") override child inlet[i in inlet_membership]:equilibrium.ThermoPackage=if i==recycled then recycle_pkg else inlet_package;
@id("486260b3ece44d31acda1fb23d161961") override let in_phase_component[i in inlet_boundaries,p in phases,j in components]:ComponentFlow=if p in inlet[i].phases then inlet[i].phase_component_flow[p,j] else 0{mol/s};
}
@id("3f86e78525fb4c41bcedc24aa318262b") def RecycleMixer(inlet_pkg:equilibrium.ThermoPackage,outlet_pkg:equilibrium.ThermoPackage,inlets:Set<kinds.port_set>,momentum_mixing:compatibility.MomentumMixingType) {
@id("685af2727e424e229eb56b878d2eff6b") child unit:mixing.MixerModel=PhaseAwareMixer(inlet_pkg=inlet_pkg,outlet_pkg=outlet_pkg,inlets=inlets,momentum_mixing=momentum_mixing);
@id("a1a1cf897fc54736ad310856d8c7ce15") eq fresh_pressure_selection:unit.outlet.pressure==unit.inlet[fresh].pressure;
@id("4ac41154da6a4184b56c884904bf0a44") material port inlet_ports[i in inlets]=unit.inlet[i].material_state;
@id("ac07559d3cff434086f53e0cb1971ae1") annotation connectivity inlet_ports(1,0);
@id("4341b0ddc29c4b7eb4bd371f7e8672ca") material port outlet_port=unit.outlet.material_state;
@id("d671c81d2acc47d78467e296b2c30b51") annotation connectivity outlet_port(0,1);
}
@id("64c30fc87c274cd3a0adc4365da6dc18") def RecycleHeater(inlet_pkg:equilibrium.ThermoPackage,outlet_pkg:equilibrium.ThermoPackage,target_value:Temperature) {
@id("3619b0c179164dc7880e25c2c7f98a18") param target:Temperature=target_value;
@id("2be70be382964271a45967c60cd9a40b") child unit:units.Heater=units.Heater(inlet_pkg=inlet_pkg,outlet_pkg=outlet_pkg);
@id("800edba3a5404ea1b5b61eda7f984d46") eq target_temperature:unit.outlet.T==target;
@id("06068da57f2c4faaa5ccfffb9f247d89") eq isobaric:unit.delta_pressure==0{Pa};
@id("c8cab308b04640c580f89b6865cb3b73") material port inlet_port=unit.inlet.material_state;
@id("83153df032134cee94239fc602bfe116") annotation connectivity inlet_port(1,0);
@id("aab074d8f7034a63b871638ecb79566d") material port outlet_port=unit.outlet.material_state;
@id("a4a14d17ede14ad6a27fe1af431e4950") annotation connectivity outlet_port(0,1);
}
@id("dcee096f47864df997c6d030f6bb76ae") def RecycleEquilibriumFlash(inlet_pkg:equilibrium.ThermoPackage,outlet_pkg:equilibrium.EquilibriumThermoPackage) {
@id("cb515e2f8f4d49c8aa7315c123c5a65d") child unit:flashing.Flash=flashing.Flash(inlet_pkg=inlet_pkg,outlet_pkg=outlet_pkg);
@id("7fd95259f33b4abc99358264c607c268") eq adiabatic:unit.heat==0{W};
@id("f706c7869a3f4acabafb3a92ff5b811f") eq isobaric:unit.delta_pressure==0{Pa};
@id("b45580fc20f34cddba8be67453668093") material port inlet_port=unit.inlet.material_state;
@id("d796a2470314492ab51805d5eef56e55") annotation connectivity inlet_port(1,0);
@id("38f1f263700142b8a4a8ab31e3b7acc9") material port outlet_port=unit.outlet.material_state;
@id("d3a2e4434441444d80dc3be072d862e6") annotation connectivity outlet_port(0,1);
@id("396d3aae78c741be92111eeecc098b9a") material port liquid_port=unit.liquid_state;
@id("9b2e7647d11a4f4ea29b77fe5fea567c") annotation connectivity liquid_port(0,1);
@id("6c8148ad7ec44892a1c3ce93b17abe05") material port vapor_port=unit.vapor_state;
@id("f329ce3bfda647b486f64457006fb3c8") annotation connectivity vapor_port(0,1);
}
@id("d66a8ab7eb09400eba4ab13df023280d") def RecycleSplitter(pkg:equilibrium.ThermoPackage,outlets:Set<kinds.port_set>,component_enthalpy:Fn(T:Temperature,p:chemistry.phase,j:chemistry.species)->MolarEnthalpy,purge_value:Scalar) {
@id("28efbcbf1db845a5922a1525c489fe11") param purge:Scalar=purge_value;
@id("f1177332ad2d46cca98d86ad29169460") child unit:separation.Separator=separation.Separator(pkg=pkg,outlets=outlets,component_enthalpy=component_enthalpy);
@id("9d4d5e94836940289f858c51cc5f4d2f") eq purge_fraction:unit.split_total[purged]==purge;
@id("a1c1bdecc6084ea5ad0a8f122df82395") material port inlet_port=unit.inlet.material_state;
@id("bdfdb1a1ae8f45b98f8ddbd8a28b5d71") annotation connectivity inlet_port(1,0);
@id("5d4bc67f5e05488db0bf974ee51954ca") material port outlet_ports[o in outlets]=unit.outlet_state[o];
@id("126b00885c3b4a82a05a8cda72d32fe5") annotation connectivity outlet_ports(0,1);
}
// A flash whose liquid is split between a purge and a recycle to its feed mixer. The heater
// sets the flash temperature; the flash is adiabatic and, like the heater, isobaric. The
// mixer states no pressure relation, since a closed isobaric loop has no minimum to select:
// the loop runs at the fresh feed's pressure. The streams are the flowsheet's equations, so
// the recycle closure is one named material connection an initialization stage can tear.
@id("3d49b293030e469893be56bdfd30ca60") fn maximum_circulating_flow(fresh:Flow,purge:Scalar)->Flow valid(fresh>=0{mol/s} and purge>0 and purge<=1)=fresh/purge;
@id("01a0f053c2807589b9b24cdcf3747f60") interface RecycleLoop {
@id("4eb1d4cf03784447a1bb52ee376364e4") param context_enabled:Boolean=false;
@id("39c3bba46b0144338b6e8219e3dce856") param feed_capacity:Flow=0{mol/s};
@id("8e0d3ed09c144d039e22eea5033da9cb") param tear_fraction:Scalar=0.01;
@id("01a0f053c2807589b9b24cdda52461b5") let purge:Scalar=splitter.purge;
@id("01a0f053c2807589b9b24cdea005f07d") let flash_temperature:Temperature=heater.target;
@id("01a0f042b660738c8ffef7191e27e353") param components:Set<chemistry.species>=bt_ideal.aromatics;
@id("01a0f042b660738c8ffef71a3a3b632a") child feed:units.Feed=units.Feed(pkg=bt_ideal.BTIdeal(defined_state=true));
@id("01a0f042b660738c8ffef71b7e420960") child mixer:RecycleMixer=RecycleMixer(inlet_pkg=bt_ideal.BTIdeal(defined_state=true),outlet_pkg=bt_ideal.BTIdeal(defined_state=false),inlets=mixer_inlets,momentum_mixing=compatibility.MomentumMixingType.none);
@id("01a0f042b660738c8ffef71c32a65c83") child heater:RecycleHeater;
@id("01a0f042b660738c8ffef71d9e72f633") child flash:RecycleEquilibriumFlash=RecycleEquilibriumFlash(inlet_pkg=bt_ideal.BTIdeal(defined_state=true),outlet_pkg=bt_ideal.BTIdeal(defined_state=false));
@id("01a0f042b660738c8ffef71e6f3bb4a9") child splitter:RecycleSplitter;
@id("94e0a3c0f56941eca2d680229bf27b11") connect fresh_feed:feed.material -> mixer.inlet_ports[fresh];
@id("691b9062866c49b88f7459bd9e0f67f3") connect mixed:mixer.outlet_port -> heater.inlet_port;
@id("13f0fa4ef0cb4d55bd7e762fe9b8856d") connect heated:heater.outlet_port -> flash.inlet_port;
@id("d8a5f9228650494288916c171913ce7d") connect liquid:flash.liquid_port -> splitter.inlet_port;
@id("86064b2612844614b40eb36cf6b085a5") connect recycle:splitter.outlet_ports[recycled] -> mixer.inlet_ports[recycled];
@id("017a9b0ca6c1430e9470624599a5792f") let tear_component[j in components]:ComponentFlow=feed.state.component_flow[j]*tear_fraction;
@id("c386789179564f778ead8ad0072a81d0") let tear_temperature:Temperature=heater.target;
@id("0e80a2fb8a904cf0b86e6228f97903f6") let tear_pressure:Pressure=feed.state.pressure;
@id("3721bbebec294b25806dc437157b1bd6") let tear_energy:Power=feed.state.flow*tear_fraction*ideal_caloric_state.mixture_enthalpy(tear_temperature,feed.state.z,components,bt_ideal.liquid_h);
// Opt-in frozen context uses authored feed capacity and the existing purge,
// never a solved stream value. These are operating-range characteristics,
// not certified bounds on downstream analysis error.
@id("7527dbf2ffb24aa195e8c2154d13a536") when context_enabled {
@id("6cfaa845b25846659d9cda2521e26971") let circulation_capacity:Flow=maximum_circulating_flow(feed_capacity,purge);
@id("361212ede7354d828d6de8e78f90abb0") let recycle_capacity:Flow=(1-purge)*circulation_capacity;
@id("0ccdab4f51a44533810744ddbb322e03") let tear_capacity:Flow=tear_fraction*feed_capacity;
@id("c03cf2cc93a24f3e9cb2cf0f37a1401d") annotation check feed_capacity(feed_capacity>=0{mol/s} and purge>0 and purge<=1 and tear_fraction>=0);
@id("f50039d80b9146368688661c8f459b6a") annotation engineering_scale feed.state.energy_flow(kind=reference_difference,value=bt_ideal.power_span(feed_capacity,bt_ideal.phase_enthalpy_span()));
@id("80e79154313b48e284284a21c3634156") annotation engineering_scale mixer.unit.inlet[fresh].energy_flow(kind=reference_difference,value=bt_ideal.power_span(feed_capacity,bt_ideal.phase_enthalpy_span()));
@id("e8305be5c2a94e4d9e8a91e028dc503e") annotation engineering_scale mixer.unit.inlet[recycled].energy_flow(kind=reference_difference,value=bt_ideal.power_span(recycle_capacity,bt_ideal.liquid_enthalpy_span()));
@id("60727dd7b87947918fb7500c00a5980a") annotation engineering_scale mixer.unit.outlet.energy_flow(kind=reference_difference,value=bt_ideal.power_span(circulation_capacity,bt_ideal.phase_enthalpy_span()));
@id("7abd0ee182c74ce69ada37c241ed4060") annotation engineering_scale heater.unit.inlet.energy_flow(kind=reference_difference,value=bt_ideal.power_span(circulation_capacity,bt_ideal.phase_enthalpy_span()));
@id("88bb3ce5ee8a437db8ffcd2e2a6cc03b") annotation engineering_scale heater.unit.outlet.energy_flow(kind=reference_difference,value=bt_ideal.power_span(circulation_capacity,bt_ideal.phase_enthalpy_span()));
@id("c57b098975a44bad9b10a41e0edd6333") annotation engineering_scale flash.unit.inlet.energy_flow(kind=reference_difference,value=bt_ideal.power_span(circulation_capacity,bt_ideal.phase_enthalpy_span()));
@id("bf16fe8cc47746b4962922a63bb1263a") annotation engineering_scale flash.unit.outlet.energy_flow(kind=reference_difference,value=bt_ideal.power_span(circulation_capacity,bt_ideal.phase_enthalpy_span()));
@id("28f675d38d1d4a2a84d51362be04bdab") annotation engineering_scale flash.unit.outlet.phase_energy_flow[chemistry.liquid](kind=reference_difference,value=bt_ideal.power_span(circulation_capacity,bt_ideal.liquid_enthalpy_span()));
@id("70b49b61318f45b9b05aea30c9db5858") annotation engineering_scale flash.unit.outlet.phase_energy_flow[chemistry.vapor](kind=reference_difference,value=bt_ideal.power_span(feed_capacity,bt_ideal.vapor_enthalpy_span()));
@id("89d0e4b270ae418d9ba38babbb0a1eff") annotation engineering_scale splitter.unit.inlet.energy_flow(kind=reference_difference,value=bt_ideal.power_span(circulation_capacity,bt_ideal.liquid_enthalpy_span()));
@id("6d9b84ee7a7b4174823b81fef9e72705") annotation engineering_scale splitter.unit.outlet_energy_flow[recycled](kind=reference_difference,value=bt_ideal.power_span(recycle_capacity,bt_ideal.liquid_enthalpy_span()));
@id("00be6931d4ee4f378cc6685cc6e3c0ba") annotation engineering_scale splitter.unit.outlet_energy_flow[purged](kind=reference_difference,value=bt_ideal.power_span(feed_capacity,bt_ideal.liquid_enthalpy_span()));
@id("54756c63692148cbbd29e70b70d706b3") annotation engineering_scale tear_energy(kind=reference_difference,value=bt_ideal.power_span(tear_capacity,bt_ideal.liquid_enthalpy_span()));
}
@id("76dc17d0b1d8478c9181cfe430939355") state tear_state supplied(true) {
coordinate component[j in components]=tear_component[j];
coordinate temperature=tear_temperature;
coordinate pressure=tear_pressure;
transport component[j in components]=tear_component[j] tolerance numerical_policy.component_flow;
transport energy=tear_energy tolerance numerical_policy.power;
}
@id("0f0d8d61c18c4667be4e199499d519ad") material port tear_port=tear_state;
@id("f821edcb22604724930ee3e554eaefd6") annotation connectivity tear_port(0,1);
@id("01a0f053c2807589b9b24cdf3a92e89f") accumulate overall[j in components]:ComponentFlow accounting tolerance numerical_policy.component_flow;
@id("01a0f053c2807589b9b24ce0f90adaaf") contribute [j in components] overall[j] role inflow=feed.state.component_flow[j];
@id("01a0f053c2807589b9b24ce1f9b44029") contribute [j in components] overall[j] role outflow=flash.unit.vapor_component_flow[j];
@id("01a0f053c2807589b9b24ce294e518a3") contribute [j in components] overall[j] role outflow=splitter.unit.component_flow[purged,j];
@id("01a0f053c2807589b9b24ce40f579e61") annotation report flash.unit.vapor_flow("vapor product");
@id("01a0f053c2807589b9b24ce535dd8351") annotation report mixer.unit.inlet[recycled].flow("liquid recycle");
}
// Numeric specifications belong to their unit problems. The existing constructor
// formals supply their initial values; the loop's lets only expose observations.
// The tear stage holds a small positive liquid recycle at the heater temperature,
// with feed pressure and composition and matching liquid enthalpy. The original
// specification then closes the recycle from that start.
@id("01a0f042b660738c8ffef718e014a1d0") def RecycleFlash(purge_fraction:Scalar=0.25,temperature:Temperature=368{K},use_accuracy_context:Boolean=false,fresh_feed_capacity:Flow=0{mol/s}):RecycleLoop {
@id("dc39f855d26842d6b5dcb3d46bb5835d") override param context_enabled:Boolean=use_accuracy_context;
@id("d4a02bf78d574b72b4a5fc839a312da9") override param feed_capacity:Flow=fresh_feed_capacity;

@id("e961fb6db2b2497ab1cc6223b1d3cc7c") override child heater:RecycleHeater=RecycleHeater(inlet_pkg=bt_ideal.BTIdeal(defined_state=true),outlet_pkg=bt_ideal.BTIdeal(defined_state=false),target_value=temperature);
@id("aee77b64111544c68411d1b564a873b1") override child splitter:RecycleSplitter=RecycleSplitter(pkg=bt_ideal.BTLiquid(defined_state=true),outlets=liquid_outlets,component_enthalpy=bt_ideal.component_enthalpy,purge_value=purge_fraction);
@id("01a0f042b660738c8ffef738c8c09b09") stage "tear" {
@id("84f1b782717b4b09adbed4740223f8fd") override connect recycle:tear_port -> mixer.inlet_ports[recycled];
}
}
// An original-specification owner for the typed conditional request handoff. It
// retains the fixture-only parameter provenance; coupled execution belongs to the
// conditional campaign rather than this declaration of its inputs.
@id("8c8789c68c014b9b8535a9b820ee0337") test recycle_flash_conditional_handoff fixture {dof 0; route steady; procedure solve; fix root.feed.state.flow=1{mol/s}; fix root.feed.state.T=368{K}; fix root.feed.state.pressure=101325{Pa}; fix root.feed.state.z[chem.benzene]=0.5{1}; fix root.feed.state.z[chem.toluene]=0.5{1};} {
@id("c530dc52bb2343f1998b47845aab59d6") child root:RecycleFlash=RecycleFlash;
}
// A tear whose recycle temperature estimate, 500 K, lies above the 450 K upper bound of the
// BTIdeal states: its stage cannot be solved, while the original specification is that of
// RecycleFlash.
@id("01a0f053c2807589b9b24ce8ecb9eca4") def OverheatedTear(use_accuracy_context:Boolean=false,fresh_feed_capacity:Flow=0{mol/s}):RecycleLoop {
@id("b4fb1c21eb8140cfb4d0dfc7cb65b3c8") override param context_enabled:Boolean=use_accuracy_context;
@id("aa125a7b551343f284d32e0238a62f67") override param feed_capacity:Flow=fresh_feed_capacity;

@id("d3432b271c7a49eaaa9e8a5096060a45") override child heater:RecycleHeater=RecycleHeater(inlet_pkg=bt_ideal.BTIdeal(defined_state=true),outlet_pkg=bt_ideal.BTIdeal(defined_state=false),target_value=368{K});
@id("a1d5e8336cdf4a5cb79df1278297b815") override child splitter:RecycleSplitter=RecycleSplitter(pkg=bt_ideal.BTLiquid(defined_state=true),outlets=liquid_outlets,component_enthalpy=bt_ideal.component_enthalpy,purge_value=0.25);
@id("2fa918deb9bc4303851fc00d659879a0") let overheated_temperature:Temperature=500{K};
@id("cad6a49dd3c74881881584e68aaa1180") state overheated_state supplied(true) {
coordinate component[j in components]=tear_component[j];
coordinate temperature=overheated_temperature;
coordinate pressure=tear_pressure;
transport component[j in components]=tear_component[j] tolerance numerical_policy.component_flow;
transport energy=tear_energy tolerance numerical_policy.power;
}
@id("5506ce7e0177411ca5e38f1bfca3463c") material port overheated_port=overheated_state;
@id("e1f802bc921643edbd9b4132ec50a0e3") annotation connectivity overheated_port(0,1);
@id("01a0f053c2807589b9b24cebe964d6ce") stage "overheated_tear" {
@id("981dcc6d34ce415587c0b6d1b2da18c6") override connect recycle:overheated_port -> mixer.inlet_ports[recycled];
}
}
@id("01a0f04cffc170d5aad0ed18309baff9") entity kind feed_sample {}
@id("01a0f04cffc170d5aad0ed1949d95d6f") entity feed_sample cold_lean {}
@id("01a0f04cffc170d5aad0ed1a593da623") entity feed_sample saturated_equimolar {}
@id("01a0f04cffc170d5aad0ed1b1cc6975c") entity feed_sample warm_rich {}
@id("01a0f04cffc170d5aad0ed1cd55b8ccb") entity feed_sample vapor_rich {}
@id("01a0f04cffc170d5aad0ed1d359f2b8b") set feed_samples:Set<feed_sample>={cold_lean,saturated_equimolar,warm_rich,vapor_rich};
@id("01a0f04cffc170d5aad0ed1ef29e7306") table sampled_feed[s:feed_sample]:{flow:Flow,temperature:Temperature,benzene:MoleFraction} complete_over(s);
@id("01a0f04cffc170d5aad0ed1f32729c1d") dataset recycle_feeds:sampled_feed complete_over(s in feed_samples) provenance(campaign_references.sampled_recycle_feeds, provenance.Role.synthetic) {
[cold_lean]=[50{mol/s},300{K},0.45{1}];
[saturated_equimolar]=[1{mol/s},368{K},0.5{1}];
[warm_rich]=[20{mol/s},330{K},0.55{1}];
[vapor_rich]=[0.5{mol/s},400{K},0.6{1}];
}
@id("01a0f04cffc170d5aad0ed2013ba7b93") def RecycleFlashStudy {
@id("01a0f04cffc170d5aad0ed213d877c6e") child point[s in feed_samples]:RecycleFlash=RecycleFlash(purge_fraction=0.1,use_accuracy_context=true,fresh_feed_capacity=sampled_feed[s].flow);
@id("01a0f04cffc170d5aad0ed2257f8648b") eq feed_flow[s in feed_samples]:point[s].feed.state.flow==sampled_feed[s].flow;
@id("01a0f04cffc170d5aad0ed232ff419c6") eq feed_temperature[s in feed_samples]:point[s].feed.state.T==sampled_feed[s].temperature;
@id("01a0f04cffc170d5aad0ed24e0dd02ad") eq feed_pressure[s in feed_samples]:point[s].feed.state.pressure==101325{Pa};
@id("01a0f04cffc170d5aad0ed2506b359db") eq feed_benzene[s in feed_samples]:point[s].feed.state.z[chem.benzene]==sampled_feed[s].benzene;
@id("01a0f04cffc170d5aad0ed26d02938b7") eq feed_toluene[s in feed_samples]:point[s].feed.state.z[chem.toluene]==1{1}-sampled_feed[s].benzene;
}
// Four feeds from subcooled to superheated, 0.5 to 50 mol/s and 0.45 to 0.6 benzene, each
// through a 368 K, 101325 Pa flash whose liquid is 90 % recycled, solved from the model's
// start annotations and the tear stage alone (no value starts). With the recycle at up to
// 373 mol/s, the same study solved without the tear stage fails its original numerical
// acceptance at this revision. At steady state the vapor product is the equilibrium flash
// of the fresh feed: x and y are the flash's equilibrium phases at 368 K (the IDAES
// test_BTIdeal state), V/F is the lever rule and the recycle is 0.9 (F - V)/0.1. The
// package's 0.01 K bubble-point smoothing moves a flash that is 2 % vaporized (cold_lean)
// by 0.5 mK. Physical comparisons and internal transport use the shared typed
// design policy; relative flow comparisons use its dimensionless allowance. The
// recycled liquid is saturated, so the derivative sample at the solution resolves that
// smoothing in its re-flash with a 1e-7 step, whose roundoff on the 1e5 W energy rows and
// truncation on the smoothing both stay below 1 %.
@id("01a0f053c2807589b9b24cf0b26a07c9") test recycle_flash_converges_from_defaults oracle campaign_references.analytic_recycle_flash fixture {dof 0; route steady; procedure initialize; stages("tear"); initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(600); policy { derivatives step(1e-7) tolerance(1e-2); }} {
@id("01a0f053c2807589b9b24cf1e6db2076") child root:RecycleFlashStudy=RecycleFlashStudy;
@id("01a0f053c2807589b9b24cf202b31e73") expect root.point[cold_lean].flash.unit.vapor_composition[chem.benzene]==0.633977{1} tolerance numerical_policy.mole_fraction;
@id("01a0f053c2807589b9b24cf3b9a99eb9") expect root.point[cold_lean].flash.unit.liquid_composition[chem.benzene]==0.412118{1} tolerance numerical_policy.mole_fraction;
@id("01a0f053c2807589b9b24cf4b5c93839") expect root.point[cold_lean].flash.unit.vapor_flow==8.53742566{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f053c2807589b9b24cf5c1c7fbaa") expect root.point[cold_lean].mixer.unit.inlet[recycled].flow==373.163169{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f053c2807589b9b24cf6c60e55b0") expect root.point[saturated_equimolar].flash.unit.vapor_composition[chem.benzene]==0.633977{1} tolerance numerical_policy.mole_fraction;
@id("01a0f053c2807589b9b24cf78c453a65") expect root.point[saturated_equimolar].flash.unit.liquid_composition[chem.benzene]==0.412118{1} tolerance numerical_policy.mole_fraction;
@id("01a0f053c2807589b9b24cf86af3e9f8") expect root.point[saturated_equimolar].flash.unit.vapor_flow==0.396116832{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f053c2807589b9b24cf9911b7f09") expect root.point[saturated_equimolar].mixer.unit.inlet[recycled].flow==5.43494852{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f053c28176ea84d8ee3dea45d640") expect root.point[warm_rich].flash.unit.vapor_composition[chem.benzene]==0.633977{1} tolerance numerical_policy.mole_fraction;
@id("01a0f053c28176ea84d8ee3e5b21e575") expect root.point[warm_rich].flash.unit.liquid_composition[chem.benzene]==0.412118{1} tolerance numerical_policy.mole_fraction;
@id("01a0f053c28176ea84d8ee3f30f1ec71") expect root.point[warm_rich].flash.unit.vapor_flow==12.429703{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f053c28176ea84d8ee405e8561e9") expect root.point[warm_rich].mixer.unit.inlet[recycled].flow==68.132673{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f053c28176ea84d8ee41685a64a0") expect root.point[vapor_rich].flash.unit.vapor_composition[chem.benzene]==0.633977{1} tolerance numerical_policy.mole_fraction;
@id("01a0f053c28176ea84d8ee42c8e9d78d") expect root.point[vapor_rich].flash.unit.liquid_composition[chem.benzene]==0.412118{1} tolerance numerical_policy.mole_fraction;
@id("01a0f053c28176ea84d8ee432bd7870f") expect root.point[vapor_rich].flash.unit.vapor_flow==0.423426734{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f053c28176ea84d8ee440f2ba107") expect root.point[vapor_rich].mixer.unit.inlet[recycled].flow==0.689159392{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f05b4c437594b6148a160c3a0a98") expect root.point[cold_lean].overall[chem.benzene]==0{mol/s} tolerance numerical_policy.component_flow;
@id("01a0f05b4c437594b6148a179bd9f7ba") expect root.point[cold_lean].overall[chem.toluene]==0{mol/s} tolerance numerical_policy.component_flow;
@id("01a0f05b4c437594b6148a18351142d7") expect root.point[saturated_equimolar].overall[chem.benzene]==0{mol/s} tolerance numerical_policy.component_flow;
@id("01a0f05b4c437594b6148a19a163b002") expect root.point[saturated_equimolar].overall[chem.toluene]==0{mol/s} tolerance numerical_policy.component_flow;
@id("01a0f05b4c437594b6148a1a620eec58") expect root.point[warm_rich].overall[chem.benzene]==0{mol/s} tolerance numerical_policy.component_flow;
@id("01a0f05b4c437594b6148a1b5e526487") expect root.point[warm_rich].overall[chem.toluene]==0{mol/s} tolerance numerical_policy.component_flow;
@id("01a0f05b4c437594b6148a1c135fb641") expect root.point[vapor_rich].overall[chem.benzene]==0{mol/s} tolerance numerical_policy.component_flow;
@id("01a0f05b4c437594b6148a1d14dea77d") expect root.point[vapor_rich].overall[chem.toluene]==0{mol/s} tolerance numerical_policy.component_flow;
}
// The overheated tear's stage fails, and the failure leaves the specification intact: the
// attempt commits nothing, and the unchanged specification, RecycleFlash's at the IDAES
// test_BTIdeal feed (1 mol/s, equimolar, 368 K, 101325 Pa) with a quarter purged, is solved
// from its own starts and answers to the same steady state.
@id("01a0f053f157702a825ee1acc5a50f11") test recycle_flash_failure_restores_specification oracle campaign_references.analytic_recycle_flash fixture {dof 0; route steady; procedure initialize; stages("overheated_tear"); initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(600); failure trial_rejected members(root.recycle); fix root.feed.state.flow=1{mol/s}; fix root.feed.state.T=368{K}; fix root.feed.state.pressure=101325{Pa}; fix root.feed.state.z[chem.benzene]=0.5{1}; fix root.feed.state.z[chem.toluene]=0.5{1};} {
@id("01a0f05f996477f09a4b59bf39131cec") child root:OverheatedTear=OverheatedTear;
@id("01a0f05f996477f09a4b59c0cd740ceb") expect root.flash.unit.vapor_composition[chem.benzene]==0.633977{1} tolerance numerical_policy.mole_fraction;
@id("01a0f05f996477f09a4b59c1a7dff362") expect root.flash.unit.liquid_composition[chem.benzene]==0.412118{1} tolerance numerical_policy.mole_fraction;
@id("01a0f05f996477f09a4b59c24aec69da") expect root.flash.unit.vapor_flow==0.396116832{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f05f996477f09a4b59c362ff95ff") expect root.mixer.unit.inlet[recycled].flow==1.81164951{mol/s} tolerance numerical_policy.molar_flow relative numerical_policy.dimensionless;
@id("01a0f05f996477f09a4b59c433047fe6") expect root.overall[chem.benzene]==0{mol/s} tolerance numerical_policy.component_flow;
@id("01a0f05f996477f09a4b59c51c020a51") expect root.overall[chem.toluene]==0{mol/s} tolerance numerical_policy.component_flow;
}
}
