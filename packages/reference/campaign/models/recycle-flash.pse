@id("01a0f042b65f749c9bbcbb4ab092671a") package recycle_flash {
@id("01a0f042b65f749c9bbcbb4b04ab206d") use provenance @"1.0.0";
@id("01a0f042b660738c8ffef70a6c386780") use campaign_references @"1.0.0";
@id("01a0f042b660738c8ffef70b425abedc") use kinds @"1.0.0";
@id("01a0f042b660738c8ffef70c2d80ce5a") use chemistry @"1.0.0";
@id("01a0f042b660738c8ffef70d328b3561") use chem @"1.0.0";
@id("01a0f042b660738c8ffef70e64611647") use units @"1.0.0";
@id("01a0f042b660738c8ffef70fdd8951af") use mixing @"1.0.0";
@id("01a0f042b660738c8ffef710a3aa2e90") use flashing @"1.0.0";
@id("01a0f042b660738c8ffef711ad128262") use separation @"1.0.0";
@id("01a0f042b660738c8ffef71205396dff") use bt_ideal @"1.0.0";
@id("01a0f04b2146776f9e058f9a0693abc9") use compatibility @"1.0.0";
@id("01a0f042b660738c8ffef713d7acc942") entity kinds.port_set fresh {}
@id("01a0f042b660738c8ffef7146ce50fa3") entity kinds.port_set recycled {}
@id("01a0f042b660738c8ffef71512501cdc") entity kinds.port_set purged {}
@id("01a0f042b660738c8ffef71697e2af80") set mixer_inlets:Set<kinds.port_set>={fresh,recycled};
@id("01a0f042b660738c8ffef717a4ad6bb4") set liquid_outlets:Set<kinds.port_set>={recycled,purged};
// A flash whose liquid is split between a purge and a recycle to its feed mixer. The heater
// sets the flash temperature; the flash is adiabatic and, like the heater, isobaric. The
// mixer states no pressure relation, since a closed isobaric loop has no minimum to select:
// the loop runs at the fresh feed's pressure. The streams are the flowsheet's equations, so
// the recycle closure is a named set of members an initialization stage can tear.
@id("01a0f053c2807589b9b24cdcf3747f60") interface RecycleLoop {
@id("01a0f053c2807589b9b24cdda52461b5") param purge:Scalar;
@id("01a0f053c2807589b9b24cdea005f07d") param flash_temperature:Temperature;
@id("01a0f042b660738c8ffef7191e27e353") param components:Set<chemistry.species>=chem.aromatics;
@id("01a0f042b660738c8ffef71a3a3b632a") child feed:units.Feed=units.Feed(pkg=bt_ideal.BTIdeal(defined_state=true));
@id("01a0f042b660738c8ffef71b7e420960") child mixer:mixing.Mixer=mixing.Mixer(inlet_pkg=bt_ideal.BTIdeal(defined_state=true),outlet_pkg=bt_ideal.BTIdeal(defined_state=false),inlets=mixer_inlets,momentum_mixing=compatibility.MomentumMixingType.none);
@id("01a0f042b660738c8ffef71c32a65c83") child heater:units.Heater=units.Heater(inlet_pkg=bt_ideal.BTIdeal(defined_state=true),outlet_pkg=bt_ideal.BTIdeal(defined_state=false));
@id("01a0f042b660738c8ffef71d9e72f633") child flash:flashing.Flash=flashing.Flash(inlet_pkg=bt_ideal.BTIdeal(defined_state=true),outlet_pkg=bt_ideal.BTIdeal(defined_state=false));
@id("01a0f042b660738c8ffef71e6f3bb4a9") child splitter:separation.Separator=separation.Separator(pkg=bt_ideal.BTIdeal(defined_state=true),outlets=liquid_outlets,component_enthalpy=bt_ideal.component_enthalpy);
@id("01a0f042b660738c8ffef71fca8c39d5") eq fresh_flow:mixer.inlet[fresh].flow==feed.flow;
@id("01a0f042b660738c8ffef720bd597e1f") eq fresh_temperature:mixer.inlet[fresh].T==feed.temperature;
@id("01a0f042b660738c8ffef721a98a4863") eq fresh_pressure:mixer.inlet[fresh].pressure==feed.pressure;
@id("01a0f042b660738c8ffef7221b6c5d4a") eq fresh_composition[j in components]:mixer.inlet[fresh].z[j]==feed.composition[j];
@id("01a0f042b660738c8ffef7233e980bc9") eq mixed_flow:heater.inlet.flow==mixer.outlet.flow;
@id("01a0f042b660738c8ffef7245935302e") eq mixed_temperature:heater.inlet.T==mixer.outlet.T;
@id("01a0f042b660738c8ffef72546ef00bc") eq mixed_pressure:heater.inlet.pressure==mixer.outlet.pressure;
@id("01a0f042b660738c8ffef72639424cd5") eq mixed_composition[j in components]:heater.inlet.z[j]==mixer.outlet.z[j];
@id("01a0f042b660738c8ffef72767268e99") eq heated_flow:flash.inlet.flow==heater.outlet.flow;
@id("01a0f042b660738c8ffef72816a922d6") eq heated_temperature:flash.inlet.T==heater.outlet.T;
@id("01a0f042b660738c8ffef729f1527c0a") eq heated_pressure:flash.inlet.pressure==heater.outlet.pressure;
@id("01a0f042b660738c8ffef72adc4ae370") eq heated_composition[j in components]:flash.inlet.z[j]==heater.outlet.z[j];
@id("01a0f042b660738c8ffef72b31336cb1") eq liquid_flow:splitter.inlet.flow==flash.liquid_flow;
@id("01a0f042b660738c8ffef72c18d57080") eq liquid_temperature:splitter.inlet.T==flash.liquid_temperature;
@id("01a0f042b660738c8ffef72daeb3feff") eq liquid_pressure:splitter.inlet.pressure==flash.liquid_pressure;
@id("01a0f042b660738c8ffef72e8e58f497") eq liquid_composition[j in components]:splitter.inlet.z[j]==flash.liquid_composition[j];
@id("01a0f042b660738c8ffef72f68485efa") eq recycle_flow:mixer.inlet[recycled].flow==splitter.flow[recycled];
@id("01a0f042b660738c8ffef730bf97c6ef") eq recycle_temperature:mixer.inlet[recycled].T==splitter.temperature;
@id("01a0f042b660738c8ffef7310fa8092e") eq recycle_pressure:mixer.inlet[recycled].pressure==splitter.pressure;
@id("01a0f042b660738c8ffef732fd5b2e47") eq recycle_composition[j in components]:mixer.inlet[recycled].z[j]==splitter.composition[recycled,j];
@id("01a0f04b2146776f9e058f9bf4821e89") eq loop_pressure:mixer.outlet.pressure==feed.pressure;
@id("01a0f042b660738c8ffef733e3fab052") eq flash_temperature_spec:heater.outlet.T==flash_temperature;
@id("01a0f042b660738c8ffef7348b00e616") eq heater_isobaric:heater.delta_pressure==0{Pa};
@id("01a0f042b660738c8ffef735a74b1e9a") eq adiabatic_flash:flash.heat==0{W};
@id("01a0f042b660738c8ffef736e2bf4d97") eq isobaric_flash:flash.delta_pressure==0{Pa};
@id("01a0f042b660738c8ffef737b6e8cce5") eq purge_fraction:splitter.split_total[purged]==purge;
@id("01a0f053c2807589b9b24cdf3a92e89f") accumulate overall[j in components]:ComponentFlow accounting tolerance 1e-7{mol/s};
@id("01a0f053c2807589b9b24ce0f90adaaf") contribute [j in components] overall[j] role inflow=feed.component_flow[j];
@id("01a0f053c2807589b9b24ce1f9b44029") contribute [j in components] overall[j] role outflow=flash.vapor_component_flow[j];
@id("01a0f053c2807589b9b24ce294e518a3") contribute [j in components] overall[j] role outflow=splitter.component_flow[purged,j];
@id("01a0f053c2807589b9b24ce40f579e61") annotation report flash.vapor_flow("vapor product");
@id("01a0f053c2807589b9b24ce535dd8351") annotation report mixer.inlet[recycled].flow("liquid recycle");
}
// The recycle torn at the fresh feed: the tear stage holds the recycle empty at the feed's
// temperature, pressure and composition, so the loop solves once through; the original
// specification then closes the recycle from that start.
@id("01a0f042b660738c8ffef718e014a1d0") def RecycleFlash(purge_fraction:Scalar=0.25,temperature:Temperature=368{K}):RecycleLoop {
@id("01a0f053c2807589b9b24ce64f6d1616") override param purge:Scalar=purge_fraction;
@id("01a0f053c2807589b9b24ce7d54a0389") override param flash_temperature:Temperature=temperature;
@id("01a0f042b660738c8ffef738c8c09b09") stage "tear" {
@id("01a0f042b660738c8ffef7394412dbc0") override eq recycle_flow:mixer.inlet[recycled].flow==0{mol/s};
@id("01a0f042b660738c8ffef73a81d37217") override eq recycle_temperature:mixer.inlet[recycled].T==feed.temperature;
@id("01a0f042b660738c8ffef73b44c11dda") override eq recycle_pressure:mixer.inlet[recycled].pressure==feed.pressure;
@id("01a0f042b660738c8ffef73c2c859469") override eq recycle_composition[j in components]:mixer.inlet[recycled].z[j]==feed.composition[j];
}
}
// A tear whose recycle temperature estimate, 500 K, lies above the 450 K upper bound of the
// BTIdeal states: its stage cannot be solved, while the original specification is that of
// RecycleFlash.
@id("01a0f053c2807589b9b24ce8ecb9eca4") def OverheatedTear:RecycleLoop {
@id("01a0f053c2807589b9b24ce94c7a1003") override param purge:Scalar=0.25;
@id("01a0f053c2807589b9b24ceadf737004") override param flash_temperature:Temperature=368{K};
@id("01a0f053c2807589b9b24cebe964d6ce") stage "overheated_tear" {
@id("01a0f053c2807589b9b24cec47e1d9f3") override eq recycle_flow:mixer.inlet[recycled].flow==0{mol/s};
@id("01a0f053c2807589b9b24ced0b455cf9") override eq recycle_temperature:mixer.inlet[recycled].T==500{K};
@id("01a0f053c2807589b9b24cee2b8a954d") override eq recycle_pressure:mixer.inlet[recycled].pressure==feed.pressure;
@id("01a0f053c2807589b9b24cef9eaa2b2e") override eq recycle_composition[j in components]:mixer.inlet[recycled].z[j]==feed.composition[j];
}
}
@id("01a0f04cffc170d5aad0ed18309baff9") entity kind feed_sample {}
@id("01a0f04cffc170d5aad0ed1949d95d6f") entity feed_sample cold_lean {}
@id("01a0f04cffc170d5aad0ed1a593da623") entity feed_sample saturated_equimolar {}
@id("01a0f04cffc170d5aad0ed1b1cc6975c") entity feed_sample warm_rich {}
@id("01a0f04cffc170d5aad0ed1cd55b8ccb") entity feed_sample vapor_rich {}
@id("01a0f04cffc170d5aad0ed1d359f2b8b") set feed_samples:Set<feed_sample>={cold_lean,saturated_equimolar,warm_rich,vapor_rich};
@id("01a0f04cffc170d5aad0ed1ef29e7306") table sampled_feed[s:feed_sample]:{flow:Flow,temperature:Temperature,benzene:MoleFraction} complete_over(s);
@id("01a0f04cffc170d5aad0ed1f32729c1d") dataset recycle_feeds:sampled_feed complete_over(s in feed_samples) provenance(campaign_references.sampled_recycle_feeds, provenance.Role.synthetic) {
[cold_lean]=[50{mol/s},300{K},0.45{1}];
[saturated_equimolar]=[1{mol/s},368{K},0.5{1}];
[warm_rich]=[20{mol/s},330{K},0.55{1}];
[vapor_rich]=[0.5{mol/s},400{K},0.6{1}];
}
@id("01a0f04cffc170d5aad0ed2013ba7b93") def RecycleFlashStudy {
@id("01a0f04cffc170d5aad0ed213d877c6e") child point[s in feed_samples]:RecycleFlash=RecycleFlash(purge_fraction=0.1);
@id("01a0f04cffc170d5aad0ed2257f8648b") eq feed_flow[s in feed_samples]:point[s].feed.state.flow==sampled_feed[s].flow;
@id("01a0f04cffc170d5aad0ed232ff419c6") eq feed_temperature[s in feed_samples]:point[s].feed.state.T==sampled_feed[s].temperature;
@id("01a0f04cffc170d5aad0ed24e0dd02ad") eq feed_pressure[s in feed_samples]:point[s].feed.state.pressure==101325{Pa};
@id("01a0f04cffc170d5aad0ed2506b359db") eq feed_benzene[s in feed_samples]:point[s].feed.state.z[chem.benzene]==sampled_feed[s].benzene;
@id("01a0f04cffc170d5aad0ed26d02938b7") eq feed_toluene[s in feed_samples]:point[s].feed.state.z[chem.toluene]==1{1}-sampled_feed[s].benzene;
}
// Four feeds from subcooled to superheated, 0.5 to 50 mol/s and 0.45 to 0.6 benzene, each
// through a 368 K, 101325 Pa flash whose liquid is 90 % recycled, solved from the model's
// start annotations and the tear stage alone (no value starts). With the recycle at up to
// 373 mol/s, the same study solved without the tear stage fails its original numerical
// acceptance at this revision. At steady state the vapor product is the equilibrium flash
// of the fresh feed: x and y are the flash's equilibrium phases at 368 K (the IDAES
// test_BTIdeal state), V/F is the lever rule and the recycle is 0.9 (F - V)/0.1. The
// package's 0.01 K bubble-point smoothing moves a flash that is 2 % vaporized (cold_lean)
// by 0.5 mK, so compositions compare within 1e-5 and flows within 5e-4 relative. The
// recycled liquid is saturated, so the derivative sample at the solution resolves that
// smoothing in its re-flash with a 1e-7 step, whose roundoff on the 1e5 W energy rows and
// truncation on the smoothing both stay below 1 %.
@id("01a0f053c2807589b9b24cf0b26a07c9") test recycle_flash_converges_from_defaults oracle campaign_references.analytic_recycle_flash fixture {dof 0; run initialized; stages("tear"); initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(600); policy { derivatives step(1e-7) tolerance(1e-2); }} {
@id("01a0f053c2807589b9b24cf1e6db2076") child root:RecycleFlashStudy=RecycleFlashStudy;
@id("01a0f053c2807589b9b24cf202b31e73") expect root.point[cold_lean].flash.vapor_composition[chem.benzene]==0.633977{1} tolerance 0.00001{1};
@id("01a0f053c2807589b9b24cf3b9a99eb9") expect root.point[cold_lean].flash.liquid_composition[chem.benzene]==0.412118{1} tolerance 0.00001{1};
@id("01a0f053c2807589b9b24cf4b5c93839") expect root.point[cold_lean].flash.vapor_flow==8.53742566{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f053c2807589b9b24cf5c1c7fbaa") expect root.point[cold_lean].mixer.inlet[recycled].flow==373.163169{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f053c2807589b9b24cf6c60e55b0") expect root.point[saturated_equimolar].flash.vapor_composition[chem.benzene]==0.633977{1} tolerance 0.00001{1};
@id("01a0f053c2807589b9b24cf78c453a65") expect root.point[saturated_equimolar].flash.liquid_composition[chem.benzene]==0.412118{1} tolerance 0.00001{1};
@id("01a0f053c2807589b9b24cf86af3e9f8") expect root.point[saturated_equimolar].flash.vapor_flow==0.396116832{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f053c2807589b9b24cf9911b7f09") expect root.point[saturated_equimolar].mixer.inlet[recycled].flow==5.43494852{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f053c28176ea84d8ee3dea45d640") expect root.point[warm_rich].flash.vapor_composition[chem.benzene]==0.633977{1} tolerance 0.00001{1};
@id("01a0f053c28176ea84d8ee3e5b21e575") expect root.point[warm_rich].flash.liquid_composition[chem.benzene]==0.412118{1} tolerance 0.00001{1};
@id("01a0f053c28176ea84d8ee3f30f1ec71") expect root.point[warm_rich].flash.vapor_flow==12.429703{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f053c28176ea84d8ee405e8561e9") expect root.point[warm_rich].mixer.inlet[recycled].flow==68.132673{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f053c28176ea84d8ee41685a64a0") expect root.point[vapor_rich].flash.vapor_composition[chem.benzene]==0.633977{1} tolerance 0.00001{1};
@id("01a0f053c28176ea84d8ee42c8e9d78d") expect root.point[vapor_rich].flash.liquid_composition[chem.benzene]==0.412118{1} tolerance 0.00001{1};
@id("01a0f053c28176ea84d8ee432bd7870f") expect root.point[vapor_rich].flash.vapor_flow==0.423426734{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f053c28176ea84d8ee440f2ba107") expect root.point[vapor_rich].mixer.inlet[recycled].flow==0.689159392{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f05b4c437594b6148a160c3a0a98") expect root.point[cold_lean].overall[chem.benzene]==0{mol/s} tolerance 0.000001{mol/s};
@id("01a0f05b4c437594b6148a179bd9f7ba") expect root.point[cold_lean].overall[chem.toluene]==0{mol/s} tolerance 0.000001{mol/s};
@id("01a0f05b4c437594b6148a18351142d7") expect root.point[saturated_equimolar].overall[chem.benzene]==0{mol/s} tolerance 0.000001{mol/s};
@id("01a0f05b4c437594b6148a19a163b002") expect root.point[saturated_equimolar].overall[chem.toluene]==0{mol/s} tolerance 0.000001{mol/s};
@id("01a0f05b4c437594b6148a1a620eec58") expect root.point[warm_rich].overall[chem.benzene]==0{mol/s} tolerance 0.000001{mol/s};
@id("01a0f05b4c437594b6148a1b5e526487") expect root.point[warm_rich].overall[chem.toluene]==0{mol/s} tolerance 0.000001{mol/s};
@id("01a0f05b4c437594b6148a1c135fb641") expect root.point[vapor_rich].overall[chem.benzene]==0{mol/s} tolerance 0.000001{mol/s};
@id("01a0f05b4c437594b6148a1d14dea77d") expect root.point[vapor_rich].overall[chem.toluene]==0{mol/s} tolerance 0.000001{mol/s};
}
// The overheated tear's stage fails, and the failure leaves the specification intact: the
// attempt commits nothing, and the unchanged specification, RecycleFlash's at the IDAES
// test_BTIdeal feed (1 mol/s, equimolar, 368 K, 101325 Pa) with a quarter purged, is solved
// from its own starts and answers to the same steady state.
@id("01a0f053f157702a825ee1acc5a50f11") test recycle_flash_failure_restores_specification oracle campaign_references.analytic_recycle_flash fixture {dof 0; run initialized; stages("overheated_tear"); initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(600); failure trial_rejected "modeling.qualification.rejected"; fix root.feed.state.flow=1{mol/s}; fix root.feed.state.T=368{K}; fix root.feed.state.pressure=101325{Pa}; fix root.feed.state.z[chem.benzene]=0.5{1}; fix root.feed.state.z[chem.toluene]=0.5{1};} {
@id("01a0f05f996477f09a4b59bf39131cec") child root:OverheatedTear=OverheatedTear;
@id("01a0f05f996477f09a4b59c0cd740ceb") expect root.flash.vapor_composition[chem.benzene]==0.633977{1} tolerance 0.00001{1};
@id("01a0f05f996477f09a4b59c1a7dff362") expect root.flash.liquid_composition[chem.benzene]==0.412118{1} tolerance 0.00001{1};
@id("01a0f05f996477f09a4b59c24aec69da") expect root.flash.vapor_flow==0.396116832{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f05f996477f09a4b59c362ff95ff") expect root.mixer.inlet[recycled].flow==1.81164951{mol/s} tolerance 0.000001{mol/s} relative 0.0005;
@id("01a0f05f996477f09a4b59c433047fe6") expect root.overall[chem.benzene]==0{mol/s} tolerance 0.000001{mol/s};
@id("01a0f05f996477f09a4b59c51c020a51") expect root.overall[chem.toluene]==0{mol/s} tolerance 0.000001{mol/s};
}
}
