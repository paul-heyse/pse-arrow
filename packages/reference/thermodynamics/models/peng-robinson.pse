@id("01a0e16f32a3739a874c126cc515f27f") package peng_robinson {
@id("15b3790224654c03b371661250d81f8c") use properties @"1.0.0";
@id("4362a717cefc4e6787f67e9b4532b147") use interactions @"1.0.0";

@id("01a0f14ead4e761899b3c3b0ab48ff1b") use constants @"1.0.0";
@id("67bf96b8ebf54a7aa4508c1519ba11f2") use cubic @"1.0.0";
@id("01a0ee04daaa77568ef4eee4aa5b3d82") use chemistry @"1.0.0";
@id("01a0e16f32a3739a874c126e9ed994cd") use caloric @"1.0.0";
@id("01a0e16f32a3739a874c126f267b5147") use pure_properties @"1.0.0";
@id("01a0e16f32a3739a874c127084b1b608") use helmholtz @"1.0.0";
@id("01a0e16f32a3739a874c1273be829596") fn attractive(t:Scalar,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->Scalar valid(t>0) = family.omega_a*helmholtz.reduced_gas_constant()^2*tc*tc/pc*(1+k*(1-sqrt(t/tc)))^2 where tc=cubic.selected_tc(pkg,j)/constants.temperature_scale,pc=cubic.selected_pc(pkg,j)/constants.pressure_unit,w=cubic.selected_omega(pkg,j),k=cubic.kappa[family,0]+cubic.kappa[family,1]*w+cubic.kappa[family,2]*w*w;
@id("01a0e16f32a3739a874c127454d61f81") fn covolume(j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->Scalar = family.omega_b*helmholtz.reduced_gas_constant()*(cubic.selected_tc(pkg,j)/constants.temperature_scale)/(cubic.selected_pc(pkg,j)/constants.pressure_unit);
@id("01a0e16f32a3739a874c12757f489c73") fn a_mix(t:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Scalar = sum(i in members | sum(j in members | n[i]*n[j]*sqrt(attractive(t,i,pkg,family)*attractive(t,j,pkg,family))*(1-interactions.selected_pair(pkg,cubic.binary_interaction,i,j))))/(sum(i in members | n[i]))^2;
@id("01a0e16f32a3739a874c12768b51c088") fn b_mix(n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Scalar = sum(i in members | n[i]*covolume(i,pkg,family))/sum(i in members | n[i]);
// These explicit coordinates retain the calibrated Kelvin and mol/m^3 conventions.
@id("3f1e7edb298d43fa92f5d5bc79101a86") coordinate map coordinates(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family) valid(T>constants.absolute_zero and V>0{m^3} and sum(j in members | n[j])>0{mol}) {
@id("f4633679c60d4dbe9c8bc6234dc90c6b") slot t=(T-constants.absolute_zero)/constants.temperature_scale;
@id("18b7bccbf8644a6c9c1d266711132822") slot r=(sum(j in members | n[j])/V)/constants.density_unit;
@id("d32891736b0c4152bab1c514b90adadb") slot n[j in members]=n[j]/constants.amount_unit;
}
@id("1796f24b48b448da8992399c73142dec") reconstruction residual for coordinates(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->ResidualHelmholtzEnergy reference helmholtz.residual_reference=sum(j in members | n[j])*constants.gas_constant*(T-constants.absolute_zero);
@id("495ac65472134debac921e60beb144c0") fn reduced_potential(t:Coordinate<coordinates.t>,r:Coordinate<coordinates.r>,n:Coordinate<coordinates.n>[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Reduced<residual> valid(t>0 and r>0 and b_mix(n,members,pkg,family)*r<1 and sum(j in members | n[j])>0 and sum(j in members | if n[j]>0 then 0 else 1)==0) = -log(1-b*r)-a/(sqrt(family.u^2-4*family.w)*b*helmholtz.reduced_gas_constant()*t)*log((1+((family.u+sqrt(family.u^2-4*family.w))/2)*b*r)/(1+((family.u-sqrt(family.u^2-4*family.w))/2)*b*r)) where a=a_mix(t,n,members,pkg,family),b=b_mix(n,members,pkg,family);
@id("01a0e16f32a3739a874c1277f7023238") fn potential(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->ResidualHelmholtzEnergy=reconstruct(residual,reduced_potential,T,V,n,members,pkg,family);
@id("01a0e16f32a3739a874c1278c0cab6b0") fn pressure_coordinate(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Scalar = helmholtz.reduced_gas_constant()*t*r/(1-b*r)-a*r*r/(1+family.u*b*r+family.w*b*b*r*r) where a=a_mix(t,n,members,pkg,family),b=b_mix(n,members,pkg,family);
@id("01a0eee77229746ba4feb33abae924be") fn compressibility_polynomial(t:Scalar,p:Scalar,z:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Scalar=z^3-(1+(1-family.u)*bb)*z^2+(aa+family.w*bb^2-family.u*bb-family.u*bb^2)*z-(aa*bb+family.w*bb^2+family.w*bb^3) where aa=a_mix(t,n,members,pkg,family)*p/(helmholtz.reduced_gas_constant()*t)^2,bb=b_mix(n,members,pkg,family)*p/(helmholtz.reduced_gas_constant()*t);
@id("01a0e17a4587742dba37029731f4b644") fn density_polynomial(t:Scalar,p:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Scalar=p*(1-b*r)*(1+family.u*b*r+family.w*b*b*r*r)-helmholtz.reduced_gas_constant()*t*r*(1+family.u*b*r+family.w*b*b*r*r)+a*r*r*(1-b*r) where a=a_mix(t,n,members,pkg,family),b=b_mix(n,members,pkg,family);
// Physical front door for the calibrated cubic density polynomial; its residual is a pressure difference.
@id("903507276277440c978631c9caa6a8ef") fn polynomial_pressure_scale()->DeltaPressure=1{Pa};
@id("994a6efae0704e2b921729d5d7598448") coordinate map density_root_coordinates(T:Temperature,P:Pressure,rho:Density,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family) valid(T>constants.absolute_zero and sum(i in members | n[i])>0{mol}) {
@id("d8fb048e36474565b885fca0a0f43b92") slot t=(T-constants.absolute_zero)/constants.temperature_scale;
@id("09e4487c3d3441e3a6c297a922ebee98") slot p=P/constants.pressure_unit;
@id("4d8d024debaa4ef399cd6bcb442d74de") slot r=rho/constants.density_unit;
@id("72fdb07335d04682830c84e740a1ebcf") slot n[i in members]=n[i]/constants.amount_unit;
}
@id("e13b4b49efc04d179f6f6b32ad49530e") reconstruction density_root_polynomial for density_root_coordinates(T:Temperature,P:Pressure,rho:Density,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->DeltaPressure reference helmholtz.residual_reference=polynomial_pressure_scale();
@id("0efcfe32a43747ae96d1fb03f374dae6") fn reduced_density_root_polynomial(t:Coordinate<density_root_coordinates.t>,p:Coordinate<density_root_coordinates.p>,r:Coordinate<density_root_coordinates.r>,n:Coordinate<density_root_coordinates.n>[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Reduced<density_root_polynomial>=density_polynomial(t,p,r,n,members,pkg,family);
@id("2b44308e5e0047f19a36f6802ae99a57") fn density_residual(T:Temperature,P:Pressure,rho:Density,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->DeltaPressure=reconstruct(density_root_polynomial,reduced_density_root_polynomial,T,P,rho,n,members,pkg,family);
@id("01a0e17a4587742dba37029883951354") interface DensityRoot extends helmholtz.HelmholtzPhase {
@id("510691c7f486481b8adfb3323137d850") param parameter_package:properties.property_package;
@id("8ec1580333bf4a60b35fa8ebb8388b66") param family:cubic.cubic_family=cubic.pr;
@id("7cb6ce8eaadc4827b8f349e78ef16970") param law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy;
@id("01a0e17a4587742dba3702994065516a") override param potential:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy=law;
@id("01a0e17a4587742dba37029a4515bbdd") var target_pressure:Pressure;
// Solver bounds and starts are numerical multipliers of the declared 1 mol/m^3 density reference.
@id("01a0e17a4587742dba37029b59248c6a") param density_lower:Scalar;
@id("01a0e17a4587742dba37029c88c8eb09") param density_upper:Scalar;
@id("01a0e17a4587742dba37029d8d49cec3") param density_start:Scalar;
@id("01a0e17a4587742dba37029e28827903") implicit density select operational(coordinate=density_start*constants.density_unit) settings("native.kinsol.v1") {
@id("01a0e17a4587742dba37029fb3c7f009") var coordinate:Density;
@id("01a0e17a4587742dba3702a03f57d8c1") eq residual:density_residual(T,target_pressure,coordinate,amount,components,parameter_package,family)==0{Pa};
@id("01a0e17a4587742dba3702a11464f97e") annotation start coordinate(density_start*constants.density_unit);
@id("01a0e17a4587742dba3702a2f5d0749a") annotation bounds coordinate(density_lower*constants.density_unit,density_upper*constants.density_unit);
@id("01a0e17a4587742dba3702a47a06a72d") annotation nominal coordinate(density_start*constants.density_unit);
@id("01a0e17a4587742dba3702a51fb460cd") annotation scale residual(inverseSum);
}
@id("01a0e17a4587742dba3702a657f77fb4") eq density_binding:rho==density.coordinate;
@id("01a0e17a4587742dba3702a74b2f5e34") annotation start rho(density_start*constants.density_unit);
@id("01a0e1b78065727b91c0d5d969c5a0c2") annotation nominal rho(density_start*constants.density_unit);
@id("01a0e17a4587742dba3702a3987c3535") annotation valid rho(density_lower*constants.density_unit,density_upper*constants.density_unit);
@id("01a0e17a4587742dba3702a8903e21fb") annotation check rho(abs(pressure-target_pressure)<0.001{Pa});
}
@id("01a0e17a4587742dba3702a9f82392ed") def InlineDensity(selected:Set<chemistry.species>,pkg:properties.property_package,law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy,selected_family:cubic.cubic_family=cubic.pr):DensityRoot {
@id("8418857723e746b9946cf293be59e3b6") override param parameter_package:properties.property_package=pkg;
@id("79d97708ac1048aa817abfa407ece2ab") override param family:cubic.cubic_family=selected_family;
@id("6deffdfb2f8945a592831e95510986e8") override param law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy=law;
@id("01a0e17a4587742dba3702aa65fbd99a") override param components:Set<chemistry.species>=selected;
@id("01a0e17a4587742dba3702ab9501bf52") realize density_policy on density using inline;
}
@id("01a0e17a4587742dba3702ac9a481616") def NestedDensity(selected:Set<chemistry.species>,pkg:properties.property_package,law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy,selected_family:cubic.cubic_family=cubic.pr):DensityRoot {
@id("d4ed63a5aa9644088d9b15dc412e6d57") override param parameter_package:properties.property_package=pkg;
@id("b2702de3397d4801acdb41afe2742c47") override param family:cubic.cubic_family=selected_family;
@id("ff8dbfe24aa64ceab4361f2ea501e47f") override param law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy=law;
@id("01a0e17a4587742dba3702addc2f0dbd") override param components:Set<chemistry.species>=selected;
@id("01a0e17a4587742dba3702ae26199736") realize density_policy on density using nested;
}
@id("01a0e17a4587742dba3702af08a837e4") def AcceleratedDensity(selected:Set<chemistry.species>,pkg:properties.property_package,law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy,selected_family:cubic.cubic_family=cubic.pr):DensityRoot {
@id("64118bd7f9054421a3937c20461008b6") override param parameter_package:properties.property_package=pkg;
@id("c84e74165e6a459cbd31ca658fcad190") override param family:cubic.cubic_family=selected_family;
@id("5615410937a248e6a4b58e70204027bc") override param law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy=law;
@id("01a0e17a4587742dba3702b04b49c8a0") override param components:Set<chemistry.species>=selected;
@id("01a0e17a4587742dba3702b1150c3137") realize density_policy on density using accelerated(cubic_roots);
}
@id("01a0e17fb4307404bb45616ed2b17342") fn delta_row(t:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->Scalar=2*sum(k in members | n[k]*sqrt(attractive(t,j,pkg,family)*attractive(t,k,pkg,family))*(1-interactions.selected_pair(pkg,cubic.binary_interaction,j,k)))/(sum(k in members | n[k])*a_mix(t,n,members,pkg,family));
@id("01a0e17fb4307404bb45616ff29b66e8") fn idaes_ln_phi(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->Scalar=bj/b*(z-1)-log(z*(1-b*r))-a/(sqrt(family.u^2-4*family.w)*b*helmholtz.reduced_gas_constant()*t)*(delta_row(t,n,members,j,pkg,family)-bj/b)*log((1+((family.u+sqrt(family.u^2-4*family.w))/2)*b*r)/(1+((family.u-sqrt(family.u^2-4*family.w))/2)*b*r)) where a=a_mix(t,n,members,pkg,family),b=b_mix(n,members,pkg,family),bj=covolume(j,pkg,family),z=pressure_coordinate(t,r,n,members,pkg,family)/(helmholtz.reduced_gas_constant()*t*r);
@id("01a0eef360b67582bfa3bbcff630701b") fn compressibility_ln_phi(t:Scalar,p:Scalar,z:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->Scalar=bj/b*(z-1)-log(z-bb)-aa/(sqrt(family.u^2-4*family.w)*bb)*(delta_row(t,n,members,j,pkg,family)-bj/b)*log((z+((family.u+sqrt(family.u^2-4*family.w))/2)*bb)/(z+((family.u-sqrt(family.u^2-4*family.w))/2)*bb)) where b=b_mix(n,members,pkg,family),bj=covolume(j,pkg,family),aa=a_mix(t,n,members,pkg,family)*p/(helmholtz.reduced_gas_constant()*t)^2,bb=b*p/(helmholtz.reduced_gas_constant()*t);
// The dimensionless compressibility unknown is already a lawful neutral coordinate.
@id("c5b6ed07c45346a6a04c04bdb6fc3af1") coordinate map compressibility_root_coordinates(T:Temperature,P:Pressure,z:Scalar,n:MoleFraction[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family) valid(T>constants.absolute_zero and P>0{Pa}) {
@id("33d7a111b8a349eba74a0603206a06f5") slot t=(T-constants.absolute_zero)/constants.temperature_scale;
@id("aa9a26caad494ca5b49cba32bc330a13") slot p=P/constants.pressure_unit;
@id("8e19c903d4464d748f8c24c94b83fffe") slot compressibility=z;
@id("5b389262c734460f95b9b74678a2978f") slot n[i in members]=n[i]/compressibility_fraction_unit();
}
@id("5813f29c28994091a5ee81b536a9519c") reconstruction compressibility_root_polynomial for compressibility_root_coordinates(T:Temperature,P:Pressure,z:Scalar,n:MoleFraction[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Scalar reference helmholtz.residual_reference=1;
@id("ff795ea50a0943f99e9d5594d7723d97") fn reduced_compressibility_root_polynomial(t:Coordinate<compressibility_root_coordinates.t>,p:Coordinate<compressibility_root_coordinates.p>,compressibility:Coordinate<compressibility_root_coordinates.compressibility>,n:Coordinate<compressibility_root_coordinates.n>[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Reduced<compressibility_root_polynomial>=compressibility_polynomial(t,p,compressibility,n,members,pkg,family);
@id("ee33eaf9a5444fa1930075a5bc02dfb6") fn compressibility_residual(T:Temperature,P:Pressure,z:Scalar,n:MoleFraction[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package,family:cubic.cubic_family)->Scalar=reconstruct(compressibility_root_polynomial,reduced_compressibility_root_polynomial,T,P,z,n,members,pkg,family);
// Physical temperature, pressure and composition for the ordered-row compressibility convention.
@id("e188851ce67e4c61b37d0a6f951121ac") fn compressibility_fraction_unit()->MoleFraction=1{1};
@id("48b130c1ba21421a986fdc60f1e9e02d") coordinate map compressibility_coordinates(T:Temperature,P:Pressure,z:Scalar,n:MoleFraction[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family) valid(T>constants.absolute_zero and P>0{Pa} and z>0) {
@id("4c135f0401b94aa2b2ba6bb73d7c283f") slot t=(T-constants.absolute_zero)/constants.temperature_scale;
@id("f96483164f5b429a9e3d5ff9fbe227af") slot p=P/constants.pressure_unit;
@id("f67a68ad10934b7bb349a9371cb6045c") slot compressibility=z;
@id("3d50f6f2a1a44a18ba439b93bb40621b") slot n[i in members]=n[i]/compressibility_fraction_unit();
}
@id("5ec8dde5e3b94af0b6c49a1f203b53d5") reconstruction compressibility_fugacity for compressibility_coordinates(T:Temperature,P:Pressure,z:Scalar,n:MoleFraction[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->LogFugacityCoefficient reference helmholtz.residual_reference=1;
@id("cd00373beff849b3be3f5d7e8c84f6d3") fn reduced_compressibility_fugacity(t:Coordinate<compressibility_coordinates.t>,p:Coordinate<compressibility_coordinates.p>,compressibility:Coordinate<compressibility_coordinates.compressibility>,n:Coordinate<compressibility_coordinates.n>[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->Reduced<compressibility_fugacity>=compressibility_ln_phi(t,p,compressibility,n,members,j,pkg,family);
@id("a025f5e7b12249378289dbe803624c6b") fn compressibility_fugacity_response(T:Temperature,P:Pressure,z:Scalar,n:MoleFraction[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->LogFugacityCoefficient=reconstruct(compressibility_fugacity,reduced_compressibility_fugacity,T,P,z,n,members,j,pkg,family);
// Explicit physical wrapper for the independent ordered-row cubic convention.
@id("3df98186c04c490a8e9459e482aa63eb") coordinate map ordered_coordinates(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family) valid(T>constants.absolute_zero and V>0{m^3} and sum(i in members | n[i])>0{mol}) {
@id("933999a7ac57440ea9d95d296a2cb4cb") slot t=(T-constants.absolute_zero)/constants.temperature_scale;
@id("30eeb6b2aff94bb5bdfebedc7c665882") slot r=(sum(i in members | n[i])/V)/constants.density_unit;
@id("c08bae8ed9f74be0b3f7caec815baebd") slot n[i in members]=n[i]/constants.amount_unit;
}
@id("c8023bf8db204e5592e0d003af62cf4b") reconstruction ordered_fugacity for ordered_coordinates(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->LogFugacityCoefficient reference helmholtz.residual_reference=1;
@id("094d3e99c2b247d0b9be1a2d1f4f4cea") fn reduced_ordered_fugacity(t:Coordinate<ordered_coordinates.t>,r:Coordinate<ordered_coordinates.r>,n:Coordinate<ordered_coordinates.n>[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->Reduced<ordered_fugacity>=idaes_ln_phi(t,r,n,members,j,pkg,family);
@id("1049fd85acb4454999578b602187de6f") fn ordered_fugacity_response(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package,family:cubic.cubic_family)->LogFugacityCoefficient=reconstruct(ordered_fugacity,reduced_ordered_fugacity,T,V,n,members,j,pkg,family);
@id("01a0e17fb4307404bb4561704fec4bb4") interface IdaesDeltaPhase extends helmholtz.HelmholtzPhase {
@id("61cbf84a4e25403cb747f1a32325140e") param parameter_package:properties.property_package;
@id("a868558dba0a40378f8d857f92579453") param family:cubic.cubic_family=cubic.pr;
@id("92f802bbaa69415da149ecc56c16cb78") param law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy;
@id("01a0e17fb4307404bb4561718f09f6a3") override param potential:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy=law;
@id("01a0e17fb4307404bb45617215c75611") override let ln_phi[j in components]:LogFugacityCoefficient=ordered_fugacity_response(T,volume,amount,components,j,parameter_package,family);
}
