@id("01a0e178d29871ca9ccbc6ffbcd0f2db") package pcsaft {
@id("01a0ee04daaa77568ef4eee37defb8f3") use chemistry @"1.0.0";
@id("01a0e178d29871ca9ccbc70157b0176e") use caloric @"1.0.0";
@id("01a0ef5fa28670bab2c02c74827ebeb9") use provenance @"1.0.0";
// The nonassociating PC-SAFT equation of state; its dispersion constants are this paper's.
@id("01a0ef5fa28670bab2c02c75d6d53f39") entity provenance.publication gross_sadowski_2001 { title = "Perturbed-Chain SAFT: An Equation of State Based on a Perturbation Theory for Chain Molecules (Gross and Sadowski), Industrial & Engineering Chemistry Research 40, 1244-1260", year = 2001, doi = Id<provenance.doi>("10.1021/ie0003887") }
@id("01a0e178d29871ca9ccbc70251ebee9d") table segments[j:chemistry.species]:{m:Scalar,sigma_angstrom:Scalar,epsilon:TemperatureScale} complete_over(j);
@id("01a0e178d29871ca9ccbc7039c2837c3") table interaction[i:chemistry.species,j:chemistry.species]:Scalar complete_over(i,j);
@id("01a0e178d29871ca9ccbc70459973946") entity kind polynomial_term {}
@id("01a0e178d29871ca9ccbc705e130cc62") entity polynomial_term p0 {}
@id("01a0e178d29871ca9ccbc706f86a7646") entity polynomial_term p1 {}
@id("01a0e178d29871ca9ccbc707720356c0") entity polynomial_term p2 {}
@id("01a0e178d29871ca9ccbc7085140a73a") entity polynomial_term p3 {}
@id("01a0e178d29871ca9ccbc7099cddbc08") entity polynomial_term p4 {}
@id("01a0e178d29871ca9ccbc70a843a6e37") entity polynomial_term p5 {}
@id("01a0e178d29871ca9ccbc70b4f7a7bff") entity polynomial_term p6 {}
@id("01a0e178d29871ca9ccbc70c9f4bc6b8") set powers:Set<polynomial_term>={p0,p1,p2,p3,p4,p5,p6};
@id("01a0e178d29871ca9ccbc70d9351cd23") table dispersion_coefficients[k:polynomial_term]:{power:Scalar,a0:Scalar,a1:Scalar,a2:Scalar,b0:Scalar,b1:Scalar,b2:Scalar} complete_over(k in powers);
@id("01a0e178d29871ca9ccbc70e51716b38") dataset gross_sadowski:dispersion_coefficients provenance(gross_sadowski_2001, provenance.Role.published) {
[p0]=[0,0.91056314451539,-0.3084016918272,-0.09061483509767,0.72409469413165,-0.5755498075345,0.09768831158356];
[p1]=[1,0.63612814494991,0.18605311591713,0.4527842806392,2.2382791860938,0.69950955214436,-0.255757498161];
[p2]=[2,2.68613478913903,-2.50300472586548,0.59627007280101,-4.00258494846342,3.89256733895307,-9.15585615297321];
[p3]=[3,-26.5473624914884,21.4197936296668,-1.72418291311787,-21.00357681484648,-17.21547164777212,20.64207597439724];
[p4]=[4,97.7592087835073,-65.2558853303492,-4.13021125311661,26.8556413626615,192.6722644652495,-38.80443005206285];
[p5]=[5,-159.5915408656,83.3186804808856,13.7766318697211,206.5513384066188,-161.8264616487648,93.6267740770146];
[p6]=[6,91.2977740839123,-33.7469229297323,-8.67284703679646,-355.60235612207947,-165.2076934555607,-29.66690558514725];
}
@id("01a0e178d29871ca9ccbc70f9786cf12") fn pi()->Scalar=3.1415926535897932384626433832795;
@id("01a0e178d29871ca9ccbc71004f6a928") fn molecular_density(r:Scalar)->Scalar=r*6.02214076e-7;
@id("01a0e178d29871ca9ccbc711c2a85eeb") fn diameter(t:Scalar,j:chemistry.species)->Scalar=segments[j].sigma_angstrom*(1-0.12*exp(-3*(segments[j].epsilon/caloric.kelvin())/t));
@id("01a0e178d29871ca9ccbc712d88170e2") fn mean_segments(n:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=sum(j in members | n[j]*segments[j].m)/sum(j in members | n[j]);
@id("01a0e178d29871ca9ccbc713b0771902") fn moment(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,k:Scalar)->Scalar=pi()/6*molecular_density(r)*sum(j in members | n[j]*segments[j].m*diameter(t,j)^k)/sum(j in members | n[j]);
@id("01a0e178d29871ca9ccbc714ff477ce4") fn hard_sphere(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=6/(pi()*molecular_density(r))*(3*z1*z2/(1-z3)+z2^3/(z3*(1-z3)^2)+(z2^3/z3^2-z0)*log(1-z3)) where z0=moment(t,r,n,members,0),z1=moment(t,r,n,members,1),z2=moment(t,r,n,members,2),z3=moment(t,r,n,members,3);
@id("01a0e178d29871ca9ccbc715e7434513") fn contact(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,j:chemistry.species)->Scalar=1/(1-z3)+1.5*d*z2/(1-z3)^2+0.5*d*d*z2*z2/(1-z3)^3 where d=diameter(t,j),z2=moment(t,r,n,members,2),z3=moment(t,r,n,members,3);
@id("01a0e178d29871ca9ccbc71679d8e782") fn hard_chain(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=hard_sphere(t,r,n,members)-sum(j in members | n[j]*(segments[j].m-1)*log(contact(t,r,n,members,j)))/sum(j in members | n[j]);
@id("01a0e178d29871ca9ccbc7173413b738") fn integral_one(eta:Scalar,m:Scalar)->Scalar=sum(k in powers | (dispersion_coefficients[k].a0+(m-1)/m*dispersion_coefficients[k].a1+(m-1)*(m-2)/(m*m)*dispersion_coefficients[k].a2)*eta^dispersion_coefficients[k].power);
@id("01a0e178d29871ca9ccbc718e02b1137") fn integral_two(eta:Scalar,m:Scalar)->Scalar=sum(k in powers | (dispersion_coefficients[k].b0+(m-1)/m*dispersion_coefficients[k].b1+(m-1)*(m-2)/(m*m)*dispersion_coefficients[k].b2)*eta^dispersion_coefficients[k].power);
@id("01a0e178d29871ca9ccbc719b560043e") fn compressibility_factor(eta:Scalar,m:Scalar)->Scalar=1/(1+m*(8*eta-2*eta^2)/(1-eta)^4+(1-m)*(20*eta-27*eta^2+12*eta^3-2*eta^4)/((1-eta)*(2-eta))^2);
@id("01a0e178d29871ca9ccbc71a1f0df014") fn pair_energy(t:Scalar,i:chemistry.species,j:chemistry.species)->Scalar=sqrt((segments[i].epsilon/caloric.kelvin())*(segments[j].epsilon/caloric.kelvin()))*(1-interaction[i,j])/t;
@id("01a0e178d29871ca9ccbc71bb828b13a") fn pair_size(i:chemistry.species,j:chemistry.species)->Scalar=((segments[i].sigma_angstrom+segments[j].sigma_angstrom)/2)^3;
@id("01a0e178d29871ca9ccbc71c1cf81175") fn dispersion(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=-pi()*molecular_density(r)*(2*integral_one(eta,m)*e1+m*compressibility_factor(eta,m)*integral_two(eta,m)*e2) where eta=moment(t,r,n,members,3),m=mean_segments(n,members),total=sum(j in members | n[j]),e1=sum(i in members | sum(j in members | n[i]*n[j]*segments[i].m*segments[j].m*pair_size(i,j)*pair_energy(t,i,j)))/(total*total),e2=sum(i in members | sum(j in members | n[i]*n[j]*segments[i].m*segments[j].m*pair_size(i,j)*pair_energy(t,i,j)^2))/(total*total);
@id("01a0e178d29871ca9ccbc71d66cc95d6") fn potential(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar valid(t>0 and r>0 and sum(j in members | n[j])>0 and sum(j in members | if n[j]>0 and segments[j].m>=1 and segments[j].sigma_angstrom>0 and segments[j].epsilon/caloric.kelvin()>0 then 0 else 1)==0 and moment(t,r,n,members,3)<1)=hard_chain(t,r,n,members)+dispersion(t,r,n,members);
}
