@id("01a0e178d29871ca9ccbc6ffbcd0f2db") package pcsaft {
@id("1ab97bf74167427bb8f542fe6d8200a6") use helmholtz @"1.0.0";
@id("4751203b1df043d6ad284f5d97b1a0bd") use interactions @"1.0.0";

@id("01a0f18b7a38765da908148799c2d1b9") use references @"1.0.0";
@id("01a0f1868dd475edadc0e45f9782758f") use compatibility @"1.0.0";
@id("01a0f1868dd475edadc0e45ebbd50009") use pcsaft_parameters @"1.0.0";
@id("01a0f1868dd475edadc0e45de1a89fe9") use properties @"1.0.0";
@id("01a0f14ead4e761899b3c3ad03d21ccd") use constants @"1.0.0";
@id("01a0ee04daaa77568ef4eee37defb8f3") use chemistry @"1.0.0";
@id("01a0e178d29871ca9ccbc70157b0176e") use caloric @"1.0.0";
@id("01a0ef5fa28670bab2c02c74827ebeb9") use provenance @"1.0.0";
// The nonassociating PC-SAFT equation of state; its dispersion constants are this paper's.
@id("01a0e178d29871ca9ccbc70c9f4bc6b8") set powers:Set<Integer>={6,5,4,3,2,1,0};
@id("01a0e178d29871ca9ccbc70d9351cd23") table dispersion_coefficients[k:0..6]:{a0:Scalar,a1:Scalar,a2:Scalar,b0:Scalar,b1:Scalar,b2:Scalar} complete_over(k in 0..6);
@id("01a0e178d29871ca9ccbc70e51716b38") dataset gross_sadowski:dispersion_coefficients provenance(references.gross_sadowski_2001, provenance.Role.published) {
[0]=[0.91056314451539,-0.3084016918272,-0.09061483509767,0.72409469413165,-0.5755498075345,0.09768831158356];
[1]=[0.63612814494991,0.18605311591713,0.4527842806392,2.2382791860938,0.69950955214436,-0.255757498161];
[2]=[2.68613478913903,-2.50300472586548,0.59627007280101,-4.00258494846342,3.89256733895307,-9.15585615297321];
[3]=[-26.5473624914884,21.4197936296668,-1.72418291311787,-21.00357681484648,-17.21547164777212,20.64207597439724];
[4]=[97.7592087835073,-65.2558853303492,-4.13021125311661,26.8556413626615,192.6722644652495,-38.80443005206285];
[5]=[-159.5915408656,83.3186804808856,13.7766318697211,206.5513384066188,-161.8264616487648,93.6267740770146];
[6]=[91.2977740839123,-33.7469229297323,-8.67284703679646,-355.60235612207947,-165.2076934555607,-29.66690558514725];
}
@id("01a0e178d29871ca9ccbc71004f6a928") fn molecular_density(r:Scalar)->Scalar=r*(constants.avogadro/constants.reciprocal_amount_unit)*(constants.segment_length/constants.length_unit)^3;
@id("01a0e178d29871ca9ccbc711c2a85eeb") fn diameter(t:Scalar,j:chemistry.species,pkg:properties.property_package)->Scalar=(segment_sigma(pkg,j)/constants.segment_length)*(1-0.12*exp(-3*(segment_epsilon(pkg,j)/constants.temperature_scale)/t));
@id("01a0e178d29871ca9ccbc712d88170e2") fn mean_segments(n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package)->Scalar=sum(j in members | n[j]*segment_m(pkg,j))/sum(j in members | n[j]);
@id("01a0e178d29871ca9ccbc713b0771902") fn moment(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,k:Scalar,pkg:properties.property_package)->Scalar=constants.pi/6*molecular_density(r)*sum(j in members | n[j]*segment_m(pkg,j)*diameter(t,j,pkg)^k)/sum(j in members | n[j]);
@id("01a0e178d29871ca9ccbc714ff477ce4") fn hard_sphere(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package)->Scalar=6/(constants.pi*molecular_density(r))*(3*z1*z2/(1-z3)+z2^3/(z3*(1-z3)^2)+(z2^3/z3^2-z0)*log(1-z3)) where z0=moment(t,r,n,members,0,pkg),z1=moment(t,r,n,members,1,pkg),z2=moment(t,r,n,members,2,pkg),z3=moment(t,r,n,members,3,pkg);
@id("01a0e178d29871ca9ccbc715e7434513") fn contact(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,j:chemistry.species,pkg:properties.property_package)->Scalar=1/(1-z3)+1.5*d*z2/(1-z3)^2+0.5*d*d*z2*z2/(1-z3)^3 where d=diameter(t,j,pkg),z2=moment(t,r,n,members,2,pkg),z3=moment(t,r,n,members,3,pkg);
@id("01a0e178d29871ca9ccbc71679d8e782") fn hard_chain(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package)->Scalar=hard_sphere(t,r,n,members,pkg)-sum(j in members | n[j]*(segment_m(pkg,j)-1)*log(contact(t,r,n,members,j,pkg)))/sum(j in members | n[j]);
@id("01a0e178d29871ca9ccbc7173413b738") fn integral_one(eta:Scalar,m:Scalar)->Scalar=fold(acc,value; k in powers | dispersion_coefficients[k].a0+(m-1)/m*dispersion_coefficients[k].a1+(m-1)*(m-2)/(m*m)*dispersion_coefficients[k].a2; acc*eta+value);
@id("01a0e178d29871ca9ccbc718e02b1137") fn integral_two(eta:Scalar,m:Scalar)->Scalar=fold(acc,value; k in powers | dispersion_coefficients[k].b0+(m-1)/m*dispersion_coefficients[k].b1+(m-1)*(m-2)/(m*m)*dispersion_coefficients[k].b2; acc*eta+value);
@id("01a0e178d29871ca9ccbc719b560043e") fn compressibility_factor(eta:Scalar,m:Scalar)->Scalar=1/(1+m*(8*eta-2*eta^2)/(1-eta)^4+(1-m)*(20*eta-27*eta^2+12*eta^3-2*eta^4)/((1-eta)*(2-eta))^2);
@id("01a0e178d29871ca9ccbc71a1f0df014") fn pair_energy(t:Scalar,i:chemistry.species,j:chemistry.species,pkg:properties.property_package)->Scalar=sqrt((segment_epsilon(pkg,i)/constants.temperature_scale)*(segment_epsilon(pkg,j)/constants.temperature_scale))*(1-interactions.pair_parameter(pkg,pcsaft_parameters.binary_interaction,i,j))/t;
@id("01a0e178d29871ca9ccbc71bb828b13a") fn pair_size(i:chemistry.species,j:chemistry.species,pkg:properties.property_package)->Scalar=(((segment_sigma(pkg,i)/constants.segment_length)+(segment_sigma(pkg,j)/constants.segment_length))/2)^3;
@id("01a0e178d29871ca9ccbc71c1cf81175") fn dispersion(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package)->Scalar=-constants.pi*molecular_density(r)*(2*integral_one(eta,m)*e1+m*compressibility_factor(eta,m)*integral_two(eta,m)*e2) where eta=moment(t,r,n,members,3,pkg),m=mean_segments(n,members,pkg),total=sum(j in members | n[j]),e1=sum(i in members | sum(j in members | n[i]*n[j]*segment_m(pkg,i)*segment_m(pkg,j)*pair_size(i,j,pkg)*pair_energy(t,i,j,pkg)))/(total*total),e2=sum(i in members | sum(j in members | n[i]*n[j]*segment_m(pkg,i)*segment_m(pkg,j)*pair_size(i,j,pkg)*pair_energy(t,i,j,pkg)^2))/(total*total);
// These explicit coordinates retain the calibrated Kelvin and mol/m^3 conventions.
@id("d0d1709a91804f1191c0a01647d99df0") coordinate map coordinates(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package) valid(T>constants.absolute_zero and V>0{m^3} and sum(j in members | n[j])>0{mol}) {
@id("c9429e3bbd5c478ead0045a4ab7a1380") slot t=(T-constants.absolute_zero)/constants.temperature_scale;
@id("3c59b72b72c94460b287d512ae1f50df") slot r=(sum(j in members | n[j])/V)/constants.density_unit;
@id("5aa85d3fd05142b28ffe079136ff8340") slot n[j in members]=n[j]/constants.amount_unit;
}
@id("701aa77065f34f8eb6eedce861dc2511") reconstruction residual for coordinates(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package)->ResidualHelmholtzEnergy reference helmholtz.residual_reference=sum(j in members | n[j])*constants.gas_constant*(T-constants.absolute_zero);
@id("d8ed22bdbe2248f78152b6644b0cfff0") fn reduced_potential(t:Coordinate<coordinates.t>,r:Coordinate<coordinates.r>,n:Coordinate<coordinates.n>[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package)->Reduced<residual> valid(t>0 and r>0 and sum(j in members | n[j])>0 and sum(j in members | if n[j]>0 and segment_m(pkg,j)>=1 and (segment_sigma(pkg,j)/constants.segment_length)>0 and segment_epsilon(pkg,j)/constants.temperature_scale>0 then 0 else 1)==0 and moment(t,r,n,members,3,pkg)<1)=hard_chain(t,r,n,members,pkg)+dispersion(t,r,n,members,pkg);
@id("01a0e178d29871ca9ccbc71d66cc95d6") fn potential(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>,pkg:properties.property_package)->ResidualHelmholtzEnergy=reconstruct(residual,reduced_potential,T,V,n,members,pkg);
@id("01a0f18777e9763b85954cf02da518fd") fn segment_m(pkg:properties.property_package,j:chemistry.species)->Scalar=c.m where s=properties.selection[pkg,j,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase],c=pcsaft_parameters.nonassociating[s.subject,s.property,s.phase_type,s.source,s.variant];
@id("01a0f18777e9763b85954cf165d2cf81") fn segment_sigma(pkg:properties.property_package,j:chemistry.species)->Length=c.sigma where s=properties.selection[pkg,j,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase],c=pcsaft_parameters.nonassociating[s.subject,s.property,s.phase_type,s.source,s.variant];
@id("01a0f18777e9763b85954cf24097f9fb") fn segment_epsilon(pkg:properties.property_package,j:chemistry.species)->TemperatureScale=c.epsilon where s=properties.selection[pkg,j,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase],c=pcsaft_parameters.nonassociating[s.subject,s.property,s.phase_type,s.source,s.variant];
}
