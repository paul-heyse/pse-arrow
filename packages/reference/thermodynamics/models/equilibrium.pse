@id("01a0e18b78db742e8fd36e110ff14989") package equilibrium {
@id("01a0e18b78db742e8fd36e12a3f932aa") use kinds @"1.0.0";
@id("01a0e18b78db742e8fd36e1308c99e5c") use math @"1.0.0";
@id("01a0e18b78db742e8fd36e14a5a5f8b3") use caloric @"1.0.0";
@id("01a0e18b78db742e8fd36e155522a7b8") use pure_properties @"1.0.0";
@id("c1ac28b6694144a890b9854d887fa26c") entity kinds.phase liquid {}
@id("c2e7b1a320d24eb482bfb7301782f55c") entity kinds.phase vapor {}
@id("74a301a092ad413bb5de501ccd67ffb5") fn pressure_difference_unit()->DeltaPressure=1{Pa};
@id("56a9a222e4c048fc8c76aa9017ae3413") fn component_flow_unit()->ComponentFlow=1{mol/s};
@id("4695e4aa4fc843eba60c3a122a932b9c") fn flow_unit()->Flow=1{mol/s};
@id("01a0e18b78db742e8fd36e16de242b6d") fn fraction_unit()->MoleFraction=1{1};
@id("01a0e1ad3a7f706c8439ef48ad021285") fn log_fugacity(x:MoleFraction,pure_fugacity:Pressure)->Scalar=log(x/fraction_unit())+log(pure_fugacity/pure_properties.pressure_unit());
@id("01a0e18b78db742e8fd36e17b5a6be89") interface MaterialState {
@id("01a0e1db89d8722baac398bf7f110f21") param defined:Boolean=true;
@id("01a0e18b78db742e8fd36e18c7e3ae74") param components:Set<kinds.species>;
@id("01a0e18b78db742e8fd36e19bdd385fa") var flow:Flow;
@id("01a0e18b78db742e8fd36e1ad23fe387") var T:Temperature;
@id("01a0e18b78db742e8fd36e1b607f0363") var pressure:Pressure;
@id("01a0e18b78db742e8fd36e1c320e73d7") var z[j in components]:MoleFraction;
@id("01a0e18b78db742e8fd36e1d1a2ebc35") let component_flow[j in components]:ComponentFlow=flow*z[j];
@id("01a0e18b78db742e8fd36e1e9159c2a3") annotation check flow(sum(j in components | z[j]/fraction_unit())>0.999999999 and sum(j in components | z[j]/fraction_unit())<1.000000001);
}
@id("01a0e18b78db742e8fd36e1f842113bb") interface PhaseEquilibrium extends MaterialState {
@id("01a0e18b78db742e8fd36e20f8c8a417") var beta:Scalar;
@id("01a0e18b78db742e8fd36e216dfd5b70") var x[j in components]:MoleFraction;
@id("01a0e18b78db742e8fd36e228dcd14f1") var y[j in components]:MoleFraction;
@id("01a0e18b78db742e8fd36e233ed51e39") let liquid_flow:Flow=(1-beta)*flow;
@id("01a0e18b78db742e8fd36e24c142a79c") let vapor_flow:Flow=beta*flow;
@id("01a0e18b78db742e8fd36e25a404b206") eq material[j in components]:z[j]==(1-beta)*x[j]+beta*y[j];
@id("01a0e18b78db742e8fd36e2626c216bb") eq normalization:sum(j in components | x[j]/fraction_unit()-y[j]/fraction_unit())==0;
@id("01a0e18b78db742e8fd36e27eec651b9") annotation bounds beta(0,1);
}
@id("01a0e19bbec57004aabdabb7c9c21b4c") fn rr_correction(beta:Scalar,z:Scalar[kinds.species],k:Scalar[kinds.species],members:Set<kinds.species>)->Scalar=math.smooth_min(math.smooth_max(beta+sum(j in members | z[j]*(k[j]-1)/(1+beta*(k[j]-1)))/(1e-12+sum(j in members | z[j]*((k[j]-1)/(1+beta*(k[j]-1)))^2)),1e-6,1e-8),1-1e-6,1e-8);
@id("01a0e19bbec57004aabdabb8cc497025") fn rr_start(z:Scalar[kinds.species],k:Scalar[kinds.species],members:Set<kinds.species>)->Scalar=b4 where b1=rr_correction(0.5,z,k,members),b2=rr_correction(b1,z,k,members),b3=rr_correction(b2,z,k,members),b4=rr_correction(b3,z,k,members);
@id("01a0e18b78db742e8fd36e2bee937544") interface SmoothVLE extends PhaseEquilibrium {
@id("c78288d9ac944248b95e8133adacf980") annotation start z(fraction_unit()/sum(k in components | 1));
@id("7c9064ecb449498d8278067dc15a92d2") annotation start flow(1{mol/s});
@id("de0703f8b8e0419681c510639643409f") annotation nominal flow(1{mol/s});
@id("af3429ed9fcc44e5b34a5db85c84dff1") annotation start pressure(101325{Pa});
@id("14c1ef845f4b499db7fcd049ad58f2b9") annotation nominal pressure(101325{Pa});
@id("1f6c53319c984704991232530986a8bb") when not defined {
@id("ad2227891b654485affe11e369645c7f") eq total_composition:sum(j in components | z[j]/fraction_unit())==1;
}
@id("01a0e18b78db742e8fd36e2c0210b39b") param psat:Fn(T:Temperature,j:kinds.species)->Pressure;
@id("01a0e18b78db742e8fd36e2da45dba88") param epsilon_bubble:DeltaTemperature=0.01{K};
@id("01a0e18b78db742e8fd36e2e58e91c8d") param epsilon_dew:DeltaTemperature=0.0005{K};
@id("01a0e18c398b741fafbe644758157fe0") param minimum_temperature:Temperature;
@id("01a0e18c398b741fafbe644819d88985") param maximum_temperature:Temperature;
@id("01a0e18c398b741fafbe6449b3efa879") param bubble_start:Temperature;
@id("01a0e18c398b741fafbe644af66b3833") param dew_start:Temperature;
@id("01a0e18b78db742e8fd36e2f9415a08c") var bubble:Temperature;
@id("01a0e18b78db742e8fd36e30344c517f") var dew:Temperature;
@id("01a0e18b78db742e8fd36e310fe29b12") var equilibrium_temperature:Temperature;
@id("01a0e18b78db742e8fd36e326c35c691") eq bubble_point:sum(j in components | z[j]/fraction_unit()*(psat(bubble,j)/pure_properties.pressure_unit()))==pressure/pure_properties.pressure_unit();
@id("01a0e18b78db742e8fd36e33e2347c1d") eq dew_point:sum(j in components | z[j]/fraction_unit()*(pressure/psat(dew,j)))==1;
@id("01a0e18b78db742e8fd36e34de742536") eq equilibrium_temperature_binding:equilibrium_temperature==math.smooth_min(math.smooth_max(T,bubble,epsilon_bubble),dew,epsilon_dew);
@id("01a0e19bbec57004aabdabb974cf6de8") let initial_K[j in components]:Scalar=psat(T,j)/pressure;
@id("01a0e19bbec57004aabdabbaf609bbbc") let feed_fraction[j in components]:Scalar=z[j]/fraction_unit();
@id("01a0e19bbec57004aabdabbbefc8fcc7") let initial_beta:Scalar=rr_start(feed_fraction,initial_K,components);
@id("01a0e19bbec57004aabdabbcec335c91") annotation start beta(initial_beta);
@id("01a0e19bbec57004aabdabbd2818eb29") annotation start x(z[j]/(1+initial_beta*(initial_K[j]-1)));
@id("01a0e19bbec57004aabdabbed9637e88") annotation start y(initial_K[j]*z[j]/(1+initial_beta*(initial_K[j]-1)));
@id("01a0e19bbec57004aabdabbf35dd4566") annotation bounds x(0.0000000001{1},1{1});
@id("01a0e19bbec57004aabdabc0180b134b") annotation bounds y(0.0000000001{1},1{1});
@id("01a0e18b78db742e8fd36e352667ac39") eq fugacity[j in components]:log_fugacity(x[j],psat(equilibrium_temperature,j))==log_fugacity(y[j],pressure);
@id("01a0e18b78db742e8fd36e3646d5406a") annotation start bubble(bubble_start);
@id("01a0e18b78db742e8fd36e37aaaf00c2") annotation start dew(dew_start);
@id("01a0e18b78db742e8fd36e38826fcd13") annotation start equilibrium_temperature(bubble_start+(dew_start-bubble_start)/2);
@id("01a0e18b78db742e8fd36e39eecee2c6") annotation bounds bubble(minimum_temperature,maximum_temperature);
@id("01a0e18b78db742e8fd36e3adc6036ca") annotation bounds dew(minimum_temperature,maximum_temperature);
@id("01a0e18b78db742e8fd36e3b95e0bed4") annotation bounds equilibrium_temperature(minimum_temperature,maximum_temperature);
@id("01a0e1ad3a7f706c8439ef497dcb87d2") stage "ideal-K" {
@id("01a0e1ad3a7f706c8439ef4a9a2e04fb") override eq fugacity[j in components]:log_fugacity(x[j],psat(equilibrium_temperature,j))==log_fugacity(y[j],pressure);
}

}
@id("01a0e18b78db742e8fd36e3c4814e20c") def FTPx(selected:Set<kinds.species>,vapor_pressure:Fn(T:Temperature,j:kinds.species)->Pressure):SmoothVLE {
@id("01a0e18b78db742e8fd36e3df604a2f2") override param components:Set<kinds.species>=selected;
@id("01a0e18b78db742e8fd36e3e34bfc2b3") override param psat:Fn(T:Temperature,j:kinds.species)->Pressure=vapor_pressure;
}
@id("01a0e1971f9075519925980c1db041c9") fn enthalpy_datum()->MolarEnthalpy=0{J/mol};
@id("01a0e1db89d774f6b2eec0873293f7a4") interface ThermoPackage extends MaterialState {
@id("ba9aee1d2f2545f681e4e11603c10e4f") let phase_enthalpy[p in phases]:MolarEnthalpy;
@id("1a4771793c444fb48d4f61dcd9f74b98") let phase_energy_flow[p in phases]:Power=phase_flow[p]*phase_enthalpy[p];
@id("88efc9ad7b274af59b23dfd91f43faf7") param phases:Set<kinds.phase>;
@id("37766651229c418598666318e635866d") let phase_flow[p in phases]:Flow;
@id("31ea754fbae54e4b870920d04ee7a2fa") let phase_component_flow[p in phases,j in components]:ComponentFlow;
@id("01a0e1971f90755199259812ebf22d4a") var h:MolarEnthalpy;
@id("01a0e1db89d774f6b2eec088e3c2ac5b") let energy_flow:Power=flow*h;
}
@id("01a0e1971f9075519925980d433ab742") interface EquilibriumThermoPackage extends SmoothVLE,ThermoPackage {
@id("d7f2b6e8992440dfb04edcf868375ecd") let phase_enthalpy[p in phases]:MolarEnthalpy=if p==equilibrium.liquid then h_liquid else h_vapor;
@id("e35c912ebc5541b590703da681ccbe68") override param phases:Set<kinds.phase>={equilibrium.liquid,equilibrium.vapor};
@id("fbaa44f3b30b474f8aac6758b0d54f70") let phase_flow[p in phases]:Flow=if p==equilibrium.liquid then liquid_flow else vapor_flow;
@id("4f5d3eeebb87436c90f556fb9937bb98") let phase_component_flow[p in phases,j in components]:ComponentFlow=phase_flow[p]*(if p==equilibrium.liquid then x[j] else y[j]);
@id("01a0e1971f9075519925980eee091dae") param liquid_enthalpy:Fn(T:Temperature,j:kinds.species)->MolarEnthalpy;
@id("01a0e1971f9075519925980f4248144b") param vapor_enthalpy:Fn(T:Temperature,j:kinds.species)->MolarEnthalpy;
@id("01a0e1971f90755199259810f02e67ef") let h_liquid:MolarEnthalpy=enthalpy_datum()+sum(j in components | (x[j]/fraction_unit())*(liquid_enthalpy(T,j)-enthalpy_datum()));
@id("01a0e1971f9075519925981122f9c576") let h_vapor:MolarEnthalpy=enthalpy_datum()+sum(j in components | (y[j]/fraction_unit())*(vapor_enthalpy(T,j)-enthalpy_datum()));
@id("01a0e1971f9075519925981361bc4e59") eq enthalpy_binding:h==enthalpy_datum()+(1-beta)*(h_liquid-enthalpy_datum())+beta*(h_vapor-enthalpy_datum());
@id("01a0e1971f907551992598147f124064") annotation start h(50000{J/mol});
@id("01a0e1971f907551992598150db963e1") annotation nominal h(50000{J/mol});
@id("01a0e1971f9075519925981681c3d748") annotation start T(bubble_start+(dew_start-bubble_start)/2);
@id("01a0e19cfdf87365aea712b282903565") annotation nominal T(bubble_start+(dew_start-bubble_start)/2);
@id("01a0e1971f90755199259817e35542c5") annotation bounds T(minimum_temperature,maximum_temperature);
@id("01a0e1971f90755199259818776ea65c") annotation scale enthalpy_binding(inverseSum);
}
@id("60dd59149a4147eea537f55651a41240") interface EntropyThermoPackage extends ThermoPackage {
@id("76271ec7559245fd85acb649a5256ba9") let s:MolarEntropy;
}
@id("01a0e1b4f60e71eab3418879641baa89") fn entropy_datum()->MolarEntropy=0{J/(mol*K)};
}
