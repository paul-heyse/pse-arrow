@id("01a0e18b78db742e8fd36e110ff14989") package equilibrium {
@id("01a0f1955e96736397df7b58f77f6f9c") use compatibility @"1.0.0";
@id("01a0f14ead4e761899b3c3a9dc2b6f7f") use constants @"1.0.0";
@id("01a0ede58ecf75039afc471668012ddd") use chemistry @"1.0.0";
@id("01a0e18b78db742e8fd36e1308c99e5c") use math @"1.0.0";
@id("01a0e18b78db742e8fd36e14a5a5f8b3") use caloric @"1.0.0";
@id("01a0e18b78db742e8fd36e155522a7b8") use pure_properties @"1.0.0";
@id("74a301a092ad413bb5de501ccd67ffb5") fn pressure_difference_unit()->DeltaPressure=1{Pa};
@id("56a9a222e4c048fc8c76aa9017ae3413") fn component_flow_unit()->ComponentFlow=1{mol/s};
@id("4695e4aa4fc843eba60c3a122a932b9c") fn flow_unit()->Flow=1{mol/s};
@id("01a0e18b78db742e8fd36e16de242b6d") fn fraction_unit()->MoleFraction=1{1};
@id("01a0e1ad3a7f706c8439ef48ad021285") fn log_fugacity(x:MoleFraction,pure_fugacity:Pressure)->Scalar=log(x/fraction_unit())+log(pure_fugacity/constants.pressure_unit);
@id("01a0e18b78db742e8fd36e17b5a6be89") interface MaterialState {
@id("01a0e1db89d8722baac398bf7f110f21") param defined:Boolean=true;
@id("01a0e18b78db742e8fd36e18c7e3ae74") param components:Set<chemistry.species>;
@id("01a0e18b78db742e8fd36e19bdd385fa") var flow:Flow;
@id("01a0e18b78db742e8fd36e1ad23fe387") var T:Temperature;
@id("01a0e18b78db742e8fd36e1b607f0363") var pressure:Pressure;
@id("01a0e18b78db742e8fd36e1c320e73d7") var z[j in components]:MoleFraction;
@id("01a0e18b78db742e8fd36e1d1a2ebc35") let component_flow[j in components]:ComponentFlow=flow*z[j];
@id("01a0e18b78db742e8fd36e1e9159c2a3") annotation check flow(sum(j in components | z[j]/fraction_unit())>0.999999999 and sum(j in components | z[j]/fraction_unit())<1.000000001);
}
@id("01a0e18b78db742e8fd36e1f842113bb") interface PhaseEquilibrium extends MaterialState {
@id("01a0e18b78db742e8fd36e20f8c8a417") var beta:Scalar;
@id("01a0e18b78db742e8fd36e216dfd5b70") var x[j in components]:MoleFraction;
@id("01a0e18b78db742e8fd36e228dcd14f1") var y[j in components]:MoleFraction;
@id("01a0e18b78db742e8fd36e233ed51e39") let liquid_flow:Flow=(1-beta)*flow;
@id("01a0e18b78db742e8fd36e24c142a79c") let vapor_flow:Flow=beta*flow;
@id("01a0e18b78db742e8fd36e25a404b206") eq material[j in components]:z[j]==(1-beta)*x[j]+beta*y[j];
@id("01a0e18b78db742e8fd36e2626c216bb") eq normalization:sum(j in components | x[j]/fraction_unit()-y[j]/fraction_unit())==0;
@id("01a0e18b78db742e8fd36e27eec651b9") annotation bounds beta(0,1);
}
@id("01a0e19bbec57004aabdabb7c9c21b4c") fn rr_correction(beta:Scalar,z:Scalar[chemistry.species],k:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=math.smooth_min(math.smooth_max(beta+sum(j in members | z[j]*(k[j]-1)/(1+beta*(k[j]-1)))/(1e-12+sum(j in members | z[j]*((k[j]-1)/(1+beta*(k[j]-1)))^2)),1e-6,1e-8),1-1e-6,1e-8);
@id("01a0e19bbec57004aabdabb8cc497025") fn rr_start(z:Scalar[chemistry.species],k:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=b4 where b1=rr_correction(0.5,z,k,members),b2=rr_correction(b1,z,k,members),b3=rr_correction(b2,z,k,members),b4=rr_correction(b3,z,k,members);
@id("01a0e18b78db742e8fd36e2bee937544") interface SmoothVLE extends PhaseEquilibrium {
@id("c78288d9ac944248b95e8133adacf980") annotation start z(fraction_unit()/sum(k in components | 1));
@id("7c9064ecb449498d8278067dc15a92d2") annotation start flow(1{mol/s});
@id("de0703f8b8e0419681c510639643409f") annotation nominal flow(1{mol/s});
@id("af3429ed9fcc44e5b34a5db85c84dff1") annotation start pressure(101325{Pa});
@id("14c1ef845f4b499db7fcd049ad58f2b9") annotation nominal pressure(101325{Pa});
@id("1f6c53319c984704991232530986a8bb") when not defined {
@id("ad2227891b654485affe11e369645c7f") eq total_composition:sum(j in components | z[j]/fraction_unit())==1;
}
@id("01a0e18b78db742e8fd36e2c0210b39b") param psat:Fn(T:Temperature,j:chemistry.species)->Pressure;
@id("01a0e18b78db742e8fd36e2da45dba88") param epsilon_bubble:DeltaTemperature=0.01{K};
@id("01a0e18b78db742e8fd36e2e58e91c8d") param epsilon_dew:DeltaTemperature=0.0005{K};
@id("01a0e18c398b741fafbe644758157fe0") param minimum_temperature:Temperature;
@id("01a0e18c398b741fafbe644819d88985") param maximum_temperature:Temperature;
@id("01a0e18c398b741fafbe6449b3efa879") param bubble_start:Temperature;
@id("01a0e18c398b741fafbe644af66b3833") param dew_start:Temperature;
@id("01a0e18b78db742e8fd36e2f9415a08c") var bubble:Temperature;
@id("01a0e18b78db742e8fd36e30344c517f") var dew:Temperature;
@id("01a0e18b78db742e8fd36e310fe29b12") var equilibrium_temperature:Temperature;
@id("01a0e18b78db742e8fd36e326c35c691") eq bubble_point:sum(j in components | z[j]/fraction_unit()*(psat(bubble,j)/constants.pressure_unit))==pressure/constants.pressure_unit;
@id("01a0e18b78db742e8fd36e33e2347c1d") eq dew_point:sum(j in components | z[j]/fraction_unit()*(pressure/psat(dew,j)))==1;
@id("01a0e18b78db742e8fd36e34de742536") eq equilibrium_temperature_binding:equilibrium_temperature==math.smooth_min(math.smooth_max(T,bubble,epsilon_bubble),dew,epsilon_dew);
@id("01a0e19bbec57004aabdabb974cf6de8") let initial_K[j in components]:Scalar=psat(T,j)/pressure;
@id("01a0e19bbec57004aabdabbaf609bbbc") let feed_fraction[j in components]:Scalar=z[j]/fraction_unit();
@id("01a0e19bbec57004aabdabbbefc8fcc7") let initial_beta:Scalar=rr_start(feed_fraction,initial_K,components);
@id("01a0e19bbec57004aabdabbcec335c91") annotation start beta(initial_beta);
@id("01a0e19bbec57004aabdabbd2818eb29") annotation start x(z[j]/(1+initial_beta*(initial_K[j]-1)));
@id("01a0e19bbec57004aabdabbed9637e88") annotation start y(initial_K[j]*z[j]/(1+initial_beta*(initial_K[j]-1)));
@id("01a0e19bbec57004aabdabbf35dd4566") annotation bounds x(0.0000000001{1},1{1});
@id("01a0e19bbec57004aabdabc0180b134b") annotation bounds y(0.0000000001{1},1{1});
@id("01a0e18b78db742e8fd36e352667ac39") eq fugacity[j in components]:log_fugacity(x[j],psat(equilibrium_temperature,j))==log_fugacity(y[j],pressure);
@id("01a0e18b78db742e8fd36e3646d5406a") annotation start bubble(bubble_start);
@id("01a0e18b78db742e8fd36e37aaaf00c2") annotation start dew(dew_start);
@id("01a0e18b78db742e8fd36e38826fcd13") annotation start equilibrium_temperature(bubble_start+(dew_start-bubble_start)/2);
@id("01a0e18b78db742e8fd36e39eecee2c6") annotation bounds bubble(minimum_temperature,maximum_temperature);
@id("01a0e18b78db742e8fd36e3adc6036ca") annotation bounds dew(minimum_temperature,maximum_temperature);
@id("01a0e18b78db742e8fd36e3b95e0bed4") annotation bounds equilibrium_temperature(minimum_temperature,maximum_temperature);
@id("01a0e1ad3a7f706c8439ef497dcb87d2") stage "ideal-K" {
@id("01a0e1ad3a7f706c8439ef4a9a2e04fb") override eq fugacity[j in components]:log_fugacity(x[j],psat(equilibrium_temperature,j))==log_fugacity(y[j],pressure);
}

}
@id("01a0e18b78db742e8fd36e3c4814e20c") def FTPx(selected:Set<chemistry.species>,vapor_pressure:Fn(T:Temperature,j:chemistry.species)->Pressure):SmoothVLE {
@id("01a0e18b78db742e8fd36e3df604a2f2") override param components:Set<chemistry.species>=selected;
@id("01a0e18b78db742e8fd36e3e34bfc2b3") override param psat:Fn(T:Temperature,j:chemistry.species)->Pressure=vapor_pressure;
}
// A complementarity VLE (after Dabadghao et al., AIChE J. 2022, DOI 10.1002/aic.18029):
// the equilibrium temperature leaves T by a slack while one phase vanishes, each slack
// complementary to its phase fraction. The realization of the pairs is the author's.
@id("01e4e7198547443aa30242346a72c7cd") fn temperature_difference_unit()->DeltaTemperature=1{K};
@id("01a0eeced80374ab83c0818dcb375c61") enum VleFormulation {@id("01a0ef441d697427a7ebd648366a09f2") smooth, @id("01a0ef441d697427a7ebd649f9fc78fc") complementarity, @id("01a0ef441d697427a7ebd64a9841bf6f") nested}
@id("f8b565f98a4d47d6beace4813bc00094") interface ComplementarityVLE extends PhaseEquilibrium {
@id("3bd6388e2a5a4703b65c3f7e50071495") annotation start z(fraction_unit()/sum(k in components | 1));
@id("4da42935ba2a44e9a4985496ca583775") annotation start flow(1{mol/s});
@id("fd6a63c79bcc4f47a3acb4125040849e") annotation nominal flow(1{mol/s});
@id("a5c6e7cef3e04a9694483a99d86201b4") annotation start pressure(101325{Pa});
@id("117ab2004a9a4455a401f77885e4ea7c") annotation nominal pressure(101325{Pa});
@id("d6896d4a0ee44f45b7c9c4738ec38b92") when not defined {
@id("99629f0b045749edaf0067aaf945201c") eq total_composition:sum(j in components | z[j]/fraction_unit())==1;
}
@id("bebb7cb4eead4a5fb72d4fff9483328e") param psat:Fn(T:Temperature,j:chemistry.species)->Pressure;
@id("ecbabe9eadb04f328a1f0ac6c6664623") param epsilon_phase:Scalar=0.0001;
@id("ac60e8fa80b94ee1b8583c2912519af1") param epsilon_start:DeltaTemperature=0.01{K};
@id("9dd04cda89e64f2daac08c5839cabce4") param minimum_temperature:Temperature;
@id("480218e4e8d64b7888ac1f3079b928f2") param maximum_temperature:Temperature;
@id("863fcafd3bd548cdbfb418f65cd343ac") param bubble_start:Temperature;
@id("26fbaa919dde448bb3fd4ed6507501a6") param dew_start:Temperature;
@id("db85a4fe0e2840b79f5b61b16e17cdd4") var liquid_slack:Scalar;
@id("73c3723802ae4b5498f0a61baafbb9c2") var vapor_slack:Scalar;
@id("add70dde48ee4d2897ca570fb186147d") var equilibrium_temperature:Temperature;
@id("c49252c589364bd289218bd33f46a6c8") let liquid_fraction:Scalar=1-beta;
@id("a1d121ba742d4f18930c1c06f7d1ab7c") eq equilibrium_temperature_binding:equilibrium_temperature==T+(vapor_slack-liquid_slack)*temperature_difference_unit();
@id("0b99f8285e814ca4ba1a8788bebfee24") eq fugacity[j in components]:log_fugacity(x[j],psat(equilibrium_temperature,j))==log_fugacity(y[j],pressure);
@id("de3fc959158a4ddcbca5e636a840cd5d") let initial_temperature:Temperature=math.smooth_min(math.smooth_max(T,bubble_start,epsilon_start),dew_start,epsilon_start);
@id("bc451bec87d040b3bb8a578180f17a71") let initial_K[j in components]:Scalar=psat(initial_temperature,j)/pressure;
@id("bad0de0971ab406da09509e15d1f813e") let feed_fraction[j in components]:Scalar=z[j]/fraction_unit();
@id("6588eb41f4ee460e9ac3d750549c7f4f") let initial_beta:Scalar=rr_start(feed_fraction,initial_K,components);
@id("88377f2772c24d7b8b0a998b9a2fb458") annotation start beta(initial_beta);
@id("e34b56b4050d48b6903d890c2f1e7468") annotation start x(z[j]/(1+initial_beta*(initial_K[j]-1)));
@id("35577f6994fc425b9a67cb50dabdc9a4") annotation start y(initial_K[j]*z[j]/(1+initial_beta*(initial_K[j]-1)));
@id("cc47cda3f4d0473ea37fa2d94869b9e4") annotation bounds x(0.0000000001{1},1{1});
@id("724d5128579a495282c6c3af99944b6f") annotation bounds y(0.0000000001{1},1{1});
@id("cc02fc04071640ee8ce3d3d6966a8af0") annotation start liquid_slack(math.smooth_max((T-initial_temperature)/temperature_difference_unit(),0,0.0001));
@id("8774a8aaccf5481fb02c61f2b761c4bf") annotation start vapor_slack(math.smooth_max((initial_temperature-T)/temperature_difference_unit(),0,0.0001));
@id("70edce9a7d474c98aa5f8a5e5a98abfa") annotation bounds liquid_slack(0,(maximum_temperature-minimum_temperature)/temperature_difference_unit());
@id("194a970df4984033a2c0a9bd3f938b1c") annotation bounds vapor_slack(0,(maximum_temperature-minimum_temperature)/temperature_difference_unit());
@id("b76c90963b5847c78cb52d54e6598b00") annotation start equilibrium_temperature(initial_temperature);
@id("534b50404607491c990c1e446e22c44e") annotation bounds equilibrium_temperature(minimum_temperature,maximum_temperature);
@id("5b8ab4cf8d5f4531a65ef5051f7d5017") annotation report beta("vapor fraction");
@id("075eb6eac0c045deb04f4b1d5b562f92") annotation report equilibrium_temperature("equilibrium temperature");
}
@id("e3e50185c5104c2395d3f57653465911") def SmoothComplementarityFTPx(selected:Set<chemistry.species>,vapor_pressure:Fn(T:Temperature,j:chemistry.species)->Pressure):ComplementarityVLE {
@id("52fedc5789bf4445a72a644c9e66f605") override param components:Set<chemistry.species>=selected;
@id("23627ad371e04f01b02246de4e9189ae") override param psat:Fn(T:Temperature,j:chemistry.species)->Pressure=vapor_pressure;
@id("5830706ea51f4c3ebabe0266c193abc0") complements liquid_disappearance:(liquid_slack>=0,liquid_fraction>=0);
@id("444f06602c204cbcac334f3179eb0dba") complements vapor_disappearance:(vapor_slack>=0,beta>=0);
@id("280e415960e34c5797cd762748ef80e3") realize liquid_realization on liquid_disappearance using smooth(math.smooth_min,epsilon_phase);
@id("6008c529a5be4e4e95100ae69551344c") realize vapor_realization on vapor_disappearance using smooth(math.smooth_min,epsilon_phase);
}
@id("85f919fd8bf34d4dbec23e52aafc5799") def DisjunctiveComplementarityFTPx(selected:Set<chemistry.species>,vapor_pressure:Fn(T:Temperature,j:chemistry.species)->Pressure):ComplementarityVLE {
@id("711ca0cbe93442698d76a7db78bd1760") override param components:Set<chemistry.species>=selected;
@id("066a511a18f54dfd9f9e60cdc8a47e4a") override param psat:Fn(T:Temperature,j:chemistry.species)->Pressure=vapor_pressure;
@id("6efa38c1983e47f495901ce80a6fc383") complements liquid_disappearance:(liquid_slack>=0,liquid_fraction>=0);
@id("ee87201ff458454bad64a12c290342e3") complements vapor_disappearance:(vapor_slack>=0,beta>=0);
@id("4d706aa3ad384cee92af3febb9562c05") realize liquid_realization on liquid_disappearance using disjunctive;
@id("e7b384d009414dadaf54d7f50fe621f5") realize vapor_realization on vapor_disappearance using disjunctive;
}
@id("49cf10e61b9547039b98c8f29c51a13d") def PenaltyComplementarityFTPx(selected:Set<chemistry.species>,vapor_pressure:Fn(T:Temperature,j:chemistry.species)->Pressure):ComplementarityVLE {
@id("38d80063398c4f74afea8b27656411ba") override param components:Set<chemistry.species>=selected;
@id("686f09a0939544ca84b3797b99627a04") override param psat:Fn(T:Temperature,j:chemistry.species)->Pressure=vapor_pressure;
@id("62850f29dbc745399bc729f5560b4c80") complements liquid_disappearance:(liquid_slack>=0,liquid_fraction>=0);
@id("01d3451965184bd9bb7d25ae053ba9de") complements vapor_disappearance:(vapor_slack>=0,beta>=0);
@id("4f53a191e0ac432b80a68cdb5806334a") realize liquid_realization on liquid_disappearance using penalty(l1);
@id("72ec4b9d05c64c6fae63704237cd02a3") realize vapor_realization on vapor_disappearance using penalty(l1);
}
@id("01a0e1db89d774f6b2eec0873293f7a4") interface ThermoPackage extends MaterialState {
@id("ba9aee1d2f2545f681e4e11603c10e4f") let phase_enthalpy[p in phases]:MolarEnthalpy;
@id("1a4771793c444fb48d4f61dcd9f74b98") let phase_energy_flow[p in phases]:Power=phase_flow[p]*phase_enthalpy[p];
@id("88efc9ad7b274af59b23dfd91f43faf7") param phases:Set<chemistry.phase>;
@id("37766651229c418598666318e635866d") let phase_flow[p in phases]:Flow;
@id("31ea754fbae54e4b870920d04ee7a2fa") let phase_component_flow[p in phases,j in components]:ComponentFlow;
@id("01a0e1971f90755199259812ebf22d4a") var h:MolarEnthalpy;
@id("01a0e1db89d774f6b2eec088e3c2ac5b") let energy_flow:Power=flow*h;
}
@id("01a0e1971f9075519925980d433ab742") interface EquilibriumThermoPackage extends SmoothVLE,ThermoPackage {
@id("01a0f195c3f4775da30eb8fc2b964ff4") param liquid_phase:chemistry.phase=chemistry.liquid;
@id("01a0f195c3f4775da30eb8fdc0cdb610") param vapor_phase:chemistry.phase=chemistry.vapor;
@id("01a0f195c3f4775da30eb8fe2c7e746b") require liquid_phase.type==compatibility.PhaseType.liquidPhase and vapor_phase.type==compatibility.PhaseType.vaporPhase : "the two phase slots have their declared phase types";
@id("d7f2b6e8992440dfb04edcf868375ecd") let phase_enthalpy[p in phases]:MolarEnthalpy=if p==liquid_phase then h_liquid else h_vapor;
@id("e35c912ebc5541b590703da681ccbe68") override param phases:Set<chemistry.phase>={liquid_phase,vapor_phase};
@id("fbaa44f3b30b474f8aac6758b0d54f70") let phase_flow[p in phases]:Flow=if p==liquid_phase then liquid_flow else vapor_flow;
@id("4f5d3eeebb87436c90f556fb9937bb98") let phase_component_flow[p in phases,j in components]:ComponentFlow=phase_flow[p]*(if p==liquid_phase then x[j] else y[j]);
@id("01a0e1971f9075519925980eee091dae") param liquid_enthalpy:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy;
@id("01a0e1971f9075519925980f4248144b") param vapor_enthalpy:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy;
@id("01a0e1971f90755199259810f02e67ef") let h_liquid:MolarEnthalpy=constants.standard_enthalpy_datum+sum(j in components | (x[j]/fraction_unit())*(liquid_enthalpy(T,j)-constants.standard_enthalpy_datum));
@id("01a0e1971f9075519925981122f9c576") let h_vapor:MolarEnthalpy=constants.standard_enthalpy_datum+sum(j in components | (y[j]/fraction_unit())*(vapor_enthalpy(T,j)-constants.standard_enthalpy_datum));
@id("01a0e1971f9075519925981361bc4e59") eq enthalpy_binding:h==constants.standard_enthalpy_datum+(1-beta)*(h_liquid-constants.standard_enthalpy_datum)+beta*(h_vapor-constants.standard_enthalpy_datum);
@id("01a0e1971f907551992598147f124064") annotation start h(50000{J/mol});
@id("01a0e1971f907551992598150db963e1") annotation nominal h(50000{J/mol});
@id("01a0e1971f9075519925981681c3d748") annotation start T(bubble_start+(dew_start-bubble_start)/2);
@id("01a0e19cfdf87365aea712b282903565") annotation nominal T(bubble_start+(dew_start-bubble_start)/2);
@id("01a0e1971f90755199259817e35542c5") annotation bounds T(minimum_temperature,maximum_temperature);
@id("01a0e1971f90755199259818776ea65c") annotation scale enthalpy_binding(inverseSum);
}
@id("60dd59149a4147eea537f55651a41240") interface EntropyThermoPackage extends ThermoPackage {
@id("76271ec7559245fd85acb649a5256ba9") let s:MolarEntropy;
}
}
