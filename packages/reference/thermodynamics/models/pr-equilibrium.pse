@id("01a0eeced80374ab83c0818e557e8e92") use math @"1.0.0";
@id("01a0eeced80374ab83c0818f15fa2917") use nested_equilibrium @"1.0.0";
@id("01a0e1b4f60e71eab341887ae9752485") interface SmoothPR extends equilibrium.EquilibriumThermoPackage,equilibrium.EntropyThermoPackage {
@id("e830a09c16d9430593fcdf0bfb3b4587") param eos_package:properties.property_package;
@id("f11f409f32ce48ba915537572882b379") param eos_family:cubic.cubic_family=cubic.pr;
@id("da493c45654e46698d9f64c294685bbb") param eos_potential:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy;

@id("03aaa07a0d15470295eebcad71a4c31d") let s:MolarEntropy=constants.standard_entropy_datum+(1-beta)*(s_liquid-constants.standard_entropy_datum)+beta*(s_vapor-constants.standard_entropy_datum);
@id("01a0e1b4f60e71eab341887bd38ad2af") param ideal_entropy:Fn(T:Temperature,j:chemistry.species)->MolarEntropy;
@id("01a0e1b4f60e71eab341887cd93e968e") var bubble_vapor[j in components]:MoleFraction;
@id("01a0e1b4f60e71eab341887de648cd50") annotation start bubble_vapor(z[j]);
@id("01a0e1b4f60e71eab341887ebeb67cd9") annotation bounds bubble_vapor(1e-10{1},1{1});
@id("01a0e1b4f60e71eab341887f0abdfd8e") var dew_liquid[j in components]:MoleFraction;
@id("01a0e1b4f60e71eab34188804c78cbf2") annotation start dew_liquid(z[j]);
@id("01a0e1b4f60e71eab341888139be8fc2") annotation bounds dew_liquid(1e-10{1},1{1});
@id("01a0e1b4f60e71eab3418882b658ad97") child eq_liquid:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=eos_package,law=eos_potential,selected_family=eos_family,lower=5000,upper=11000,start=10000);
@id("01a0e1b4f60e71eab3418883099b1787") eq eq_liquid_temperature:eq_liquid.T==equilibrium_temperature;
@id("01a0e1b4f60e71eab3418884ab782212") eq eq_liquid_pressure:eq_liquid.target_pressure==pressure;
@id("01a0e1b4f60e71eab341888550d8040c") eq eq_liquid_amount[j in components]:eq_liquid.amount[j]==constants.amount_unit*(x[j]/equilibrium.fraction_unit());
@id("01a0e1b4f60e71eab3418886bf02fcbd") annotation start eq_liquid.T(equilibrium_temperature);
@id("01a0e1b4f60e71eab341888709f93c67") annotation nominal eq_liquid.T(equilibrium_temperature);
@id("01a0e1b4f60e71eab341888808bb3e7c") annotation start eq_liquid.target_pressure(pressure);
@id("01a0e1b4f60e71eab3418889dd8ece9f") annotation nominal eq_liquid.target_pressure(pressure);
@id("01a0e1b4f60e71eab341888aa9414373") annotation start eq_liquid.amount(constants.amount_unit*(x[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab341888bffc63911") annotation nominal eq_liquid.amount(constants.amount_unit*(x[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab341888ce11c32f3") annotation bounds eq_liquid.T(minimum_temperature,maximum_temperature);
@id("01a0e1b4f60e71eab341888dc4ffa4ae") annotation bounds eq_liquid.target_pressure(50000{Pa},200000{Pa});
@id("01a0e1b4f60e71eab341888e60cf86c8") annotation bounds eq_liquid.amount(1e-10{mol},1{mol});
@id("01a0e1b4f60e71eab341888fcf729aac") child eq_vapor:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=eos_package,law=eos_potential,selected_family=eos_family,lower=1,upper=300,start=33);
@id("01a0e1b4f60e71eab341889017301dac") eq eq_vapor_temperature:eq_vapor.T==equilibrium_temperature;
@id("01a0e1b4f60e71eab3418891b5486f2e") eq eq_vapor_pressure:eq_vapor.target_pressure==pressure;
@id("01a0e1b4f60e71eab3418892d6b3d1d8") eq eq_vapor_amount[j in components]:eq_vapor.amount[j]==constants.amount_unit*(y[j]/equilibrium.fraction_unit());
@id("01a0e1b4f60e71eab3418893187e8c3e") annotation start eq_vapor.T(equilibrium_temperature);
@id("01a0e1b4f60e71eab34188941f3224db") annotation nominal eq_vapor.T(equilibrium_temperature);
@id("01a0e1b4f60e71eab3418895ebb109e4") annotation start eq_vapor.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188960c4fd5a9") annotation nominal eq_vapor.target_pressure(pressure);
@id("01a0e1b4f60e71eab3418897ba6e7e7c") annotation start eq_vapor.amount(constants.amount_unit*(y[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab341889877c2047f") annotation nominal eq_vapor.amount(constants.amount_unit*(y[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab341889991103c45") annotation bounds eq_vapor.T(minimum_temperature,maximum_temperature);
@id("01a0e1b4f60e71eab341889a8d2c4849") annotation bounds eq_vapor.target_pressure(50000{Pa},200000{Pa});
@id("01a0e1b4f60e71eab341889b5bc5a8c3") annotation bounds eq_vapor.amount(1e-10{mol},1{mol});
@id("01a0e1b4f60e71eab341889c19d9287c") child bubble_liquid:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=eos_package,law=eos_potential,selected_family=eos_family,lower=5000,upper=11000,start=10000);
@id("01a0e1b4f60e71eab341889da97813fb") eq bubble_liquid_temperature:bubble_liquid.T==bubble;
@id("01a0e1b4f60e71eab341889ef2295ee4") eq bubble_liquid_pressure:bubble_liquid.target_pressure==pressure;
@id("01a0e1b4f60e71eab341889fde3abd22") eq bubble_liquid_amount[j in components]:bubble_liquid.amount[j]==constants.amount_unit*(z[j]/equilibrium.fraction_unit());
@id("01a0e1b4f60e71eab34188a01fc7f97d") annotation start bubble_liquid.T(bubble);
@id("01a0e1b4f60e71eab34188a1760bd4b0") annotation nominal bubble_liquid.T(bubble);
@id("01a0e1b4f60e71eab34188a245ea7c2b") annotation start bubble_liquid.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188a3f844dd78") annotation nominal bubble_liquid.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188a47ca782e6") annotation start bubble_liquid.amount(constants.amount_unit*(z[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188a55ba49768") annotation nominal bubble_liquid.amount(constants.amount_unit*(z[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188a6134ff5c0") annotation bounds bubble_liquid.T(minimum_temperature,maximum_temperature);
@id("01a0e1b4f60e71eab34188a7a098457e") annotation bounds bubble_liquid.target_pressure(50000{Pa},200000{Pa});
@id("01a0e1b4f60e71eab34188a8f69fd85c") annotation bounds bubble_liquid.amount(1e-10{mol},1{mol});
@id("01a0e1b4f60e71eab34188a976ce25f4") child bubble_gas:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=eos_package,law=eos_potential,selected_family=eos_family,lower=1,upper=300,start=33);
@id("01a0e1b4f60e71eab34188aa2f9cc652") eq bubble_gas_temperature:bubble_gas.T==bubble;
@id("01a0e1b4f60e71eab34188abf3864e6c") eq bubble_gas_pressure:bubble_gas.target_pressure==pressure;
@id("01a0e1b4f60e71eab34188ac2634bd95") eq bubble_gas_amount[j in components]:bubble_gas.amount[j]==constants.amount_unit*(bubble_vapor[j]/equilibrium.fraction_unit());
@id("01a0e1b4f60e71eab34188ad1fcb6c69") annotation start bubble_gas.T(bubble);
@id("01a0e1b4f60e71eab34188ae3d85e088") annotation nominal bubble_gas.T(bubble);
@id("01a0e1b4f60e71eab34188af9206f4de") annotation start bubble_gas.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188b068a2d175") annotation nominal bubble_gas.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188b1697dc4ad") annotation start bubble_gas.amount(constants.amount_unit*(bubble_vapor[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188b2ce5ecbc8") annotation nominal bubble_gas.amount(constants.amount_unit*(bubble_vapor[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188b32cf0873d") annotation bounds bubble_gas.T(minimum_temperature,maximum_temperature);
@id("01a0e1b4f60e71eab34188b40058f786") annotation bounds bubble_gas.target_pressure(50000{Pa},200000{Pa});
@id("01a0e1b4f60e71eab34188b5c8ca1ac4") annotation bounds bubble_gas.amount(1e-10{mol},1{mol});
@id("01a0e1b4f60e71eab34188b6f0cc80a1") child dew_condensate:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=eos_package,law=eos_potential,selected_family=eos_family,lower=5000,upper=11000,start=10000);
@id("01a0e1b4f60e71eab34188b7b6ae21fa") eq dew_condensate_temperature:dew_condensate.T==dew;
@id("01a0e1b4f60e71eab34188b8ae723f59") eq dew_condensate_pressure:dew_condensate.target_pressure==pressure;
@id("01a0e1b4f60e71eab34188b9892183a2") eq dew_condensate_amount[j in components]:dew_condensate.amount[j]==constants.amount_unit*(dew_liquid[j]/equilibrium.fraction_unit());
@id("01a0e1b4f60e71eab34188bafb627a12") annotation start dew_condensate.T(dew);
@id("01a0e1b4f60e71eab34188bb2fbd51fc") annotation nominal dew_condensate.T(dew);
@id("01a0e1b4f60e71eab34188bc98ebe979") annotation start dew_condensate.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188bdc28f3b26") annotation nominal dew_condensate.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188be4afcc6f7") annotation start dew_condensate.amount(constants.amount_unit*(dew_liquid[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188bf3ef93c45") annotation nominal dew_condensate.amount(constants.amount_unit*(dew_liquid[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188c0d3a8fcca") annotation bounds dew_condensate.T(minimum_temperature,maximum_temperature);
@id("01a0e1b4f60e71eab34188c1c2633978") annotation bounds dew_condensate.target_pressure(50000{Pa},200000{Pa});
@id("01a0e1b4f60e71eab34188c2b275c9d2") annotation bounds dew_condensate.amount(1e-10{mol},1{mol});
@id("01a0e1b4f60e71eab34188c35ee75944") child dew_vapor:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=eos_package,law=eos_potential,selected_family=eos_family,lower=1,upper=300,start=33);
@id("01a0e1b4f60e71eab34188c4fa9be5b6") eq dew_vapor_temperature:dew_vapor.T==dew;
@id("01a0e1b4f60e71eab34188c562d0e782") eq dew_vapor_pressure:dew_vapor.target_pressure==pressure;
@id("01a0e1b4f60e71eab34188c64f1af6ff") eq dew_vapor_amount[j in components]:dew_vapor.amount[j]==constants.amount_unit*(z[j]/equilibrium.fraction_unit());
@id("01a0e1b4f60e71eab34188c78c6189c5") annotation start dew_vapor.T(dew);
@id("01a0e1b4f60e71eab34188c8e3e26974") annotation nominal dew_vapor.T(dew);
@id("01a0e1b4f60e71eab34188c930d94bcf") annotation start dew_vapor.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188ca409a0675") annotation nominal dew_vapor.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188cbff3d011d") annotation start dew_vapor.amount(constants.amount_unit*(z[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188cca8137535") annotation nominal dew_vapor.amount(constants.amount_unit*(z[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188cd42e2a140") annotation bounds dew_vapor.T(minimum_temperature,maximum_temperature);
@id("01a0e1b4f60e71eab34188cec5aeeac0") annotation bounds dew_vapor.target_pressure(50000{Pa},200000{Pa});
@id("01a0e1b4f60e71eab34188cf14774d39") annotation bounds dew_vapor.amount(1e-10{mol},1{mol});
@id("01a0e1b4f60e71eab34188d0908fed93") child liquid:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=eos_package,law=eos_potential,selected_family=eos_family,lower=5000,upper=11000,start=10000);
@id("01a0e1b4f60e71eab34188d103bf6bf2") eq liquid_temperature:liquid.T==T;
@id("01a0e1b4f60e71eab34188d253cccc15") eq liquid_pressure:liquid.target_pressure==pressure;
@id("01a0e1b4f60e71eab34188d3dcaf27a2") eq liquid_amount[j in components]:liquid.amount[j]==constants.amount_unit*(x[j]/equilibrium.fraction_unit());
@id("01a0e1b4f60e71eab34188d4cc156e7d") annotation start liquid.T(T);
@id("01a0e1b4f60e71eab34188d5829e9d4a") annotation nominal liquid.T(T);
@id("01a0e1b4f60e71eab34188d6b8e1c881") annotation start liquid.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188d7cd468d97") annotation nominal liquid.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188d8e04c484a") annotation start liquid.amount(constants.amount_unit*(x[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188d9fcf63af8") annotation nominal liquid.amount(constants.amount_unit*(x[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188da999c9787") annotation bounds liquid.T(minimum_temperature,maximum_temperature);
@id("01a0e1b4f60e71eab34188db43957eab") annotation bounds liquid.target_pressure(50000{Pa},200000{Pa});
@id("01a0e1b4f60e71eab34188dc7793754e") annotation bounds liquid.amount(1e-10{mol},1{mol});
@id("01a0e1b4f60e71eab34188dd813f45f0") child vapor:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=eos_package,law=eos_potential,selected_family=eos_family,lower=1,upper=300,start=33);
@id("01a0e1b4f60e71eab34188ded4cd98d9") eq vapor_temperature:vapor.T==T;
@id("01a0e1b4f60e71eab34188dfa60e1e71") eq vapor_pressure:vapor.target_pressure==pressure;
@id("01a0e1b4f60e71eab34188e0636aa802") eq vapor_amount[j in components]:vapor.amount[j]==constants.amount_unit*(y[j]/equilibrium.fraction_unit());
@id("01a0e1b4f60e71eab34188e1a52b06c6") annotation start vapor.T(T);
@id("01a0e1b4f60e71eab34188e285e2269b") annotation nominal vapor.T(T);
@id("01a0e1b4f60e71eab34188e362c071c9") annotation start vapor.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188e4052170ef") annotation nominal vapor.target_pressure(pressure);
@id("01a0e1b4f60e71eab34188e5313c3de5") annotation start vapor.amount(constants.amount_unit*(y[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188e6d849a340") annotation nominal vapor.amount(constants.amount_unit*(y[j]/equilibrium.fraction_unit()));
@id("01a0e1b4f60e71eab34188e79f8625d2") annotation bounds vapor.T(minimum_temperature,maximum_temperature);
@id("01a0e1b4f60e71eab34188e8d1d85a76") annotation bounds vapor.target_pressure(50000{Pa},200000{Pa});
@id("01a0e1b4f60e71eab34188e9485a0824") annotation bounds vapor.amount(1e-10{mol},1{mol});
@id("01a0e1b4f60e71eab34188ea618c7e44") override eq bubble_point:sum(j in components | bubble_vapor[j]/equilibrium.fraction_unit())==1;
@id("01a0e1b4f60e71eab34188eb04902430") eq bubble_fugacity[j in components]:log(z[j]/equilibrium.fraction_unit())+bubble_liquid.ln_phi[j]==log(bubble_vapor[j]/equilibrium.fraction_unit())+bubble_gas.ln_phi[j];
@id("01a0e1b4f60e71eab34188ec68ced640") override eq dew_point:sum(j in components | dew_liquid[j]/equilibrium.fraction_unit())==1;
@id("01a0e1b4f60e71eab34188edf8406654") eq dew_fugacity[j in components]:log(dew_liquid[j]/equilibrium.fraction_unit())+dew_condensate.ln_phi[j]==log(z[j]/equilibrium.fraction_unit())+dew_vapor.ln_phi[j];
@id("01a0e1b4f60e71eab34188eea2200d0a") override eq fugacity[j in components]:log(x[j]/equilibrium.fraction_unit())+eq_liquid.ln_phi[j]==log(y[j]/equilibrium.fraction_unit())+eq_vapor.ln_phi[j];
@id("01a0e1b4f60e71eab34188ef8f05e6d1") override let h_liquid:MolarEnthalpy=constants.standard_enthalpy_datum+sum(j in components | (x[j]/equilibrium.fraction_unit())*(liquid_enthalpy(T,j)-constants.standard_enthalpy_datum))+liquid.h_residual;
@id("01a0e1b4f60e71eab34188f0a5751f23") let s_liquid:MolarEntropy=constants.standard_entropy_datum+sum(j in components | (x[j]/equilibrium.fraction_unit())*(ideal_entropy(T,j)-constants.standard_entropy_datum))+liquid.s_residual-constants.entropy_increment_unit*helmholtz.reduced_gas_constant()*(log(pressure/constants.standard_pressure)+sum(j in components | (x[j]/equilibrium.fraction_unit())*log(x[j]/equilibrium.fraction_unit())));
@id("01a0e1b4f60e71eab34188f1d78b3b6f") override let h_vapor:MolarEnthalpy=constants.standard_enthalpy_datum+sum(j in components | (y[j]/equilibrium.fraction_unit())*(vapor_enthalpy(T,j)-constants.standard_enthalpy_datum))+vapor.h_residual;
@id("01a0e1b4f60e71eab34188f29b90d9e7") let s_vapor:MolarEntropy=constants.standard_entropy_datum+sum(j in components | (y[j]/equilibrium.fraction_unit())*(ideal_entropy(T,j)-constants.standard_entropy_datum))+vapor.s_residual-constants.entropy_increment_unit*helmholtz.reduced_gas_constant()*(log(pressure/constants.standard_pressure)+sum(j in components | (y[j]/equilibrium.fraction_unit())*log(y[j]/equilibrium.fraction_unit())));
}
@id("01a0eeced80374ab83c0819051f61a80") def ComplementarityPR(selected:Set<chemistry.species>,vapor_pressure:Fn(T:Temperature,j:chemistry.species)->Pressure,minimum:Temperature,maximum:Temperature,bubble:Temperature,dew:Temperature,epsilon:Scalar=0.0001,pkg:properties.property_package,law:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy,family:cubic.cubic_family=cubic.pr):nested_equilibrium.FlashSplit {
@id("01a0eeced80374ab83c081916b461427") override param components:Set<chemistry.species>=selected;
@id("01a0eeced80374ab83c081924e377c96") param minimum_temperature:Temperature=minimum;
@id("01a0eeced80374ab83c08193d4675749") param maximum_temperature:Temperature=maximum;
@id("01a0eeced80374ab83c08194ea19c3b7") var fraction:Scalar;
@id("01a0eeced80374ab83c08195f05fa54f") var liquid[j in components]:MoleFraction;
@id("01a0eeced80374ab83c0819641ec7fc0") var vapor[j in components]:MoleFraction;
@id("01a0eeced80374ab83c0819710b66e03") var equilibrium_temperature:Temperature;
@id("01a0eeced80374ab83c081983c023eb4") var liquid_slack:Scalar;
@id("01a0eeced80374ab83c08199cc4a7a2d") var vapor_slack:Scalar;
@id("01a0eeced80374ab83c0819ae362752c") let liquid_fraction:Scalar=1-fraction;
@id("01a0eeced80374ab83c0819b30c1fbc9") eq material[j in components]:z[j]==(1-fraction)*liquid[j]+fraction*vapor[j];
@id("01a0eeced80374ab83c0819c6ddb104f") eq normalization:sum(j in components | liquid[j]/equilibrium.fraction_unit()-vapor[j]/equilibrium.fraction_unit())==0;
@id("01a0eeced80374ab83c0819d315c5bee") eq equilibrium_temperature_binding:equilibrium_temperature==T+(vapor_slack-liquid_slack)*equilibrium.temperature_difference_unit();
@id("01a0eeced80374ab83c0819e59cefa47") child eq_liquid:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=pkg,law=law,selected_family=family,lower=5000,upper=11000,start=10000);
@id("01a0eeced80374ab83c0819ffcd43a3f") eq eq_liquid_temperature:eq_liquid.T==equilibrium_temperature;
@id("01a0eeced80374ab83c081a08fc0d5f1") eq eq_liquid_pressure:eq_liquid.target_pressure==pressure;
@id("01a0eeced80374ab83c081a13aaeb600") eq eq_liquid_amount[j in components]:eq_liquid.amount[j]==constants.amount_unit*(liquid[j]/equilibrium.fraction_unit());
@id("01a0eeced80374ab83c081a2d4375337") annotation start eq_liquid.T(initial_temperature);
@id("01a0eeced80374ab83c081a35c8bad18") annotation nominal eq_liquid.T(initial_temperature);
@id("01a0eeced80374ab83c081a4f8f2f930") annotation start eq_liquid.target_pressure(pressure);
@id("01a0eeced80374ab83c081a57610e771") annotation nominal eq_liquid.target_pressure(pressure);
@id("01a0eeced80374ab83c081a66fe258df") annotation start eq_liquid.amount(constants.amount_unit*(liquid[j]/equilibrium.fraction_unit()));
@id("01a0eeced80374ab83c081a7817362e3") annotation nominal eq_liquid.amount(constants.amount_unit*(liquid[j]/equilibrium.fraction_unit()));
@id("01a0eeced80374ab83c081a8f53cd378") annotation bounds eq_liquid.T(minimum_temperature,maximum_temperature);
@id("01a0eeced80374ab83c081a9c7c11f56") annotation bounds eq_liquid.target_pressure(50000{Pa},200000{Pa});
@id("01a0eeced80374ab83c081aa903069b5") annotation bounds eq_liquid.amount(1e-10{mol},1{mol});
@id("01a0eeced80374ab83c081ab7736a9e3") child eq_vapor:peng_robinson.DensityRoot=peng_robinson.BoundedCubicDensity(selected=components,pkg=pkg,law=law,selected_family=family,lower=1,upper=300,start=33);
@id("01a0eeced80374ab83c081ac46c525bd") eq eq_vapor_temperature:eq_vapor.T==equilibrium_temperature;
@id("01a0eeced80374ab83c081ad53a914e4") eq eq_vapor_pressure:eq_vapor.target_pressure==pressure;
@id("01a0eeced80374ab83c081aee5cb9e18") eq eq_vapor_amount[j in components]:eq_vapor.amount[j]==constants.amount_unit*(vapor[j]/equilibrium.fraction_unit());
@id("01a0eeced80374ab83c081afdf33a36f") annotation start eq_vapor.T(initial_temperature);
@id("01a0eeced80374ab83c081b06d93b4fa") annotation nominal eq_vapor.T(initial_temperature);
@id("01a0eeced80374ab83c081b1cf0fc7d6") annotation start eq_vapor.target_pressure(pressure);
@id("01a0eeced80374ab83c081b2197d0210") annotation nominal eq_vapor.target_pressure(pressure);
@id("01a0eeced80374ab83c081b3b1c86185") annotation start eq_vapor.amount(constants.amount_unit*(vapor[j]/equilibrium.fraction_unit()));
@id("01a0eeced80374ab83c081b4cfaa85f8") annotation nominal eq_vapor.amount(constants.amount_unit*(vapor[j]/equilibrium.fraction_unit()));
@id("01a0eeced80374ab83c081b5e028dd8d") annotation bounds eq_vapor.T(minimum_temperature,maximum_temperature);
@id("01a0eeced80374ab83c081b60a0d7124") annotation bounds eq_vapor.target_pressure(50000{Pa},200000{Pa});
@id("01a0eeced80374ab83c081b77296ee5d") annotation bounds eq_vapor.amount(1e-10{mol},1{mol});
@id("01a0eeced80374ab83c081b80d4f5d73") eq fugacity[j in components]:log(liquid[j]/equilibrium.fraction_unit())+eq_liquid.ln_phi[j]==log(vapor[j]/equilibrium.fraction_unit())+eq_vapor.ln_phi[j];
@id("01a0eeced80374ab83c081b96288cccb") complements liquid_disappearance:(liquid_slack>=0,liquid_fraction>=0);
@id("01a0eeced80374ab83c081baf7f8d84b") complements vapor_disappearance:(vapor_slack>=0,fraction>=0);
@id("01a0eeced80374ab83c081bb38312bec") realize liquid_realization on liquid_disappearance using smooth(math.smooth_min,epsilon);
@id("01a0eeced80374ab83c081bc19e8da56") realize vapor_realization on vapor_disappearance using smooth(math.smooth_min,epsilon);
@id("01a0eeced80374ab83c081bd82bef535") let initial_temperature:Temperature=math.smooth_min(math.smooth_max(T,bubble,0.01*equilibrium.temperature_difference_unit()),dew,0.01*equilibrium.temperature_difference_unit());
@id("01a0eeced80374ab83c081be9dc4908b") let initial_K[j in components]:Scalar=vapor_pressure(initial_temperature,j)/pressure;
@id("01a0eeced80374ab83c081bfe0efe1e7") let feed[j in components]:Scalar=z[j]/equilibrium.fraction_unit();
@id("01a0eeced80374ab83c081c05428434b") let initial_split:Scalar=equilibrium.rr_start(feed,initial_K,components);
@id("01a0eeced80374ab83c081c1591db626") annotation start fraction(initial_split);
@id("01a0eeced80374ab83c081c2d54cbfc3") annotation bounds fraction(0,1);
@id("01a0eeced80374ab83c081c3f0c60e31") annotation start liquid(z[j]/(1+initial_split*(initial_K[j]-1)));
@id("01a0eeced80374ab83c081c46daf39ed") annotation start vapor(initial_K[j]*z[j]/(1+initial_split*(initial_K[j]-1)));
@id("01a0eeced80374ab83c081c5a8aed075") annotation bounds liquid(0.0000000001{1},1{1});
@id("01a0eeced80374ab83c081c6d6f394f9") annotation bounds vapor(0.0000000001{1},1{1});
@id("01a0eeced80374ab83c081c794cee966") annotation start equilibrium_temperature(initial_temperature);
@id("01a0eeced80374ab83c081c86c7dd56a") annotation bounds equilibrium_temperature(minimum_temperature,maximum_temperature);
@id("01a0eeced80374ab83c081c9dc8b2048") annotation start liquid_slack(math.smooth_max((T-initial_temperature)/equilibrium.temperature_difference_unit(),0,0.0001));
@id("01a0eeced80374ab83c081ca228299b3") annotation start vapor_slack(math.smooth_max((initial_temperature-T)/equilibrium.temperature_difference_unit(),0,0.0001));
@id("01a0eeced80374ab83c081cb649fea18") annotation bounds liquid_slack(0,(maximum_temperature-minimum_temperature)/equilibrium.temperature_difference_unit());
@id("01a0eeced80374ab83c081ccdfa7886e") annotation bounds vapor_slack(0,(maximum_temperature-minimum_temperature)/equilibrium.temperature_difference_unit());
@id("01a0eeced80374ab83c081cd6f7fc094") override let beta:Scalar=fraction;
@id("01a0eeced80374ab83c081cec1b5096b") override let x[j in components]:MoleFraction=liquid[j];
@id("01a0eeced80374ab83c081cfcd4a0625") override let y[j in components]:MoleFraction=vapor[j];
@id("01a0eeced80374ab83c081d018192fb5") annotation report equilibrium_temperature("complementarity equilibrium temperature");
}
}
