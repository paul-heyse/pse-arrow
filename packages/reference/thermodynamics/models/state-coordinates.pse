@id("64d02000000040008000000000000001") package state_coordinates {
@id("64d02000000040008000000000000002") use chemistry @"1.0.0";
@id("64d02000000040008000000000000003") use equilibrium @"1.0.0";
@id("64d02000000040008000000000000004") use numerical_policy @"1.0.0";
// These are coordinate choices, not equilibrium or phase-selection laws.
// Every selected phase admits the selected component set in this first closure.
// Nonnegative amounts are exact domains; normalization alone has an allowance.
@id("64d02000000040008000000000000005") fn composition(part:ComponentFlow,total:Flow)->MoleFraction valid(total>0{mol/s} and part>=0{mol/s})=part/total;
@id("64d02000000040008000000000000006") fn fraction(part:Flow,total:Flow)->Scalar valid(total>0{mol/s} and part>=0{mol/s})=part/total;
@id("64d02000000040008000000000000007") interface PhysicalState extends equilibrium.ThermoPackage {
@id("64d02000000040008000000000000008") require sum(j in components | 1)>0 : "a coordinate state has at least one component";
@id("64d02000000040008000000000000009") annotation check flow(flow>=0{mol/s});
@id("64d0200000004000800000000000000a") annotation check z(z[j]>=0{1} and z[j]<=1{1});
}
// One reference component is reconstructed only on a receiving state. A supplied
// state supplies all fractions, including the reference, and is checked in full.
@id("64d0200000004000800000000000000b") interface TotalFlowTemperature extends PhysicalState {
@id("64d0200000004000800000000000000c") param reference_component:chemistry.species;
@id("64d0200000004000800000000000000d") require reference_component in components : "the reference component belongs to the state";
@id("64d0200000004000800000000000000e") param independent_components:Set<chemistry.species>={j for j in components where j!=reference_component};
@id("64d0200000004000800000000000000f") override state component_state supplied(defined) {
coordinate flow=flow;
coordinate temperature=T;
coordinate pressure=pressure;
coordinate fraction[j in independent_components]=z[j];
reconstruct reference:z[reference_component]==equilibrium.fraction_unit()*(1-sum(j in independent_components | z[j]/equilibrium.fraction_unit())) tolerance numerical_policy.mole_fraction;
transport component[j in components]=component_flow[j] tolerance numerical_policy.component_flow;
}
}
@id("64d02000000040008000000000000010") interface TotalFlowEnthalpy extends TotalFlowTemperature {
@id("64d02000000040008000000000000011") override state component_state supplied(defined) {
coordinate flow=flow;
coordinate enthalpy=h;
coordinate pressure=pressure;
coordinate fraction[j in independent_components]=z[j];
reconstruct reference:z[reference_component]==equilibrium.fraction_unit()*(1-sum(j in independent_components | z[j]/equilibrium.fraction_unit())) tolerance numerical_policy.mole_fraction;
transport component[j in components]=component_flow[j] tolerance numerical_policy.component_flow;
}
}
// Zero component flows are admitted, but zero total flow cannot determine z.
// Guarded reconstruction refuses that input rather than inventing a composition.
@id("64d02000000040008000000000000012") interface ComponentFlowTemperature extends PhysicalState {
@id("64d02000000040008000000000000013") var component_rate[j in components]:ComponentFlow;
@id("64d02000000040008000000000000014") override let component_flow[j in components]:ComponentFlow=component_rate[j];
@id("64d02000000040008000000000000015") eq coordinate_flow:flow==sum(j in components | component_rate[j]);
@id("64d02000000040008000000000000016") eq coordinate_composition[j in components]:z[j]==composition(component_rate[j],flow);
@id("64d02000000040008000000000000017") annotation check component_rate(component_rate[j]>=0{mol/s});
@id("64d02000000040008000000000000018") annotation check flow(flow>0{mol/s});
@id("64d02000000040008000000000000019") annotation start component_rate(1{mol/s});
@id("64d0200000004000800000000000001a") annotation nominal component_rate(1{mol/s});
@id("64d0200000004000800000000000001b") override state component_state supplied(defined) {
coordinate component[j in components]=component_rate[j];
coordinate temperature=T;
coordinate pressure=pressure;
transport component[j in components]=component_flow[j] tolerance numerical_policy.component_flow;
}
}
@id("64d0200000004000800000000000001c") interface ComponentFlowEnthalpy extends ComponentFlowTemperature {
@id("64d0200000004000800000000000001d") override state component_state supplied(defined) {
coordinate component[j in components]=component_rate[j];
coordinate enthalpy=h;
coordinate pressure=pressure;
transport component[j in components]=component_flow[j] tolerance numerical_policy.component_flow;
}
}
@id("64d0200000004000800000000000001e") interface PhaseComponentFlowTemperature extends PhysicalState {
@id("64d0200000004000800000000000001f") require sum(p in phases | 1)>0 : "a phase coordinate state has at least one phase";
@id("64d02000000040008000000000000020") var phase_component_rate[p in phases,j in components]:ComponentFlow;
@id("64d02000000040008000000000000021") override let phase_component_flow[p in phases,j in components]:ComponentFlow=phase_component_rate[p,j];
@id("64d02000000040008000000000000022") override let phase_flow[p in phases]:Flow=sum(j in components | phase_component_rate[p,j]);
@id("64d02000000040008000000000000023") override let component_flow[j in components]:ComponentFlow=sum(p in phases | phase_component_rate[p,j]);
@id("64d02000000040008000000000000024") eq coordinate_flow:flow==sum(p in phases | phase_flow[p]);
@id("64d02000000040008000000000000025") eq coordinate_composition[j in components]:z[j]==composition(component_flow[j],flow);
@id("64d02000000040008000000000000026") let phase_fraction[p in phases]:Scalar=fraction(phase_flow[p],flow);
@id("64d02000000040008000000000000027") annotation check phase_component_rate(phase_component_rate[p,j]>=0{mol/s});
@id("64d02000000040008000000000000028") annotation check flow(flow>0{mol/s});
@id("64d02000000040008000000000000029") annotation start phase_component_rate(1{mol/s});
@id("64d0200000004000800000000000002a") annotation nominal phase_component_rate(1{mol/s});
@id("64d02000000040008000000000000041") annotation start flow(1{mol/s});
@id("64d02000000040008000000000000042") annotation nominal flow(1{mol/s});
@id("64d0200000004000800000000000002b") override state component_state supplied(defined) {
coordinate phase_component[p in phases,j in components]=phase_component_rate[p,j];
coordinate temperature=T;
coordinate pressure=pressure;
transport component[j in components]=component_flow[j] tolerance numerical_policy.component_flow;
transport phase_component[p in phases,j in components]=phase_component_flow[p,j] tolerance numerical_policy.component_flow;
}
}
// Phase flow and phase composition are independent. A disappearing phase retains
// its supplied/reconstructed composition; it is not inferred from a zero ratio.
// A zero total still refuses the undefined bulk composition and phase fractions.
@id("64d0200000004000800000000000002c") interface PhaseFlowTemperature extends PhysicalState {
@id("64d0200000004000800000000000002d") param reference_component:chemistry.species;
@id("64d0200000004000800000000000002e") require reference_component in components : "the reference component belongs to every selected phase";
@id("64d0200000004000800000000000002f") require sum(p in phases | 1)>0 : "a phase coordinate state has at least one phase";
@id("64d02000000040008000000000000030") param independent_components:Set<chemistry.species>={j for j in components where j!=reference_component};
@id("64d02000000040008000000000000031") var phase_rate[p in phases]:Flow;
@id("64d02000000040008000000000000032") var phase_z[p in phases,j in components]:MoleFraction;
@id("64d02000000040008000000000000033") override let phase_flow[p in phases]:Flow=phase_rate[p];
@id("64d02000000040008000000000000034") eq coordinate_flow:flow==sum(p in phases | phase_rate[p]);
@id("64d02000000040008000000000000035") override let phase_component_flow[p in phases,j in components]:ComponentFlow=phase_rate[p]*phase_z[p,j];
@id("64d02000000040008000000000000036") override let component_flow[j in components]:ComponentFlow=sum(p in phases | phase_component_flow[p,j]);
@id("64d02000000040008000000000000037") eq coordinate_composition[j in components]:z[j]==composition(component_flow[j],flow);
@id("64d02000000040008000000000000038") let phase_fraction[p in phases]:Scalar=fraction(phase_rate[p],flow);
@id("64d02000000040008000000000000039") annotation check phase_rate(phase_rate[p]>=0{mol/s});
@id("64d0200000004000800000000000003a") annotation check flow(flow>0{mol/s});
@id("64d0200000004000800000000000003b") annotation check phase_z(phase_z[p,j]>=0{1} and phase_z[p,j]<=1{1});
@id("64d0200000004000800000000000003c") annotation check phase_rate(abs(sum(j in components | phase_z[p,j]/equilibrium.fraction_unit())-1)<=numerical_policy.dimensionless);
@id("64d0200000004000800000000000003d") annotation start phase_rate(1{mol/s});
@id("64d0200000004000800000000000003e") annotation nominal phase_rate(1{mol/s});
@id("64d02000000040008000000000000043") annotation start flow(1{mol/s});
@id("64d02000000040008000000000000044") annotation nominal flow(1{mol/s});
@id("64d0200000004000800000000000003f") annotation start phase_z(equilibrium.fraction_unit()/sum(j in components | 1));
@id("64d02000000040008000000000000040") override state component_state supplied(defined) {
coordinate phase_flow[p in phases]=phase_rate[p];
coordinate phase_composition[p in phases,j in independent_components]=phase_z[p,j];
coordinate temperature=T;
coordinate pressure=pressure;
reconstruct reference[p in phases]:phase_z[p,reference_component]==equilibrium.fraction_unit()*(1-sum(j in independent_components | phase_z[p,j]/equilibrium.fraction_unit())) tolerance numerical_policy.mole_fraction;
transport component[j in components]=component_flow[j] tolerance numerical_policy.component_flow;
transport phase_component[p in phases,j in components]=phase_component_flow[p,j] tolerance numerical_policy.component_flow;
}
}
}
