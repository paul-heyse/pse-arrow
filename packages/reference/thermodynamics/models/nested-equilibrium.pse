@id("01a0e1a936cf7134841d5b2d8e49f10c") package nested_equilibrium {
@id("30df7686c3ba4bddbee959958bd75e30") use properties @"1.0.0";
@id("5b4edf043cb84baea40f381e0e9a900e") use cubic @"1.0.0";

@id("01a0f14ead4e761899b3c3af2e6242e5") use constants @"1.0.0";
@id("01a0ee04daaa77568ef4eee2f2e72cc0") use chemistry @"1.0.0";
@id("01a0e1a936cf7134841d5b2fa8833a4b") use equilibrium @"1.0.0";
@id("01a0e1a936cf7134841d5b308a81218b") use caloric @"1.0.0";
@id("01a0eeced80374ab83c081d10057cdf2") use peng_robinson @"1.0.0";
@id("01a0eeced80374ab83c081d244503339") use pure_properties @"1.0.0";
@id("01a0e1a936cf7134841d5b312e59333a") interface FlashSplit {
@id("01a0e1a936cf7134841d5b322192dcae") param components:Set<chemistry.species>;
@id("01a0e1a936cf7134841d5b33af8f13d7") var T:Temperature;
@id("01a0e1a936cf7134841d5b34c29bfc53") var pressure:Pressure;
@id("01a0e1a936cf7134841d5b355fbd91e5") var z[j in components]:MoleFraction;
@id("01a0e1a936cf7134841d5b36a29d9517") let beta:Scalar;
@id("01a0e1a936cf7134841d5b3778574673") let x[j in components]:MoleFraction;
@id("01a0e1a936cf7134841d5b380dd072c1") let y[j in components]:MoleFraction;
}
@id("01a0e1a936cf7134841d5b39fc915b63") def IdealFlash(selected:Set<chemistry.species>,vapor_pressure:Fn(T:Temperature,j:chemistry.species)->Pressure):FlashSplit {
@id("01a0e1a936cf7134841d5b3a91161915") override param components:Set<chemistry.species>=selected;
@id("01a0e1a936cf7134841d5b3b0423accc") let feed[j in components]:Scalar=z[j]/equilibrium.fraction_unit();
@id("01a0e1a936cf7134841d5b3ce2589166") let K[j in components]:Scalar=vapor_pressure(T,j)/pressure;
@id("01a0e1a936cf7134841d5b3debe0f37e") let seed:Scalar=equilibrium.rr_start(feed,K,components);
@id("01a0e1a936cf7134841d5b3e8fa7f5f1") implicit split select minimum((1-fraction)*sum(j in components | liquid[j]*(log(liquid[j])+log(K[j])))+fraction*sum(j in components | vapor[j]*log(vapor[j])),1e-9) {
@id("01a0e1a936cf7134841d5b3fe9180357") var fraction:Scalar;
@id("01a0e1a936cf7134841d5b40f068fea6") var liquid[j in components]:Scalar;
@id("01a0e1a936cf7134841d5b41bec55ac9") var vapor[j in components]:Scalar;
@id("01a0e1a936cf7134841d5b422528d81f") annotation bounds fraction(-20,20);
@id("01a0e1a936cf7134841d5b43b04cb995") annotation bounds liquid(1e-10,1);
@id("01a0e1a936cf7134841d5b4406e56877") annotation bounds vapor(1e-10,1);
@id("01a0e1a936d074a8ae57c313ae36eecf") regime two_phase eligible(fraction>0 and fraction<1) {
@id("01a0e1a936d074a8ae57c314d12c0972") eq material[j in components]:feed[j]==(1-fraction)*liquid[j]+fraction*vapor[j];
@id("01a0e1a936d074a8ae57c315ef15c25d") eq normalization:sum(j in components | liquid[j]-vapor[j])==0;
@id("01a0e1a936d074a8ae57c316fadc5d56") eq fugacity[j in components]:log(liquid[j])+log(K[j])==log(vapor[j]);
@id("01a0e1a936d074a8ae57c3170f279ebc") annotation start fraction(seed);
@id("01a0e1a936d074a8ae57c3184c2d8c01") annotation start liquid(feed[j]/(1+seed*(K[j]-1)));
@id("01a0e1a936d074a8ae57c319c1205086") annotation start vapor(K[j]*feed[j]/(1+seed*(K[j]-1)));
}
@id("01a0e1a936d074a8ae57c31a42907889") regime liquid_only eligible(sum(j in components | K[j]*feed[j])<1) {
@id("01a0e1a936d074a8ae57c31b15b66957") eq phase:fraction==0;
@id("01a0e1a936d074a8ae57c31c849bab26") eq composition_l[j in components]:liquid[j]==feed[j];
@id("01a0e1a936d074a8ae57c31d3c75d02e") eq composition_v[j in components]:vapor[j]==K[j]*feed[j]/sum(k in components | K[k]*feed[k]);
@id("01a0e1a936d074a8ae57c31ec57d1d9b") annotation start fraction(0);
@id("01a0e1a936d074a8ae57c31f98b3f75e") annotation start liquid(feed[j]);
@id("01a0e1a936d074a8ae57c320a15f6144") annotation start vapor(K[j]*feed[j]/sum(k in components | K[k]*feed[k]));
}
@id("01a0e1a936d074a8ae57c321927005f1") regime vapor_only eligible(sum(j in components | feed[j]/K[j])<1) {
@id("01a0e1a936d074a8ae57c322a5a92e52") eq phase:fraction==1;
@id("01a0e1a936d074a8ae57c32309045c8a") eq composition_l[j in components]:liquid[j]==(feed[j]/K[j])/sum(k in components | feed[k]/K[k]);
@id("01a0e1a936d074a8ae57c324d6e0db8f") eq composition_v[j in components]:vapor[j]==feed[j];
@id("01a0e1a936d074a8ae57c3255c5a3ef7") annotation start fraction(1);
@id("01a0e1a936d074a8ae57c3262e3ef55b") annotation start liquid((feed[j]/K[j])/sum(k in components | feed[k]/K[k]));
@id("01a0e1a936d074a8ae57c327d6bf8cd9") annotation start vapor(feed[j]);
}
}
@id("01a0e1a936d074a8ae57c3283098c909") realize closure_policy on split using nested;
@id("01a0e1a936d074a8ae57c329f9b9b0ef") override let beta:Scalar=split.fraction;
@id("01a0e1a936d074a8ae57c32a7a53a7d1") override let x[j in components]:MoleFraction=split.liquid[j]*equilibrium.fraction_unit();
@id("01a0e1a936d074a8ae57c32beaac6c47") override let y[j in components]:MoleFraction=split.vapor[j]*equilibrium.fraction_unit();
}
@id("01a0eeced80374ab83c081d38efde5b6") def NestedPRFlash(selected:Set<chemistry.species>,vapor_pressure:Fn(T:Temperature,j:chemistry.species)->Pressure,pkg:properties.property_package,family:cubic.cubic_family=cubic.pr):FlashSplit {
@id("01a0eeced80374ab83c081d42d24356a") override param components:Set<chemistry.species>=selected;
@id("01a0eeced80374ab83c081d5f25d6fd1") let feed[j in components]:Scalar=z[j]/equilibrium.fraction_unit();
@id("01a0eeced80374ab83c081d6d645e5af") let t:Scalar=T/constants.temperature_scale;
@id("01a0eeced80374ab83c081d7e880cad4") let p:Scalar=pressure/constants.pressure_unit;
@id("01a0eeced80374ab83c081d83d236f3f") let K[j in components]:Scalar=vapor_pressure(T,j)/pressure;
@id("01a0eeced80374ab83c081d96835dd53") let seed:Scalar=equilibrium.rr_start(feed,K,components);
@id("01a0eeced80374ab83c081dacaffe6ca") implicit split select minimum((1-fraction)*sum(k in components | liquid[k]*(log(liquid[k])+peng_robinson.compressibility_ln_phi(t,p,liquid_compressibility,liquid,components,k,pkg,family)))+fraction*sum(k in components | vapor[k]*(log(vapor[k])+peng_robinson.compressibility_ln_phi(t,p,vapor_compressibility,vapor,components,k,pkg,family))),1e-9) {
@id("01a0eeced80374ab83c081db14994aa2") var fraction:Scalar;
@id("01a0eeced80374ab83c081dc477abaa0") var liquid[j in components]:Scalar;
@id("01a0eeced80374ab83c081ddbd22059e") var vapor[j in components]:Scalar;
@id("01a0eeced80374ab83c081dea4a20c7c") var liquid_compressibility:Scalar;
@id("01a0eeced80374ab83c081df983b8af1") var vapor_compressibility:Scalar;
@id("01a0eeced80374ab83c081e089c086c2") annotation bounds fraction(-20,20);
@id("01a0eeced80374ab83c081e14d034f23") annotation bounds liquid(1e-10,1);
@id("01a0eeced80374ab83c081e236226fe7") annotation bounds vapor(1e-10,1);
@id("01a0eeced80374ab83c081e3c504e423") annotation bounds liquid_compressibility(0.0001,0.2);
@id("01a0eeced80374ab83c081e40108a8f7") annotation bounds vapor_compressibility(0.5,1.2);
@id("01a0eedc4859757a92b28698fad9418f") annotation nominal liquid_compressibility(0.004);
@id("01a0eedc4859757a92b28699465b0c64") annotation nominal vapor_compressibility(1);
@id("01a0eeced80374ab83c081e54c29cda5") regime two_phase eligible(fraction>0 and fraction<1) {
@id("01a0eeced80374ab83c081e629846668") eq material[j in components]:feed[j]==(1-fraction)*liquid[j]+fraction*vapor[j];
@id("01a0eeced80374ab83c081e7a57ae73a") eq normalization:sum(j in components | liquid[j]-vapor[j])==0;
@id("01a0eeced80374ab83c081e88ed625a0") eq fugacity[j in components]:log(liquid[j])+peng_robinson.compressibility_ln_phi(t,p,liquid_compressibility,liquid,components,j,pkg,family)==log(vapor[j])+peng_robinson.compressibility_ln_phi(t,p,vapor_compressibility,vapor,components,j,pkg,family);
@id("01a0eeced80374ab83c081e970a43092") eq liquid_root:peng_robinson.compressibility_residual(t,p,liquid_compressibility,liquid,components,pkg,family)==0;
@id("01a0eeced80374ab83c081ea13d8f651") eq vapor_root:peng_robinson.compressibility_residual(t,p,vapor_compressibility,vapor,components,pkg,family)==0;
@id("01a0eeced80374ab83c081eb69695c2d") annotation start fraction(seed);
@id("01a0eeced80374ab83c081ec4fe6bfa4") annotation start liquid(feed[j]/(1+seed*(K[j]-1)));
@id("01a0eeced80374ab83c081ed690e4a9a") annotation start vapor(K[j]*feed[j]/(1+seed*(K[j]-1)));
@id("01a0eeced80374ab83c081ee6daab6bd") annotation start liquid_compressibility(0.004);
@id("01a0eeced80374ab83c081ef7b455404") annotation start vapor_compressibility(0.97);
}
@id("01a0eeced80374ab83c081f037dcd405") regime liquid_only eligible(sum(k in components | feed[k]*exp(peng_robinson.compressibility_ln_phi(t,p,liquid_compressibility,liquid,components,k,pkg,family)-peng_robinson.compressibility_ln_phi(t,p,vapor_compressibility,vapor,components,k,pkg,family)))<1) {
@id("01a0eeced80374ab83c081f188e50423") eq phase:fraction==0;
@id("01a0eeced80374ab83c081f2fb80ba33") eq composition_l[j in components]:liquid[j]==feed[j];
@id("01a0eeced80374ab83c081f3f0c29258") eq composition_v[j in components]:vapor[j]==feed[j];
@id("01a0eeced80374ab83c081f4e9290094") eq liquid_root:peng_robinson.compressibility_residual(t,p,liquid_compressibility,liquid,components,pkg,family)==0;
@id("01a0eeced80374ab83c081f599850dd3") eq vapor_root:peng_robinson.compressibility_residual(t,p,vapor_compressibility,vapor,components,pkg,family)==0;
@id("01a0eeced80374ab83c081f62ba13e83") annotation start fraction(0);
@id("01a0eeced80374ab83c081f76bd59690") annotation start liquid(feed[j]);
@id("01a0eeced80374ab83c081f8e4c1ba25") annotation start vapor(feed[j]);
@id("01a0eeced80374ab83c081f94e6ed950") annotation start liquid_compressibility(0.004);
@id("01a0eeced80374ab83c081fa467c95ba") annotation start vapor_compressibility(0.97);
}
@id("01a0eeced80374ab83c081fbb5ecc47e") regime vapor_only eligible(sum(k in components | feed[k]*exp(peng_robinson.compressibility_ln_phi(t,p,vapor_compressibility,vapor,components,k,pkg,family)-peng_robinson.compressibility_ln_phi(t,p,liquid_compressibility,liquid,components,k,pkg,family)))<1) {
@id("01a0eeced80374ab83c081fc213288bb") eq phase:fraction==1;
@id("01a0eeced80374ab83c081fdb0617870") eq composition_l[j in components]:liquid[j]==feed[j];
@id("01a0eeced80374ab83c081fed83732bd") eq composition_v[j in components]:vapor[j]==feed[j];
@id("01a0eeced80374ab83c081ffcc0af8b4") eq liquid_root:peng_robinson.compressibility_residual(t,p,liquid_compressibility,liquid,components,pkg,family)==0;
@id("01a0eeced80374ab83c08200ea3d4707") eq vapor_root:peng_robinson.compressibility_residual(t,p,vapor_compressibility,vapor,components,pkg,family)==0;
@id("01a0eeced80374ab83c08201d4d904b8") annotation start fraction(1);
@id("01a0eeced80374ab83c0820285611369") annotation start liquid(feed[j]);
@id("01a0eeced80374ab83c08203b1efaded") annotation start vapor(feed[j]);
@id("01a0eeced80374ab83c082049b99c518") annotation start liquid_compressibility(0.004);
@id("01a0eeced80374ab83c0820597e810ea") annotation start vapor_compressibility(0.97);
}
}
@id("01a0eeced80374ab83c082062327112f") realize closure_policy on split using nested;
@id("01a0eeced80374ab83c0820754a6e89d") override let beta:Scalar=split.fraction;
@id("01a0eeced80374ab83c0820876de3a5c") override let x[j in components]:MoleFraction=split.liquid[j]*equilibrium.fraction_unit();
@id("01a0eeced80374ab83c082093cb42f6d") override let y[j in components]:MoleFraction=split.vapor[j]*equilibrium.fraction_unit();
}
}
