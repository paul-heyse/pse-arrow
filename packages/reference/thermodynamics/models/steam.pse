@id("64d0300000000000000000000000003f") override param pressure_law:Fn(T:Temperature,rho:Density)->Pressure=vapor_pressure;
@id("64d03000000000000000000000000040") override param enthalpy_law:Fn(T:Temperature,rho:Density)->MolarEnthalpy=vapor_enthalpy;
@id("64d03000000000000000000000000041") override param entropy_law:Fn(T:Temperature,rho:Density)->MolarEntropy=vapor_entropy;
