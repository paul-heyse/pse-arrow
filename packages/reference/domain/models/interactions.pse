// Pair and group data (ADR-0127, review F06): a symmetric binary parameter from one source,
// the source a property package selects for each pair property, and group-contribution
// structure. A method library declares its own typed pair and group-interaction relations
// keyed by source and reads them through the selected source.
@id("01a0f00c1fbc7251b799a7a9b0731015") package interactions {
@id("01a0f00c1fbc7251b799a7aae789884c") use chemistry @"1.0.0";
@id("01a0f00c1fbc7251b799a7ab51f43bfb") use properties @"1.0.0";
@id("01a0f00c1fbc7251b799a7aca85d29ea") use provenance @"1.0.0";
// One source's value of a symmetric pair property for two distinct species, written once per
// unordered pair; either order reads it.
@id("01a0f00c1fbc7251b799a7adb78eefe6") table pair[s: provenance.source, p: properties.property, i: chemistry.species, j: chemistry.species]: Scalar symmetric(i, j) diagonal excluded complete_over(s, p, i, j) require p.shape == properties.IndexShape.pair;
// The source of a package's pair or group data for one property. A lookup without a row is
// refused, naming the package and the property.
@id("01a0f00c1fbc7251b799a7aee600e53a") table pair_selection[k: properties.property_package, p: properties.property]: provenance.source complete_over(k, p) require p.shape != properties.IndexShape.pure;
@id("01a0f00c1fbc7251b799a7aff055a612") fn pair_parameter(k: properties.property_package, p: properties.property, i: chemistry.species, j: chemistry.species) -> Scalar = pair[pair_selection[k, p], p, i, j];
// Group contribution: main groups, their subgroups with volume and surface parameters, and the
// subgroup counts of each species.
@id("01a0f00c1fbc7251b799a7b0f3d2041b") entity kind main_group {}
@id("01a0f00c1fbc7251b799a7b1a088b0ea") entity kind subgroup {
@id("01a0f00c1fbc7251b799a7b271b096a5") attribute main: main_group;
@id("01a0f00c1fbc7251b799a7b346ce8938") attribute r: Scalar;
@id("01a0f00c1fbc7251b799a7b45def587b") attribute q: Scalar;
}
@id("01a0f00c1fbc7251b799a7b53a61c973") table group_count[j: chemistry.species, g: subgroup]: Count missing default 0{1};
}
