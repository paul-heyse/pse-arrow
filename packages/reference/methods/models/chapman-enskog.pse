@id("64d03100000000000000000000000010") package chapman_enskog {
@id("64d03100000000000000000000000011") use constants @"1.0.0";
@id("64d03100000000000000000000000012") use properties @"1.0.0";
@id("64d03100000000000000000000000013") use compatibility @"1.0.0";
@id("64d03100000000000000000000000014") use provenance @"1.0.0";
@id("64d03100000000000000000000000015") entity provenance.source formulation {title="The Properties of Gases and Liquids, fifth edition, equations 9-3.9 and 9-4.3: dilute-gas Chapman–Enskog viscosity and Neufeld collision integral"}
@id("64d03100000000000000000000000016") constant molar_mass_scale:MolarMass=0.001{kg/mol} provenance(formulation,provenance.Role.published);
// The reduced formula uses molar mass in g/mol, T in K and diameter in Å.
// Converting its 26.69 micropoise prefactor to SI supplies the output scale.
@id("64d03100000000000000000000000017") constant viscosity_scale:DynamicViscosity=2.669e-6{Pa*s} provenance(formulation,provenance.Role.published);
@id("64d03100000000000000000000000018") entity kind neufeld extends properties.viscosity_set {
@id("64d03100000000000000000000000019") attribute diameter:Length storage {m};
@id("64d0310000000000000000000000001a") attribute well_temperature:TemperatureScale storage {K};
@id("64d0310000000000000000000000001b") require phase_type==compatibility.PhaseType.vaporPhase and diameter>0{m} and well_temperature>0{K} : "Chapman–Enskog requires a vapor-phase selection with positive Lennard–Jones diameter and well temperature";
@id("64d0310000000000000000000000001c") require (if present(subject.molar_mass) then subject.molar_mass else 0{kg/mol})>0{kg/mol} : "Chapman–Enskog requires a positive molar mass from the selected species";
@id("64d0310000000000000000000000001d") viscosity=gas_viscosity;
@id("64d0310000000000000000000000001e") applicability=unknown_dilute_range;
}
@id("64d0310000000000000000000000001f") applicability unknown_dilute_range(T:Temperature,s:neufeld) owner neufeld scope data evidence s.source unknown("The selected Lennard–Jones fit does not specify an empirical dilute-gas applicability interval");
// Positive arguments ensure the real logarithm and square root are defined;
// they do not extend the empirical method to dense fluids or other phases.
@id("64d03100000000000000000000000020") coordinate map coordinates(T:Temperature,s:neufeld) valid(T>constants.absolute_zero) {
@id("64d03100000000000000000000000021") slot kelvin=T/constants.temperature_scale;
@id("64d03100000000000000000000000022") slot reduced_temperature=T/s.well_temperature;
@id("64d03100000000000000000000000023") slot diameter=s.diameter/constants.segment_length;
@id("64d03100000000000000000000000024") slot molar_mass=(if present(s.subject.molar_mass) then s.subject.molar_mass else 0{kg/mol})/molar_mass_scale;
}
@id("64d03100000000000000000000000025") reconstruction viscosity for coordinates(T:Temperature,s:neufeld)->DynamicViscosity reference formulation=viscosity_scale;
// The collision integral is evaluated in the same reduced-coordinate law.
@id("64d03100000000000000000000000027") fn reduced_viscosity(kelvin:Coordinate<coordinates.kelvin>,reduced_temperature:Coordinate<coordinates.reduced_temperature>,diameter:Coordinate<coordinates.diameter>,molar_mass:Coordinate<coordinates.molar_mass>,s:neufeld)->Reduced<viscosity>=sqrt(molar_mass*kelvin)/(diameter^2*omega) where omega=1.16145*exp(-0.14874*log(reduced_temperature))+0.52487*exp(-0.77320*reduced_temperature)+2.16178*exp(-2.43787*reduced_temperature);
@id("64d03100000000000000000000000028") fn gas_viscosity(T:Temperature,s:neufeld)->DynamicViscosity applicability(s.applicability(T,s)) valid(T>constants.absolute_zero)=reconstruct(viscosity,reduced_viscosity,T,s);
}
