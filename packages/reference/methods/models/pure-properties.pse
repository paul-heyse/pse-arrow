@id("01a0e15d9eff71b98e7519e7bacb2a92") package pure_properties {
@id("01a0f13f1de571549177b1c8fdc15295") use properties @"1.0.0";
@id("01a0f13f1de571549177b1c9ee36778b") interface VaporPressure {
@id("01a0f13f1de571549177b1ca53658059") param T:Temperature;
@id("01a0f13f1de571549177b1cb169e93a8") let pressure:Pressure;
}
@id("01a0f13f1de571549177b1cccfb24db3") def VaporPressureSet(s:properties.vapor_pressure_set):VaporPressure {
@id("01a0f13f1de571549177b1cdc86e1ac6") override let pressure:Pressure=properties.saturation_pressure(s,T);
}
}
