@id("01a0e1484fb87705b3f22bcc49115347") package caloric {
@id("01a0f13f1de571549177b1ceb9425cf5") use properties @"1.0.0";
@id("01a0f13f1de571549177b1cfdb4ab8a4") def CaloricReference(s:properties.caloric_set) {
@id("01a0f13f1de571549177b1d0ae99cb2b") param T:Temperature;
@id("01a0f13f1de571549177b1d14446f6d5") param T_reference:Temperature;
@id("01a0f13f1de571549177b1d2c659ad98") param h_reference:MolarEnthalpy;
@id("01a0f13f1de571549177b1d3829272a4") param s_reference:MolarEntropy;
@id("01a0f13f1de571549177b1d47c65d7c7") let cp:MolarCp=properties.caloric_cp(s,T);
@id("01a0f13f1de571549177b1d5e4de1d02") let enthalpy:MolarEnthalpy=h_reference+properties.caloric_dh(s,T_reference,T);
@id("01a0f13f1de571549177b1d620ef5a94") let entropy:MolarEntropy=s_reference+properties.caloric_ds(s,T_reference,T);
}
}
