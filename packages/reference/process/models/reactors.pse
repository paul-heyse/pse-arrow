@id("b79a061e0dd9457b8249f2afcee73e1d") package reactors {
@id("73e9f7cd1f0d417a9f88db56742be3d6") use caloric @"1.0.0";
@id("2659777aab884fbb9b22d3a06e0812d9") use helmholtz @"1.0.0";
@id("6b1048fd2cfe4660ac34be15f0ce901d") use kinds @"1.0.0";
@id("cc4293f7a9a24deeb0160f9804ebf817") use equilibrium @"1.0.0";
@id("c6f7b655191549fb8f4819344cabafd8") use aqueous @"1.0.0";
@id("fa1a7c1344694910a9a4d8e8e4cd347a") use reactions @"1.0.0";
@id("1d34bc92921f4656bfb3c19c980f17ce") use control_volumes @"1.0.0";
@id("6ba1eaf7ae4042aeb81dc761ce52e574") fn volume_unit()->Volume=1{m3};
@id("73d2637eb9c74b6585ae042562d66d14") fn power_unit()->Power=1{W};
@id("4b6effccc1a64c338c4915767a4288b6") fn reaction_heat_unit()->ReactionHeat=1{J/mol};
@id("ecb3aec4215b4aed87fb9f5bd8c81f71") fn stored_energy(volume:Volume,density:Density,enthalpy:MolarEnthalpy,pressure:Pressure)->Energy=1{J}*(volume/volume_unit())*((density/helmholtz.density_unit())*((enthalpy-equilibrium.enthalpy_datum())/caloric.h_unit())-(pressure-100000{Pa})/equilibrium.pressure_difference_unit());
@id("b176836e913849d69b3597b74930af5b") def CSTR(inlet_pkg:aqueous.DiluteLiquid,outlet_pkg:aqueous.DiluteLiquid,reaction_pkg:reactions.RateLaw,holdup:Boolean=false):control_volumes.ControlVolume0D {
@id("ffb822da2fca45b6a421c985d8556664") override param has_holdup:Boolean=holdup;
@id("55823dd9a6794dbfb616805e0b9ea56d") require material_basis==control_volumes.MaterialBalance.componentTotal : "CSTR reaction sources use component-total balances";
@id("ccba2a74d5454952919cffe0e88da858") override param inlet_package:equilibrium.ThermoPackage=inlet_pkg;
@id("1790cc6952374574b4bb1b2eb7011b99") override param outlet_package:equilibrium.ThermoPackage=outlet_pkg;
@id("af4800211ca84b30ac2b2ef22df75993") override child inlet:aqueous.DiluteLiquid=inlet_pkg;
@id("798186e63641424e83bc1c7b4731b41a") override child outlet:aqueous.DiluteLiquid=outlet_pkg;
@id("9e9040ca12634b7a9579c1cb5dbdb7d9") child reaction:reactions.RateLaw=reaction_pkg;
@id("f17710cf241c478b807cd5c237f69084") param reaction_set:Set<kinds.reaction>=reaction_pkg.reactions;
@id("0839c88a4a90484ca4ed59bfaaabc446") require reaction_pkg.components==components : "reaction and material state component sets must agree";
@id("24152de1d8284af8b0d1045aa8ee3d47") var volume:Volume;
@id("2e9d9e6619b9449bb6a32f386e7529fb") annotation bounds volume(1e-12{m3},1000000{m3});
@id("070735ac141e42339543408b766e9506") annotation start volume(0.001{m3});
@id("e6952598afe746079441d014bdc63685") annotation nominal volume(0.001{m3});
@id("74b5b1ab7850440aa06bc96702b4ff53") eq no_work:work==0{W};
@id("890eeb5934e44ebfaba2d7dc69323a7a") eq reaction_temperature:reaction.T==outlet.T;
@id("0e9713dada6a412d90dd6973920bcb77") eq reaction_concentration[j in components]:reaction.concentration[j]==outlet.concentration[j];
@id("7698bf5614144e809115bbf0344a1b7b") let extent[r in reaction_set]:Scalar=(volume/volume_unit())*(reaction.rate[r]/reactions.rate_unit());
@id("7e7946177bf341dd8e5bcc6ded1b6913") contribute [r in reaction_set,j in components] material[j] role positive=equilibrium.component_flow_unit()*extent[r]*reaction.stoich[r,j];
@id("088ad63dc48a420eb0627deb45cd79e5") contribute [r in reaction_set] energy role positive=-power_unit()*extent[r]*(reaction.heat[r]/reaction_heat_unit());
@id("32def9d5a822404089c2e688c67df190") when has_holdup {
@id("cb09d6e68c514c018da88318bffe15ab") eq material_inventory[p in phases,j in components]:phase_material_holdup[p,j]==volume*outlet.concentration[j];
@id("a06e6a7005bd42da9619a9c989ac2329") eq energy_inventory[p in phases]:phase_energy_holdup[p]==stored_energy(volume,outlet.total_density,outlet.h,outlet.pressure);
}
@id("aae99fe4c27d438d8c7f737407508029") annotation report outlet.concentration("outlet concentration");
@id("64b4980f119a4395be5aba4e3e7fd0e9") annotation report extent("reaction extent in mol/s");
}
@id("e839c4490b804072b5a2737fce4ddf69") use distributed_volumes @"1.0.0";
@id("6dd82d02107547baadd19fcebeee925c") fn length_unit()->Length=1{m};
@id("7f429ddba89f43cf8e2d1043e5ccab8f") fn area_unit()->Area=1{m2};
@id("df9e4db62215402abcda00bd2606e0c8") def PFR(inlet_pkg:aqueous.DiluteLiquid,outlet_pkg:aqueous.DiluteLiquid,reaction_pkg:reactions.RateLaw,elements:Integer=20,use_radau:Boolean=false,order:Integer=3):distributed_volumes.ControlVolume1D {
@id("f06c2a96812044ed95f4e91faa7025dd") override param inlet_package:equilibrium.ThermoPackage=inlet_pkg;
@id("aceb8506234242e899c56c999495b976") override param outlet_package:equilibrium.ThermoPackage=outlet_pkg;
@id("eb498aeb6e6a4620a79673b66bf7f38d") override param finite_elements:Integer=elements;
@id("61d143637a1a4b69a2d2fadf211fa139") override param radau_scheme:Boolean=use_radau;
@id("1deb3fd98bfc4fda978aee8e689ebf36") override param interpolation_order:Integer=order;
@id("616dcfe48cb14e5191ec871a0654d221") override child state[i in x]:aqueous.DiluteLiquid=if i==0 then inlet_pkg else outlet_pkg;
@id("05b25f09b3c54a98ade20b8517199cb0") param reaction_set:Set<kinds.reaction>=reaction_pkg.reactions;
@id("bffc26989b5044eba0042a62fa6feed0") require reaction_pkg.components==components : "reaction and spatial material components must agree";
@id("4481793703b344c2a09816dc4f040917") child reaction[i in x]:reactions.RateLaw=reaction_pkg;
@id("125ea57b237d415493e0563d0220ffde") var length:Length;
@id("2e12c01a725a49b4b29aa1f74ebbf059") var area:Area;
@id("26c61e74605a488a9bb4de3f5e16a77b") var heat_duty:Power;
@id("11357196c98e4c26b51dda40885f226f") var delta_pressure:DeltaPressure;
@id("8b11a8c2c6344ebbabdc25632e4d7027") let volume:Volume=volume_unit()*(length/length_unit())*(area/area_unit());
@id("b7eeff8e152c4bab95db2dd926c13c89") annotation bounds length(1e-10{m},100000{m});
@id("2b375228c6924f2cb6a4fe5b58221eb7") annotation bounds area(1e-10{m2},100000{m2});
@id("a21c73bc81fe4901b1742390be1723d2") annotation start length(0.5{m});
@id("735d697a36634561b9d138fff4798017") annotation start area(0.1{m2});
@id("cbcddbe7589d4ba3a8ce1c4b70cd5046") annotation start heat_duty(0{W});
@id("4cd35163338a41a6a0b22db26ced3f7b") annotation start delta_pressure(0{Pa});
@id("3b0353b9b78a4227aa2ba9d1242798ad") eq heat_distribution[i in x]:heat[i]==heat_duty;
@id("25c2a6470a3b4d54970cfb80f50e8de0") eq no_work[i in x]:work[i]==0{W};
@id("50113ce2906d4df2b02ce17f19f461aa") eq pressure_distribution[i in x]:pressure_gradient[i]==delta_pressure;
@id("c9b34c6f9b3841abbcf00741ddd7914e") eq reaction_temperature[i in x]:reaction[i].T==state[i].T;
@id("b7e502200a124a15a658f63d6c371954") eq reaction_concentration[i in x,j in components]:reaction[i].concentration[j]==state[i].concentration[j];
@id("0ebcdd27f1544627aa7572acd5b5b0d4") let reaction_extent[i in x,r in reaction_set]:Scalar=(volume/volume_unit())*(reaction[i].rate[r]/reactions.rate_unit());
@id("4a54526c0701428b8e50134e16308634") contribute [i in x,r in reaction_set,j in components] material_source[i,j] role positive=equilibrium.component_flow_unit()*reaction_extent[i,r]*reaction[i].stoich[r,j];
@id("6c859f627f434a3a86917b0251b4cb93") contribute [i in x,r in reaction_set] energy_source[i] role positive=-power_unit()*reaction_extent[i,r]*(reaction[i].heat[r]/reaction_heat_unit());
@id("16913b65237d40508baef2f64ebd3ecd") port outlet_temperature:Temperature=state[1].T;
@id("7d6ba7238ab54574b592568d2932ab62") port outlet_pressure:Pressure=state[1].pressure;
@id("577ef29f5d1c4668a1dc9acc4d89d584") port outlet_concentration[j in components]:MolarDensity=state[1].concentration[j];
@id("bd5c2658282d4c9a9f91556d45f295a3") annotation report outlet_temperature("PFR outlet temperature");
@id("8920443ceb884fe088617d900f2324c1") annotation report outlet_concentration("PFR outlet concentration");
}
}
