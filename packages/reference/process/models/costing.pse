@id("b4640cd490084005b748815ff4ce80e4") package costing {
@id("feac9e35e86743c4bd949d48ca47c8de") entity kind hx_design {}
@id("61b47220a38c4466b2669a9bd24c809f") entity kind hx_material {}
@id("92824211ea824cf9b9707ea17f30ccc3") entity kind tube_length {}
@id("369b706de7d84df7bb9fa97183ff3993") entity hx_design floating {}
@id("aea53d1b24014865af744cd37f58e364") entity hx_design fixed {}
@id("d16f24c2af194ac3ac1ad70da5878655") entity hx_design utube {}
@id("417a8f965d894d85aee0920df9a40368") entity hx_design kettle {}
@id("68aebbd09b284c7ca06d02f92842dca5") entity hx_material carbon_carbon {}
@id("fe3412d5ed03413d9e906b9d9411fac4") entity hx_material carbon_brass {}
@id("9d874508ce9842998c1de4b0528b8412") entity hx_material carbon_stainless {}
@id("789259a977c6472bbbc8ad4535fb3877") entity hx_material carbon_monel {}
@id("3a7de96bb46a4d0bb36f34932c16687d") entity hx_material carbon_titanium {}
@id("02ddab27a4764d42b523380ab8c62118") entity hx_material carbon_crmo {}
@id("eabf6a7f0e48469ca1fb35135780d7c7") entity hx_material crmo_crmo {}
@id("7a3240553e3d44f9b16296344fb0a68c") entity hx_material stainless_stainless {}
@id("ab29fb96747242cd839471960f8cc88c") entity hx_material monel_monel {}
@id("e08536ee30c74ca79f953aeb276f5ea1") entity hx_material titanium_titanium {}
@id("744be291289644aab0fceb9e2f79f56f") entity tube_length eight {}
@id("c095d4f089fb4ed88cb79bcfbab7d7fd") entity tube_length twelve {}
@id("ec70e2d4a79c4313883a033041dde3d1") entity tube_length sixteen {}
@id("cbfdf9a87e5041e4bf512c3a4a48518d") entity tube_length twenty {}
@id("1fe0e59de7df4951bc1aced29b50d020") table design_coefficients[d:hx_design]:{constant:Scalar,linear:Scalar,quadratic:Scalar} complete_over(d);
@id("e1f183461bdb4f08b9dec444556478a8") table material_coefficients[m:hx_material]:{offset:Scalar,exponent:Scalar} complete_over(m);
@id("cda011e4a3f74dfd9b51d4dc32cd03a4") table length_factor[l:tube_length]:Scalar complete_over(l);
@id("8f71dc0c02f84ddc8c7033d1fb607799") fn square_foot()->Area=0.09290304{m^2};
@id("97c5376022b34a2d95e9200d0e935fc7") fn atmospheric_pressure()->Pressure=101325{Pa};
@id("63abf3f232a54b73a4087fc469dfc344") fn hundred_psi()->DeltaPressure=689475.7293168361{Pa};
@id("3838198bd3b04d2ca0e313b7a6071b42") fn currency_unit()->CapitalCost=1{USD_CE500};
@id("e65466ca94df46418736981dbf0d735f") fn base_amount(area:Scalar,a:Scalar,b:Scalar,c:Scalar)->Scalar valid(area>0)=exp(a+log(area)*(c*log(area)-b));
@id("cc0da20ecd9b4a6d840c2dfdb93501c4") interface UnitCosting {
@id("e6e8fd837baa47dd857ef4e946d8315e") let capital_cost:CapitalCost;
}
@id("6276490b85754d9f90b9c799c221b4cd") def HeatExchangerCost(design:hx_design=utube,material:hx_material=stainless_stainless,tubes:tube_length=twelve,pressure_extrapolation:Boolean=false):UnitCosting {
@id("ca87aee5fa024564bf08647139341442") var area:Area;
@id("aeaa377854134283b6220bc13cac79f6") var pressure:Pressure;
@id("a4ff2fca53244c83accd0c89ab672a6c") param oversize:Scalar=1.1;
@id("9472a2f6918545d79ea54b93933c9cca") annotation bounds area(1e-8{m^2},1000000{m^2});
@id("db2113ca0bb74391ba5132f7c7c50f28") annotation start area(1000{m^2});
@id("87f3b2587c2a489d926410e2c8fc09aa") annotation start pressure(202650{Pa});
@id("f9ba6722c6814f3590f1fc832b060195") annotation valid oversize(1.1,1.5,reject);
@id("2f5889e48a434688a43e0ea17e2dd707") let area_per_unit:Scalar=area/square_foot();
@id("09d66a8512294a8d81c53960b8a64799") let base_cost_per_unit:CapitalCost=currency_unit()*base_amount(area_per_unit*oversize,design_coefficients[design].constant,design_coefficients[design].linear,design_coefficients[design].quadratic);
@id("6ae2f809b1f2455ca84953dbca27e735") let material_factor:Scalar=if material==carbon_carbon then 1 else material_coefficients[material].offset+(area_per_unit/100)^material_coefficients[material].exponent;
@id("cba1ee22fa6b4b6894c058ea7cc13201") let normalized_pressure:Scalar=(pressure-atmospheric_pressure())/hundred_psi();
@id("52817caaba4742d9b71182aacf2a16e9") let pressure_factor:Scalar=0.9803+normalized_pressure*(0.0180+0.0017*normalized_pressure);
@id("858341fb32b34562a9d067b114830b59") let capital_cost:CapitalCost=base_cost_per_unit*material_factor*pressure_factor*length_factor[tubes];
@id("c70589f9e1ef44d6b6af04f64eb3da60") when pressure_extrapolation {
@id("e4de402caf8e47759788c4c0d8606f61") annotation valid pressure(atmospheric_pressure()+hundred_psi(),atmospheric_pressure()+20*hundred_psi(),extrapolate);
}
@id("4e587ef2498848c2a70ff11d1fe08c56") when not pressure_extrapolation {
@id("52f6cd839dc74a9599ba885c54e72618") annotation valid pressure(atmospheric_pressure()+hundred_psi(),atmospheric_pressure()+20*hundred_psi(),reject);
}
@id("a2b764f0890043ac882d3c6fc676968d") annotation report capital_cost("capital cost at CEPCI 500");
@id("3fd7e3a60430421d8078acf48dee48f6") annotation report base_cost_per_unit("base purchase cost");
@id("6073944898af47fabca6c3d73d6e2a72") annotation report area_per_unit("area in square feet");
}
}
