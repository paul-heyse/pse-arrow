@id("35967416f406452a98e2d8798bc7c3eb") package control_volumes {
@id("effedc6b569b4c5cb75bc8ac1cb16ac3") use numerical_policy @"1.0.0";
@id("01a0ede58eca75b18609170950fe7e0d") use chemistry @"1.0.0";
@id("06e61a91f30f4151873a54209bd83190") use equilibrium @"1.0.0";
@id("bee5ac9c31614333966f869cce24e75a") enum MaterialBalance {@id("01a0eec94a7e70229fdabc155f05ce35") componentPhase, @id("01a0eec94a7e70229fdabc1624f82bfd") componentTotal, @id("01a0eec94a7e70229fdabc17007c4779") elementTotal, @id("01a0eec94a7e70229fdabc181f583a21") total}
@id("871ea161bbee48cbb24df15d8158ff3d") use provenance @"1.0.0";
@id("462ad7b4791a441788598716352b4049") entity provenance.source elemental_projection_reference {title="Element counts per species project molar component flow onto its declared element"}
@id("0829ca78822e4bb6adc2df41f6e4054f") coordinate map elemental_coordinates(count:Count,j:chemistry.species,e:chemistry.element) {
@id("e558e51bf3f14cceb90b16960531c7b2") slot coefficient=count;
}
@id("63442c817f054f09a2d35a050423f701") reconstruction elemental_projection for elemental_coordinates(count:Count,j:chemistry.species,e:chemistry.element)->ElementCountPerSpecies reference elemental_projection_reference=1;
@id("2006f8dd9f0a4be7b80200666011aa6e") fn reduced_elemental_projection(coefficient:Coordinate<elemental_coordinates.coefficient>,j:chemistry.species,e:chemistry.element)->Reduced<elemental_projection>=coefficient;
@id("04f7049de5394192964d37196fb1b115") fn element_coefficient(count:Count,j:chemistry.species,e:chemistry.element)->ElementCountPerSpecies=reconstruct(elemental_projection,reduced_elemental_projection,count,j,e);
@id("0ce1490219af5196a661ffdf251e8a20") use kinds @"1.0.0";
@id("090b2b2f6cd55055afb4be968183220f") entity kinds.port_set inlet_boundary {}
@id("88de8f99f09f52cda6269f23f2b4cdc8") entity kinds.port_set outlet_boundary {}
@id("95ceb9da026754e9bf6f5e73c3f957d2") interface IndexedBalances {
// All balance modes share the global typed physical design allowances.
// Conservation still imposes native row requirements; observation/accounting
// remain distinct meanings rather than alternate ways to bypass conservation.
@id("eea7622247ee5fce9347ce9f696827b8") param inlet_boundaries:Set<kinds.port_set>;
@id("3c22663740b95635b4611e066249167a") param outlet_boundaries:Set<kinds.port_set>;
@id("c97011f537d55951b235eb66bda530df") param components:Set<chemistry.species>;
@id("94ab798eaa06514b9d6fa205b3da593a") param phases:Set<chemistry.phase>;
@id("2aa462867e4054e38e714e787a9ad497") param elements:Set<chemistry.element>={};
@id("ea114c7f5bf453fbaeb41e7395f13466") param material_basis:MaterialBalance=MaterialBalance.componentTotal;
@id("06a3e23a26a3566299ba5853645d2b2d") param algebraic_balances:Boolean=true;
@id("d7f412b17fe453158b54b71fbadd0b81") param observe_balances:Boolean=false;
@id("b5e092a74b435f67be40f34c9e066969") boundary energy_boundary;
@id("a90b4b0cf35758bebeeee527680e0c66") let in_component[i in inlet_boundaries,j in components]:ComponentFlow;
@id("dbab3c2a3290596c8ab28a943c8a95d3") let out_component[o in outlet_boundaries,j in components]:ComponentFlow;
@id("59ddafa49cf8518d8f6e1154a5871182") let in_phase_component[i in inlet_boundaries,p in phases,j in components]:ComponentFlow;
@id("03c9da341ce85e95b83a91e72c3da2ba") let out_phase_component[o in outlet_boundaries,p in phases,j in components]:ComponentFlow;
@id("2f774260515254489543dd7822843096") let in_energy[i in inlet_boundaries]:Power;
@id("4441b99aae3e522a9569e0d7103416e8") let out_energy[o in outlet_boundaries]:Power;
@id("fe93f3dd62ed5bd79721ecda0abfd3eb") let in_total[i in inlet_boundaries]:Flow;
@id("8b880beef829548a88179196771bd295") let out_total[o in outlet_boundaries]:Flow;
@id("75b6de4420155e64b4d59bccb2c68961") when material_basis==MaterialBalance.componentTotal {
@id("2f92504cac5a57808558b118d30ba845") when algebraic_balances and not observe_balances {
@id("24a82c6a754355f6b519c96985fc6329") accumulate material[j in components]:ComponentFlow conservation tolerance numerical_policy.component_flow;
}
@id("db3567bff1225d67b610dae813e78080") when observe_balances {
@id("bfdf74133c0652fd988fd741a12220dc") accumulate material[j in components]:ComponentFlow observation tolerance numerical_policy.component_flow;
}
@id("986f97f726be5b228dc7cd92ab170df5") when not algebraic_balances and not observe_balances {
@id("02395ac96f725b388b7169630af08ae1") accumulate material[j in components]:ComponentFlow accounting tolerance numerical_policy.component_flow;
}
@id("d619511d33c95dc185851ac7ea47a0d4") contribute [i in inlet_boundaries,j in components] material[j] role inflow=in_component[i,j];
@id("b46f2cd061825bf2baacb214e49fdd67") contribute [o in outlet_boundaries,j in components] material[j] role outflow=out_component[o,j];
}
@id("9cf9c88c71fa5aaa811fbbf5b5dc2d2d") when material_basis==MaterialBalance.componentPhase {
@id("9fd237cf270d55688ad2acd7d416d089") when algebraic_balances and not observe_balances {
@id("2330f74fe2a65cc189e1007edb28a76d") accumulate phase_material[p in phases,j in components]:ComponentFlow conservation tolerance numerical_policy.component_flow;
}
@id("dcf1a37515a15df98b3a7fbe62078c86") when observe_balances {
@id("4125f9a4ded45998abebba10d22f1cfe") accumulate phase_material[p in phases,j in components]:ComponentFlow observation tolerance numerical_policy.component_flow;
}
@id("9cbc39ada5d957c3ac6bb0a78a7d1ad4") when not algebraic_balances and not observe_balances {
@id("ce48121e648d5800bd762eaa9fac6c77") accumulate phase_material[p in phases,j in components]:ComponentFlow accounting tolerance numerical_policy.component_flow;
}
@id("9724f1067ddf52a989b5d9ae689c5ed1") contribute [i in inlet_boundaries,p in phases,j in components] phase_material[p,j] role inflow=in_phase_component[i,p,j];
@id("cfc9b81bdf85533f86107bb0a2cfdc0b") contribute [o in outlet_boundaries,p in phases,j in components] phase_material[p,j] role outflow=out_phase_component[o,p,j];
}
@id("b01eb517d812529ebaa84864025d492a") when material_basis==MaterialBalance.elementTotal {
@id("a5c32de27ea75823918d3abbe4b65a39") require sum(j in components | if j.composition==chemistry.CompositionKnowledge.Complete then 0 else 1)==0 : "IncompleteComposition: elemental balances require complete component composition";
@id("cd35358cf65b5923aa11106d1e51c5a7") require sum(e in elements | 1)>0 : "element balances require a nonempty declared element set";
@id("66a05abff63d5272b588db6ff655f46d") when algebraic_balances and not observe_balances {
@id("3ccadbcfa493544baca299850594669a") accumulate element_material[e in elements]:ElementFlow conservation tolerance numerical_policy.element_flow;
}
@id("0d49c954820b550ca773d6a589d26cb8") when observe_balances {
@id("dc186e66bf8252238b527b731a365452") accumulate element_material[e in elements]:ElementFlow observation tolerance numerical_policy.element_flow;
}
@id("52e9861c63c55c30a0af6f8df6579170") when not algebraic_balances and not observe_balances {
@id("f6cdcec7c3b05a8ba2871410069927e5") accumulate element_material[e in elements]:ElementFlow accounting tolerance numerical_policy.element_flow;
}
@id("3179567b6666534189196d4d9a90eae9") contribute [i in inlet_boundaries,e in elements] element_material[e] role inflow=sum(j in components | in_component[i,j]*element_coefficient(chemistry.element_count(j,e),j,e));
@id("8573395b9f36560b8b30d2f1d63f7ca4") contribute [o in outlet_boundaries,e in elements] element_material[e] role outflow=sum(j in components | out_component[o,j]*element_coefficient(chemistry.element_count(j,e),j,e));
}
@id("d6613beb5fd052c699aff813c3044881") when material_basis==MaterialBalance.total {
@id("6609df20a0dd5a0abe6edf385cd776eb") when algebraic_balances and not observe_balances {
@id("8526bf09cf885326a2caf421ae9e4916") accumulate total_material:Flow conservation tolerance numerical_policy.molar_flow;
}
@id("b7bf5c9ccf96556daa9fa0fca39a7d53") when observe_balances {
@id("e42bcb8c493b58a99b74c7440c9397ad") accumulate total_material:Flow observation tolerance numerical_policy.molar_flow;
}
@id("380d43659949587682f159c43025b95b") when not algebraic_balances and not observe_balances {
@id("6982903961325ec0934f374f2e05aed0") accumulate total_material:Flow accounting tolerance numerical_policy.molar_flow;
}
@id("6788193f1d13512d9223990aefe9288c") contribute [i in inlet_boundaries] total_material role inflow=in_total[i];
@id("bbb5887a6cb052e59ca1172bbc3b8fc3") contribute [o in outlet_boundaries] total_material role outflow=out_total[o];
}
@id("ec30a9f1a0325d10aa119a9fe5a3ceaa") when true {
@id("c009f8e75656531e8a0ef7da396b8e37") when algebraic_balances and not observe_balances {
@id("1a8a8d57c60a54f48e30750a70aadb8f") accumulate energy:Power boundary energy_boundary conservation tolerance numerical_policy.power;
}
@id("456e0a3825ae552db06a47a0ac0a571b") when observe_balances {
@id("3b694a67a208522e9785e5cfafdb77f8") accumulate energy:Power boundary energy_boundary observation tolerance numerical_policy.power;
}
@id("01464a08d4de5774b9d620f73ff09a80") when not algebraic_balances and not observe_balances {
@id("f549e512c3495185884e0b52f34be847") accumulate energy:Power boundary energy_boundary accounting tolerance numerical_policy.power;
}
@id("ee7bd047059d5f3f8cd21e211808b3a8") contribute [i in inlet_boundaries] energy role inflow=in_energy[i];
@id("bccf42a494d25a6dbd9a33e6845966d3") contribute [o in outlet_boundaries] energy role outflow=out_energy[o];
}
}
@id("40f0b54ac58945819315b96a5663bb71") interface ControlVolume0D extends IndexedBalances {
@id("ed28654dfc04469eb777c6393db2ff5d") param has_holdup:Boolean=false;
@id("9f92fa22dae34cecb63ad8fc5935cb94") when has_holdup {
@id("e65add71c52a47af97cfa4115c432f3d") var phase_material_holdup[p in phases,j in components]:Amount;
@id("866d1dac169543028f4088c7e7fe102f") var phase_energy_holdup[p in phases]:Energy;
@id("2f839079384d4509980d40ce26a1b8f9") annotation start phase_material_holdup(1{mol});
@id("23825a758e134c81bc7807fd86c9132b") annotation nominal phase_material_holdup(1{mol});
@id("c72f2e1a9eb04616a8952fafdf3d099a") annotation start phase_energy_holdup(1000{J});
@id("6444a049da5e4486bbd1c7bad8a7fbc1") annotation nominal phase_energy_holdup(10000{J});
}
@id("01a0ee398db8733eb490d0d695def0fe") param time:Set<Time>={};
@id("01a0ee414bb27705867410005413e924") require not analysis.dynamic or not has_holdup or sum(i in time | 1)==1 : "a dynamic control volume is evaluated at one instant of its owner's time domain";
@id("01a0ee398db8733eb490d0d7e02bf428") param constant_inventory:Set<chemistry.species>={};
@id("01a0ee398db8733eb490d0d8816a79bf") param evolving_inventory:Set<chemistry.species>={j for j in components where not (j in constant_inventory)};
@id("4fee7b020ea94caaae04d6d470202852") override param material_basis:MaterialBalance=MaterialBalance.componentTotal;
@id("9b5e8a73656444e1b1db2b41a049c162") override param phases:Set<chemistry.phase>=outlet_package.phases;
@id("0fecf4a5ef1b476e9d7e154dc118c3bb") override param elements:Set<chemistry.element>={};

@id("106bd81f5f93497884ab1374afebc60e") param inlet_package:equilibrium.ThermoPackage;
@id("c3d86eece83048a186ad684765daed71") param outlet_package:equilibrium.ThermoPackage;
@id("07be8fcd4a814d7d944468c3057ab7a3") override param components:Set<chemistry.species>=outlet_package.components;
@id("c6bb619d7e3841e491b89d2573e15323") require inlet_package.components==components : "control-volume states must have identical component membership";
@id("25b038cd5d4542a5892c53689605e1f3") when material_basis==MaterialBalance.componentPhase {
@id("9672802677494ee296c875c617af997f") require inlet_package.phases==phases : "phase-component balances require matching declared phase membership";
}
@id("8a5fc0115d4a45628b40a3c09d63064c") require inlet_package.defined and not outlet_package.defined : "the inlet is specified and the outlet supplies its state normalization";
@id("b2ed414fb8334b78a1e928ccf96399e8") child inlet:equilibrium.ThermoPackage=inlet_package;
@id("9a74872ba8f44159a5b66eb7cfc55d99") child outlet:equilibrium.ThermoPackage=outlet_package;
@id("3bf856d00226426baced36793a4e7e5c") var heat:Transfer<EnergyTransferRate,energy_boundary,Into>;
@id("f40bcc95de8c466e95c84f27afc9bc7a") var work:Transfer<EnergyTransferRate,energy_boundary,Into>;
@id("7ed07f19c8f147d494e8eb642c80b04a") var delta_pressure:DeltaPressure;
@id("92d4872d50f84787885a979b55482615") eq pressure_balance:outlet.pressure==inlet.pressure+delta_pressure;
@id("5400b7b8f9bb42bba195dbbdbab7027e") annotation start heat(0{W});
@id("19d1f5157ba94b058f964f7c5e586b44") annotation nominal heat(10000{W});
@id("bad3cc15f96e41b392b0b7e38afecfb0") annotation start work(0{W});
@id("bb15ad26d84e4a679cf9f262957165b8") annotation nominal work(10000{W});
@id("a15e34c13d95457ba2523b75fe7b32c1") annotation start delta_pressure(0{Pa});
@id("82616445dc76434bb15724ea9fb633c2") annotation nominal delta_pressure(100000{Pa});
@id("c4806e52ce115bdd97dd07daaa2ff41d") material port inlet_port=inlet.material_state;
@id("34ec271afe495ccab54eeb97b93a2e61") material port outlet_port=outlet.material_state;
@id("41e64965de9f5a7f93098ddb1212aa07") override param inlet_boundaries:Set<kinds.port_set>={inlet_boundary};
@id("05dfc4e3d85953ce91c7d02b92b3302a") override param outlet_boundaries:Set<kinds.port_set>={outlet_boundary};
@id("9370a62d10f1583cae945ae85e3233aa") override param algebraic_balances:Boolean=if analysis.dynamic and has_holdup then false else true;
@id("a6af43da15e3552f93c4f512695f4dd4") override let in_component[i in inlet_boundaries,j in components]:ComponentFlow=inlet.component_flow[j];
@id("c0be2e12c6fc55848a8eb2ec3a3e9dc9") override let out_component[o in outlet_boundaries,j in components]:ComponentFlow=outlet.component_flow[j];
@id("850cea98bcfc53fa82f9bb891f014a04") override let in_phase_component[i in inlet_boundaries,p in phases,j in components]:ComponentFlow=inlet.phase_component_flow[p,j];
@id("cffd15bd70ce51d9a4e13ff3c71a02b6") override let out_phase_component[o in outlet_boundaries,p in phases,j in components]:ComponentFlow=outlet.phase_component_flow[p,j];
@id("b8e5160bbaa055c19ca02c6333efcc35") override let in_energy[i in inlet_boundaries]:Power=inlet.energy_flow;
@id("4acf1e170dc8577d8181bcc3bd996213") override let out_energy[o in outlet_boundaries]:Power=outlet.energy_flow;
@id("77c4fa6634ec5b76821988164de30cf9") override let in_total[i in inlet_boundaries]:Flow=inlet.flow;
@id("b1cc1279d4e7541cb3cf2581f147dd83") override let out_total[o in outlet_boundaries]:Flow=outlet.flow;
@id("72c50d1cf95257e1bd64e7f8aa23558a") contribute energy role directed=heat;
@id("993bc29d3e1956f3ab3f272e53f7645e") contribute energy role directed=work;
// Temporal closure uses the same global amount and energy allowances.
// These physical mismatch limits are distinct from local integration error.
@id("d5bd7cf7a012515dbc8d57e10342543d") when analysis.dynamic and has_holdup {
@id("5ab68a7cbf2459c49964e79f1fbbf2a8") require sum(p in phases | 1)==1 : "stored control-volume transport requires an explicit phase allocation for multiple phases";
@id("ea5814bf1a1e566b92370bd7f1fe1759") require material_basis==MaterialBalance.componentTotal or material_basis==MaterialBalance.componentPhase : "stored element/total bases require an explicit inventory projection and transfer allocation";
@id("fee18c4ff2895fad85ee8ed402389f4b") when material_basis==MaterialBalance.componentTotal {
@id("6066907899665626903ed5985f16c9bf") conserve temporal_material[i in time,p in phases,j in evolving_inventory]:Amount on time inventory phase_material_holdup[p,j] flux material[j] tolerance numerical_policy.amount;
@id("e97e1ff8054d5db593069eeb74a168ba") eq constant_material[j in constant_inventory]:material[j]==0{mol/s};
}
@id("69d71d954a6152479aed1d371371b3a7") when material_basis==MaterialBalance.componentPhase {
@id("ee144af05a0b5ddbb84e5a9b315f2f35") conserve temporal_material[i in time,p in phases,j in evolving_inventory]:Amount on time inventory phase_material_holdup[p,j] flux phase_material[p,j] tolerance numerical_policy.amount;
@id("e555e1021d785480953884f7f97bdf3a") eq constant_material[p in phases,j in constant_inventory]:phase_material[p,j]==0{mol/s};
}
@id("09ff068d35e65cea9a688757463884d7") conserve temporal_energy[i in time,p in phases]:Energy on time inventory phase_energy_holdup[p] flux energy tolerance numerical_policy.energy;
}
@id("c1f94440ae6c4941851e49f36ea25559") annotation report inlet.T("inlet.T");
@id("67a3cc63b34f4e32a8c2c022e9f8f4e1") annotation report outlet.T("outlet.T");
@id("e5d7ec3a8d9144a592ebfa44b65f0649") annotation report inlet.h("inlet.h");
@id("4f21cba145004f03aa1d0ded2c2c6482") annotation report outlet.h("outlet.h");
@id("088d49042f4f4554a83507dfa54bbf74") annotation report inlet.energy_flow("inlet.energy_flow");
@id("8714c530434c4ce1a9606eafc36b0e7c") annotation report outlet.energy_flow("outlet.energy_flow");
@id("1cb0a812d0c5419db809ddc053a3bfe5") annotation report inlet.flow("inlet.flow");
@id("e5c9d569b2fd4bb5a0a41bff8a503242") annotation report outlet.flow("outlet.flow");
@id("3826495077f45d0eb7198c11e20210ba") annotation connectivity inlet_port(1,0);
@id("5e9e588ba65350d59e6b77c5bc114d66") annotation connectivity outlet_port(0,1);
}
}
