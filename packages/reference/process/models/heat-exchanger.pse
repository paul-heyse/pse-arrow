@id("5586667416bb4fb8851f1b94cc874d9e") package heat_exchange {
@id("9004bbcc2b7f46f9b37c1ac4434b4cc0") use equilibrium @"1.0.0";
@id("508f078c9c2f452686489eb14d5790d4") use units @"1.0.0";
@id("9477962e352b4cec8b9d68da964a0827") use temperature_driving_force @"1.0.0";
@id("836285c79d5449b79871fdfb37befd00") def HeatExchanger(hot_inlet_pkg:equilibrium.ThermoPackage,hot_outlet_pkg:equilibrium.ThermoPackage,cold_inlet_pkg:equilibrium.ThermoPackage,cold_outlet_pkg:equilibrium.ThermoPackage,driving_force:temperature_driving_force.DeltaT=temperature_driving_force.LMTD,cocurrent:Boolean=false) {
@id("e64c89efe2f44fa1bb46da595a3ee179") child hot:units.Heater=units.Heater(inlet_pkg=hot_inlet_pkg,outlet_pkg=hot_outlet_pkg);
@id("397196c2f23b4da9acd90dc75743c561") child cold:units.Heater=units.Heater(inlet_pkg=cold_inlet_pkg,outlet_pkg=cold_outlet_pkg);
@id("1ea5c968361c40b4930fdfcd0e28f749") child delta:temperature_driving_force.DeltaT=driving_force;
@id("4c88f08ef760479da840a626cbbf30dc") var area:Area;
@id("901e432825414f23bb96eb016adeed02") var coefficient:HeatTransferCoefficient;
@id("42911eaf3a364d08b4fdb60ed052bbee") annotation bounds area(1e-12{m^2},1000000{m^2});
@id("687505a75e4f4cb9bc61af5bff613228") annotation start area(1{m^2});
@id("3b87c66a5366495cb5d15012f2ac292e") annotation bounds coefficient(1e-12{W/(m^2*K)},1000000{W/(m^2*K)});
@id("f60d2d9a121746ea9982ab9f3945a2cc") annotation start coefficient(100{W/(m^2*K)});
@id("801ac3540f2d40ceb2ab113eb4c82da8") exchange thermal_exchange between hot.energy_boundary and cold.energy_boundary;
@id("2eb61c4c300d41b99225898d313ac12f") eq isolated_exchange:hot.heat==reflect(thermal_exchange,cold.heat,Into);
@id("7439ec92a7ff433b9b7da5249b158aa8") eq duty:cold.heat==transfer(area*coefficient*delta.mean,cold.energy_boundary,Into);
@id("9d9bb65266e94cc5abc34596cfddfc6f") when cocurrent {
@id("cf6ff6ef5cee42ce892e1f41c6281a53") eq first_difference:delta.first==hot.inlet.T-cold.inlet.T;
@id("eb0e7903726a427496409e85c22c71e8") eq second_difference:delta.second==hot.outlet.T-cold.outlet.T;
}
@id("fb985e9a08e04de9962746a64cefc303") when not cocurrent {
@id("04c8401bb36a4c72a7015b452da6ead8") eq first_difference:delta.first==hot.inlet.T-cold.outlet.T;
@id("1a41c00a6b7c43e3852bd3e99419b43a") eq second_difference:delta.second==hot.outlet.T-cold.inlet.T;
}
}
}
