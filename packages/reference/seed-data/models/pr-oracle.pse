@id("01a0e17fb4307404bb456179a6be3f89") package pr_oracle {
@id("eeadb183040d4db7b8b217bf7104f67e") use properties @"1.0.0";
@id("b124fa807ecb467ab0690e636ea88d4d") use interactions @"1.0.0";
@id("2e38937a364443029e08a1d916c34a99") use cubic @"1.0.0";
@id("3ee8a59df28342a895546b4e58b02898") use compatibility @"1.0.0";

@id("01a0ef604fe0732189b9373439d2a50a") use provenance @"1.0.0";
@id("01a0ef604fe0732189b93735d3567a11") use references @"1.0.0";
@id("01a0ee04daa874fc91673816f8d77a80") use chemistry @"1.0.0";
@id("01a0e17fb4307404bb45617bbe4feaa3") use peng_robinson @"1.0.0";
@id("01a0e17fb4307404bb45617c4361a096") entity chemistry.species a {}
@id("01a0e17fb4307404bb45617d29331305") entity chemistry.species b {}
@id("01a0e17fb4307404bb45617e1e6ad9dc") entity chemistry.species c {}
@id("01a0e17fb4307404bb45617fd533221c") set members:Set<chemistry.species>={a,b,c};
@id("01a0e17fb4307404bb45618032a2b567") dataset critical:cubic.critical_point bind(property=cubic.critical_parameters,phase_type=compatibility.PhaseType.vaporPhase,source=references.idaes_test_ceos_pr) provenance(references.idaes_test_ceos_pr, provenance.Role.oracle_input) {
[a]=[100{K},100000{Pa},0.1];
[b]=[200{K},200000{Pa},0.2];
[c]=[300{K},300000{Pa},0.3];
}
@id("01a0e17fb4307404bb456182e91fdc67") test liquid oracle references.idaes_test_ceos_pr fixture {dof 0; run pure; fix root.T=300{K}; fix root.rho=41.15650806416406{mol/m^3}; fix root.amount[a]=0.6{mol}; fix root.amount[b]=0.3{mol}; fix root.amount[c]=0.1{mol}; } {
@id("01a0e17fb4307404bb456183c9c3b286") child root:peng_robinson.IdaesDeltaPhase=peng_robinson.IdaesHomogeneousPhase(selected=members,pkg=oracle_parameters,law=potential);
@id("01a0e17fb4307404bb456184e62d85c0") expect exp(root.ln_phi[a])==1.01213 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb456185a528275c") expect exp(root.ln_phi[b])==0.95919 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb4561864b3bc122") expect exp(root.ln_phi[c])==0.91356 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb4561872d335b0d") expect root.pressure==101325{Pa} tolerance 0.02{Pa} relative 1e-6;
}
@id("01a0e17fb4307404bb456188b73032ca") test vapor oracle references.idaes_test_ceos_pr fixture {dof 0; run pure; fix root.T=300{K}; fix root.rho=44.80008901754609{mol/m^3}; fix root.amount[a]=0.1{mol}; fix root.amount[b]=0.2{mol}; fix root.amount[c]=0.7{mol}; } {
@id("01a0e17fb4307404bb45618912287bb4") child root:peng_robinson.IdaesDeltaPhase=peng_robinson.IdaesHomogeneousPhase(selected=members,pkg=oracle_parameters,law=potential);
@id("01a0e17fb4307404bb45618a7a1df81a") expect exp(root.ln_phi[a])==1.05952 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb45618bd486c46a") expect exp(root.ln_phi[b])==0.9607 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb45618ce93a73cd") expect exp(root.ln_phi[c])==0.87903 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb45618d79f4fa47") expect root.pressure==101325{Pa} tolerance 0.02{Pa} relative 1e-6;
}
@id("01a0e1c189be77f58aa2fc8fbfffec1d") use helmholtz @"1.0.0";
@id("01a0e1c189bf70b9a2a6f0aa14b05fc1") entity chemistry.species asym_a {}
@id("01a0e1c189bf70b9a2a6f0ab9cac816a") entity chemistry.species asym_b {}
@id("01a0e1c189bf70b9a2a6f0acc8277469") set asym_members:Set<chemistry.species>={asym_a,asym_b};
@id("01a0e1c189bf70b9a2a6f0ad74541655") dataset asym_critical:cubic.critical_point bind(property=cubic.critical_parameters,phase_type=compatibility.PhaseType.vaporPhase,source=references.analytic_cubic_fugacity) provenance(references.analytic_cubic_fugacity, provenance.Role.synthetic) {
[asym_a]=[300{K},5000000{Pa},0.1];
[asym_b]=[400{K},4000000{Pa},0.2];
}
@id("01a0e1c189bf70b9a2a6f0ae9a640e2f") dataset asym_interactions:cubic.directional_pair provenance(references.analytic_cubic_fugacity, provenance.Role.synthetic) {
[references.analytic_cubic_fugacity,cubic.binary_interaction,asym_a,asym_b]=[0.1];
[references.analytic_cubic_fugacity,cubic.binary_interaction,asym_b,asym_a]=[0.3];
}
@id("01a0e1c189bf70b9a2a6f0af9074e8c1") test asymmetric_conventions oracle references.analytic_cubic_fugacity fixture {dof 0; run pure; fix ordinary.T=450{K}; fix ordinary.rho=25{mol/m^3}; fix ordinary.amount[asym_a]=0.4{mol}; fix ordinary.amount[asym_b]=0.6{mol}; fix parity.T=450{K}; fix parity.rho=25{mol/m^3}; fix parity.amount[asym_a]=0.4{mol}; fix parity.amount[asym_b]=0.6{mol};} {
@id("01a0e1c189bf70b9a2a6f0b05e4b70a8") child ordinary:helmholtz.HelmholtzPhase=helmholtz.HomogeneousPhase(selected=asym_members,law=asymmetric_potential);
@id("01a0e1c189bf70b9a2a6f0b15bab08cf") child parity:peng_robinson.IdaesDeltaPhase=peng_robinson.IdaesHomogeneousPhase(selected=asym_members,pkg=asymmetric_parameters,law=asymmetric_potential);
@id("01a0e1c189bf70b9a2a6f0b22ac1f7e3") expect ordinary.ln_phi[asym_a]==-0.00087601338686184738 tolerance 1e-12;
@id("01a0e1c189bf70b9a2a6f0b397e635ab") expect ordinary.ln_phi[asym_b]==-0.0056470379251695683 tolerance 1e-12;
@id("01a0e1c189bf70b9a2a6f0b41c0e0a20") expect parity.ln_phi[asym_a]==-0.0014504283514031962 tolerance 1e-12;
@id("01a0e1c189bf70b9a2a6f0b52c106c7a") expect parity.ln_phi[asym_b]==-0.0052640946154753352 tolerance 1e-12;
@id("01a0e1c189bf70b9a2a6f0b64b7e0603") expect ordinary.pressure==parity.pressure tolerance 1e-8{Pa};
}
@id("adc699a018fa4ab790cbbcc38cc4ecbe") entity properties.property_package oracle_parameters {}
@id("b4753f424cf94203afc0d16d3273effc") set oracle_parameters_set:Set<properties.property_package>={oracle_parameters};
@id("f530583d5b3948bebf77a79f0c26b504") set oracle_parameters_critical:Set<properties.property>={cubic.critical_parameters};
@id("6f619f821ad44d9f9f8b758eca090738") set oracle_parameters_pair:Set<properties.property>={cubic.binary_interaction};
@id("25f7df8e73e84ab59179d5f42eb2c612") dataset oracle_parameters_selection:properties.selection complete_over(k in oracle_parameters_set,j in members,p in oracle_parameters_critical,t in properties.vapor_types) provenance(references.idaes_test_ceos_pr,provenance.Role.oracle_input) {
[oracle_parameters,a,cubic.critical_parameters,compatibility.PhaseType.vaporPhase]=[cubic.critical_point[a,cubic.critical_parameters,compatibility.PhaseType.vaporPhase,references.idaes_test_ceos_pr]];
[oracle_parameters,b,cubic.critical_parameters,compatibility.PhaseType.vaporPhase]=[cubic.critical_point[b,cubic.critical_parameters,compatibility.PhaseType.vaporPhase,references.idaes_test_ceos_pr]];
[oracle_parameters,c,cubic.critical_parameters,compatibility.PhaseType.vaporPhase]=[cubic.critical_point[c,cubic.critical_parameters,compatibility.PhaseType.vaporPhase,references.idaes_test_ceos_pr]];
}
@id("83d50e69cd8d479596688ce3e9e497e3") dataset oracle_parameters_source:interactions.pair_selection complete_over(k in oracle_parameters_set,p in oracle_parameters_pair) provenance(references.idaes_test_ceos_pr,provenance.Role.oracle_input) { [oracle_parameters,cubic.binary_interaction]=[references.idaes_test_ceos_pr]; }
@id("0ebfb7b053464c82ae444e9427044966") dataset oracle_parameters_absence:interactions.absence_policy complete_over(k in oracle_parameters_set,p in oracle_parameters_pair) provenance(references.idaes_test_ceos_pr,provenance.Role.oracle_input) { [oracle_parameters,cubic.binary_interaction]=[interactions.PairAbsence.predictiveZero]; }
@id("27c7685551f94e31a4af4d83d618645d") dataset oracle_parameters_method:interactions.pair_method complete_over(k in oracle_parameters_set,p in oracle_parameters_pair) provenance(references.idaes_test_ceos_pr,provenance.Role.oracle_input) { [oracle_parameters,cubic.binary_interaction]=[interactions.pair_parameter]; }
@id("50b8102d4915495898cff3b2f3dd38a2") entity properties.property_package asymmetric_parameters {}
@id("a87f912fb99b4abab7dd3926c2055d58") set asymmetric_parameters_set:Set<properties.property_package>={asymmetric_parameters};
@id("76502f2234f3436b879050884d14bc28") set asymmetric_parameters_critical:Set<properties.property>={cubic.critical_parameters};
@id("30c8fa9a8d2e4e7b9578d3d32fc12182") set asymmetric_parameters_pair:Set<properties.property>={cubic.binary_interaction};
@id("dadbb64dfccf4cc39612f2d410fbe073") dataset asymmetric_parameters_selection:properties.selection complete_over(k in asymmetric_parameters_set,j in asym_members,p in asymmetric_parameters_critical,t in properties.vapor_types) provenance(references.analytic_cubic_fugacity,provenance.Role.oracle_input) {
[asymmetric_parameters,asym_a,cubic.critical_parameters,compatibility.PhaseType.vaporPhase]=[cubic.critical_point[asym_a,cubic.critical_parameters,compatibility.PhaseType.vaporPhase,references.analytic_cubic_fugacity]];
[asymmetric_parameters,asym_b,cubic.critical_parameters,compatibility.PhaseType.vaporPhase]=[cubic.critical_point[asym_b,cubic.critical_parameters,compatibility.PhaseType.vaporPhase,references.analytic_cubic_fugacity]];
}
@id("2b6ac803ce8d40ffbcdea362944a2376") dataset asymmetric_parameters_source:interactions.pair_selection complete_over(k in asymmetric_parameters_set,p in asymmetric_parameters_pair) provenance(references.analytic_cubic_fugacity,provenance.Role.oracle_input) { [asymmetric_parameters,cubic.binary_interaction]=[references.analytic_cubic_fugacity]; }
@id("1438069d5f1942e8ad066baaaf47593f") dataset asymmetric_parameters_absence:interactions.absence_policy complete_over(k in asymmetric_parameters_set,p in asymmetric_parameters_pair) provenance(references.analytic_cubic_fugacity,provenance.Role.oracle_input) { [asymmetric_parameters,cubic.binary_interaction]=[interactions.PairAbsence.predictiveZero]; }
@id("4b3fdca5130a4e8181093368494ad26b") dataset asymmetric_parameters_method:interactions.pair_method complete_over(k in asymmetric_parameters_set,p in asymmetric_parameters_pair) provenance(references.analytic_cubic_fugacity,provenance.Role.oracle_input) { [asymmetric_parameters,cubic.binary_interaction]=[cubic.directional_parameter]; }
@id("05e157709ff34b008f66286d3c819f8e") fn potential(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=peng_robinson.potential(t,r,n,members,oracle_parameters,cubic.pr);
@id("73c3c6a55103442cb346012644d26dc1") fn asymmetric_potential(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=peng_robinson.potential(t,r,n,members,asymmetric_parameters,cubic.pr);
}
