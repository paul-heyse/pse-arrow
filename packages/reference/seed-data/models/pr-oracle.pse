@id("01a0e17fb4307404bb456179a6be3f89") package pr_oracle {
@id("01a0e17fb4307404bb45617aa286e41e") use kinds @"1.0.0";
@id("01a0e17fb4307404bb45617bbe4feaa3") use peng_robinson @"1.0.0";
@id("01a0e17fb4307404bb45617c4361a096") entity kinds.species a {}
@id("01a0e17fb4307404bb45617d29331305") entity kinds.species b {}
@id("01a0e17fb4307404bb45617e1e6ad9dc") entity kinds.species c {}
@id("01a0e17fb4307404bb45617fd533221c") set members:Set<kinds.species>={a,b,c};
@id("01a0e17fb4307404bb45618032a2b567") dataset critical:peng_robinson.critical source "IDAES 2.13 test_ceos_PR fictitious component parameters; oracle inputs only" {
[a]=[100{K},100000{Pa},0.1];
[b]=[200{K},200000{Pa},0.2];
[c]=[300{K},300000{Pa},0.3];
}
@id("01a0e17fb4307404bb456181aae62135") dataset interactions:peng_robinson.interaction source "IDAES test_ceos_PR zero interaction matrix" {
[a,a]=[0];
[a,b]=[0];
[a,c]=[0];
[b,a]=[0];
[b,b]=[0];
[b,c]=[0];
[c,a]=[0];
[c,b]=[0];
[c,c]=[0];
}
@id("01a0e17fb4307404bb456182e91fdc67") test liquid source "IDAES 2.13 test_ceos_PR fugacity test; printed Z determines density; homogeneous branch label only" revision "2.13.0" fixture {dof 0; run pure; fix root.T=300{K}; fix root.rho=41.15650806416406{mol/m^3}; fix root.amount[a]=0.6{mol}; fix root.amount[b]=0.3{mol}; fix root.amount[c]=0.1{mol}; } {
@id("01a0e17fb4307404bb456183c9c3b286") child root:peng_robinson.IdaesDeltaPhase=peng_robinson.IdaesHomogeneousPhase(selected=members);
@id("01a0e17fb4307404bb456184e62d85c0") expect exp(root.ln_phi[a])==1.01213 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb456185a528275c") expect exp(root.ln_phi[b])==0.95919 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb4561864b3bc122") expect exp(root.ln_phi[c])==0.91356 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb4561872d335b0d") expect root.pressure==101325{Pa} tolerance 0.02{Pa} relative 1e-6;
}
@id("01a0e17fb4307404bb456188b73032ca") test vapor source "IDAES 2.13 test_ceos_PR fugacity test; printed Z determines density; homogeneous branch label only" revision "2.13.0" fixture {dof 0; run pure; fix root.T=300{K}; fix root.rho=44.80008901754609{mol/m^3}; fix root.amount[a]=0.1{mol}; fix root.amount[b]=0.2{mol}; fix root.amount[c]=0.7{mol}; } {
@id("01a0e17fb4307404bb45618912287bb4") child root:peng_robinson.IdaesDeltaPhase=peng_robinson.IdaesHomogeneousPhase(selected=members);
@id("01a0e17fb4307404bb45618a7a1df81a") expect exp(root.ln_phi[a])==1.05952 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb45618bd486c46a") expect exp(root.ln_phi[b])==0.9607 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb45618ce93a73cd") expect exp(root.ln_phi[c])==0.87903 tolerance 1e-6 relative 1e-5;
@id("01a0e17fb4307404bb45618d79f4fa47") expect root.pressure==101325{Pa} tolerance 0.02{Pa} relative 1e-6;
}
@id("01a0e1c189be77f58aa2fc8fbfffec1d") use helmholtz @"1.0.0";
@id("01a0e1c189bf70b9a2a6f0aa14b05fc1") entity kinds.species asym_a {}
@id("01a0e1c189bf70b9a2a6f0ab9cac816a") entity kinds.species asym_b {}
@id("01a0e1c189bf70b9a2a6f0acc8277469") set asym_members:Set<kinds.species>={asym_a,asym_b};
@id("01a0e1c189bf70b9a2a6f0ad74541655") dataset asym_critical:peng_robinson.critical source "Synthetic PR convention control, not physical component data" {
[asym_a]=[300{K},5000000{Pa},0.1];
[asym_b]=[400{K},4000000{Pa},0.2];
}
@id("01a0e1c189bf70b9a2a6f0ae9a640e2f") dataset asym_interactions:peng_robinson.interaction source "Deliberately asymmetric ordered interaction control" {
[asym_a,asym_a]=[0];
[asym_a,asym_b]=[0.1];
[asym_b,asym_a]=[0.3];
[asym_b,asym_b]=[0];
}
@id("01a0e1c189bf70b9a2a6f0af9074e8c1") test asymmetric_conventions source "Analytic cubic fugacity: symmetric mixture derivative versus ordered-row delta convention" revision "PR-1976" fixture {dof 0; run pure; fix ordinary.T=450{K}; fix ordinary.rho=25{mol/m^3}; fix ordinary.amount[asym_a]=0.4{mol}; fix ordinary.amount[asym_b]=0.6{mol}; fix parity.T=450{K}; fix parity.rho=25{mol/m^3}; fix parity.amount[asym_a]=0.4{mol}; fix parity.amount[asym_b]=0.6{mol};} {
@id("01a0e1c189bf70b9a2a6f0b05e4b70a8") child ordinary:helmholtz.HelmholtzPhase=helmholtz.HomogeneousPhase(selected=asym_members,law=peng_robinson.potential);
@id("01a0e1c189bf70b9a2a6f0b15bab08cf") child parity:peng_robinson.IdaesDeltaPhase=peng_robinson.IdaesHomogeneousPhase(selected=asym_members);
@id("01a0e1c189bf70b9a2a6f0b22ac1f7e3") expect ordinary.ln_phi[asym_a]==-0.00087601338686184738 tolerance 1e-12;
@id("01a0e1c189bf70b9a2a6f0b397e635ab") expect ordinary.ln_phi[asym_b]==-0.0056470379251695683 tolerance 1e-12;
@id("01a0e1c189bf70b9a2a6f0b41c0e0a20") expect parity.ln_phi[asym_a]==-0.0014504283514031962 tolerance 1e-12;
@id("01a0e1c189bf70b9a2a6f0b52c106c7a") expect parity.ln_phi[asym_b]==-0.0052640946154753352 tolerance 1e-12;
@id("01a0e1c189bf70b9a2a6f0b64b7e0603") expect ordinary.pressure==parity.pressure tolerance 1e-8{Pa};
}
}
