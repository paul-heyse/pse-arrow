@id("881a0e9fb03144108d64f181a79d1e9f") package phase_stability_fixtures {
@id("01a0f12be01970a7bc46738390189410") use bt_ideal @"1.0.0";
@id("01a0ef604fe0732189b9372ffbb8d433") use provenance @"1.0.0";
@id("01a0ef604fe0732189b937305e9d40dd") use references @"1.0.0";
@id("01a0ee04daa874fc916738151bcdd293") use chemistry @"1.0.0";
@id("92f9b10e46114b5ab2177265f5d883b4") use chem @"1.0.0";
@id("bb47906570b24eca9db33b0d7dee49e1") use helmholtz @"1.0.0";
@id("30448313577e45088ceb7dc8a7f0d416") use phase_stability @"1.0.0";
@id("97025dfbe5f24c42a2db9f7f79abe86a") use vessel_fixtures @"1.0.0";
@id("a82abeca35f743c586078c7257f7935c") table feeds[j:chemistry.species]:Scalar complete_over(j in bt_ideal.aromatics);
@id("b9ef452ef0ab4ab78c137b4d013c83b2") dataset equimolar_bt:feeds provenance(references.pr_stability_reference, provenance.Role.synthetic) {
[chem.benzene]=[0.5];
[chem.toluene]=[0.5];
}
@id("2ed407471d154508a8e6db87779f4b90") fn bt_feed(j:chemistry.species)->Scalar=feeds[j];
@id("f622163224f64cecaa98b10d0952aa16") test tpd_ideal oracle references.analytic_ideal_tangent_plane fixture {dof 2; route steady; procedure solve; intent certify;} {
@id("4fdb92718b0840589294cd7b11f68fc0") child root:phase_stability.TangentPlaneStability=phase_stability.TangentPlaneStability(selected=vessel_fixtures.alkanes,law=helmholtz.ideal,feed=vessel_fixtures.fraction);
@id("42c7c868378e407f97d1fa652302d315") expect root.tpd==0{1} tolerance 0.000001{1};
}
}
