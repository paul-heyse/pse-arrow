[gross2001_package,chem.tridecane,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase]=[pcsaft_parameters.nonassociating[chem.tridecane,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase,references.gross_sadowski_2001]];
