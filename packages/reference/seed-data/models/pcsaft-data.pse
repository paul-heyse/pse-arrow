[gross2001_package,chem.heptane,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase]=[pcsaft_parameters.nonassociating[chem.heptane,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase,references.gross_sadowski_2001]];
[gross2001_package,chem.octane,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase]=[pcsaft_parameters.nonassociating[chem.octane,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase,references.gross_sadowski_2001]];
[gross2001_package,chem.nonane,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase]=[pcsaft_parameters.nonassociating[chem.nonane,pcsaft_parameters.segments,compatibility.PhaseType.vaporPhase,references.gross_sadowski_2001]];
