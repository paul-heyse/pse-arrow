@id("01a0e15d9eff71b98e7519f362a7ba3d") package phase_data {
@id("d0fe95036d0c4f85b3150e13f3438dbe") use compatibility @"1.0.0";
@id("01a0f13f1dda7370bf417d8ce1f338da") use correlations @"1.0.0";
@id("01a0f13f1dda7370bf417d8ba0e40d3b") use chem @"1.0.0";
@id("01a0f13d55b07622b0ebf7c1ddcb3db8") use properties @"1.0.0";
@id("01a0ef604fe0732189b9372de5c7a0e9") use provenance @"1.0.0";
@id("01a0ef604fe0732189b9372e7100d056") use references @"1.0.0";
@id("01a0e15d9eff71b98e7519f4efdb5ad8") use caloric @"1.0.0";
@id("01a0e15d9eff71b98e7519f5332e09da") use pure_properties @"1.0.0";



@id("01a0e15d9eff71b98e7519ff51aff28f") test water_source_oracles oracle references.idaes_2_13 fixture {dof 0; run pure;} {
@id("01a0e15d9eff71b98e751a00a736373f") expect properties.saturated_density(correlations.dippr105[chem.water, properties.liquid_molar_density, compatibility.PhaseType.liquidPhase, references.idaes_test_perrys],273.16{K})==55583{mol/m^3} tolerance 0{mol/m^3} relative 1e-4;
@id("01a0e15d9eff71b98e751a012d6427b3") expect properties.saturated_density(correlations.dippr105[chem.water, properties.liquid_molar_density, compatibility.PhaseType.liquidPhase, references.idaes_test_perrys],333.15{K})==54703{mol/m^3} tolerance 0{mol/m^3} relative 1e-4;
@id("01a0e15d9eff71b98e751a02cd650678") expect properties.saturation_pressure(correlations.rpp4_wagner[chem.water, properties.vapor_pressure, compatibility.PhaseType.liquidPhase, references.idaes_test_rpp4],298.15{K})==3171.4391{Pa} tolerance 0.001{Pa};
@id("01a0e15d9eff71b98e751a03fb0e887b") expect properties.saturation_pressure(correlations.rpp4_wagner[chem.water, properties.vapor_pressure, compatibility.PhaseType.liquidPhase, references.idaes_test_rpp4],373.15{K})==101378{Pa} tolerance 0{Pa} relative 1e-4;
}
@id("01a0e15d9eff71b98e751a045545b291") test pressure_interface oracle references.idaes_test_rpp4 fixture {dof 0; run pure; value root.T=373.15{K};} {
@id("01a0e15d9eff71b98e751a05327478aa") child root:pure_properties.VaporPressure=pure_properties.VaporPressureSet(s=correlations.rpp4_wagner[chem.water, properties.vapor_pressure, compatibility.PhaseType.liquidPhase, references.idaes_test_rpp4]);
@id("01a0e15d9eff71b98e751a06aab4b497") expect root.pressure==101378{Pa} tolerance 0{Pa} relative 1e-4;
}
@id("01a0e16127e470a5896844b4731c4f7c") test critical_endpoint_rejected oracle references.rpp4 fixture {dof 0; run pure; failure trial_rejected validity(form) form(correlations.rpp4_wagner_psat) set(correlations.rpp4_wagner[chem.benzene, properties.vapor_pressure, compatibility.PhaseType.liquidPhase, references.idaes_test_rpp4]) variable(T);} {
@id("01a0e16127e470a5896844b51e6733d6") expect correlations.rpp4_wagner_psat(562.2{K},correlations.rpp4_wagner[chem.benzene, properties.vapor_pressure, compatibility.PhaseType.liquidPhase, references.idaes_test_rpp4])==4890000{Pa} tolerance 1{Pa};
}
}
