@id("64d0200000004000800000000000024d") test phase_component_temperature oracle analytic_states fixture {dof 0;route steady;procedure solve;fix root.source.phase_component_rate[chemistry.liquid,chem.benzene]=0.5{mol/s};fix root.source.phase_component_rate[chemistry.liquid,chem.toluene]=1.5{mol/s};fix root.source.phase_component_rate[chemistry.vapor,chem.benzene]=0.5{mol/s};fix root.source.phase_component_rate[chemistry.vapor,chem.toluene]=0.5{mol/s};fix root.source.T=350{K};fix root.source.pressure=101325{Pa};} {
