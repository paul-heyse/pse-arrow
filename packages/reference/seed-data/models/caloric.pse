@id("01a0e1550b117611b1f5a20b04d5d8e2") package caloric_data {
@id("01a0f14ead4d7118a57e366230fcdd15") use constants @"1.0.0";
@id("6550f7e2e2824d5cafc7b61f53b19efb") constant derivative_temperature_interval:DeltaTemperature=300{K} provenance(references.analytic_identities,provenance.Role.synthetic);
@id("71e6ea8ad2e24fa7a832991f80561ceb") use compatibility @"1.0.0";
@id("01a0f13d55b07622b0ebf7c26770650f") dataset constant_validation:correlations.constant bind(property=properties.heat_capacity,source=references.analytic_identities) provenance(references.analytic_identities,provenance.Role.synthetic) { [chem.water,compatibility.PhaseType.liquidPhase]=[298.15{K},500{K},75.3{J/(mol*K)}]; }

@id("01a0f13cde3c75399f3a54a97dea134b") use correlations @"1.0.0";
@id("01a0f13cde3c75399f3a54aa45a5d6d1") use properties @"1.0.0";










@id("01a0ef604fdf73c68b36e128785f89d0") use provenance @"1.0.0";
@id("01a0ef604fdf73c68b36e1293a7d135a") use references @"1.0.0";
@id("01a0e1550b117611b1f5a20c24299be4") use caloric @"1.0.0";
@id("01a0e1484fb87705b3f22bcefb1f99d8") use chem @"1.0.0";
@id("45d00839b1ca46ab9921146e35637ae1") use chemistry @"1.0.0";
@id("01a0e1484fb87705b3f22bd8fe49aa48") test nitrogen_shomate_values oracle references.nist_chase_1998 fixture {dof 0; run pure;} {
@id("01a0e1484fb87705b3f22bd97567a8d4") expect properties.caloric_cp(correlations.shomate[chem.nitrogen, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.nist_chase_1998], 300{K})==29.12{J/(mol*K)} tolerance 0.005{J/(mol*K)};
@id("01a0e1484fb87705b3f22bda75574392") expect properties.caloric_cp(correlations.shomate[chem.nitrogen, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.nist_chase_1998], 400{K})==29.25{J/(mol*K)} tolerance 0.005{J/(mol*K)};
@id("01a0e1484fb87705b3f22bdb25394875") expect properties.caloric_dh(correlations.shomate[chem.nitrogen, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.nist_chase_1998], 298.15{K}, 400{K})==2970{J/mol} tolerance 5{J/mol};
@id("01a0e1484fb87705b3f22bdc3e4d2d78") expect partial(properties.caloric_dh,T)(correlations.shomate[chem.nitrogen, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.nist_chase_1998], 298.15{K}, 300{K})==properties.caloric_cp(correlations.shomate[chem.nitrogen, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.nist_chase_1998], 300{K}) tolerance 1e-10{J/(mol*K)};
}

@id("01a0e1550b117611b1f5a2318d83dca8") test liquid_source_values oracle references.perry7_table_2_196 fixture {dof 0; run pure;} {
@id("01a0e1550b117611b1f5a23259ad1391") expect properties.caloric_cp(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 278.68{K})==132.51{J/(mol*K)} tolerance 0.005{J/(mol*K)};
@id("01a0e1550b117611b1f5a233c70df80b") expect properties.caloric_cp(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 353.24{K})==150.40{J/(mol*K)} tolerance 0.005{J/(mol*K)};
@id("01a0e1550b117611b1f5a2341a26a7d0") expect partial(properties.caloric_dh,T)(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 298.15{K}, 300{K})==properties.caloric_cp(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 300{K}) tolerance 1e-10{J/(mol*K)};
@id("01a0e1550b117611b1f5a235bb339a3b") expect partial(properties.caloric_dh,T)(correlations.constant[chem.water,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.analytic_identities],298.15{K},300{K})==75.3{J/(mol*K)} tolerance 1e-10{J/(mol*K)};
@id("01a0e1550b117611b1f5a23663f2aed6") expect properties.caloric_ds(correlations.constant[chem.water,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.analytic_identities], 300{K}, 400{K})==21.662460055619096{J/(mol*K)} tolerance 1e-9{J/(mol*K)};
}
@id("01a0e1575d2f7080bba3cc615b4b23da") test liquid_references oracle references.analytic_identities fixture {dof 0; run pure; value root.T=298.15{K}; value root.T_reference=298.15{K}; value root.h_reference=123{J/mol}; value root.s_reference=45{J/(mol*K)};} {
@id("01a0e1575d2f7080bba3cc622f613a18") child root:caloric.CaloricReference=caloric.CaloricReference(s=correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196]);
@id("01a0e1575d2f7080bba3cc6394e78f69") expect root.enthalpy==123{J/mol} tolerance 1e-10{J/mol};
@id("01a0e1575d2f7080bba3cc647d816de7") expect root.entropy==45{J/(mol*K)} tolerance 1e-10{J/(mol*K)};
}
@id("01a0e1575d2f7080bba3cc655982e414") test gas_references oracle references.analytic_identities fixture {dof 0; run pure; value root.T=298.15{K}; value root.T_reference=298.15{K}; value root.h_reference=123{J/mol}; value root.s_reference=45{J/(mol*K)};} {
@id("01a0e1575d2f7080bba3cc66213af0f8") child root:caloric.CaloricReference=caloric.CaloricReference(s=correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196]);
@id("01a0e1575d2f7080bba3cc67e4539412") expect root.enthalpy==123{J/mol} tolerance 1e-10{J/mol};
@id("01a0e1575d2f7080bba3cc68915ad0c2") expect root.entropy==45{J/(mol*K)} tolerance 1e-10{J/(mol*K)};
}
@id("01a0e159fa9673b48608c5be1e5e1b6b") test caloric_form_identities oracle references.analytic_identities fixture {dof 0; run pure;} {
@id("01a0e159fa9673b48608c5bf7c7b76c7") expect properties.caloric_cp(correlations.rpp4_cp[chem.benzene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 400{K})==111.9312{J/(mol*K)} tolerance 1e-8{J/(mol*K)};
@id("01a0e159fa9673b48608c5c07810b35a") expect partial(properties.caloric_dh,T)(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 298.15{K}, 300{K})==properties.caloric_cp(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 300{K}) tolerance 1e-10{J/(mol*K)};
@id("01a0e159fa9673b48608c5c190f5acc1") expect partial(properties.caloric_dh,T)(correlations.dippr100[chem.toluene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 298.15{K}, 300{K})==properties.caloric_cp(correlations.dippr100[chem.toluene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 300{K}) tolerance 1e-10{J/(mol*K)};
@id("01a0e159fa9673b48608c5c29c7d4cf8") expect partial(properties.caloric_dh,T)(correlations.rpp4_cp[chem.benzene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 298.15{K}, 300{K})==properties.caloric_cp(correlations.rpp4_cp[chem.benzene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 300{K}) tolerance 1e-10{J/(mol*K)};
@id("01a0e159fa9673b48608c5c390dc5288") expect partial(properties.caloric_dh,T)(correlations.rpp4_cp[chem.toluene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 298.15{K}, 300{K})==properties.caloric_cp(correlations.rpp4_cp[chem.toluene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 300{K}) tolerance 1e-10{J/(mol*K)};
@id("01a0e159fa9673b48608c5c4270dc931") expect partial(properties.caloric_dh,T)(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300{K})==properties.caloric_cp(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 300{K}) tolerance 1e-10{J/(mol*K)};
@id("01a0e159fa9673b48608c5c5f3348415") expect partial(properties.caloric_dh,T)(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300{K})==properties.caloric_cp(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 300{K}) tolerance 1e-10{J/(mol*K)};
@id("01a0e159fa9673b48608c5c611cb8a70") expect partial(properties.caloric_dh,T)(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300{K})==properties.caloric_cp(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 300{K}) tolerance 1e-10{J/(mol*K)};
}
@id("01a0e15f7bbc77769bb7a760a7d8b700") test entropy_derivative_identities oracle references.analytic_identities fixture {dof 0; run pure;} {
@id("01a0e15f7bbc77769bb7a7617899d529") expect partial(properties.caloric_ds,T)(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 298.15{K}, 300{K})*derivative_temperature_interval==properties.caloric_cp(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 300{K})*(derivative_temperature_interval/(constants.absolute_zero+derivative_temperature_interval)) tolerance 3e-8{J/(mol*K)};
@id("01a0e15f7bbc77769bb7a7622877a1e6") expect partial(properties.caloric_ds,T)(correlations.dippr100[chem.toluene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 298.15{K}, 300{K})*derivative_temperature_interval==properties.caloric_cp(correlations.dippr100[chem.toluene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 300{K})*(derivative_temperature_interval/(constants.absolute_zero+derivative_temperature_interval)) tolerance 3e-8{J/(mol*K)};
@id("01a0e15f7bbc77769bb7a7633a4ff937") expect partial(properties.caloric_ds,T)(correlations.rpp4_cp[chem.benzene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 298.15{K}, 300{K})*derivative_temperature_interval==properties.caloric_cp(correlations.rpp4_cp[chem.benzene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 300{K})*(derivative_temperature_interval/(constants.absolute_zero+derivative_temperature_interval)) tolerance 3e-8{J/(mol*K)};
@id("01a0e15f7bbc77769bb7a7643d1243e0") expect partial(properties.caloric_ds,T)(correlations.rpp4_cp[chem.toluene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 298.15{K}, 300{K})*derivative_temperature_interval==properties.caloric_cp(correlations.rpp4_cp[chem.toluene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal], 300{K})*(derivative_temperature_interval/(constants.absolute_zero+derivative_temperature_interval)) tolerance 3e-8{J/(mol*K)};
@id("01a0e15f7bbc77769bb7a7659f2fcd3f") expect partial(properties.caloric_ds,T)(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300{K})*derivative_temperature_interval==properties.caloric_cp(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 300{K})*(derivative_temperature_interval/(constants.absolute_zero+derivative_temperature_interval)) tolerance 3e-8{J/(mol*K)};
@id("01a0e15f7bbc77769bb7a7667b6fb9e3") expect partial(properties.caloric_ds,T)(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300{K})*derivative_temperature_interval==properties.caloric_cp(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 300{K})*(derivative_temperature_interval/(constants.absolute_zero+derivative_temperature_interval)) tolerance 3e-8{J/(mol*K)};
@id("01a0e15f7bbc77769bb7a7672fb8f934") expect partial(properties.caloric_ds,T)(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300{K})*derivative_temperature_interval==properties.caloric_cp(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 300{K})*(derivative_temperature_interval/(constants.absolute_zero+derivative_temperature_interval)) tolerance 3e-8{J/(mol*K)};
@id("01a0e15f7bbc77769bb7a7686128a08e") expect partial(properties.caloric_ds,T)(correlations.shomate[chem.nitrogen, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.nist_chase_1998], 298.15{K}, 300{K})*derivative_temperature_interval==properties.caloric_cp(correlations.shomate[chem.nitrogen, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.nist_chase_1998], 300{K})*(derivative_temperature_interval/(constants.absolute_zero+derivative_temperature_interval)) tolerance 3e-8{J/(mol*K)};
@id("01a0e15f7bbc77769bb7a769964df2e0") expect partial(properties.caloric_ds,T)(correlations.constant[chem.water,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.analytic_identities],298.15{K},300{K})*derivative_temperature_interval==75.3{J/(mol*K)} tolerance 3e-8{J/(mol*K)};
}
@id("01a0e16127e470a5896844b60f09f2ef") test liquid_envelope_rejected oracle references.perry7_table_2_196 fixture {dof 0; run pure; failure trial_rejected validity(data) form(properties.caloric_cp) set(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196]) variable(T);} {
@id("01a0e16127e470a5896844b70942a384") expect properties.caloric_cp(correlations.dippr100[chem.benzene, properties.heat_capacity, compatibility.PhaseType.liquidPhase, references.perry7_table_2_196], 400{K})==150{J/(mol*K)} tolerance 1{J/(mol*K)};
}
@id("01a0e16127e470a5896844b87c45c7ed") test vessel_caloric_reference oracle references.plan14_thermo_reference fixture {dof 0; run pure;} {
@id("01a0e16127e470a5896844b9934b50cb") expect 0.2*(properties.caloric_dh(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300.0{K})) + 0.3*(properties.caloric_dh(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300.0{K})) + 0.5*(properties.caloric_dh(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300.0{K}))==110.88591367620424{J/mol} tolerance 1e-5{J/mol} relative 2e-8;
@id("01a0e16127e470a5896844ba8749893e") expect 0.2*(properties.caloric_dh(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 350.0{K})) + 0.3*(properties.caloric_dh(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 350.0{K})) + 0.5*(properties.caloric_dh(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 350.0{K}))==3291.7026814953447{J/mol} tolerance 1e-5{J/mol} relative 2e-8;
@id("01a0e16127e470a5896844bbe30cd9bb") expect 0.6*(properties.caloric_dh(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 400.0{K})) + 0.25*(properties.caloric_dh(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 400.0{K})) + 0.15000000000000002*(properties.caloric_dh(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 400.0{K}))==5102.8281402246885{J/mol} tolerance 1e-5{J/mol} relative 2e-8;
@id("01a0e16127e470a5896844bcf5cfcd7d") expect 0.1*(properties.caloric_dh(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300.0{K})) + 0.2*(properties.caloric_dh(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300.0{K})) + 0.7*(properties.caloric_dh(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 300.0{K}))==121.87185639870955{J/mol} tolerance 1e-5{J/mol} relative 2e-8;
@id("01a0e16127e470a5896844bdb91478a0") expect 0.2*(properties.caloric_dh(correlations.dippr100[chem.methane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 298.15{K})) + 0.3*(properties.caloric_dh(correlations.dippr100[chem.ethane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 298.15{K})) + 0.5*(properties.caloric_dh(correlations.dippr100[chem.propane, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.poling2000], 298.15{K}, 298.15{K}))==0.0{J/mol} tolerance 1e-5{J/mol} relative 2e-8;
}
}
