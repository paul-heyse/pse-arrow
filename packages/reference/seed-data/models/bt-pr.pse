@id("01a0e1b4f611717da49a9268ae84b41b") package bt_pr {
@id("2e7eb81f56ba439bb9b2a8a82e825e87") use eos_data @"1.0.0";

@id("01a0f14ead4d7118a57e3664098407de") use constants @"1.0.0";
@id("a5dc8a3a7f074c179277c890758ff8bc") use compatibility @"1.0.0";
@id("01a0f13d55af72e69b131205233ca285") use correlations @"1.0.0";
@id("01a0f13d55af72e69b1312046e448394") use properties @"1.0.0";
@id("01a0ef604fdf73c68b36e126bd42210b") use provenance @"1.0.0";
@id("01a0ef604fdf73c68b36e12738a6e4c8") use references @"1.0.0";
@id("01a0ee04daa773329a4687db457c50f4") use chemistry @"1.0.0";
@id("01a0e1b4f611717da49a926a2b7ad34c") use chem @"1.0.0";
@id("01a0e1b4f611717da49a926bcb59f976") use caloric @"1.0.0";
@id("01a0e1b4f611717da49a926cdeeaaff7") use caloric_data @"1.0.0";
@id("01a0e1b4f611717da49a926d44d2318b") use bt_ideal @"1.0.0";
@id("01a0e1b4f611717da49a926e90be3394") use pr_equilibrium @"1.0.0";
@id("01a0e1b4f611717da49a926f22a030a5") use equilibrium @"1.0.0";
@id("01a0e1b4f611717da49a9270067ac1c7") use helmholtz @"1.0.0";
@id("01a0eeced80374ab83c0820a4034adce") use nested_equilibrium @"1.0.0";
@id("01a0e1b4f611717da49a92713ed6ca46") table reference[j:chemistry.species]:{h:PrOracleEnthalpy,s:PrOracleEntropy} complete_over(j in bt_ideal.aromatics);
@id("01a0e1b4f611717da49a9272a559d6a6") dataset reference_values:reference provenance(references.idaes_bt_pr, provenance.Role.oracle_input) {
[chem.benzene]=[82900{J/mol},-269{J/(mol*K)}];
[chem.toluene]=[50100{J/mol},-321{J/(mol*K)}];
}
@id("dad3df578bf642ba8be32332d5bb0126") fn stock_enthalpy_anchor(T:Temperature,p:Pressure,j:chemistry.species)->MolarEnthalpy valid(T==bt_pr_oracle.temperature)=constants.standard_enthalpy_datum;
@id("57e2201c0a1842c09736f484af83e4e5") fn oracle_enthalpy_anchor(T:Temperature,p:Pressure,j:chemistry.species)->PrOracleEnthalpy valid(T==bt_pr_oracle.temperature and p==bt_pr_oracle.pressure)=reference[j].h;
// The ideal-gas pressure entropy difference is a physical reconstruction of ln(p/p0).
// Its pressure origin remains the selected stock datum, rather than a numeric adapter.
@id("512278c09ad544ae8cb3dc6c31290037") coordinate map entropy_pressure_coordinates(p:Pressure,p0:Pressure) valid(p>0{Pa} and p0>0{Pa}) {
@id("3629a3b28ba54856afc4bc74a3d7d2ee") slot pressure_ratio=p/p0;
}
@id("d5603c687012492aa816897dba6396e9") reconstruction pressure_entropy for entropy_pressure_coordinates(p:Pressure,p0:Pressure)->DeltaS reference constants.reference_conventions=constants.gas_constant;
@id("18e908a8ae274ddbadf8f3b594e213fd") fn pressure_entropy_reduced(pressure_ratio:Coordinate<entropy_pressure_coordinates.pressure_ratio>)->Reduced<pressure_entropy> valid(pressure_ratio>0)=log(pressure_ratio);
@id("b90d80f5b42d4b3c860b477a84c3411a") fn pressure_entropy_increment(p:Pressure,p0:Pressure)->DeltaS=reconstruct(pressure_entropy,pressure_entropy_reduced,p,p0);
@id("8baf004442a64b7c8f564e1111b9140e") fn stock_entropy_anchor(T:Temperature,p:Pressure,j:chemistry.species)->MolarEntropy valid(T==bt_pr_oracle.temperature)=constants.standard_entropy_datum-pressure_entropy_increment(p,constants.standard_pressure);
@id("687a07192afe417da2e880019320e9c2") fn oracle_entropy_anchor(T:Temperature,p:Pressure,j:chemistry.species)->PrOracleEntropy valid(T==bt_pr_oracle.temperature and p==bt_pr_oracle.pressure)=reference[j].s;
@id("9246743bafe34a15b6175e7fb26bf703") reference translation stock_to_oracle_enthalpy(value:MolarEnthalpy,composition:MoleFraction[chemistry.species],members:Set<chemistry.species>)->PrOracleEnthalpy anchors(source=stock_enthalpy_anchor,target=oracle_enthalpy_anchor) at(temperature=bt_pr_oracle.temperature,pressure=bt_pr_oracle.pressure) provenance(references.idaes_bt_pr,provenance.Role.oracle_input);
@id("36131f7421a94f4c8eb221a25649ecb6") reference translation stock_to_oracle_entropy(value:MolarEntropy,composition:MoleFraction[chemistry.species],members:Set<chemistry.species>)->PrOracleEntropy anchors(source=stock_entropy_anchor,target=oracle_entropy_anchor) at(temperature=bt_pr_oracle.temperature,pressure=bt_pr_oracle.pressure) provenance(references.idaes_bt_pr,provenance.Role.oracle_input);
@id("01a0e1b4f611717da49a9279038f6687") fn gas_h(T:Temperature,j:chemistry.species)->MolarEnthalpy=properties.component_enthalpy(bt_pr_idaes,chemistry.vapor,j,T);
@id("01a0e1b4f611717da49a927a3d93aefe") fn gas_s(T:Temperature,j:chemistry.species)->MolarEntropy=properties.component_entropy(bt_pr_idaes,chemistry.vapor,j,T);
@id("01a0e1b4f611717da49a927b8ced04f1") def BT_PR(defined_state:Boolean=true,minimum:Temperature=350{K},maximum:Temperature=400{K},formulation:equilibrium.VleFormulation=equilibrium.VleFormulation.smooth):pr_equilibrium.SmoothPR {
@id("e79fa9fc0a1e4d92824498ab8f0ff6fc") override param eos_package:properties.property_package=eos_data.bt_pr_parameters;
@id("51ea00c3f9be4ba0b690173bb1b2fa76") override param eos_potential:Fn(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy=eos_data.potential;

@id("e5066feedc994f50b82c7a5e05569a15") override param defined:Boolean=defined_state;
@id("01a0e1b4f611717da49a927c9b92fa31") override param components:Set<chemistry.species>=bt_ideal.aromatics;
@id("01a0e1b4f611717da49a927de67a6ef2") override param psat:Fn(T:Temperature,j:chemistry.species)->Pressure=bt_pr.psat;
@id("01a0e1b4f611717da49a927ed0b8a92b") override param liquid_enthalpy:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy=gas_h;
@id("01a0e1b4f611717da49a927f2e75c933") override param vapor_enthalpy:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy=gas_h;
@id("01a0e1b4f611717da49a9280671a1c99") override param ideal_entropy:Fn(T:Temperature,j:chemistry.species)->MolarEntropy=gas_s;
@id("01a0e1b4f611717da49a92813ed1c284") override param minimum_temperature:Temperature=minimum;
@id("01a0e1b4f611717da49a9282c0816d92") override param maximum_temperature:Temperature=maximum;
@id("01a0e1b4f611717da49a9283d7e5bb29") override param bubble_start:Temperature=365{K};
@id("01a0e1b4f611717da49a928413df3651") override param dew_start:Temperature=370{K};
@id("01a0e1b4f611717da49a9285e0b7f6d5") let oracle_h_liquid:PrOracleEnthalpy=stock_to_oracle_enthalpy(h_liquid,x,components);
@id("01a0e1b4f611717da49a92863a6d1dc5") let oracle_s_liquid:PrOracleEntropy=stock_to_oracle_entropy(s_liquid,x,components);
@id("01a0e1b4f611717da49a92879be8970c") let oracle_h_vapor:PrOracleEnthalpy=stock_to_oracle_enthalpy(h_vapor,y,components);
@id("01a0e1b4f611717da49a9288957882c3") let oracle_s_vapor:PrOracleEntropy=stock_to_oracle_entropy(s_vapor,y,components);
@id("01a0e1b4f611717da49a9289db1e3f2c") annotation valid T(minimum_temperature,maximum_temperature,reject);
@id("01a0e1b4f611717da49a928a09891d4a") annotation valid pressure(80000{Pa},120000{Pa},reject);
@id("01a0eed1000d7436b90c08550d1c0196") when formulation==equilibrium.VleFormulation.complementarity {
@id("01a0eeced80374ab83c0820cd5bb1246") child closure:nested_equilibrium.FlashSplit=pr_equilibrium.ComplementarityPR(selected=bt_ideal.aromatics,pkg=eos_package,law=eos_potential,family=eos_family,vapor_pressure=bt_pr.psat,minimum=minimum,maximum=maximum,bubble=365{K},dew=370{K});
@id("01a0eeced80374ab83c0820dd9a03750") eq bind_temperature:closure.T==T;
@id("01a0eeced80374ab83c0820ed5549345") eq bind_pressure:closure.pressure==pressure;
@id("01a0eeced80374ab83c0820f90e5029b") eq bind_feed[j in components]:closure.z[j]==z[j];
@id("01a0eeced80374ab83c08210de75dfa7") annotation start closure.T(T);
@id("01a0eeced80374ab83c08211db57506b") annotation start closure.pressure(pressure);
@id("01a0eeced80374ab83c0821294f87bf2") annotation start closure.z(z[j]);
@id("01a0eeced80374ab83c0821361050890") override eq material[j in components]:x[j]==closure.x[j];
@id("01a0eeced80374ab83c08214c816a1fa") override eq normalization:beta==closure.beta;
@id("01a0eeced80374ab83c08215149d3695") override eq fugacity[j in components]:y[j]==closure.y[j];
}
@id("01a0eed1000d7436b90c0856218645d7") when formulation==equilibrium.VleFormulation.nested {
@id("01a0eed1000d7436b90c085796f805ba") child closure:nested_equilibrium.FlashSplit=nested_equilibrium.NestedPRFlash(selected=bt_ideal.aromatics,pkg=eos_package,family=eos_family,vapor_pressure=bt_pr.psat);
@id("01a0eed189fc72d7af4d92af16a1ff4a") eq bind_temperature:closure.T==T;
@id("01a0eed189fc72d7af4d92b06aec2d0f") eq bind_pressure:closure.pressure==pressure;
@id("01a0eed189fc72d7af4d92b1aa1eaa17") eq bind_feed[j in components]:closure.z[j]==z[j];
@id("01a0eed189fc72d7af4d92b2a42d67ce") annotation start closure.T(T);
@id("01a0eed189fc72d7af4d92b34d4fc612") annotation start closure.pressure(pressure);
@id("01a0eed189fc72d7af4d92b45bce01b1") annotation start closure.z(z[j]);
@id("01a0eed189fc72d7af4d92b527ee4046") override eq material[j in components]:x[j]==closure.x[j];
@id("01a0eed189fc72d7af4d92b62fdcc5d7") override eq normalization:beta==closure.beta;
@id("01a0eed189fc72d7af4d92b767fe5b32") override eq fugacity[j in components]:y[j]==closure.y[j];
}
}
@id("01a0e1b4f611717da49a928ba89fe8d7") test ftpx_368 oracle references.idaes_test_bt_pr_368 fixture {dof 0; run steady; fix root.flow=100{mol/s}; fix root.T=368{K}; fix root.pressure=100000{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e1b4f611717da49a928c23791ee5") child root:BT_PR=BT_PR;
@id("01a0e1b4f611717da49a928d8bf28e89") expect root.x[chem.benzene]==0.4012128{1} tolerance 0.000005{1};
@id("01a0e1b4f611717da49a928e1252d268") expect root.y[chem.benzene]==0.6141738{1} tolerance 0.000007{1};
@id("01a0e1b4f611717da49a928fd215bf33") expect root.liquid.Z==0.003504 tolerance 0.00000004;
@id("01a0e1b4f611717da49a9290acb43cda") expect root.vapor.Z==0.97 tolerance 0.00001;
@id("01a0e1b4f611717da49a9291770bbafa") expect exp(root.liquid.ln_phi[chem.benzene])==1.492049{1} tolerance 0.000015{1};
@id("01a0e1b4f611717da49a9292e8692617") expect exp(root.liquid.ln_phi[chem.toluene])==0.621563{1} tolerance 0.000007{1};
@id("01a0e1b4f611717da49a92938c6971c9") expect exp(root.vapor.ln_phi[chem.benzene])==0.97469{1} tolerance 0.00001{1};
@id("01a0e1b4f611717da49a9294a8955322") expect exp(root.vapor.ln_phi[chem.toluene])==0.964642{1} tolerance 0.00001{1};
@id("01a0e1b4f611717da49a92957bcae0e8") expect root.oracle_h_liquid==38235.1{J/mol} tolerance 0.4{J/mol};
@id("01a0e1b4f611717da49a9296becb6936") expect root.oracle_h_vapor==77155.4{J/mol} tolerance 0.8{J/mol};
@id("01a0e1b4f611717da49a92973e438b65") expect root.oracle_s_liquid==-359.256{J/(mol*K)} tolerance 0.004{J/(mol*K)};
@id("01a0e1b4f611717da49a9298e6ab23f4") expect root.oracle_s_vapor==-262.348{J/(mol*K)} tolerance 0.003{J/(mol*K)};
}
@id("01a0e1c6a64b7167adfc3a95a9afa0d6") test initialized_ftpx oracle references.idaes_test_bt_pr_368 fixture {dof 0; run initialized; stages("ideal-K"); initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(600); fix root.flow=100{mol/s}; fix root.T=368{K}; fix root.pressure=100000{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e1c6a64b7167adfc3a96dacbd442") child root:BT_PR=BT_PR;
@id("01a0e1c6a64b7167adfc3a97e41fc4c3") expect root.x[chem.benzene]==0.4012128{1} tolerance 0.000005{1};
@id("01a0e1c6a64b7167adfc3a98d2872c2e") expect root.y[chem.benzene]==0.6141738{1} tolerance 0.000007{1};
@id("01a0e1c6a64b7167adfc3a996e99da70") expect root.oracle_h_liquid==38235.1{J/mol} tolerance 0.4{J/mol};
}
@id("14a11319a3fd43ddadf8b835a0055305") entity properties.property_package bt_pr_idaes {}
@id("e572ffcd08d140748d2aed097703e4bb") fn psat(T:Temperature,j:chemistry.species)->Pressure=properties.psat(bt_pr_idaes,chemistry.liquid,j,T);
@id("ed3260cfafc0494d83bc2552ca026af8") dataset property_selection:properties.selection complete_over(k in binding_packages,j in bt_ideal.aromatics,p in properties.caloric_properties,t in properties.vapor_types) provenance(references.idaes_bt_pr,provenance.Role.oracle_input) {
[bt_pr_idaes,chem.benzene,properties.heat_capacity,compatibility.PhaseType.vaporPhase]=[correlations.rpp4_cp[chem.benzene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal]];
[bt_pr_idaes,chem.toluene,properties.heat_capacity,compatibility.PhaseType.vaporPhase]=[correlations.rpp4_cp[chem.toluene, properties.heat_capacity, compatibility.PhaseType.vaporPhase, references.idaes_bt_ideal]];
}
@id("7489d5a422a5419b96cff76e461fe3ab") dataset property_selection_liquid_vapor_pressure:properties.selection complete_over(k in binding_packages,j in bt_ideal.aromatics,p in properties.vapor_pressure_properties,t in properties.liquid_types) provenance(references.idaes_bt_pr,provenance.Role.oracle_input) {
[bt_pr_idaes,chem.benzene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase]=[correlations.rpp4_wagner[chem.benzene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase,references.idaes_test_rpp4]];
[bt_pr_idaes,chem.toluene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase]=[correlations.rpp4_wagner[chem.toluene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase,references.idaes_test_rpp4]];
}
@id("6ac9cf79cfd54b3c8356589e19419f7f") set binding_packages:Set<properties.property_package>={bt_pr_idaes};
@id("5b16541585814ba7b21bd4c1e1eb9fa4") dataset datum_selection:properties.caloric_basis complete_over(k in binding_packages,t in properties.vapor_types,j in bt_ideal.aromatics) provenance(references.idaes_bt_pr,provenance.Role.oracle_input) {
[bt_pr_idaes,compatibility.PhaseType.vaporPhase,chem.benzene]=[stock,chemistry.vapor,0{J/mol},0{J/(mol*K)}];
[bt_pr_idaes,compatibility.PhaseType.vaporPhase,chem.toluene]=[stock,chemistry.vapor,0{J/mol},0{J/(mol*K)}];
}
}
