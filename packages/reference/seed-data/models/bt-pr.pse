@id("01a0e1b4f611717da49a9268ae84b41b") package bt_pr {
@id("01a0ef604fdf73c68b36e126bd42210b") use provenance @"1.0.0";
@id("01a0ef604fdf73c68b36e12738a6e4c8") use references @"1.0.0";
@id("01a0ee04daa773329a4687db457c50f4") use chemistry @"1.0.0";
@id("01a0e1b4f611717da49a926a2b7ad34c") use chem @"1.0.0";
@id("01a0e1b4f611717da49a926bcb59f976") use caloric @"1.0.0";
@id("01a0e1b4f611717da49a926cdeeaaff7") use caloric_data @"1.0.0";
@id("01a0e1b4f611717da49a926d44d2318b") use bt_ideal @"1.0.0";
@id("01a0e1b4f611717da49a926e90be3394") use pr_equilibrium @"1.0.0";
@id("01a0e1b4f611717da49a926f22a030a5") use equilibrium @"1.0.0";
@id("01a0e1b4f611717da49a9270067ac1c7") use helmholtz @"1.0.0";
@id("01a0eeced80374ab83c0820a4034adce") use nested_equilibrium @"1.0.0";
@id("01a0e1b4f611717da49a92713ed6ca46") table reference[j:chemistry.species]:{gas_fit:caloric.fit,h:PrOracleEnthalpy,s:PrOracleEntropy} complete_over(j in chem.aromatics);
@id("01a0e1b4f611717da49a9272a559d6a6") dataset reference_values:reference provenance(references.idaes_bt_pr, provenance.Role.oracle_input) {
[chem.benzene]=[caloric_data.benzene_gas_rpp4_oracle,82900{J/mol},-269{J/(mol*K)}];
[chem.toluene]=[caloric_data.toluene_gas_rpp4_oracle,50100{J/mol},-321{J/(mol*K)}];
}
@id("01a0e1b4f611717da49a92733d46726d") fn source_h_zero()->PrOracleEnthalpy=0{J/mol};
@id("01a0e1b4f611717da49a92746cf62f24") fn source_h_unit()->PrOracleDeltaH=1{J/mol};
@id("01a0e1b4f611717da49a927599ea7fa8") fn source_s_zero()->PrOracleEntropy=0{J/(mol*K)};
@id("01a0e1b4f611717da49a92764aeb5711") fn source_s_unit()->PrOracleDeltaS=1{J/(mol*K)};
@id("01a0e1b4f611717da49a9277ee0cda0d") fn reference_T()->Temperature=298.15{K};
@id("01a0e1b4f611717da49a927833f4d3d9") fn reference_P()->Pressure=101325{Pa};
@id("01a0e1b4f611717da49a9279038f6687") fn gas_h(T:Temperature,j:chemistry.species)->MolarEnthalpy=equilibrium.enthalpy_datum()+caloric.polynomial_h_primitive(T,caloric.polynomial[reference[j].gas_fit])-caloric.polynomial_h_primitive(reference_T(),caloric.polynomial[reference[j].gas_fit]);
@id("01a0e1b4f611717da49a927a3d93aefe") fn gas_s(T:Temperature,j:chemistry.species)->MolarEntropy=equilibrium.entropy_datum()+caloric.polynomial_s_primitive(T,caloric.polynomial[reference[j].gas_fit])-caloric.polynomial_s_primitive(reference_T(),caloric.polynomial[reference[j].gas_fit]);
@id("01a0e1b4f611717da49a927b8ced04f1") def BT_PR(defined_state:Boolean=true,minimum:Temperature=350{K},maximum:Temperature=400{K},formulation:equilibrium.VleFormulation=equilibrium.VleFormulation.smooth):pr_equilibrium.SmoothPR {
@id("e5066feedc994f50b82c7a5e05569a15") override param defined:Boolean=defined_state;
@id("01a0e1b4f611717da49a927c9b92fa31") override param components:Set<chemistry.species>=chem.aromatics;
@id("01a0e1b4f611717da49a927de67a6ef2") override param psat:Fn(T:Temperature,j:chemistry.species)->Pressure=bt_ideal.psat;
@id("01a0e1b4f611717da49a927ed0b8a92b") override param liquid_enthalpy:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy=gas_h;
@id("01a0e1b4f611717da49a927f2e75c933") override param vapor_enthalpy:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy=gas_h;
@id("01a0e1b4f611717da49a9280671a1c99") override param ideal_entropy:Fn(T:Temperature,j:chemistry.species)->MolarEntropy=gas_s;
@id("01a0e1b4f611717da49a92813ed1c284") override param minimum_temperature:Temperature=minimum;
@id("01a0e1b4f611717da49a9282c0816d92") override param maximum_temperature:Temperature=maximum;
@id("01a0e1b4f611717da49a9283d7e5bb29") override param bubble_start:Temperature=365{K};
@id("01a0e1b4f611717da49a928413df3651") override param dew_start:Temperature=370{K};
@id("01a0e1b4f611717da49a9285e0b7f6d5") let oracle_h_liquid:PrOracleEnthalpy=source_h_zero()+source_h_unit()*((h_liquid-equilibrium.enthalpy_datum())/caloric.h_unit()+sum(j in components | (x[j]/equilibrium.fraction_unit())*((reference[j].h-source_h_zero())/source_h_unit())));
@id("01a0e1b4f611717da49a92863a6d1dc5") let oracle_s_liquid:PrOracleEntropy=source_s_zero()+source_s_unit()*((s_liquid-equilibrium.entropy_datum())/caloric.s_unit()+helmholtz.reduced_gas_constant()*log(reference_P()/pr_equilibrium.reference_pressure())+sum(j in components | (x[j]/equilibrium.fraction_unit())*((reference[j].s-source_s_zero())/source_s_unit())));
@id("01a0e1b4f611717da49a92879be8970c") let oracle_h_vapor:PrOracleEnthalpy=source_h_zero()+source_h_unit()*((h_vapor-equilibrium.enthalpy_datum())/caloric.h_unit()+sum(j in components | (y[j]/equilibrium.fraction_unit())*((reference[j].h-source_h_zero())/source_h_unit())));
@id("01a0e1b4f611717da49a9288957882c3") let oracle_s_vapor:PrOracleEntropy=source_s_zero()+source_s_unit()*((s_vapor-equilibrium.entropy_datum())/caloric.s_unit()+helmholtz.reduced_gas_constant()*log(reference_P()/pr_equilibrium.reference_pressure())+sum(j in components | (y[j]/equilibrium.fraction_unit())*((reference[j].s-source_s_zero())/source_s_unit())));
@id("01a0e1b4f611717da49a9289db1e3f2c") annotation valid T(minimum_temperature,maximum_temperature,reject);
@id("01a0e1b4f611717da49a928a09891d4a") annotation valid pressure(80000{Pa},120000{Pa},reject);
@id("01a0eed1000d7436b90c08550d1c0196") when formulation==equilibrium.VleFormulation.complementarity {
@id("01a0eeced80374ab83c0820cd5bb1246") child closure:nested_equilibrium.FlashSplit=pr_equilibrium.ComplementarityPR(selected=chem.aromatics,vapor_pressure=bt_ideal.psat,minimum=minimum,maximum=maximum,bubble=365{K},dew=370{K});
@id("01a0eeced80374ab83c0820dd9a03750") eq bind_temperature:closure.T==T;
@id("01a0eeced80374ab83c0820ed5549345") eq bind_pressure:closure.pressure==pressure;
@id("01a0eeced80374ab83c0820f90e5029b") eq bind_feed[j in components]:closure.z[j]==z[j];
@id("01a0eeced80374ab83c08210de75dfa7") annotation start closure.T(T);
@id("01a0eeced80374ab83c08211db57506b") annotation start closure.pressure(pressure);
@id("01a0eeced80374ab83c0821294f87bf2") annotation start closure.z(z[j]);
@id("01a0eeced80374ab83c0821361050890") override eq material[j in components]:x[j]==closure.x[j];
@id("01a0eeced80374ab83c08214c816a1fa") override eq normalization:beta==closure.beta;
@id("01a0eeced80374ab83c08215149d3695") override eq fugacity[j in components]:y[j]==closure.y[j];
}
@id("01a0eed1000d7436b90c0856218645d7") when formulation==equilibrium.VleFormulation.nested {
@id("01a0eed1000d7436b90c085796f805ba") child closure:nested_equilibrium.FlashSplit=nested_equilibrium.NestedPRFlash(selected=chem.aromatics,vapor_pressure=bt_ideal.psat);
@id("01a0eed189fc72d7af4d92af16a1ff4a") eq bind_temperature:closure.T==T;
@id("01a0eed189fc72d7af4d92b06aec2d0f") eq bind_pressure:closure.pressure==pressure;
@id("01a0eed189fc72d7af4d92b1aa1eaa17") eq bind_feed[j in components]:closure.z[j]==z[j];
@id("01a0eed189fc72d7af4d92b2a42d67ce") annotation start closure.T(T);
@id("01a0eed189fc72d7af4d92b34d4fc612") annotation start closure.pressure(pressure);
@id("01a0eed189fc72d7af4d92b45bce01b1") annotation start closure.z(z[j]);
@id("01a0eed189fc72d7af4d92b527ee4046") override eq material[j in components]:x[j]==closure.x[j];
@id("01a0eed189fc72d7af4d92b62fdcc5d7") override eq normalization:beta==closure.beta;
@id("01a0eed189fc72d7af4d92b767fe5b32") override eq fugacity[j in components]:y[j]==closure.y[j];
}
}
@id("01a0e1b4f611717da49a928ba89fe8d7") test ftpx_368 oracle references.idaes_test_bt_pr_368 fixture {dof 0; run steady; fix root.flow=100{mol/s}; fix root.T=368{K}; fix root.pressure=100000{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e1b4f611717da49a928c23791ee5") child root:BT_PR=BT_PR;
@id("01a0e1b4f611717da49a928d8bf28e89") expect root.x[chem.benzene]==0.4012128{1} tolerance 0.000005{1};
@id("01a0e1b4f611717da49a928e1252d268") expect root.y[chem.benzene]==0.6141738{1} tolerance 0.000007{1};
@id("01a0e1b4f611717da49a928fd215bf33") expect root.liquid.Z==0.003504 tolerance 0.00000004;
@id("01a0e1b4f611717da49a9290acb43cda") expect root.vapor.Z==0.97 tolerance 0.00001;
@id("01a0e1b4f611717da49a9291770bbafa") expect exp(root.liquid.ln_phi[chem.benzene])==1.492049 tolerance 0.000015;
@id("01a0e1b4f611717da49a9292e8692617") expect exp(root.liquid.ln_phi[chem.toluene])==0.621563 tolerance 0.000007;
@id("01a0e1b4f611717da49a92938c6971c9") expect exp(root.vapor.ln_phi[chem.benzene])==0.97469 tolerance 0.00001;
@id("01a0e1b4f611717da49a9294a8955322") expect exp(root.vapor.ln_phi[chem.toluene])==0.964642 tolerance 0.00001;
@id("01a0e1b4f611717da49a92957bcae0e8") expect root.oracle_h_liquid==38235.1{J/mol} tolerance 0.4{J/mol};
@id("01a0e1b4f611717da49a9296becb6936") expect root.oracle_h_vapor==77155.4{J/mol} tolerance 0.8{J/mol};
@id("01a0e1b4f611717da49a92973e438b65") expect root.oracle_s_liquid==-359.256{J/(mol*K)} tolerance 0.004{J/(mol*K)};
@id("01a0e1b4f611717da49a9298e6ab23f4") expect root.oracle_s_vapor==-262.348{J/(mol*K)} tolerance 0.003{J/(mol*K)};
}
@id("01a0e1c6a64b7167adfc3a95a9afa0d6") test initialized_ftpx oracle references.idaes_test_bt_pr_368 fixture {dof 0; run initialized; stages("ideal-K"); initialize homotopy(false) step(0.5) minimum(1e-6) growth(2) attempts(4) seconds(600); fix root.flow=100{mol/s}; fix root.T=368{K}; fix root.pressure=100000{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e1c6a64b7167adfc3a96dacbd442") child root:BT_PR=BT_PR;
@id("01a0e1c6a64b7167adfc3a97e41fc4c3") expect root.x[chem.benzene]==0.4012128{1} tolerance 0.000005{1};
@id("01a0e1c6a64b7167adfc3a98d2872c2e") expect root.y[chem.benzene]==0.6141738{1} tolerance 0.000007{1};
@id("01a0e1c6a64b7167adfc3a996e99da70") expect root.oracle_h_liquid==38235.1{J/mol} tolerance 0.4{J/mol};
}
}
