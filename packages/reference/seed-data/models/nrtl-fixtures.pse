@id("ae77f0a9ad144456be8a54c53a1bfb09") package nrtl_fixtures {
@id("20c834ebbc904dcb9e95b1a4c61a26c3") use constants @"1.0.0";
@id("061f597a3f4b4c87828b26e7d33d65be") use chemistry @"1.0.0";
@id("332bb700dd744b27ba3b0152a56d6a1b") use chem @"1.0.0";
@id("124e4ecc03ed47a482a340c37ea98a92") use provenance @"1.0.0";
@id("35216cf9f07f4528a80211b31689f2a9") use properties @"1.0.0";
@id("aeb7ca94a3af4c8f894d00fe0a649200") use interactions @"1.0.0";
@id("2ece870331d049a5bfb298a0de60a0b4") use nrtl @"1.0.0";
@id("0bf5a3fe11f14228818b58a57dcc5c86") use nrtl_reference @"1.0.0";
@id("2debda0072f847cea311cd4f35cce7d0") entity properties.property_package package_selection {}
@id("4a44d9f9d6b24ffe8de94b04577b0936") set packages:Set<properties.property_package>={package_selection};
@id("fa52db4f2b5e4a24aa5ba2ec70a6f3d6") set pair_properties:Set<properties.property>={nrtl.interaction_parameters};
@id("0470eec0da324f8cab34cb968eec9f30") dataset pair_source:interactions.pair_selection complete_over(k in packages,p in pair_properties) provenance(nrtl_reference.defaults,provenance.Role.oracle_input) {[package_selection,nrtl.interaction_parameters]=[nrtl_reference.defaults];}
@id("b496bdc8e9d04b288b7a478c4e169105") set members:Set<chemistry.species>={chem.benzene,chem.toluene};
@id("86e84e07a9094a6eaa6a11ae440067e2") def Binary(composition:Scalar,total:Amount=constants.amount_unit) {
@id("4f2e80415b8941ecb83e13024befabab") let n[j in members]:Amount=total*(if j==chem.benzene then composition else 1-composition);
@id("6dba012ae3e44f96af6bf72efffeac41") let excess:Scalar=nrtl.normalized_excess(constants.standard_temperature,constants.standard_pressure,n,members,package_selection,nrtl.potential);
@id("77117de01346421887afa3957075e23a") let gamma[j in members]:Scalar=nrtl.ln_gamma(constants.standard_temperature,constants.standard_pressure,n,members,package_selection,j);
@id("6a8808622dc0470c9e0e2c4ff8a77c48") let gibbs_duhem[j in members]:Scalar=nrtl.gibbs_duhem_response(constants.standard_temperature,constants.standard_pressure,n,members,package_selection,j,nrtl.potential);
}
@id("ee8c7df5633b4a6a86b9f747da770636") test default_nrtl_closed_form_derivatives_and_idaes oracle nrtl_reference.defaults fixture {dof 0;run pure;} {
@id("ef0b0e4f1a214085918a7857dbf27b8e") set compositions:Set<Scalar>={0.2,0.5,0.8};
@id("d9ccffdaaf204644989be4739ac9a6b9") child point[x in compositions]:Binary=Binary(composition=x);
@id("51fb362de8b043d19c02d3d9e53083e8") expect sum(x in compositions | abs(point[x].excess-nrtl.binary(x,1,1,0.3,0.3)))==0 tolerance 1e-12;
@id("ce7e23846bac40868d47e84166e29e94") expect sum(x in compositions | sum(j in members | abs(point[x].gamma[j]-nrtl_reference.observations[x,j])))==0 tolerance 1e-12;
@id("f927845fa2bf494d90b879250c999895") expect sum(x in compositions | sum(j in members | abs(point[x].gibbs_duhem[j])))==0 tolerance 1e-12;
}
@id("04ece38aec494e4da773690b00b809a9") test degree_one_excess_and_amount_invariant_activity oracle nrtl_reference.defaults fixture {dof 0;run pure;} {
@id("42e3b97590a24c019754fdcab147f7a0") child one:Binary=Binary(composition=0.3,total=1{mol});
@id("c772e7721e53411a9de17f6a821215b4") child three:Binary=Binary(composition=0.3,total=3{mol});
@id("b9a5b3bdaebc4e5ca60bb8d06f6afd8e") expect three.excess==3*one.excess tolerance 1e-12;
@id("0a3674785fbe47e987aa061cc68e34b4") expect sum(j in members | abs(three.gamma[j]-one.gamma[j]))==0 tolerance 1e-12;
@id("13411678c48c40e6b90956d345139636") expect sum(j in members | abs(three.gibbs_duhem[j]))==0 tolerance 1e-12;
}
}
