@id("01a0e16f32a3739a874c1279c0bb4b35") package eos_data {
@id("9a2a625994b34e4496d416bcda94cdb7") use chemistry @"1.0.0";
@id("ca679c85475f49cf827ce44c727bde85") use properties @"1.0.0";
@id("e9c1acec96e642098f0bf212b6608a7b") use interactions @"1.0.0";
@id("2a9c16c1321b4efc9db7088cdc0ebe31") use cubic @"1.0.0";
@id("b232161467fa461ca64f33b5b7ef8144") use compatibility @"1.0.0";

@id("01a0f12be01970a7bc46738218278f90") use bt_ideal @"1.0.0";
@id("01a0ef604fdf73c68b36e12eba57f6bb") use provenance @"1.0.0";
@id("01a0ef604fdf73c68b36e12fc7943478") use references @"1.0.0";
@id("01a0e16f32a3739a874c127a25168daa") use chem @"1.0.0";
@id("01a0e16f32a3739a874c127b9803d848") use peng_robinson @"1.0.0";
@id("93ea4ca624b6470590f79038ef3c4420") entity properties.property_package bt_pr_parameters {admitted=bt_pr_parameters_admitted}
@id("36ccdb7835a446258fecd72502edcb49") set bt_pr_parameters_set:Set<properties.property_package>={bt_pr_parameters};
@id("46ed12dd806247949689f6afc170cff0") set bt_pr_parameters_critical:Set<properties.property>={cubic.critical_parameters};
@id("75bfaf89328d421a9b3e4ff17cd92581") set bt_pr_parameters_pair:Set<properties.property>={cubic.binary_interaction};
@id("8b609bd78c364ea2be923db43e6f9166") dataset bt_pr_parameters_selection:properties.pure_selection complete_over(k in bt_pr_parameters_set,j in bt_ideal.aromatics,p in bt_pr_parameters_critical) provenance(references.idaes_bt_pr,provenance.Role.oracle_input) {
[bt_pr_parameters,chem.benzene,cubic.critical_parameters]=[cubic.critical_point[chem.benzene,cubic.critical_parameters,references.idaes_bt_pr_critical_fit]];
[bt_pr_parameters,chem.toluene,cubic.critical_parameters]=[cubic.critical_point[chem.toluene,cubic.critical_parameters,references.idaes_bt_pr_critical_fit]];
}
@id("11609b22f93a4d1c948d7dd6f06fac49") fn potential(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy=peng_robinson.potential(T,V,n,members,bt_pr_parameters,cubic.pr);
@id("85eac3abbaae454e817f8cff1fdf9949") fn pressure_coordinate(t:Scalar,r:Scalar,n:Scalar[chemistry.species],members:Set<chemistry.species>)->Scalar=peng_robinson.pressure_coordinate(t,r,n,members,bt_pr_parameters,cubic.pr);
@id("7bc8b499c1e649f392e4097f79ded983") fn srk_potential(T:Temperature,V:Volume,n:Amount[chemistry.species],members:Set<chemistry.species>)->ResidualHelmholtzEnergy=peng_robinson.potential(T,V,n,members,bt_pr_parameters,cubic.srk);

@id("e79dcbbba7e44257b0bb409575707409") entity properties.predictive_rule bt_pr_parameters_zero_rule {source=references.idaes_bt_pr,family=cubic.binary_interaction,dependencies={},output=interactions.predictive_zero}
@id("fca748a9fb24438ebd25967aad2e758f") dataset bt_pr_parameters_self:interactions.self_rule complete_over(k in bt_pr_parameters_set,family in bt_pr_parameters_pair_contracts) provenance(references.idaes_bt_pr,provenance.Role.oracle_input) {[bt_pr_parameters,cubic.binary_interaction]=[interactions.zero_self];}
@id("645c193e70fc4958b926e1f67cc1ea33") set bt_pr_parameters_pair_contracts:Set<properties.property>={cubic.binary_interaction};
@id("696f4f0be06f4f96855302f51c415a1f") dataset bt_pr_parameters_predictions:interactions.symmetric_selection complete_over(k in bt_pr_parameters_set,family in bt_pr_parameters_pair_contracts,i in bt_pr_parameters_pair_subjects,j in bt_pr_parameters_pair_subjects) provenance(references.idaes_bt_pr,provenance.Role.oracle_input) {
[bt_pr_parameters,cubic.binary_interaction,chem.benzene,chem.toluene]=[missing,bt_pr_parameters_zero_rule];
}
@id("e6595b73a2c64147abb69c3ce9406f87") set bt_pr_parameters_pair_subjects:Set<chemistry.species>={chem.benzene,chem.toluene};
@id("d5fb1aabf87241b4ad5bac91c7f6e663") entity properties.selection_context bt_pr_parameters_admitted {roots={cubic.critical_point[chem.benzene,cubic.critical_parameters,references.idaes_bt_pr_critical_fit],cubic.critical_point[chem.toluene,cubic.critical_parameters,references.idaes_bt_pr_critical_fit]},subjects={chem.benzene,chem.toluene},models={cubic.critical_parameters,cubic.binary_interaction},rules={bt_pr_parameters_zero_rule}}
@id("1e7a614085fc4a818c6268175fa615ea") dataset bt_pr_parameters_law:interactions.pair_law complete_over(k in bt_pr_parameters_set,p in bt_pr_parameters_pair) provenance(references.idaes_bt_pr,provenance.Role.oracle_input) {[bt_pr_parameters,cubic.binary_interaction]=[interactions.pair_parameter];}
}
