@id("01a0e1461e93764398a669ee491806c6") entity kinds.species methane {}
@id("01a0e1461e93764398a669ef76e30f69") entity kinds.species ethane {}
@id("01a0e1461e93764398a669f099714f13") entity kinds.species propane {}
@id("01a0e1461e93764398a669f1c287283e") entity kinds.species ethyl_acetate {}
@id("01a0e1461e93764398a669f2264addb2") entity kinds.species sodium_hydroxide {}
@id("01a0e1461e93764398a669f3f073acf1") entity kinds.species sodium_acetate {}
@id("01a0e1461e93764398a669f485d31290") entity kinds.species ethanol {}
@id("01a0e1461e93764398a669f5970cb265") entity kinds.phase liquid {}
@id("01a0e1461e93764398a669f600e57253") entity kinds.phase vapor {}
@id("01a0e1461e93764398a669f732daa5d4") entity kinds.phase aqueous {}
@id("01a0e1461e93764398a669f83ae71a00") set elements:Set<kinds.element>={H,He,C,N,O,F,Na,Mg,Al,Si,P,S,Cl,Ar,K,Ca,Fe,Cu,Zn,Br,I};
@id("01a0e1461e93764398a669f95e685efd") set species:Set<kinds.species>={benzene,toluene,water,nitrogen,methane,ethane,propane,ethyl_acetate,sodium_hydroxide,sodium_acetate,ethanol};
@id("01a0e1461e93764398a669fa47465afc") set aromatics:Set<kinds.species>={benzene,toluene};
@id("01a0e1461e93764398a669fb6e743962") set alkanes:Set<kinds.species>={methane,ethane,propane};
@id("01a0e1461e93764398a669fca4ddfdbe") set saponification_species:Set<kinds.species>={ethyl_acetate,sodium_hydroxide,sodium_acetate,ethanol,water};
@id("01a0e1461e93764398a669fdf92fb6c9") table atomic_mass[e:kinds.element]:MolarMass;
@id("01a0e1461e94708a83138816e9f2da10") dataset ciaaw_2024:atomic_mass source "CIAAW abridged standard atomic weights 2024; kg/mol; normal terrestrial materials" {
[H]=[0.001008{kg/mol}];
[C]=[0.012011{kg/mol}];
[N]=[0.014007{kg/mol}];
[O]=[0.015999{kg/mol}];
[Na]=[0.022990{kg/mol}];
[He]=[0.0040026{kg/mol}];
[F]=[0.018998{kg/mol}];
[Mg]=[0.024305{kg/mol}];
[Al]=[0.026982{kg/mol}];
[Si]=[0.028085000000000002{kg/mol}];
[P]=[0.030974{kg/mol}];
[S]=[0.032060000000000005{kg/mol}];
[Cl]=[0.03545{kg/mol}];
[Ar]=[0.03995{kg/mol}];
[K]=[0.039098{kg/mol}];
[Ca]=[0.040078{kg/mol}];
[Fe]=[0.055845{kg/mol}];
[Cu]=[0.063546{kg/mol}];
[Zn]=[0.06538{kg/mol}];
[Br]=[0.079904{kg/mol}];
[I]=[0.1269{kg/mol}];
}
@id("01a0e1461e94708a83138817b9017ba3") table atoms[j:kinds.species,e:kinds.element]:Scalar missing default 0;
@id("01a0e1461e94708a831388181e66cbca") dataset elemental_composition:atoms source "Molecular formulas; neutral formula units, not dissociated aqueous ions" {
[benzene,C]=[6];
[benzene,H]=[6];
[toluene,C]=[7];
[toluene,H]=[8];
[water,H]=[2];
[water,O]=[1];
[nitrogen,N]=[2];
[methane,C]=[1];
[methane,H]=[4];
[ethane,C]=[2];
[ethane,H]=[6];
[propane,C]=[3];
[propane,H]=[8];
[ethyl_acetate,C]=[4];
[ethyl_acetate,H]=[8];
[ethyl_acetate,O]=[2];
[sodium_hydroxide,Na]=[1];
[sodium_hydroxide,O]=[1];
[sodium_hydroxide,H]=[1];
[sodium_acetate,Na]=[1];
[sodium_acetate,C]=[2];
[sodium_acetate,H]=[3];
[sodium_acetate,O]=[2];
[ethanol,C]=[2];
[ethanol,H]=[6];
[ethanol,O]=[1];
}
@id("01a0e1461e94708a83138819c156f1bc") test formula_weights fixture {dof 0; run pure;} {
@id("01a0e1461e94708a8313881a6114d017") expect sum(e in elements | atoms[benzene,e]*atomic_mass[e])==0.078114{kg/mol} tolerance 1e-12{kg/mol};
@id("01a0e1461e94708a8313881b23d74d45") expect sum(e in elements | atoms[toluene,e]*atomic_mass[e])==0.092141{kg/mol} tolerance 1e-12{kg/mol};
@id("01a0e1461e94708a8313881cd92832a5") expect sum(e in elements | atoms[methane,e]*atomic_mass[e])==0.016043{kg/mol} tolerance 1e-12{kg/mol};
@id("01a0e1461e94708a8313881d8b906241") expect atoms[ethyl_acetate,H]+atoms[sodium_hydroxide,H]==atoms[sodium_acetate,H]+atoms[ethanol,H] tolerance 1e-12;
@id("01a0e1461e94708a8313881ec53658ec") expect atoms[ethyl_acetate,C]+atoms[sodium_hydroxide,C]==atoms[sodium_acetate,C]+atoms[ethanol,C] tolerance 1e-12;
@id("01a0e1461e94708a8313881fa9068f91") expect atoms[ethyl_acetate,N]+atoms[sodium_hydroxide,N]==atoms[sodium_acetate,N]+atoms[ethanol,N] tolerance 1e-12;
@id("01a0e1461e94708a83138820bdddc67c") expect atoms[ethyl_acetate,O]+atoms[sodium_hydroxide,O]==atoms[sodium_acetate,O]+atoms[ethanol,O] tolerance 1e-12;
@id("01a0e1461e94708a8313882132c245dc") expect atoms[ethyl_acetate,Na]+atoms[sodium_hydroxide,Na]==atoms[sodium_acetate,Na]+atoms[ethanol,Na] tolerance 1e-12;
}
}
