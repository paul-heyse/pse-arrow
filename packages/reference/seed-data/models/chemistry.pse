@id("e68b413afac4e94e81268eeaed50b27c") entity kinds.element Al {}
@id("4a2d7db2f55cdd149ae5b0e22e346698") entity kinds.element Si {}
@id("81ca231c74198e0a3d218fc374aae18b") entity kinds.element P {}
