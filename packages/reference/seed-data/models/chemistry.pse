@id("e9ba8f6e5b689ec8eac6dacb0b6347e2") entity kinds.element Ar {}
@id("e2e27d26620b881b8fc71108b5fa4fe8") entity kinds.element K {}
@id("374e5f9940afd32be500ae9ff83ee6c7") entity kinds.element Ca {}
@id("08ae872fad328c4e73a2ca4ae1426070") entity kinds.element Fe {}
@id("076c1f2a09cb38c1093d0bf755b4d179") entity kinds.element Cu {}
@id("bec4907ef715c48c2ec6ace7b9b068ad") entity kinds.element Zn {}
