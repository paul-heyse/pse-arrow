@id("01a0e1461e93764398a669ea78d82d27") entity kinds.species benzene {}
@id("01a0e1461e93764398a669eb046f4eaf") entity kinds.species toluene {}
@id("01a0e1461e93764398a669ec398dd8a0") entity kinds.species water {}
