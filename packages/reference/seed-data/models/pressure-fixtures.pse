@id("5e8ff6278a5143e584ed0a8fc7debca8") package pressure_fixtures {
@id("1c6f8a87eff14dc4aebf8106cde1595b") use correlations @"1.0.0";
@id("8c31478a753d4379959581d56f7cf32e") use properties @"1.0.0";
@id("7e915a1e20d64e1cb393ec45ff76ab88") use compatibility @"1.0.0";
@id("01a0f14ead4d7118a57e3663b390e8aa") use constants @"1.0.0";
@id("01a0ef604fe0732189b937316c4c667e") use references @"1.0.0";
@id("01a0ee04daa874fc9167381793df0548") use chemistry @"1.0.0";
@id("babd01d3c2d44ea799e563b2a79a4670") use chem @"1.0.0";
@id("7fa304a44bc8414b8a6a4f708ba47945") use equilibrium @"1.0.0";
@id("83c354f1232a4d1db00ac4df5449bc10") use caloric @"1.0.0";
@id("1ca74642253d49acbd1d624bf559751b") use ideal_caloric_state @"1.0.0";
@id("b6999de11a8f458d91c77a91e06df1ce") use pressure_change @"1.0.0";
@id("862ea0fe7c814087a86af6f4c73231cf") use saponification @"1.0.0";
@id("a50b21dfc31447c99619b8b8dd16bd49") fn reference_temperature()->Temperature=300{K};
// The analytic perfect-gas fixture specifies Cp/R=3.5; reconstruction supplies
// the physical molar heat capacity rather than relabelling a gas constant.
@id("acbc9cb3c0234e58afe86a3028b466f0") coordinate map perfect_gas_caloric_coordinates(gas:GasConstant,ratio:Scalar) valid(ratio>0) {
@id("0b20b3b26d2749c2ac27944c4c36adf7") slot heat_capacity_ratio=ratio;
}
@id("37de0facf84d42f2b48dbbefbc343ac7") reconstruction perfect_gas_heat_capacity for perfect_gas_caloric_coordinates(gas:GasConstant,ratio:Scalar)->MolarCp reference references.analytic_perfect_gas=gas;
@id("a5c107901f634df8a53779b91b1a1cf0") fn perfect_gas_heat_capacity_reduced(heat_capacity_ratio:Coordinate<perfect_gas_caloric_coordinates.heat_capacity_ratio>)->Reduced<perfect_gas_heat_capacity>=heat_capacity_ratio;
@id("d432ed93187940b3adb0a271d3ef1ff1") fn cp()->MolarCp=reconstruct(perfect_gas_heat_capacity,perfect_gas_heat_capacity_reduced,constants.gas_constant,3.5);
@id("7cdb64f2f1fd4173a0ed0cd040b17806") fn molar_h(T:Temperature,j:chemistry.species)->MolarEnthalpy=constants.standard_enthalpy_datum+cp()*(T-reference_temperature());
@id("3266ba88061448708f4f377c31842e50") fn molar_s(T:Temperature,j:chemistry.species)->MolarEntropy=constants.standard_entropy_datum+cp()*log(T/reference_temperature());
@id("c4b4a61f230b4e179b25ecae7b67bcac") def PerfectNitrogen(defined_state:Boolean):ideal_caloric_state.IdealGasState {
@id("a337869f1cc74dfa857318470bb1a216") override param defined:Boolean=defined_state;
@id("c104ce24cfe046bc8b45147e21c0070d") override param components:Set<chemistry.species>={chem.nitrogen};
@id("7ac84df6c86f4ab48b2eeb2ab566a8f1") override param component_h:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy=molar_h;
@id("76f86065de55448a841ec0bdfc5462d6") override param component_s:Fn(T:Temperature,j:chemistry.species)->MolarEntropy=molar_s;
@id("d09be7d2e0ae41cc8ce72e0d11ac9114") override param reference_pressure:Pressure=101325{Pa};
@id("425abfaabc4745259ee4223303be79f2") override param minimum_temperature:Temperature=250{K};
@id("cb8feb0044364b648f0c7b647ea11a2b") override param maximum_temperature:Temperature=700{K};
}
@id("52269fd3b5184ed49e3561867aa8e01f") test compressor oracle references.analytic_perfect_gas fixture {dof 0; run steady; fix root.control.inlet.T=300{K}; fix root.control.inlet.flow=1{mol/s}; fix root.control.inlet.pressure=101325{Pa}; fix root.control.inlet.z[chem.nitrogen]=1{1}; fix root.control.delta_pressure=101325{Pa}; fix root.control.efficiency=0.8;} {
@id("c1613021ce54447b82ab44a5495fa823") child root:pressure_change.PressureChanger=pressure_change.Compressor(inlet_pkg=PerfectNitrogen(defined_state=true),outlet_pkg=PerfectNitrogen(defined_state=false),assumption=pressure_change.IsentropicAssumption(reference_pkg=PerfectNitrogen(defined_state=true)));
@id("22ea517449a74d2e956e0c63377fd4b0") expect root.control.outlet.T==382.13012032667825{K} tolerance 1e-6{K};
@id("8220ea7598984fc8b0b3e096bda694c1") expect root.control.work==2390.0373534820787{W} tolerance 1e-5{W};
@id("4f94ab109ab14528b6e5dde249bac18a") expect root.control.work_fluid==1912.029882785663{W} tolerance 1e-5{W};
}
@id("425986dbe6744141a812652489bd1b89") test turbine oracle references.analytic_perfect_gas fixture {dof 0; run steady; fix root.control.inlet.T=400{K}; fix root.control.inlet.flow=1{mol/s}; fix root.control.inlet.pressure=202650{Pa}; fix root.control.inlet.z[chem.nitrogen]=1{1}; fix root.control.delta_pressure=-101325{Pa}; fix root.control.efficiency=0.8;} {
@id("550f90ed8b8144858847b3c4908ec35d") child root:pressure_change.PressureChanger=pressure_change.Turbine(inlet_pkg=PerfectNitrogen(defined_state=true),outlet_pkg=PerfectNitrogen(defined_state=false),assumption=pressure_change.IsentropicAssumption(reference_pkg=PerfectNitrogen(defined_state=true)));
@id("e73f0d7e2e8b462ab8a63504bdf914c9") expect root.control.outlet.T==342.50731392244415{K} tolerance 1e-6{K};
@id("d828eec4641e403d92a2b423ef5b6881") expect root.control.work==-1673.0727622317006{W} tolerance 1e-5{W};
@id("d47f0ec3393644d58dbfaac6cbae8e72") expect root.control.work_fluid==-2091.3409527896256{W} tolerance 1e-5{W};
}
@id("5d973a4431fb4299a8cda93476766999") test pump oracle references.analytic_hydraulic_work fixture {dof 0; run steady; fix root.control.inlet.T=320{K}; fix root.control.inlet.volume_flow=0.001{m^3/s}; fix root.control.inlet.pressure=101325{Pa}; fix root.control.inlet.concentration[chem.water]=55388{mol/m^3}; fix root.control.inlet.concentration[chem.sodium_hydroxide]=100{mol/m^3}; fix root.control.inlet.concentration[chem.ethyl_acetate]=100{mol/m^3}; fix root.control.inlet.concentration[chem.sodium_acetate]=1e-8{mol/m^3}; fix root.control.inlet.concentration[chem.ethanol]=1e-8{mol/m^3}; fix root.control.delta_pressure=20000{Pa}; fix root.control.efficiency=0.8;} {
// These concrete analyses read the recorded water constants through parameter defaults.
// Accept their missing form-axis evidence only for these two fits; extrapolation stays disallowed.
@id("d7321b1cb2a74a11a10d9683c73b3775") permission solvent_parameter_use records(correlations.constant[chem.water,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.saponification_caloric_fit],correlations.constant_density[chem.water,properties.liquid_molar_density,compatibility.PhaseType.liquidPhase,references.saponification_density_fit]) allow_unknown true allow_extrapolation false;
@id("07eaf3c432f242168af60c20ca10c35b") child root:pressure_change.PressureChanger=pressure_change.Pump(inlet_pkg=saponification.Saponification(defined_state=true),outlet_pkg=saponification.Saponification(defined_state=false));
@id("22c361edf6f449cc81ff84aaaa456eff") expect root.control.outlet.pressure==121325{Pa} tolerance 0.01{Pa};
@id("88c1e221726847d98b23ba54058aabf8") expect root.control.work==25{W} tolerance 1e-5{W};
@id("4040a6391d99461abe6c08e91ed2356f") expect root.control.work_fluid==20{W} tolerance 1e-5{W};
}
}
