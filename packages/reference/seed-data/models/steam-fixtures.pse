@id("66e0400000000000000000000000001a") entity provenance.source valve_off_design {title="Independent linear rating at opening 0.8 with the released flow and inlet pressure: pressure drop scales by (0.5/0.8)^2, giving 39062.5 Pa"}
// The reference computes the inlet enthalpy from its specified temperature and
// pressure. Fix those same physical coordinates, so no datum magnitude moves
// between the reference implementation and this model.
@id("66e0400000000000000000000000001b") test linear_water_valve_rated oracle released_linear_water_valve fixture {dof 0;route steady;procedure solve;fix root.inlet.T=valve_feed_temperature;fix root.inlet.pressure=valve_feed_pressure;fix root.inlet.flow=valve_feed_flow;fix root.inlet.z[chem.water]=1{1};} {
@id("66e0400000000000000000000000001c") child root:pressure_change.RatedValve=pressure_change.RatedValve(inlet_pkg=steam.Liquid(water_component=chem.water),outlet_pkg=steam.Liquid(water_component=chem.water,defined_state=false),rated_flow=valve_rated_flow,rated_drop=valve_rated_drop,opening=valve_rating_opening,curve=pressure_change.ValveCurve.Linear);
@id("66e0400000000000000000000000001d") expect root.outlet.pressure==valve_rating_outlet tolerance 1{Pa};
@id("66e0400000000000000000000000001e") expect root.outlet.flow==valve_feed_flow tolerance 1e-5{mol/s};
@id("66e0400000000000000000000000001f") expect root.outlet.component_flow[chem.water]==root.inlet.component_flow[chem.water] tolerance 1e-5{mol/s};
@id("66e04000000000000000000000000020") expect root.outlet.h==root.inlet.h tolerance 0.001{J/mol};
@id("66e04000000000000000000000000021") expect root.heat==0{W} tolerance 1e-6{W};
@id("66e04000000000000000000000000022") expect root.work==0{W} tolerance 1e-6{W};
}
@id("66e04000000000000000000000000023") test linear_water_valve_off_design oracle valve_off_design fixture {dof 0;route steady;procedure solve;fix root.inlet.T=valve_feed_temperature;fix root.inlet.pressure=valve_feed_pressure;fix root.inlet.flow=valve_feed_flow;fix root.inlet.z[chem.water]=1{1};} {
@id("66e04000000000000000000000000024") child root:pressure_change.RatedValve=pressure_change.RatedValve(inlet_pkg=steam.Liquid(water_component=chem.water),outlet_pkg=steam.Liquid(water_component=chem.water,defined_state=false),rated_flow=valve_rated_flow,rated_drop=valve_rated_drop,opening=0.8,curve=pressure_change.ValveCurve.Linear);
@id("66e04000000000000000000000000025") expect root.outlet.pressure==160937.5{Pa} tolerance 1{Pa};
