@id("66e04000000000000000000000000037") entity provenance.oracle_test released_equal_percentage_water_valve {title="Equal-percentage Water valve rating with rangeability 100, 1000 mol/s, 100 kPa drop, and half opening",release=references.idaes_2_13,locator="idaes/models/unit_models/tests/test_valve.py::TestEPValveScalerObject"}
