@id("01a0e178d29871ca9ccbc72323006155") package pcsaft_fixtures {
@id("01a0e178d29871ca9ccbc7240c009f3f") use chem @"1.0.0";
@id("01a0e178d29871ca9ccbc7256b42f968") use pcsaft @"1.0.0";
@id("01a0e178d29871ca9ccbc726d5316f9f") use helmholtz @"1.0.0";
@id("01a0e178d29871ca9ccbc727545ef6f6") test homogeneous_0 source "tests/fixtures/plan14/thermo-reference.json; teqp 0.23.1 homogeneous state" revision "0.23.1" fixture {dof 0; run pure; fix root.T=300.0{K}; fix root.rho=10.0{mol/m3}; fix root.amount[chem.methane]=0.2{mol}; fix root.amount[chem.ethane]=0.3{mol}; fix root.amount[chem.propane]=0.5{mol};} {
@id("01a0e178d29871ca9ccbc7287898c604") child root:helmholtz.HelmholtzPhase=helmholtz.HomogeneousPhase(selected=chem.alkanes,law=pcsaft.potential);
@id("01a0e178d29871ca9ccbc729394eed86") expect root.pressure==24886.638796033505{Pa} tolerance 0.001{Pa} relative 2e-8;
@id("01a0e178d29871ca9ccbc72a232fe7e0") expect root.h_residual==-16.173511411750454{J/mol} tolerance 1e-5{J/mol} relative 2e-8;
@id("01a0e178d29871ca9ccbc72bef99106a") expect root.ln_phi[chem.methane]==0.00017214852196062024 tolerance 1e-7 relative 2e-8;
@id("01a0e178d29871ca9ccbc72c892dab04") expect root.ln_phi[chem.ethane]==-0.0018232656698070268 tolerance 1e-7 relative 2e-8;
@id("01a0e178d29871ca9ccbc72d60604ce0") expect root.ln_phi[chem.propane]==-0.003521693184701986 tolerance 1e-7 relative 2e-8;
}
