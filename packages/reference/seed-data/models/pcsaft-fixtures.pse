@id("01a0f19e1d7d74efbbf1a19bd23f72dd") expect state_6.h_residual==feos_oracle.states[6].h_residual tolerance 1e-5{J/mol} relative numerical_policy.dimensionless;
@id("01a0f19e1d7d74efbbf1a19c709e51ed") expect state_6.s_residual==feos_oracle.states[6].s_residual tolerance 1e-7{J/(mol*K)} relative numerical_policy.dimensionless;
@id("01a0f19e1d7d74efbbf1a19d450325c8") expect state_6.cp_residual==feos_oracle.states[6].cp_residual tolerance 1e-7{J/(mol*K)} relative numerical_policy.dimensionless;
@id("01a0f19e1d7d74efbbf1a19eb8e8f75f") expect state_6.ln_phi[chem.hexane]==feos_oracle.ln_phi_value(6,chem.hexane) tolerance 1e-7{1} relative numerical_policy.dimensionless;
}
}
