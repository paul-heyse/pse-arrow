@id("01a0f19e1d7d74efbbf1a16acd10b61a") test pcsaft_properties_from_defaults_match_feos oracle feos_oracle.pcsaft_departures fixture {dof 0; route steady; procedure check;fix state_0.T=feos_oracle.states[0].T; fix state_0.rho=feos_oracle.states[0].rho;fix state_0.amount[chem.methane]=constants.amount_unit*(if present(feos_oracle.components[0,chem.methane]) then feos_oracle.components[0,chem.methane].fraction else 0);fix state_0.amount[chem.ethane]=constants.amount_unit*(if present(feos_oracle.components[0,chem.ethane]) then feos_oracle.components[0,chem.ethane].fraction else 0);fix state_0.amount[chem.propane]=constants.amount_unit*(if present(feos_oracle.components[0,chem.propane]) then feos_oracle.components[0,chem.propane].fraction else 0);fix state_1.T=feos_oracle.states[1].T; fix state_1.rho=feos_oracle.states[1].rho;fix state_1.amount[chem.methane]=constants.amount_unit*(if present(feos_oracle.components[1,chem.methane]) then feos_oracle.components[1,chem.methane].fraction else 0);fix state_1.amount[chem.ethane]=constants.amount_unit*(if present(feos_oracle.components[1,chem.ethane]) then feos_oracle.components[1,chem.ethane].fraction else 0);fix state_1.amount[chem.propane]=constants.amount_unit*(if present(feos_oracle.components[1,chem.propane]) then feos_oracle.components[1,chem.propane].fraction else 0);fix state_2.T=feos_oracle.states[2].T; fix state_2.rho=feos_oracle.states[2].rho;fix state_2.amount[chem.methane]=constants.amount_unit*(if present(feos_oracle.components[2,chem.methane]) then feos_oracle.components[2,chem.methane].fraction else 0);fix state_2.amount[chem.ethane]=constants.amount_unit*(if present(feos_oracle.components[2,chem.ethane]) then feos_oracle.components[2,chem.ethane].fraction else 0);fix state_2.amount[chem.propane]=constants.amount_unit*(if present(feos_oracle.components[2,chem.propane]) then feos_oracle.components[2,chem.propane].fraction else 0);fix state_3.T=feos_oracle.states[3].T; fix state_3.rho=feos_oracle.states[3].rho;fix state_3.amount[chem.methane]=constants.amount_unit*(if present(feos_oracle.components[3,chem.methane]) then feos_oracle.components[3,chem.methane].fraction else 0);fix state_3.amount[chem.ethane]=constants.amount_unit*(if present(feos_oracle.components[3,chem.ethane]) then feos_oracle.components[3,chem.ethane].fraction else 0);fix state_3.amount[chem.propane]=constants.amount_unit*(if present(feos_oracle.components[3,chem.propane]) then feos_oracle.components[3,chem.propane].fraction else 0);fix state_4.T=feos_oracle.states[4].T; fix state_4.rho=feos_oracle.states[4].rho;fix state_4.amount[chem.methane]=constants.amount_unit*(if present(feos_oracle.components[4,chem.methane]) then feos_oracle.components[4,chem.methane].fraction else 0);fix state_4.amount[chem.ethane]=constants.amount_unit*(if present(feos_oracle.components[4,chem.ethane]) then feos_oracle.components[4,chem.ethane].fraction else 0);fix state_4.amount[chem.propane]=constants.amount_unit*(if present(feos_oracle.components[4,chem.propane]) then feos_oracle.components[4,chem.propane].fraction else 0);fix state_5.T=feos_oracle.states[5].T; fix state_5.rho=feos_oracle.states[5].rho;fix state_5.amount[chem.butane]=constants.amount_unit*(if present(feos_oracle.components[5,chem.butane]) then feos_oracle.components[5,chem.butane].fraction else 0);fix state_6.T=feos_oracle.states[6].T; fix state_6.rho=feos_oracle.states[6].rho;fix state_6.amount[chem.hexane]=constants.amount_unit*(if present(feos_oracle.components[6,chem.hexane]) then feos_oracle.components[6,chem.hexane].fraction else 0);} {
@id("7d3b6390b38f464ea1fbf0435e2ee308") permission selected_unknown_fit families(pcsaft_parameters.nonassociating,properties.predictive_rule) allow_unknown true allow_extrapolation false;
@id("01a0f19e1d7d74efbbf1a16bb155111d") child state_0:helmholtz.HelmholtzPhase=helmholtz.HomogeneousPhase(selected={chem.methane,chem.ethane,chem.propane},law=pcsaft_data.potential);
@id("01a0f19e1d7d74efbbf1a16c9f5d81b2") expect state_0.pressure==feos_oracle.states[0].pressure tolerance numerical_policy.pressure relative numerical_policy.dimensionless;
@id("01a0f19e1d7d74efbbf1a16dbad5e286") expect state_0.h_residual==feos_oracle.states[0].h_residual tolerance 1e-5{J/mol} relative numerical_policy.dimensionless;
@id("01a0f19e1d7d74efbbf1a16eb46f581f") expect state_0.s_residual==feos_oracle.states[0].s_residual tolerance 1e-7{J/(mol*K)} relative numerical_policy.dimensionless;
@id("01a0f19e1d7d74efbbf1a16fa67203b9") expect state_0.cp_residual==feos_oracle.states[0].cp_residual tolerance 1e-7{J/(mol*K)} relative numerical_policy.dimensionless;
@id("01a0f19e1d7d74efbbf1a1703840b993") expect state_0.ln_phi[chem.methane]==feos_oracle.ln_phi_value(0,chem.methane) tolerance 1e-7{1} relative numerical_policy.dimensionless;
