@id("01a0e178d29871ca9ccbc727545ef6f6") test homogeneous_0 oracle references.plan14_thermo_reference fixture {dof 0; route steady; procedure check; fix root.T=300.0{K}; fix root.rho=10.0{mol/m^3}; fix root.amount[chem.methane]=0.2{mol}; fix root.amount[chem.ethane]=0.3{mol}; fix root.amount[chem.propane]=0.5{mol};} {
@id("f901618aa4f64e82bb8c87f0c94b59ca") permission selected_unknown_fit families(pcsaft_parameters.nonassociating,properties.predictive_rule) allow_unknown true allow_extrapolation false;
@id("01a0e178d29871ca9ccbc7287898c604") child root:helmholtz.HelmholtzPhase=helmholtz.HomogeneousPhase(selected=vessel_fixtures.alkanes,law=pcsaft_data.potential);
