@id("1b447d5c0f784fdb893a95bc5958d97b") dataset caloric_selection:properties.selection complete_over(k in binding_packages,j in aromatics,p in properties.caloric_properties,t in properties.liquid_types) provenance(references.idaes_bt_ideal,provenance.Role.oracle_input) {
[bt_ideal_idaes,chem.benzene,properties.heat_capacity,compatibility.PhaseType.liquidPhase]=[correlations.dippr100[chem.benzene,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.idaes_bt_ideal_liquid_fit]];
[bt_ideal_idaes,chem.toluene,properties.heat_capacity,compatibility.PhaseType.liquidPhase]=[correlations.dippr100[chem.toluene,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.idaes_bt_ideal_liquid_fit]];
}
@id("6073f8ffbcc04065bcdf1d72a9009534") dataset caloric_selection_vapor_caloric:properties.selection complete_over(k in binding_packages,j in aromatics,p in properties.caloric_properties,t in properties.vapor_types) provenance(references.idaes_bt_ideal,provenance.Role.oracle_input) {
[bt_ideal_idaes,chem.benzene,properties.heat_capacity,compatibility.PhaseType.vaporPhase]=[correlations.rpp4_cp[chem.benzene,properties.heat_capacity,compatibility.PhaseType.vaporPhase,references.idaes_bt_ideal_vapor_fit]];
[bt_ideal_idaes,chem.toluene,properties.heat_capacity,compatibility.PhaseType.vaporPhase]=[correlations.rpp4_cp[chem.toluene,properties.heat_capacity,compatibility.PhaseType.vaporPhase,references.idaes_bt_ideal_vapor_fit]];
}
@id("1391ab587e684deba28e34ea5fb8e426") set binding_packages:Set<properties.property_package>={bt_ideal_idaes};
@id("01a0f1955e96736397df7b5057537aa9") set caloric_phase_types:Set<compatibility.PhaseType>={compatibility.PhaseType.liquidPhase,compatibility.PhaseType.vaporPhase};

@id("4491dd456c754971bbf556ca4e231ac0") dataset datum_selection:properties.caloric_basis complete_over(k in binding_packages,t in caloric_phase_types,j in aromatics) provenance(references.idaes_bt_ideal,provenance.Role.derived,lineage(dataset caloric_reference_values)) {
[bt_ideal_idaes,compatibility.PhaseType.liquidPhase,chem.benzene]=[bt_ideal_oracle,chemistry.vapor,-33900{J/mol},0{J/(mol*K)}];
[bt_ideal_idaes,compatibility.PhaseType.vaporPhase,chem.benzene]=[stock,chemistry.vapor,0{J/mol},0{J/(mol*K)}];
[bt_ideal_idaes,compatibility.PhaseType.liquidPhase,chem.toluene]=[bt_ideal_oracle,chemistry.vapor,-38100{J/mol},0{J/(mol*K)}];
[bt_ideal_idaes,compatibility.PhaseType.vaporPhase,chem.toluene]=[stock,chemistry.vapor,0{J/mol},0{J/(mol*K)}];
}
@id("9908d12fa75040b6b8669b44051c0ce9") fn oracle_reference_anchor(T:Temperature,p:Pressure,j:chemistry.species)->BtOracleEnthalpy valid(T==bt_ideal_oracle.temperature and p==bt_ideal_oracle.pressure)=caloric_reference[j].vapor_reference;
@id("9b2086cfdf494125aa3d0f4ce8738e9f") fn stock_reference_anchor(T:Temperature,p:Pressure,j:chemistry.species)->MolarEnthalpy valid(p==bt_ideal_oracle.pressure)=constants.standard_enthalpy_datum+properties.enthalpy_increment(bt_ideal_idaes,chemistry.vapor,j,constants.standard_temperature,T);
@id("0c6f70e19d5b4e88a1c85c4a4f2fe4b1") reference translation oracle_to_stock(value:BtOracleEnthalpy,composition:MoleFraction[chemistry.species],members:Set<chemistry.species>)->MolarEnthalpy anchors(source=oracle_reference_anchor,target=stock_reference_anchor) at(temperature=bt_ideal_oracle.temperature,pressure=bt_ideal_oracle.pressure) provenance(references.idaes_bt_ideal,provenance.Role.oracle_input);
@id("225beafbf7784b3084fe0eebe2eed74e") entity properties.selection_context bt_ideal_idaes_admitted {roots={correlations.rpp4_wagner[chem.benzene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase,references.idaes_rpp4_pressure_fit],correlations.rpp4_wagner[chem.toluene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase,references.idaes_rpp4_pressure_fit],correlations.dippr100[chem.benzene,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.idaes_bt_ideal_liquid_fit],correlations.dippr100[chem.toluene,properties.heat_capacity,compatibility.PhaseType.liquidPhase,references.idaes_bt_ideal_liquid_fit],correlations.rpp4_cp[chem.benzene,properties.heat_capacity,compatibility.PhaseType.vaporPhase,references.idaes_bt_ideal_vapor_fit],correlations.rpp4_cp[chem.toluene,properties.heat_capacity,compatibility.PhaseType.vaporPhase,references.idaes_bt_ideal_vapor_fit]},subjects={chem.benzene,chem.toluene},models={properties.vapor_pressure,properties.heat_capacity},rules={}}
}
