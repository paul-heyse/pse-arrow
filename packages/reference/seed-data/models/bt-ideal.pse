@id("01a0e18b78db742e8fd36e3f9f5d6ffb") package bt_ideal {
@id("d152e3493e1f43cd8b98eafcb18e72da") use numerical_policy @"1.0.0";
@id("01a0f14ead4d7118a57e366628a6fcd9") use constants @"1.0.0";
@id("01a0f14331eb7796a180ca8a840bcb2f") use idaes_thermo @"1.0.0";
@id("bce3c5113bbc45339f948d97406e2ab6") use compatibility @"1.0.0";
@id("01a0f13d55af72e69b1312099d4f3f48") use correlations @"1.0.0";
@id("01a0f13d55af72e69b131208d03982f1") use properties @"1.0.0";
@id("01a0e1461e93764398a669fa47465afc") set aromatics:Set<chemistry.species>={chem.benzene,chem.toluene};
@id("01a0ef604fdf73c68b36e124532f7e3f") use provenance @"1.0.0";
@id("01a0ef604fdf73c68b36e125dd9cc55a") use references @"1.0.0";
@id("01a0ede58ecb740c9dfc7a1da528aaf5") use chemistry @"1.0.0";
@id("01a0e18b78db742e8fd36e41a2cd297a") use chem @"1.0.0";
@id("01a0e18b78db742e8fd36e42afda5a53") use caloric @"1.0.0";
@id("01a0e18b78db742e8fd36e43b3bfb495") use phase_data @"1.0.0";
@id("01a0e18b78db742e8fd36e44ff510651") use pure_properties @"1.0.0";
@id("01a0e18b78db742e8fd36e45c9fe20a5") use equilibrium @"1.0.0";
@id("01a0e18b78db742e8fd36e469ec20bc1") entity properties.property_package bt_ideal_idaes {admitted=bt_ideal_idaes_admitted}
@id("01a0e18b78db742e8fd36e47fc093508") dataset pressure_bindings:properties.selection complete_over(k in binding_packages,j in aromatics,p in properties.vapor_pressure_properties,t in properties.liquid_types) provenance(references.idaes_bt_ideal, provenance.Role.derived, lineage(dataset idaes_thermo.rpp4_pressure_oracles)) {
[bt_ideal_idaes,chem.benzene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase]=[correlations.rpp4_wagner[chem.benzene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase,references.idaes_rpp4_pressure_fit]];
[bt_ideal_idaes,chem.toluene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase]=[correlations.rpp4_wagner[chem.toluene,properties.vapor_pressure,compatibility.PhaseType.liquidPhase,references.idaes_rpp4_pressure_fit]];
}
@id("01a0e18b78db742e8fd36e48fdb7529e") fn psat(T:Temperature,j:chemistry.species)->Pressure=properties.psat(bt_ideal_idaes,chemistry.liquid,j,T);
@id("01a0e18b78db742e8fd36e49b3320d06") test flash_368 oracle references.idaes_test_btideal fixture {dof 0; route steady; procedure solve; fix root.flow=1{mol/s}; value root.minimum_temperature=300{K}; value root.maximum_temperature=450{K}; value root.bubble_start=365{K}; value root.dew_start=370{K}; fix root.T=368{K}; fix root.pressure=101325{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e18b78db742e8fd36e4a7116bd44") child root:equilibrium.SmoothVLE=equilibrium.FTPx(selected=aromatics,vapor_pressure=psat);
@id("01a0e18b78db742e8fd36e4b5faa0fa8") expect root.x[chem.benzene]==0.4121{1} tolerance 0.0001{1};
@id("01a0e18b78db742e8fd36e4c682b54be") expect root.y[chem.benzene]==0.6339{1} tolerance 0.0001{1};
@id("01a0e18b78db742e8fd36e4d7507b8d6") expect root.beta==0.3961 tolerance 0.0001;
@id("01a0e18b78db742e8fd36e4e09303570") expect root.component_flow[chem.benzene]==0.5{mol/s} tolerance 1e-10{mol/s};
}
@id("01a0e1971f9075519925981c914a70d4") use caloric_data @"1.0.0";
@id("01a0e1971f9075519925981d137cc1a1") table caloric_reference[j:chemistry.species]:{vapor_reference:BtOracleEnthalpy} complete_over(j in aromatics);
@id("01a0e1971f9075519925981efae47b98") dataset caloric_reference_values:caloric_reference provenance(references.idaes_bt_ideal, provenance.Role.oracle_input) {
[chem.benzene]=[82900{J/mol}];
[chem.toluene]=[50100{J/mol}];
}
@id("01a0e1971f9075519925981f0b0c0f89") fn liquid_h(T:Temperature,j:chemistry.species)->MolarEnthalpy=properties.component_enthalpy(bt_ideal_idaes,chemistry.liquid,j,T);
@id("01a0e1971f90755199259820a9ad3ea5") fn vapor_h(T:Temperature,j:chemistry.species)->MolarEnthalpy=properties.component_enthalpy(bt_ideal_idaes,chemistry.vapor,j,T);
@id("40f35b70edac42b583ad3cc6d4e71a79") fn component_enthalpy(T:Temperature,p:chemistry.phase,j:chemistry.species)->MolarEnthalpy=properties.component_enthalpy(bt_ideal_idaes,p,j,T);
@id("01a0e1a936d074a8ae57c32cb3c24bb8") interface BTIdealBinding extends equilibrium.EquilibriumThermoPackage {

@id("01a0e1971f90755199259822137a64c1") override param components:Set<chemistry.species>=aromatics;
@id("01a0e1971f9075519925982384e3bfd0") override param psat:Fn(T:Temperature,j:chemistry.species)->Pressure=bt_ideal.psat;
@id("01a0e1971f90755199259824636559bd") override param liquid_enthalpy:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy=liquid_h;
@id("01a0e1971f9075519925982564351de3") override param vapor_enthalpy:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy=vapor_h;
@id("01a0e1971f9075519925982680c79d22") override param minimum_temperature:Temperature=300{K};
@id("01a0e1971f9075519925982726e14bf3") override param maximum_temperature:Temperature=450{K};
@id("01a0e1971f907551992598283e0d21a6") override param bubble_start:Temperature=365{K};
@id("01a0e1971f90755199259829b0731f92") override param dew_start:Temperature=370{K};
@id("01a0e1a32b1f76e89afdfd979fe12f6f") var oracle_h:BtOracleEnthalpy;
@id("01a0e1a32b1f76e89afdfd98b22af1dc") eq reference_binding:h==oracle_to_stock(oracle_h,z,components);
@id("01a0e1a32b1f76e89afdfd999db937ad") annotation start oracle_h(50000{J/mol});
@id("01a0e1a32b1f76e89afdfd9a03533797") annotation nominal oracle_h(50000{J/mol});

}
@id("01a0e1971f90755199259821d780acbd") def BTIdeal(defined_state:Boolean=true):BTIdealBinding {
@id("d897aba318dc401b9700c4f6ecbda064") override param defined:Boolean=defined_state;}
@id("268ab1ebc75e4eccbd36c7c7418cbaa3") use ideal_caloric_state @"1.0.0";
// A separated liquid keeps its phase enthalpy without an equilibrium re-flash.
@id("0812ec7723e74cc486dc774bdb5764ea") def BTLiquid(defined_state:Boolean=true):ideal_caloric_state.SinglePhaseCaloricState {
@id("169ecf09bd1640c28d2d508bd9a0790a") override param defined:Boolean=defined_state;
@id("8b22b5822329441f95bdb73a4607fa16") override param selected_phase:chemistry.phase=chemistry.liquid;
@id("4bce291fa70e4e8596ef09f144308802") override param components:Set<chemistry.species>=aromatics;
@id("c0b12ac7389549e6aef60263096dcc44") override param component_h:Fn(T:Temperature,j:chemistry.species)->MolarEnthalpy=liquid_h;
@id("749ef68fdf9b4ddaa49a788869a97e1c") override param reference_pressure:Pressure=101325{Pa};
@id("de8e6c0687a54cd1a51015358e02f67f") override param minimum_temperature:Temperature=300{K};
@id("e4286a7963ea446f99f3966064b0b577") override param maximum_temperature:Temperature=450{K};
}
@id("01a0e1971f9075519925982ae2d21d11") test ftpx_oracle oracle references.idaes_test_btideal fixture {dof 0; route steady; procedure solve; fix root.flow=1{mol/s}; fix root.pressure=101325{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1}; fix root.T=368{K};} {
@id("01a0e1971f9075519925982b3ee6b34a") child root:BTIdeal=BTIdeal;
@id("01a0e1971f9075519925982cdc912da2") expect root.x[chem.benzene]==0.4121{1} tolerance 0.0001{1};
@id("01a0e1971f9075519925982dd2dd356b") expect root.y[chem.benzene]==0.6339{1} tolerance 0.0001{1};
@id("01a0e1971f9075519925982e2a891db3") expect root.beta==0.3961 tolerance 0.0001;
@id("01a0e1971f9075519925982feb577f11") expect root.oracle_h==47297{J/mol} tolerance 1{J/mol};
}
@id("01a0e1971f90755199259830415352f7") test fphx_oracle oracle references.idaes_test_btideal_fphx fixture {dof 0; route steady; procedure solve; fix root.flow=1{mol/s}; fix root.pressure=101325{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1}; fix root.oracle_h=47297{J/mol};} {
@id("01a0e1971f907551992598319a65b91a") child root:BTIdeal=BTIdeal;
@id("01a0e1971f907551992598323e996afc") expect root.x[chem.benzene]==0.4121{1} tolerance 0.0001{1};
@id("01a0e1971f90755199259833a5eab93e") expect root.y[chem.benzene]==0.6339{1} tolerance 0.0001{1};
@id("01a0e1971f907551992598346b929bdd") expect root.beta==0.3961 tolerance 0.0001;
@id("01a0e1971f907551992598357cfa4f12") expect root.T==368{K} tolerance 0.01{K};
}
@id("01a0e1a936d074a8ae57c32d78320eaa") use nested_equilibrium @"1.0.0";
@id("01a0e1a936d074a8ae57c32e93b9b7da") def BTIdealNested:BTIdealBinding {
@id("01a0e1a936d074a8ae57c32f024e0854") child closure:nested_equilibrium.FlashSplit=nested_equilibrium.IdealFlash(selected=aromatics,vapor_pressure=bt_ideal.psat);
@id("01a0e1a936d074a8ae57c3305a3e7f9f") eq bind_temperature:closure.T==T;
@id("01a0e1a936d074a8ae57c3315d13e824") eq bind_pressure:closure.pressure==pressure;
@id("01a0e1a936d074a8ae57c332e59ba4e3") eq bind_feed[j in components]:closure.z[j]==z[j];
@id("01a0e1a936d074a8ae57c3336b2130fc") annotation start closure.T(T);
@id("01a0e1a936d074a8ae57c334e7a08ef5") annotation start closure.pressure(pressure);
@id("01a0e1a936d074a8ae57c33573c41d0c") annotation start closure.z(z[j]);
@id("01a0e1a936d074a8ae57c336942f646a") override eq material[j in components]:x[j]==closure.x[j];
@id("01a0e1a936d074a8ae57c337a35bcd44") override eq normalization:beta==closure.beta;
@id("01a0e1a936d074a8ae57c33832773407") override eq fugacity[j in components]:y[j]==closure.y[j];
@id("01a0e1a936d074a8ae57c3396d29c92b") annotation valid T(355{K},380{K});
@id("01a0e1c436917ef383fabdb5a6c59321") annotation valid pressure(100000{Pa},103000{Pa});
@id("01a0e1c436917ef383fabdb698ae783a") annotation valid z(0.4{1},0.6{1});
}
@id("01a0e1a936d074a8ae57c33ac54cf83b") test nested_liquid oracle references.idaes_test_btideal fixture {dof 0; route steady; procedure solve; fix root.flow=1{mol/s}; fix root.T=358{K}; fix root.pressure=101325{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e1a936d074a8ae57c33bbc37b03c") child root:BTIdealNested=BTIdealNested;
@id("01a0e1a936d074a8ae57c33cced342ba") expect root.beta==0 tolerance 0.0001;
@id("01a0e1a936d074a8ae57c33d8e2f84e2") expect (1-root.beta)*root.x[chem.benzene]+root.beta*root.y[chem.benzene]==root.z[chem.benzene] tolerance 1e-8{1};
@id("01a0e1a936d074a8ae57c33e4a905ad5") expect (1-root.beta)*root.x[chem.toluene]+root.beta*root.y[chem.toluene]==root.z[chem.toluene] tolerance 1e-8{1};
}
@id("01a0e1a936d074a8ae57c33fda26bf9b") test nested_two_phase oracle references.idaes_test_btideal fixture {dof 0; route steady; procedure solve; fix root.flow=1{mol/s}; fix root.T=368{K}; fix root.pressure=101325{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e1a936d074a8ae57c34054048f67") child root:BTIdealNested=BTIdealNested;
@id("01a0e1a936d074a8ae57c34140012a33") expect root.beta==0.3961 tolerance 0.0001;
@id("01a0e1a936d074a8ae57c3425dc9976b") expect (1-root.beta)*root.x[chem.benzene]+root.beta*root.y[chem.benzene]==root.z[chem.benzene] tolerance 1e-8{1};
@id("01a0e1a936d074a8ae57c343b5057a10") expect (1-root.beta)*root.x[chem.toluene]+root.beta*root.y[chem.toluene]==root.z[chem.toluene] tolerance 1e-8{1};
@id("01a0e1a936d074a8ae57c3448b7faf6b") expect root.x[chem.benzene]==0.4121{1} tolerance 0.0001{1};
@id("01a0e1a936d074a8ae57c345def9cfab") expect root.y[chem.benzene]==0.6339{1} tolerance 0.0001{1};
}
@id("01a0e1a936d074a8ae57c346abdb25f7") test nested_vapor oracle references.idaes_test_btideal fixture {dof 0; route steady; procedure solve; fix root.flow=1{mol/s}; fix root.T=378{K}; fix root.pressure=101325{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e1a936d074a8ae57c34773d01485") child root:BTIdealNested=BTIdealNested;
@id("01a0e1a936d074a8ae57c348692b9fad") expect root.beta==1 tolerance 0.0001;
@id("01a0e1a936d074a8ae57c349b5e43726") expect (1-root.beta)*root.x[chem.benzene]+root.beta*root.y[chem.benzene]==root.z[chem.benzene] tolerance 1e-8{1};
@id("01a0e1a936d074a8ae57c34a87a6907d") expect (1-root.beta)*root.x[chem.toluene]+root.beta*root.y[chem.toluene]==root.z[chem.toluene] tolerance 1e-8{1};
}
@id("01a0e1ad3a7f706c8439ef4b7b6a0584") test initialized_ftpx oracle references.idaes_test_btideal fixture {dof 0; route steady; procedure initialize; stages("ideal-K"); fix root.flow=1{mol/s}; fix root.T=368{K}; fix root.pressure=101325{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
@id("01a0e1ad3a7f706c8439ef4c048d2e11") child root:BTIdeal=BTIdeal;
@id("01a0e1ad3a7f706c8439ef4d0598eb99") expect root.beta==0.3961 tolerance 0.0001;
@id("01a0e1ad3a7f706c8439ef4e251fbecb") expect root.oracle_h==47297{J/mol} tolerance 1{J/mol};
}
@id("ffe95f6c03b24a7c87244e9c91db2608") test complementarity_liquid_smooth oracle references.idaes_test_btideal fixture {dof 0; route steady; procedure solve; fix root.flow=1{mol/s}; value root.minimum_temperature=300{K}; value root.maximum_temperature=450{K}; value root.bubble_start=365{K}; value root.dew_start=370{K}; fix root.T=358{K}; fix root.pressure=101325{Pa}; fix root.z[chem.benzene]=0.5{1}; fix root.z[chem.toluene]=0.5{1};} {
