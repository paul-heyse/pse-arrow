#
# Machine-local placement for pse-arrow commands (scripts/pse-env, the native setup
# builders, supervised canonical servers and workers). Install with `just slice-install`.
# Without this file systemd still creates the slice on demand; the file adds a CPU weight
# below interactive applications and memory-pressure monitoring of agent work.
#
# scripts/host_admission.py materializes the finite aggregate MemoryMax from
# .config/agent-capacity.toml before workload admission. A widened explicit request
# raises that ancestor coherently; individual scopes retain their own failure boundary.
[Unit]
Description=pse-arrow agent and recipe commands

[Slice]
CPUWeight=30
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=50%
