+extern "C" void uno_pse_materialization_begin(uint64_t n) {
+   pse_check_scope(0);
+   if (n > static_cast<uint64_t>(std::numeric_limits<int32_t>::max())) pse_check_scope(2);
+   const uint64_t count = n * (n + 1) / 2;
