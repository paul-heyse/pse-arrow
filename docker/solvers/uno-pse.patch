+// Scoped callback installed by the exception-shielded integration bridge.
+// It is thread-local because a solver may run on any admitted worker thread.
+namespace {
+   thread_local void (*pse_scope_callback)(int32_t, void*) = nullptr;
+   thread_local void* pse_scope_data = nullptr;
+   thread_local double pse_accuracy[4];
