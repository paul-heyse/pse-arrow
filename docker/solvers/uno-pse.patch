+}
+extern "C" void uno_pse_materialization_poll() { pse_check_scope(0); }
+extern "C" void uno_pse_materialization_memory_failure() { pse_check_scope(2); }
+extern "C" void uno_pse_materialization_column() { pse_check_scope(0); ++pse_materialization_columns; }
+extern "C" void uno_pse_materialization_complete(uint64_t numeric_bytes) {
+   ++pse_materialization_count;
