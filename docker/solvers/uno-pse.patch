+   thread_local uint64_t pse_materialization_columns = 0;
+   thread_local uint64_t pse_materialization_numeric_bytes = 0;
+   void pse_check_scope(int32_t reason) {
+      if (pse_scope_callback) pse_scope_callback(reason, pse_scope_data);
+      if (reason == 1) throw std::runtime_error("HiGHS exhausted Uno time limit");
+      if (reason == 2) throw std::bad_alloc();
+   }
+}
+extern "C" void uno_pse_set_scope_callback(void (*callback)(int32_t, void*), void* data) {
+   pse_scope_callback = callback; pse_scope_data = data;
+   if (callback) {
+      std::fill_n(pse_accuracy, 4, std::numeric_limits<double>::quiet_NaN());
+      pse_feasibility_calls = pse_feasibility_iterations = 0;
+      pse_feasibility_status = pse_feasibility_status_available = 0;
+      pse_feasibility_iterations_available = 1; pse_qp_hot_start = -1;
+      pse_feasibility_tolerance = std::numeric_limits<double>::quiet_NaN();
+   }
+}
