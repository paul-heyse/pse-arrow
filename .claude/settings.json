{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Bash(uv add*)",
      "Bash(uv remove*)",
      "Bash(uv lock*)",
      "Bash(cargo add*)",
      "Bash(cargo remove*)",
      "Bash(cargo update*)",
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(/.git/**)",
      "Edit(/target/**)",
      "Edit(/build/**)",
      "Edit(/external/**)",
      "Edit(/docs/generated/**)",
      "Edit(/crates/*/src/generated/**)",
      "Edit(/crates/pse-ipopt-sys/src/bindings.rs)",
      "Edit(/crates/pse-operations-queries/**)",
      "Edit(/python/pse/_native.pyi)",
      "Edit(/python/pse/contracts/**)"
    ]
  },
  "env": {
    "CARGO_TERM_COLOR": "never"
  },
  "enabledPlugins": {
    "superpowers@synced": false,
    "notion-memory@synced": false,
    "Notion@synced": false,
    "design@synced": false,
    "cowork-plugin-management@synced": false,
    "dropbox@synced": false,
    "pyright-lsp@claude-plugins-official": false
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    },
    {
      "serverName": "claude.ai Google Drive"
    },
    {
      "serverName": "claude.ai Dropbox"
    },
    {
      "serverName": "claude.ai Notion"
    }
  ],
  "skillListingMaxDescChars": 400,
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/agent-hooks.py\" guard",
            "timeout": 10
          }
        ],
        "matcher": "^(Edit|MultiEdit|NotebookEdit|Write)$"
      }
    ]
  }
}
