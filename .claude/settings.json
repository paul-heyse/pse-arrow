{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(/.git/**)",
      "Edit(/target/**)",
      "Edit(/build/**)",
      "Edit(/external/**)",
      "Edit(/docs/generated/**)",
      "Edit(/crates/*/src/generated/**)",
      "Edit(/crates/pse-ipopt-sys/src/bindings.rs)",
      "Edit(/crates/pse-operations-queries/**)",
      "Edit(/python/pse/_native.pyi)",
      "Edit(/python/pse/contracts/**)"
    ]
  },
  "env": {
    "CARGO_TERM_COLOR": "never"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/agent-hooks.py\" guard",
            "timeout": 10
          }
        ],
        "matcher": "^(Edit|MultiEdit|NotebookEdit|Write)$"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"${AFTER_TURN_ROLE:-}\" ] || uv run --no-project --python 3.14 python \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"/scripts/after_turn.py guard",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.14 python \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"/scripts/after_turn.py stop --harness claude",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --python 3.14 python \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}\"/scripts/after_turn.py prompt --harness claude",
            "timeout": 1800,
            "statusMessage": "Waiting for this session's end-of-turn checks"
          }
        ]
      }
    ]
  }
}
