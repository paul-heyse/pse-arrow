      "Bash(just lint-agents)",
      "Bash(just quality)",
      "Bash(just py-test:*)",
      "Bash(just policy)",
      "Bash(just coverage)",
      "Bash(just bench-smoke)",
      "Bash(just doc-lint)",
      "Bash(just adr-lint)",
      "Bash(just adr-index)",
      "Bash(just docs)",
      "Bash(just register-check)",
      "Bash(just deps-unused)",
      "Bash(just unsafe-surface)",
      "Bash(just floors-latest)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt --check:*)",
      "Bash(cargo fmt --all -- --check)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo nextest run:*)",
      "Bash(cargo test:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo deny check:*)",
      "Bash(cargo audit:*)",
      "Bash(cargo xtask family-check:*)",
      "Bash(cargo xtask governance:*)",
      "Bash(cargo xtask doc-lint:*)",
      "Bash(cargo xtask probe-host:*)",
      "Bash(.venv/bin/ruff check:*)",
      "Bash(.venv/bin/ruff format --check:*)",
      "Bash(.venv/bin/pyrefly check:*)",
      "Bash(.venv/bin/lint-imports:*)",
      "Bash(.venv/bin/reuse lint:*)",
      "Bash(.venv/bin/taplo fmt --check:*)",
      "Bash(.venv/bin/typos:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(python3 scripts/doctor.py:*)",
      "Bash(python3 scripts/check_agent_config.py:*)",
      "Bash(python3 scripts/adr.py lint:*)",
      "Bash(python3 scripts/adr.py index --check)",
      "Bash(python3 scripts/check_register.py --lint)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh workflow list:*)",
      "Bash(actionlint:*)",
      "Bash(ast-grep scan:*)",
      "Bash(shellcheck:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git tag:*)",
      "Bash(gh api:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(just bootstrap:*)",
      "Bash(just fmt)",
      "Bash(just codegen:*)",
      "Bash(just snapshots-accept)",
      "Bash(just release:*)",
      "Bash(just lock-upgrade:*)",
      "Bash(just adr-new:*)",
      "Bash(just adr-supersede:*)",
      "Bash(just plan:*)",
      "Bash(just labels-sync)",
      "Bash(just gh-setup:*)",
      "Bash(just evidence-regen)",
      "Bash(just solver-image:*)",
      "Bash(just fetch-external)",
      "Bash(uv pip install:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(uv sync:*)",
      "Bash(cargo add:*)",
      "Bash(cargo update:*)",
      "Bash(cargo publish:*)",
      "Bash(maturin publish:*)",
      "Bash(uv publish:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Edit(./target/**)",
      "Write(./target/**)",
      "Edit(./build/**)",
      "Write(./build/**)",
      "Edit(./external/**)",
      "Write(./external/**)",
      "Edit(./docs/generated/**)",
      "Write(./docs/generated/**)",
      "Edit(./crates/*/src/generated/**)",
      "Write(./crates/*/src/generated/**)",
      "Edit(./crates/pse-ipopt-sys/src/bindings.rs)",
      "Write(./crates/pse-ipopt-sys/src/bindings.rs)",
      "Edit(./python/pse/contracts/**)",
      "Write(./python/pse/contracts/**)"
    ]
  },
  "env": {
    "CARGO_TERM_COLOR": "never"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks.py\" session",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks.py\" guard",
            "timeout": 10
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/agent-hooks.py\" format",
            "timeout": 60
          }
        ],
        "matcher": "Edit|Write"
      }
    ]
  }
}
