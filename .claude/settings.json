{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Edit(./target/**)",
      "Write(./target/**)",
      "Edit(./build/**)",
      "Write(./build/**)",
      "Edit(./external/**)",
      "Write(./external/**)",
      "Edit(./docs/generated/**)",
      "Write(./docs/generated/**)",
      "Edit(./crates/*/src/generated/**)",
      "Write(./crates/*/src/generated/**)",
      "Edit(./crates/pse-ipopt-sys/src/bindings.rs)",
      "Write(./crates/pse-ipopt-sys/src/bindings.rs)",
      "Edit(./python/pse/contracts/**)",
      "Write(./python/pse/contracts/**)"
    ]
  },
  "env": {
    "CARGO_TERM_COLOR": "never"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/agent-hooks.py\" session",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/agent-hooks.py\" guard",
            "timeout": 10
          }
        ],
        "matcher": "^(Edit|MultiEdit|NotebookEdit|Write)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/scripts/agent-hooks.py\" format",
            "timeout": 60
          }
        ],
        "matcher": "^(Edit|MultiEdit|NotebookEdit|Write)$"
      }
    ]
  }
}
