# shellcheck shell=bash
# direnv configuration for pse-arrow.
#
# Contract: entering this directory is FAST and touches NO network. This file exports
# variables, puts the project's own tools first on PATH, and reports what is missing. It
# never creates a venv, installs a package, or downloads anything -- `just bootstrap` does
# that, deliberately and visibly.
#
# First time here:  direnv allow

# The interpreter this project develops against. `.python-version` is the single source
# of truth; uv reads it directly and scripts/doctor.py checks .venv against it.
export PSE_PYTHON="${PSE_PYTHON:-$(cat .python-version 2>/dev/null || echo 3.14.7)}"

# One environment for uv, just, Claude Code and Codex.
export UV_PROJECT_ENVIRONMENT="${UV_PROJECT_ENVIRONMENT:-.venv}"

# Keep Cargo output inside the repo so just recipes, rust-analyzer and CI agree.
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target}"

# Golden stores read by the Python tests (produced by `cargo xtask golden`).
export PSE_GOLDEN_DIR="${PSE_GOLDEN_DIR:-$PWD/tests/golden}"

# Project tools before machine-global ones: this is what stops a stale ~/.local/bin/ruff
# from shadowing the version pinned in pyproject.toml.
case "$UV_PROJECT_ENVIRONMENT" in
  /*|[A-Za-z]:*) PSE_VENV_PATH="$UV_PROJECT_ENVIRONMENT" ;;
  *) PSE_VENV_PATH="$PWD/$UV_PROJECT_ENVIRONMENT" ;;
esac
if [ "${OS:-}" = Windows_NT ]; then
  PATH_add "$PSE_VENV_PATH/Scripts"
else
  PATH_add "$PSE_VENV_PATH/bin"
fi
unset PSE_VENV_PATH

# A locally built solver stack (docker/solvers/build.sh run natively) lives here.
if [ -d /opt/pse-solvers/bin ]; then
  PATH_add /opt/pse-solvers/bin
  export IPOPT_DIR="${IPOPT_DIR:-/opt/pse-solvers}"
  export PKG_CONFIG_PATH="/opt/pse-solvers/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
fi

# Re-evaluate when any of these change, so a toolchain bump is picked up on the next cd.
watch_file .python-version
watch_file pyproject.toml
watch_file rust-toolchain.toml

# Personal, machine-local overrides. Gitignored; see .envrc.local.example.
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi

# Status block. Uses the system python deliberately: it has to work before the venv
# exists, which is precisely when you need to be told what to do.
if [ -f scripts/doctor.py ]; then
  python3 scripts/doctor.py --format=direnv || true
fi
