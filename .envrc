# Activation only. Rust/Python workload admission remains with scripts/pse-env.
strict_env
PATH_rm '*/.venv/bin' '*/.venv-*/bin'
if [[ -n ${VIRTUAL_ENV-} ]]; then
    PATH_rm "$VIRTUAL_ENV/bin"
    unset VIRTUAL_ENV
fi
_pse_exports=$(/usr/bin/python3 scripts/pse_env.py --print) || return $?
eval "$_pse_exports"
unset _pse_exports
watch_file .python-version pyproject.toml uv.lock rust-toolchain.toml .envrc.local
watch_file .config/build.toml scripts/build_environment.py scripts/pse_env.py
# Run the existing doctor explicitly when needed; never on directory entry.
