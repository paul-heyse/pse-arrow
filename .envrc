# Activation only. Workload ownership remains with the native scripts/pse-env boundary.
strict_env
PATH_rm '*/.venv/bin' '*/.venv-*/bin'
if [[ -n ${VIRTUAL_ENV-} ]]; then
    PATH_rm "$VIRTUAL_ENV/bin"
    unset VIRTUAL_ENV
fi
_pse_exports=$(scripts/pse-env --print) || return $?
eval "$_pse_exports"
unset _pse_exports
watch_file .python-version pyproject.toml uv.lock rust-toolchain.toml .envrc.local
watch_file .config/build.toml scripts/pse-env target/host-tools/current
watch_file .cargo/config.toml .config/agent-capacity.toml
# Run the existing doctor explicitly when needed; never on directory entry.
