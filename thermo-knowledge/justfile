# Standalone command surface for the thermodynamic knowledge base (Plan 24).
#
# Run `just -f thermo-knowledge/justfile <recipe>` from the repository root, or
# `just <recipe>` inside this directory. Self-contained: it reads nothing from the root
# justfile. Every recipe runs in this tree's own environment, `thermo-knowledge/.venv`,
# whatever the caller exported: the repository's .envrc sets UV_PROJECT_ENVIRONMENT=.venv
# and puts the root .venv first on PATH, so the environment is overridden here and uv is
# given this directory as its project.

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

tree := justfile_directory()

export UV_PROJECT_ENVIRONMENT := tree / ".venv"

[doc('List the recipes')]
default:
    @just --justfile {{ quote(justfile()) }} --list

[doc('Create or refresh the locked environment (thermo-knowledge/.venv); fails when uv.lock is stale')]
tk-sync:
    unset VIRTUAL_ENV; uv sync --project {{ quote(tree) }} --locked

[doc('Resolve dependencies and update uv.lock')]
tk-lock:
    unset VIRTUAL_ENV; uv lock --project {{ quote(tree) }}

[doc('Run the tree tests with pytest; arguments go to pytest')]
tk-test *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked pytest "$@"

[doc('Create the pse_thermo database if missing (peer authentication, no sudo); idempotent')]
tk-db-bootstrap:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk db bootstrap

[doc('Server version, database, user and schemas of the configured database')]
tk-db-status:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk db status

[doc('Run the stage CLI: just tk <subcommand> [args]')]
tk *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk "$@"

[doc('Acquire declared sources into the raw store and update sources.lock (networked): just tk-acquire [<id>...]')]
tk-acquire *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk acquire "$@"

[doc('Offline: recompute each stored tree hash and compare it with sources.lock: just tk-acquire-check [<id>...]')]
tk-acquire-check *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk acquire --check "$@"

[doc('Generate sql/generated/ from the declaration')]
tk-generate:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk generate

[doc('Compare sql/generated/ with a fresh generation; fails on any difference')]
tk-generate-check:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk generate --check

[doc('Create or refresh a side environment from its lock (envs/<name>, prefix .store/envs/<name>): just tk-env-sync thermotools|geochem|rmg')]
tk-env-sync name:
    bash {{ quote(tree / "envs/tk-env.sh") }} sync {{ quote(name) }}

[doc('Re-solve a side environment and rewrite its lock: just tk-env-lock thermotools|geochem|rmg')]
tk-env-lock name:
    bash {{ quote(tree / "envs/tk-env.sh") }} lock {{ quote(name) }}

[doc('Run a command inside a side environment: just tk-env-run <name> <command>...')]
tk-env-run name *args:
    bash {{ quote(tree / "envs/tk-env.sh") }} run "$@"

[doc('Read acquired sources into source-faithful staged Parquet: just tk-read [<id>...] [--force] [--list]')]
tk-read *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk read "$@"

[doc('Load staged Parquet into the src_<id> schemas of the configured database: just tk-load-src [<id>...]')]
tk-load-src *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk load-src "$@"

[doc('Map staged tables to canonical Parquet: just tk-map [<id>...] [--phase identity] [--force]')]
tk-map *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk map "$@"

[doc('Resolve the identity claims of every source with phase-1 output: just tk-resolve [--force]')]
tk-resolve *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk resolve "$@"

[doc('Build the canonical schemas of the configured database from the declaration and the canonical Parquet: just tk-build [--sources <id>] [--dry-run]')]
tk-build *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk build "$@"

[doc('Run every check of sql/verify/ against the built database and write the JSON report: just tk-verify [--report <path>]')]
tk-verify *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk verify "$@"

[doc('Run the qualification cases of qualification/ against the built database: just tk-qualify [<case>...] [--force] [--report <path>]')]
tk-qualify *args:
    unset VIRTUAL_ENV; uv run --project {{ quote(tree) }} --locked tk qualify "$@"
