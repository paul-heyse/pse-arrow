+    /// Estimated retained heap extent, including native kernel/log metadata and
+    /// materialized action/statistics buffers. Shared allocations are deliberately
+    /// charged in full per snapshot. This is capacity evidence, not allocator telemetry.
+    pub fn estimated_owned_heap_size_bytes(&self) -> usize {
+        let kernel = self.inner.estimated_owned_heap_size_bytes();
+        let materialized = self.materialized_files.as_ref().map_or(0, |files| {
+            // The private identity clones protocol/metadata from the same snapshot;
+            // charge another kernel metadata extent rather than serialized JSON size.
+            files.batches.iter().fold(
+                kernel.saturating_add(std::mem::size_of::<MaterializedFiles>()),
+                |sum, batch| sum.saturating_add(batch.get_array_memory_size()),
+            )
+        });
+        std::mem::size_of::<Self>()
+            .saturating_add(kernel)
+            .saturating_add(materialized)
+    }
